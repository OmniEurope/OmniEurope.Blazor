@page "/"
@rendermode InteractiveServer

<PageTitle>Catalogue OmniEurope.Blazor</PageTitle>

<OmniComponentsHost OverlayService="@Overlays">
    <header class="catalog-hero">
        <OmniHeading Level="OmniHeadingLevel.H1">Catalogue des composants</OmniHeading>
        <p>Hôte de validation local des 110 capacités inventoriées. Les exemples utilisent la feuille statique du paquet, une CSP sans <code>unsafe-inline</code> ni <code>unsafe-eval</code>, et aucun projet consommateur.</p>
        <div class="catalog-summary">
            <div><strong>110/110</strong><span>balises couvertes</span></div>
            <div><strong>0</strong><span>style inline</span></div>
            <div><strong>10</strong><span>familles fonctionnelles</span></div>
        </div>
    </header>

    <section class="catalog-section" aria-labelledby="foundations-title">
        <OmniHeading Level="OmniHeadingLevel.H2" Id="foundations-title">Fondations et actions</OmniHeading>
        <div class="catalog-grid">
            <OmniCard Class="catalog-card">
                <Header>Boutons et états</Header>
                <ChildContent>
                    <div class="catalog-row">
                        <OmniButton>Principal</OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary">Secondaire</OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Danger">Danger</OmniButton>
                        <OmniButton Busy="true">Chargement</OmniButton>
                        <OmniToggleButton @bind-Value="ToggleValue">Basculer</OmniToggleButton>
                    </div>
                </ChildContent>
            </OmniCard>
            <OmniCard Class="catalog-card">
                <Header>Messages</Header>
                <ChildContent>
                    <div class="catalog-list">
                        <OmniAlert Severity="OmniAlertSeverity.Info" Title="Information">Message informatif.</OmniAlert>
                        <OmniAlert Severity="OmniAlertSeverity.Success" Title="Succès">Opération terminée.</OmniAlert>
                        <OmniProgressBar Value="68" Label="Progression" />
                        <OmniSkeleton Lines="2" />
                    </div>
                </ChildContent>
            </OmniCard>
            <OmniCard Class="catalog-card">
                <Header>Superpositions</Header>
                <ChildContent>
                    <div class="catalog-row">
                        <OmniButton OnClick="@(_ => OpenDialog())">Ouvrir le dialogue</OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary" OnClick="@(_ => Notify())">Notifier</OmniButton>
                        <OmniTooltip Text="Infobulle accessible">Survolez ou focalisez</OmniTooltip>
                    </div>
                </ChildContent>
            </OmniCard>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="forms-title">
        <OmniHeading Level="OmniHeadingLevel.H2" Id="forms-title">Formulaires et sélections</OmniHeading>
        <OmniCard Class="catalog-card">
            <EditForm EditContext="@EditContext" class="catalog-form">
                <OmniFormField For="catalog-name" Label="@NameLabel" Required="true">
                    <OmniTextBox Id="catalog-name" Placeholder="Nom" @bind-Value="Model.Name" />
                    <OmniRequiredValidator TValue="string" For="@(() => Model.Name)" />
                </OmniFormField>
                <OmniTextArea Id="catalog-notes" ShowCount="true" MaxLength="120" @bind-Value="Model.Notes" />
                <OmniDropDown TValue="string" Id="catalog-choice" Options="@Options" @bind-Value="Model.Choice" />
                <OmniAutocomplete TValue="string" Id="catalog-search" Search="SearchAsync" DebounceMilliseconds="100" @bind-Value="Model.Search" />
                <OmniDatePicker Id="catalog-date" @bind-Value="Model.Date" />
                <OmniSlider Id="catalog-slider" @bind-Value="Model.Amount" />
                <OmniColorPicker Id="catalog-color" @bind-Value="Model.Color" />
                <OmniUpload AllowedContentTypes="@AllowedTypes" />
            </EditForm>
        </OmniCard>
    </section>

    <section class="catalog-section" aria-labelledby="navigation-title">
        <OmniHeading Level="OmniHeadingLevel.H2" Id="navigation-title">Navigation et collections</OmniHeading>
        <OmniBreadcrumb><OmniBreadcrumbItem Href="/">Accueil</OmniBreadcrumbItem><OmniBreadcrumbItem Current="true">Catalogue</OmniBreadcrumbItem></OmniBreadcrumb>
        <OmniTabs @bind-Value="Tab" Keys="@TabKeys">
            <OmniTabsItem Key="list" Title="Liste">
                <OmniDataList TItem="string" Items="@Names" ItemTemplate="@NameTemplate" />
            </OmniTabsItem>
            <OmniTabsItem Key="tree" Title="Arbre">
                <OmniTree TValue="string" Multiple="true" @bind-SelectedValues="TreeSelection">
                    <OmniTreeItem TValue="string" Value="@Alpha" Text="Europe" Expanded="true">
                        <OmniTreeItem TValue="string" Value="@Beta" Text="Belgique" />
                    </OmniTreeItem>
                </OmniTree>
            </OmniTabsItem>
        </OmniTabs>
    </section>

    <section class="catalog-section" aria-labelledby="data-title">
        <OmniHeading Level="OmniHeadingLevel.H2" Id="data-title">Données et graphiques</OmniHeading>
        <OmniDataGrid TItem="CatalogRow" Items="@Rows" Caption="Exemple de grille" PageSize="5" SelectionMode="OmniDataGridSelectionMode.Multiple" KeySelector="row => row.Id" @bind-SelectedKeys="GridSelection">
            <Columns>
                <OmniDataGridColumn TItem="CatalogRow" Key="name" Title="Nom" Value="row => row.Name" Filterable="true" />
                <OmniDataGridColumn TItem="CatalogRow" Key="value" Title="Valeur" Value="row => row.Value" />
            </Columns>
        </OmniDataGrid>
        <div class="catalog-chart">
            <OmniChart Id="catalog-chart" Title="Indicateurs" Description="Trois points de démonstration" DataTable="@ChartTable">
                <OmniGridLines />
                <OmniCategoryAxis Labels="@ChartLabels" />
                <OmniValueAxis />
                <OmniLineSeries Data="@ChartPoints" Title="Mesure" />
                <OmniMarkers Data="@ChartPoints" />
            </OmniChart>
        </div>
    </section>

    <section class="catalog-section" aria-labelledby="time-title">
        <OmniHeading Level="OmniHeadingLevel.H2" Id="time-title">Temps et contenu HTML</OmniHeading>
        <OmniScheduler Date="@SchedulerDate" Items="@Appointments" TimeZone="@TimeZoneInfo.Utc" />
        <EditForm EditContext="@EditContext">
            <OmniHtmlEditor Id="catalog-editor" @bind-Value="Model.Html" />
        </EditForm>
    </section>
</OmniComponentsHost>

@code {
    private readonly OmniOverlayService Overlays = new();
    private readonly CatalogModel Model = new();
    private EditContext EditContext = default!;
    private bool ToggleValue;
    private string? Tab = "list";
    private IReadOnlyList<string> TreeSelection = Array.Empty<string>();
    private IReadOnlyList<object> GridSelection = Array.Empty<object>();
    private string Alpha { get; } = "europe";
    private string Beta { get; } = "belgium";
    private IReadOnlyList<string> TabKeys { get; } = ["list", "tree"];
    private IReadOnlyList<string> Names { get; } = ["Astraia", "Aetheus", "Pronoia"];
    private IReadOnlyList<string> AllowedTypes { get; } = ["text/plain", "image/png"];
    private IReadOnlyList<OmniOption<string>> Options { get; } = [new("one", "Premier"), new("two", "Second")];
    private IReadOnlyList<CatalogRow> Rows { get; } = [new(1, "Alpha", 30), new(2, "Beta", 70), new(3, "Gamma", 45)];
    private IReadOnlyList<OmniChartPoint> ChartPoints { get; } = [new(10, 30, "A"), new(50, 70, "B"), new(90, 45, "C")];
    private IReadOnlyList<string> ChartLabels { get; } = ["A", "B", "C"];
    private DateTimeOffset SchedulerDate { get; } = new(2026, 8, 10, 0, 0, 0, TimeSpan.Zero);
    private IReadOnlyList<OmniSchedulerAppointment> Appointments { get; } = [new("demo", "Revue du catalogue", new DateTimeOffset(2026, 8, 10, 9, 0, 0, TimeSpan.Zero), new DateTimeOffset(2026, 8, 10, 10, 0, 0, TimeSpan.Zero))];
    private RenderFragment NameLabel => builder => builder.AddContent(0, "Nom du composant");
    private RenderFragment<string> NameTemplate => value => builder => builder.AddContent(0, value);
    private RenderFragment ChartTable => builder => builder.AddMarkupContent(0, "<table><caption>Données : A 30, B 70, C 45</caption></table>");

    protected override void OnInitialized() => EditContext = new EditContext(Model);
    private Task<IReadOnlyList<OmniOption<string>>> SearchAsync(string text, CancellationToken token) => Task.FromResult<IReadOnlyList<OmniOption<string>>>(Options.Where(option => option.Text.Contains(text, StringComparison.OrdinalIgnoreCase)).ToArray());
    private void OpenDialog() => Overlays.OpenDialog(new OmniDialogRequest("Dialogue du catalogue", builder => builder.AddContent(0, "Le focus et la fermeture contrôlée peuvent être vérifiés ici.")));
    private void Notify() => Overlays.Notify("La notification est annoncée dans une région live.", OmniNotificationSeverity.Success);

    private sealed record CatalogRow(int Id, string Name, int Value);
    private sealed class CatalogModel
    {
        public string Name { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public string Choice { get; set; } = "one";
        public string Search { get; set; } = string.Empty;
        public DateOnly? Date { get; set; } = new DateOnly(2026, 8, 10);
        public double Amount { get; set; } = 55;
        public string Color { get; set; } = "#165DFF";
        public string Html { get; set; } = "<p>Contenu <strong>sanitizé</strong>.</p>";
    }
}
