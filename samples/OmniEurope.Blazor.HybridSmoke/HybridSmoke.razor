@using OmniEurope.Blazor.Components

<OmniCard Id="hybrid-probe">
    <OmniHeading Level="@OmniHeadingLevel.H2">@Text["Title"]</OmniHeading>
    <OmniButton Id="hybrid-action" OnClick="@(_ => IncrementAsync())"><Icon><OmniIcon Name="OmniIconName.Check" Size="OmniControlSize.Small" /></Icon> <ChildContent><span>@Text["Action"]</span></ChildContent></OmniButton>
    <output id="hybrid-count" aria-live="polite">@Count</output>
</OmniCard>
