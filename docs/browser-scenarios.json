{
  "scope": "Only interactions asserted by the referenced runtime scripts are listed.",
  "scenarios": [
    {
      "id": "catalog-critical-interactions",
      "host": "Server catalog",
      "script": "eng/Test-CatalogProbe.mjs",
      "components": ["OmniButton", "OmniComponentsHost", "OmniDialog", "OmniNotification"],
      "assertions": ["five catalog families", "dialog opens and owns focus", "dialog closes", "notification live role", "zero browser console errors", "zero client CSP violations"]
    },
    {
      "id": "wasm-counter-progress",
      "host": "WebAssembly",
      "script": "eng/Test-WasmHost.ps1",
      "components": ["OmniButton", "OmniProgressBar"],
      "assertions": ["counter changes to 1", "progress aria-valuenow changes to 1", "zero browser console errors"]
    },
    {
      "id": "auto-counter",
      "host": "Interactive Auto",
      "script": "eng/Test-AutoHost.ps1",
      "components": ["OmniButton"],
      "assertions": ["prerender marker", "hydrated counter changes to 1", "zero browser console errors"]
    },
    {
      "id": "hybrid-counter",
      "host": "MAUI Blazor Hybrid",
      "script": "eng/Test-HybridHost.ps1",
      "components": ["OmniButton"],
      "assertions": ["WebView2 counter changes to 1", "zero WebView console errors"]
    },
    {
      "id": "showcase-mindmap-gestures",
      "host": "Static WebAssembly showcase with strict CSP headers, run by hand, not in CI",
      "script": "eng/Test-ShowcaseMindMapProbe.mjs",
      "components": ["OmniMindMap", "OmniMindMapNodeProperties"],
      "assertions": ["trusted mouse drag moves the node and its link, committed by .NET", "wheel zooms in", "arrow keys move aria-activedescendant", "N adds a node and Ctrl+Z removes it", "context menu takes the focus, ArrowDown walks it, Escape closes it and returns the focus to the canvas", "double click on the background adds a node", "zero CSP violations", "zero inline style attributes", "zero browser console errors"]
    }
  ]
}
