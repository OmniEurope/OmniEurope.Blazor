<Project Sdk="Microsoft.NET.Sdk">
  <!-- The showcase API: unit tests of its rules, and integration tests against a real PostgreSQL
       started by Testcontainers (Docker required; without Docker those tests fail, they never skip). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../site/OmniEurope.Blazor.Showcase.Back/OmniEurope.Blazor.Showcase.Back.csproj" />
  </ItemGroup>
</Project>
