<EditForm EditContext="@EditContext">
    <OmniHtmlEditor Id="editor" Mode="OmniHtmlEditorMode.Source" Commands="@Commands" @bind-Value="Model.Html" />
</EditForm>

@code {
    public EditorModel Model { get; } = new();
    public EditContext EditContext { get; private set; } = default!;
    private IReadOnlyList<OmniHtmlEditorCommand> Commands { get; } =
    [
        .. OmniHtmlEditorCommands.Default,
        OmniHtmlEditorCommands.Separator,
        OmniHtmlEditorCommand.Create("heading", "Titre", context => context.SetHtmlAsync($"<h2>{context.Html}</h2>"))
    ];
    protected override void OnInitialized() => EditContext = new EditContext(Model);
    public sealed class EditorModel { public string Html { get; set; } = "<p>Bonjour</p>"; }
}
