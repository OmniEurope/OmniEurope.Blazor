@* Columns of every alignment case for the numeric cell: a text property, a numeric property left at
   the default alignment, a numeric property aligned explicitly (centred, or stretched, which a column reads as the start), a numeric value read by a lambda, and a
   numeric property drawn by its own template. *@
<OmniDataGrid TItem="NumericRun"
              Items="@Runs"
              SelectionMode="OmniDataGridSelectionMode.Single"
              KeyOf="run => run.Name"
              Value="@Selected">
    <Columns>
        <OmniDataGridColumn TItem="NumericRun" Key="name" Title="Nom" Property="Name" />
        <OmniDataGridColumn TItem="NumericRun" Key="duration" Title="Durée" Property="Duration" />
        <OmniDataGridColumn TItem="NumericRun" Key="cost" Title="Coût" Property="Cost" TextAlign="OmniAlignment.Center" />
        <OmniDataGridColumn TItem="NumericRun" Key="stretched-number" Title="Étiré" Property="Duration" TextAlign="OmniAlignment.Stretch" />
        <OmniDataGridColumn TItem="NumericRun" Key="stretched-text" Title="Libellé" Property="Name" TextAlign="OmniAlignment.Stretch" />
        <OmniDataGridColumn TItem="NumericRun" Key="lambda" Title="Calcul" Value="run => run.Duration * 2" />
        <OmniDataGridColumn TItem="NumericRun" Key="templated" Title="Numéro" Property="Duration">
            <Template Context="run"><a href="#">#@run.Duration</a></Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@code {
    public IReadOnlyList<NumericRun> Runs { get; } = [new("a", 12, 1.5m), new("b", 7, 2m)];

    public IReadOnlyList<NumericRun> Selected => [Runs[1]];

    public sealed record NumericRun(string Name, int Duration, decimal? Cost);
}
