@* The three pickers inside an open dialog, to check that Escape in a panel stays in the panel. *@
<OmniDialog @bind-Open="Open" Title="Rendez-vous">
    <OmniDatePicker Id="date" TimeProvider="@Clock" @bind-Value="Date" />
    <OmniTimePicker Id="time" TimeProvider="@Clock" @bind-Value="Time" />
    <OmniDateTimePicker Id="moment" TimeProvider="@Clock" @bind-Value="Moment" />
</OmniDialog>

@code {
    [Parameter] public TimeProvider Clock { get; set; } = TimeProvider.System;

    public bool Open { get; set; } = true;

    public DateOnly? Date { get; set; }

    public TimeOnly? Time { get; set; }

    public DateTime? Moment { get; set; }
}
