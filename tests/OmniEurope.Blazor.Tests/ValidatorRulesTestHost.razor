<EditForm EditContext="@EditContext">
    <OmniEmailValidator For="@(() => Model.Mail)" Message="@MailMessage" />
    <OmniLengthValidator For="@(() => Model.Code)" Min="@Min" Max="@Max" Message="@CodeMessage" />
</EditForm>

@code {
    [Parameter] public int? Min { get; set; }
    [Parameter] public int? Max { get; set; } = 4;
    [Parameter] public string? MailMessage { get; set; }
    [Parameter] public string? CodeMessage { get; set; }

    public RulesModel Model { get; } = new();
    public EditContext EditContext { get; private set; } = default!;

    protected override void OnInitialized() => EditContext = new EditContext(Model);

    public sealed class RulesModel
    {
        public string Mail { get; set; } = string.Empty;
        public string? Code { get; set; }
    }
}
