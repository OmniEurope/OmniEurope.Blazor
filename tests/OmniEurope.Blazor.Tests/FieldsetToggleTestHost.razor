@* A host that binds the open state both ways, and can stop listening on the same instance. *@
<OmniFieldset Collapsible="true" Expanded="Expanded" ExpandedChanged="Callback">
    <Legend>Avancé</Legend>
    <ChildContent>Champs</ChildContent>
</OmniFieldset>

@code {
    public bool Expanded { get; set; }

    public bool Listening { get; set; } = true;

    public List<bool> Reported { get; } = [];

    private EventCallback<bool> Callback => Listening
        ? EventCallback.Factory.Create<bool>(this, HandleChanged)
        : default;

    private void HandleChanged(bool expanded)
    {
        Reported.Add(expanded);
        Expanded = expanded;
    }

    public void Open(bool expanded)
    {
        Expanded = expanded;
        StateHasChanged();
    }

    public void StopListening()
    {
        Listening = false;
        StateHasChanged();
    }
}
