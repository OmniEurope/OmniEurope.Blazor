@* Formats and Position are conveniences of this host: given formats switch on exactly those export buttons, in the
   footer bar (Bottom), the header bar (Top) or both (TopAndBottom), unless ShowHeaderBar or ShowFooterBar ask for more. *@
<OmniDataGrid TItem="Row"
              Items="@Items"
              Load="@Load"
              ExportLoad="@ExportLoad"
              KeyOf="@(row => row.Id)"
              PageSize="2"
              Caption="@Caption"
              ShowHeaderBar="@(ShowHeaderBar || (Formats.Count > 0 && Position != OmniDataGridPlacement.Bottom))"
              ShowFooterBar="@(ShowFooterBar || (Formats.Count > 0 && Position != OmniDataGridPlacement.Top))"
              HeaderBarExport="@HeaderBarExport"
              FooterBarExport="@FooterBarExport"
              HeaderBarContent="@HeaderBarContent"
              FooterBarContent="@FooterBarContent"
              ExportMarkdown="@(Formats.Count == 0 ? ExportMarkdown : Formats.Contains(OmniTableExportFormat.Markdown))"
              ExportCsv="@(Formats.Count == 0 ? ExportCsv : Formats.Contains(OmniTableExportFormat.Csv))"
              ExportExcel="@(Formats.Count == 0 ? ExportExcel : Formats.Contains(OmniTableExportFormat.Excel))"
              ExportPdf="@(Formats.Count == 0 ? ExportPdf : Formats.Contains(OmniTableExportFormat.Pdf))"
              ExportTitle="@Title"
              ExportFields="@Fields"
              ExportFileName="@FileName"
              ExportVariants="@Variants"
              ShowExportButtonText="@ShowExportButtonText"
              ExportRowLimit="@RowLimit"
              OnExport="@Deliver"
              OnExportError="@(exception => Failure = exception)">
    <Columns>
        @if (OnlyTemplates)
        {
            <OmniDataGridColumn TItem="Row" Title="Actions">
                <Template Context="row"><button type="button">Ouvrir</button></Template>
            </OmniDataGridColumn>
        }
        else
        {
        <OmniDataGridColumn TItem="Row" Property="Id" Title="N°" />
        <OmniDataGridColumn TItem="Row" Property="Name" Title="Nom" DefaultFilterValue="@NameFilter" SortOrder="@NameSort" />
        <OmniDataGridColumn TItem="Row" Property="Amount" Title="Montant" FormatString="{0:n2} EUR" />
        <OmniDataGridColumn TItem="Row" Property="Day" Title="Jour" />
        <OmniDataGridColumn TItem="Row" Title="Statut" ExportValue="@(row => row.Paid ? "payée" : "due")">
            <Template Context="row"><strong>@(row.Paid ? "payée" : "due")</strong></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="Row" Property="Secret" Title="Interne" Exportable="false" />
        <OmniDataGridColumn TItem="Row" Property="Name" Key="hidden" Title="Masquée" Visible="false" />
        <OmniDataGridColumn TItem="Row" Title="Actions">
            <Template Context="row"><button type="button">Ouvrir</button></Template>
        </OmniDataGridColumn>
        }
    </Columns>
</OmniDataGrid>

@code {
    [Parameter] public IReadOnlyList<Row> Items { get; set; } = [];

    [Parameter] public Func<OmniDataGridLoadRequest, Task<OmniDataGridResult<Row>>>? Load { get; set; }

    [Parameter] public Func<OmniDataGridLoadRequest, Task<OmniDataGridResult<Row>>>? ExportLoad { get; set; }

    [Parameter] public IReadOnlyList<OmniTableExportFormat> Formats { get; set; } = [];

    [Parameter] public OmniDataGridPlacement Position { get; set; }

    [Parameter] public bool ShowHeaderBar { get; set; }

    [Parameter] public bool ShowFooterBar { get; set; }

    [Parameter] public OmniDataGridBarExport HeaderBarExport { get; set; } = OmniDataGridBarExport.Start;

    [Parameter] public OmniDataGridBarExport FooterBarExport { get; set; } = OmniDataGridBarExport.Start;

    [Parameter] public RenderFragment? HeaderBarContent { get; set; }

    [Parameter] public RenderFragment? FooterBarContent { get; set; }

    [Parameter] public bool ExportMarkdown { get; set; } = true;

    [Parameter] public bool ExportCsv { get; set; } = true;

    [Parameter] public bool ExportExcel { get; set; } = true;

    [Parameter] public bool ExportPdf { get; set; } = true;

    [Parameter] public string? Caption { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public IReadOnlyList<OmniTableExportField> Fields { get; set; } = [];

    [Parameter] public int RowLimit { get; set; } = 5000;

    [Parameter] public string? NameFilter { get; set; }

    [Parameter] public OmniDataGridSortOrder? NameSort { get; set; }

    [Parameter] public bool ThrowOnExport { get; set; }

    [Parameter] public string? FileName { get; set; } = "commandes";

    [Parameter] public IReadOnlyDictionary<OmniTableExportFormat, OmniButtonVariant>? Variants { get; set; }

    [Parameter] public bool OnlyTemplates { get; set; }

    [Parameter] public bool ShowExportButtonText { get; set; }

    public OmniTableExportDocument? Exported { get; private set; }

    // A host handler that fails after the file was handed over, when ThrowOnExport asks for it.
    private void Deliver(OmniTableExportDocument document)
    {
        Exported = document;
        if (ThrowOnExport)
        {
            throw new InvalidOperationException("host handler failed");
        }
    }

    public Exception? Failure { get; private set; }

    public sealed record Row(int Id, string Name, decimal Amount, DateOnly Day, bool Paid, string Secret = "interne");
}
