@using System.Linq.Expressions

<EditForm EditContext="@EditContext">
    <OmniRequiredValidator TValue="string" For="@TargetExpression" />
</EditForm>

@code {
    public ValidatorModel Model { get; private set; } = new("same", string.Empty);
    public EditContext EditContext { get; private set; } = default!;
    private bool _useBlank;

    private Expression<Func<string>> TargetExpression =>
        _useBlank ? () => Model.Blank : () => Model.Value;

    protected override void OnInitialized() => EditContext = new EditContext(Model);

    public void ValidateTheBlankField() => _useBlank = true;

    public void ReplaceModel()
    {
        Model = new ValidatorModel(string.Empty, string.Empty);
        EditContext = new EditContext(Model);
        _useBlank = false;
    }

    public sealed record ValidatorModel(string Value, string Blank);
}
