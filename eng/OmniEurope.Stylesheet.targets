<Project>
  <!--
    The stylesheet is written as ordered parts under Styles/ (NN-topic.css), each with the comments
    that explain why its rules exist. The build joins them in file-name order, which is the cascade
    order, into the one omnieurope.blazor.css a host downloads at the same path as ever, and also
    writes a minified copy of it. Release serves the minified copy, so builds, publishes and the NuGet
    package all ship it; Debug serves the readable joined copy.
  -->
  <PropertyGroup>
    <OmniShipMinifiedStylesheet Condition="'$(OmniShipMinifiedStylesheet)' == '' and '$(Configuration)' == 'Release'">true</OmniShipMinifiedStylesheet>
  </PropertyGroup>

  <UsingTask TaskName="OmniBuildStylesheet"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.IO;
using System.Linq;
using System.Text;

public sealed class OmniBuildStylesheet : Microsoft.Build.Utilities.Task
{
    [Microsoft.Build.Framework.Required]
    public string PartsDirectory { get; set; }

    [Microsoft.Build.Framework.Required]
    public string JoinedDestination { get; set; }

    [Microsoft.Build.Framework.Required]
    public string MinifiedDestination { get; set; }

    public override bool Execute()
    {
        // Ordinal file-name order is the cascade order: the NN- prefix of each part fixes its place.
        var parts = Directory.Exists(PartsDirectory)
            ? Directory.GetFiles(PartsDirectory, "*.css").OrderBy(path => Path.GetFileName(path), StringComparer.Ordinal).ToArray()
            : new string[0];
        if (parts.Length == 0)
        {
            Log.LogError("No stylesheet part (*.css) found in {0}.", PartsDirectory);
            return false;
        }

        var joined = new StringBuilder();
        var starts = new int[parts.Length];
        for (var index = 0; index < parts.Length; index++)
        {
            var text = File.ReadAllText(parts[index]);
            // A part that does not end its last line would weld it to the first line of the next part.
            if (text.Length > 0 && text[text.Length - 1] != '\n')
            {
                Log.LogError("{0} does not end with a line break.", parts[index]);
                return false;
            }

            starts[index] = joined.Length;
            joined.Append(text);
        }

        var css = joined.ToString();
        var minified = Minify(css, offset => parts[Array.FindLastIndex(starts, start => start <= offset)]);
        if (minified == null)
        {
            return false;
        }

        Write(JoinedDestination, css);
        Write(MinifiedDestination, minified);
        return !Log.HasLoggedErrors;
    }

    private string Minify(string css, Func<int, string> partAt)
    {
        var output = new StringBuilder(css.Length);
        var pendingSpace = false;

        for (var i = 0; i < css.Length; i++)
        {
            var c = css[i];
            if (c == '/' && i + 1 < css.Length && css[i + 1] == '*')
            {
                var end = css.IndexOf("*/", i + 2, StringComparison.Ordinal);
                if (end < 0)
                {
                    Log.LogError("Unterminated comment in {0}.", partAt(i));
                    return null;
                }

                // A comment is dropped without turning into a space: between two tokens it may be the
                // only separator, and a space there would change what a selector matches.
                i = end + 1;
                continue;
            }

            if (char.IsWhiteSpace(c))
            {
                pendingSpace = true;
                continue;
            }

            // Whitespace survives, as one space, unless a neighbour makes it meaningless. A space
            // before ':' is kept: '.a :hover' and '.a:hover' select different elements.
            if (pendingSpace && output.Length > 0 && "{};,>:".IndexOf(output[output.Length - 1]) < 0 && "{};,>".IndexOf(c) < 0)
            {
                output.Append(' ');
            }

            pendingSpace = false;
            if (c == '}' && output.Length > 0 && output[output.Length - 1] == ';')
            {
                output.Length--;
            }

            output.Append(c);
            if (c == '"' || c == '\'')
            {
                for (i++; i < css.Length; i++)
                {
                    output.Append(css[i]);
                    if (css[i] == '\\' && i + 1 < css.Length)
                    {
                        output.Append(css[++i]);
                    }
                    else if (css[i] == c)
                    {
                        break;
                    }
                }
            }
        }

        return output.ToString();
    }

    // Rewritten only when the content changes, so an unchanged stylesheet keeps its timestamp and the
    // static web asset pipeline does not compress it again. The task runs on every build: a part
    // added, edited or deleted is always seen, which timestamp inputs could not promise for a deletion.
    private static void Write(string destination, string content)
    {
        Directory.CreateDirectory(Path.GetDirectoryName(destination));
        if (!File.Exists(destination) || File.ReadAllText(destination) != content)
        {
            File.WriteAllText(destination, content, new UTF8Encoding(false));
        }
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="OmniBuildStylesheet" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(NoBuild)' != 'true'">
    <PropertyGroup>
      <_OmniStylesheetRoot>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)omni-stylesheet'))))\</_OmniStylesheetRoot>
      <_OmniStylesheetJoinedRoot>$(_OmniStylesheetRoot)joined\</_OmniStylesheetJoinedRoot>
      <_OmniStylesheetServedRoot Condition="'$(OmniShipMinifiedStylesheet)' == 'true'">$(_OmniStylesheetRoot)</_OmniStylesheetServedRoot>
      <_OmniStylesheetServedRoot Condition="'$(OmniShipMinifiedStylesheet)' != 'true'">$(_OmniStylesheetJoinedRoot)</_OmniStylesheetServedRoot>
    </PropertyGroup>

    <OmniBuildStylesheet PartsDirectory="$(MSBuildProjectDirectory)\Styles"
                         JoinedDestination="$(_OmniStylesheetJoinedRoot)omnieurope.blazor.css"
                         MinifiedDestination="$(_OmniStylesheetRoot)omnieurope.blazor.css" />

    <!-- There is no stylesheet under wwwroot: the served copy is added here as the static web asset. -->
    <ItemGroup>
      <Content Include="$(_OmniStylesheetServedRoot)omnieurope.blazor.css"
               Link="wwwroot\omnieurope.blazor.css"
               ContentRoot="$(_OmniStylesheetServedRoot)"
               CopyToPublishDirectory="PreserveNewest"
               CopyToOutputDirectory="Never" />
    </ItemGroup>
  </Target>
</Project>
