<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One build per target framework of the package: each loads the matching lib of OmniEurope.Blazor, and
         eng/Test-PublicApi.ps1 checks both against the one baseline docs/public-api.txt. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OmniEurope.Blazor/OmniEurope.Blazor.csproj" />
  </ItemGroup>
</Project>
