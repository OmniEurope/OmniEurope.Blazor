<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The API of the showcase application: anonymous visitor preferences in PostgreSQL. It belongs
       to the deployed showcase, never to the NuGet package, which references none of it. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniEurope.Blazor.Showcase.Back.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OmniEurope.Blazor.Showcase.Shared/OmniEurope.Blazor.Showcase.Shared.csproj" />
  </ItemGroup>
</Project>
