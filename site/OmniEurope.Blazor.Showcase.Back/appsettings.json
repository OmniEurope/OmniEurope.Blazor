{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "SingleLine": true
      }
    }
  },
  "AllowedHosts": "*",
  "Preferences": {
    "Limits": {
      "MaxValueLength": 16384,
      "MaxKeysPerVisitor": 100,
      "MaxStoredLengthPerVisitor": 65536,
      "MaxVisitors": 50000,
      "NewVisitorsPerAddressPerHour": 20
    },
    "Retention": {
      "IdleDays": 60,
      "SweepInterval": "06:00:00",
      "BatchSize": 1000
    }
  },
  "RateLimiting": {
    "ReadsPerMinute": 240,
    "WritesPerMinute": 60
  }
}
