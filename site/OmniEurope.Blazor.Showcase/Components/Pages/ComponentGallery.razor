@page "/components/legacy"
@page "/components/legacy/{DemoKey}"
@using OmniEurope.Blazor.Showcase.Components.Gallery
@using OmniEurope.Blazor.Showcase.Demos

@* The gallery of the earlier demos, kept reachable under components/legacy until each is moved to a
   page of the new gallery (PLAN-005), then removed with its catalogue. *@

@if (Current is null)
{
    @* An address naming a key the gallery does not have: the same not-found content as the router's. *@
    <PageTitle>@Text["NotFoundPageTitle"]</PageTitle>
    <section aria-labelledby="not-found-title">
        <OmniHeading Id="not-found-title" Level="OmniHeadingLevel.H1">@Text["NotFoundTitle"]</OmniHeading>
        <p>@Text["NotFoundDescription"]</p>
        <OmniLink Href="">@Text["BackHome"]</OmniLink>
    </section>
    return;
}

<PageTitle>@Text["GalleryPageTitle"]</PageTitle>

<section aria-labelledby="gallery-title">
    <OmniHeading Id="gallery-title" Level="OmniHeadingLevel.H1">@Text["GalleryTitle"]</OmniHeading>
    <p>@Text["GalleryLead"]</p>
</section>

<article class="showcase-gallery__detail" aria-labelledby="demo-title">
    <OmniHeading Id="demo-title" Level="OmniHeadingLevel.H2">@Text[Current.TitleKey]</OmniHeading>
    <p>@Text[Current.SummaryKey]</p>

    <OmniHeading Level="OmniHeadingLevel.H3">@Text["GalleryCapabilities"]</OmniHeading>
    <ul>
        @foreach (var capability in Current.CapabilityKeys)
        {
            var arguments = Current.ArgumentsOf(capability);
            <li>@(arguments.Length == 0 ? Text[capability] : Text[capability, arguments])</li>
        }
    </ul>

    <OmniHeading Level="OmniHeadingLevel.H3">@Text["GalleryPreview"]</OmniHeading>
    <div class="showcase-preview">
        <DynamicComponent Type="Current.Component" />
    </div>

    <OmniHeading Level="OmniHeadingLevel.H3">@Text["GallerySource"]</OmniHeading>
    <p class="showcase-source-note">@Text["GallerySourceNote"]</p>
    @if (Source is null)
    {
        <OmniAlert Severity="OmniSeverity.Warning" Title="@Text["GallerySourceMissingTitle"]">
            @Text["GallerySourceMissing"]
        </OmniAlert>
    }
    else
    {
        <pre class="showcase-code"><code>@Source</code></pre>
    }
</article>
