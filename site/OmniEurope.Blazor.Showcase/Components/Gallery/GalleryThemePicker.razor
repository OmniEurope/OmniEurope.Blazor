@* The theme and the palette of the whole showcase, beside the title of every gallery page: they write
   the same state as the customizer, so the page, the menu and the customizer always agree. The light
   or dark mode stays in the site header. *@
<div class="gallery-theme-picker">
    <OmniDropDown TValue="string" Class="gallery-theme-picker__select" Options="ThemeOptions" Label="@Text["GalleryThemePicker"]"
                  @bind-Value:get="Theme.Theme.Name" @bind-Value:set="SelectThemeAsync" />
    <OmniDropDown TValue="string" Class="gallery-theme-picker__select" Options="PaletteOptions" Label="@Text["GalleryPalettePicker"]"
                  @bind-Value:get="Theme.Palette.Name" @bind-Value:set="SelectPaletteAsync" />
    @if (!OnThemePage)
    {
        <OmniButton Variant="OmniButtonVariant.Secondary" Label="@Foundations["ThemeOpenPage"]" title="@Foundations["ThemeOpenPage"]"
                    OnClick="OpenThemePage">
            <OmniIcon Name="OmniIconName.ThemeSystem" />
        </OmniButton>
    }
    <OmniButton Variant="OmniButtonVariant.Secondary" Label="@Text["GalleryOpenCustomizer"]" title="@Text["GalleryOpenCustomizer"]"
                OnClick="OpenCustomizer">
        <OmniIcon Name="OmniIconName.Palette" />
    </OmniButton>
</div>
