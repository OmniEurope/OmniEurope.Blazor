@page "/components/data-grid-variants"
@using OmniEurope.Blazor.Showcase.Examples.Data

<GalleryPageFrame Slug="data-grid-variants">
    <Preview>
        <OmniCard Class="gallery-preview">
            <HeaderContent>@Text["VariantsCasesTitle"]</HeaderContent>
            <ChildContent>
                <OmniText Tone="OmniTextTone.Muted">@Text["VariantsCasesHint"]</OmniText>
                <DataGridCasesExample />
            </ChildContent>
        </OmniCard>

        <OmniCard Class="gallery-preview">
            <HeaderContent>@Text["VariantsSizingTitle"]</HeaderContent>
            <ChildContent>
                <OmniText Tone="OmniTextTone.Muted">@Text["VariantsSizingHint"]</OmniText>
                <div class="gallery-data-sizing">
                    <DataGridContentSizingExample />
                </div>
