@page "/components/form-layouts"
@using OmniEurope.Blazor.Showcase.Examples.Forms

<GalleryPageFrame Slug="form-layouts">
    <Preview>
        <OmniCard Class="gallery-preview">
            <HeaderContent>@Text["FormLayoutsVerticalTitle"]</HeaderContent>
            <ChildContent>
                <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Muted">@Text["FormLayoutsVerticalDescription"]</OmniText>
                <VerticalFormExample />
            </ChildContent>
        </OmniCard>
        <OmniCard Class="gallery-preview">
            <HeaderContent>@Text["FormLayoutsChoicesTitle"]</HeaderContent>
            <ChildContent>
                <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Muted">@Text["FormLayoutsChoicesDescription"]</OmniText>
                <VerticalFormChoicesExample />
            </ChildContent>
        </OmniCard>
    </Preview>
</GalleryPageFrame>
