@page "/components/overflow-menu"
@using OmniEurope.Blazor.Showcase.Examples.Overlays

<GalleryPageFrame Slug="overflow-menu">
    <Settings>
        <OmniSettingsSection Title="@Text["OverflowMenuSettingsTitle"]" Description="@Text["OverflowMenuSettingsDescription"]">
            <OmniSettingsTile Title="@Text["OverflowMenuSize"]" Description="@Text["OverflowMenuSizeDescription"]">
                <Icon><OmniIcon Name="OmniIconName.Ruler" /></Icon>
                <Details>
                    <OmniSelectBar TValue="OmniControlSize" Options="@SizeOptions" @bind-Value="Size" Label="@Text["OverflowMenuSize"]" />
                </Details>
            </OmniSettingsTile>

            <OmniSettingsTile Title="@Text["OverflowMenuDisabled"]" Description="@Text["OverflowMenuDisabledDescription"]">
                <Icon><OmniIcon Name="OmniIconName.Prohibit" /></Icon>
                <ChildContent>
                    <OmniSwitch @bind-Value="Disabled" aria-label="@Text["OverflowMenuDisabled"]" />
                </ChildContent>
            </OmniSettingsTile>

            <OmniSettingsTile Title="@Text["OverflowMenuShowDelete"]" Description="@Text["OverflowMenuShowDeleteDescription"]">
                <Icon><OmniIcon Name="OmniIconName.Delete" /></Icon>
                <ChildContent>
                    <OmniSwitch @bind-Value="ShowDelete" aria-label="@Text["OverflowMenuShowDelete"]" />
                </ChildContent>
            </OmniSettingsTile>

            <OmniSettingsTile Title="@Text["OverflowMenuDisableRename"]" Description="@Text["OverflowMenuDisableRenameDescription"]">
                <Icon><OmniIcon Name="OmniIconName.Edit" /></Icon>
                <ChildContent>
                    <OmniSwitch @bind-Value="DisableRename" aria-label="@Text["OverflowMenuDisableRename"]" />
                </ChildContent>
            </OmniSettingsTile>
        </OmniSettingsSection>
    </Settings>
    <Preview>
        <OmniCard Class="gallery-preview">
            <HeaderContent>@Text["OverflowMenuPreviewTitle"]</HeaderContent>
            <ChildContent>
                <OverflowMenuExample Size="Size" Disabled="Disabled" ShowDelete="ShowDelete" DisableRename="DisableRename" />
                <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Muted">@Text["OverflowMenuKeyboardHint"]</OmniText>
            </ChildContent>
        </OmniCard>
    </Preview>
</GalleryPageFrame>
