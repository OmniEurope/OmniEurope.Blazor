@* What is left of the layout demonstration once rows, columns, cards, field groups, settings sections and
   densities moved to the gallery pages: the tile grids, which the stat tiles and navigation tiles page will absorb. *@
<OmniStack Gap="OmniSpacing.Large">
    @* Grille de tuiles (OmniTileGrid) : toutes les tuiles du paquet y ont la même largeur et, par défaut, la
       même hauteur, celle de la plus haute, quel que soit leur contenu ; DoubleWidth en étale une sur deux
       colonnes. Les mots qui ne tiennent pas passent à la ligne ou sont coupés dans la tuile, rien ne déborde. *@
    <OmniTileGrid Id="demo-tile-grid" Columns="4">
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 12.4]" Title="@Text["DemoPagesTokensToday"]" Detail="@Text["DemoPagesTokensReset", new TimeOnly(18, 0)]">
            <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
        </OmniStatTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 8.2]" Title="@Text["DemoPagesWeekly"]">
            <Icon><OmniIcon Name="OmniIconName.CalendarCheck" /></Icon>
        </OmniStatTile>
        <OmniNavTile Href="components/legacy/grille" Title="@Text["DemoGridTitle"]" Description="@Text["DemoGridSummary"]">
            <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
        </OmniNavTile>
        <OmniCard><ChildContent>@Text["DemoLayoutStretchedText"]</ChildContent></OmniCard>
        <OmniSelectableCard Title="Linux" Description="Debian, Ubuntu, Fedora" Multiple="true" @bind-Value="TileChoice">
            <Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon>
        </OmniSelectableCard>
        <OmniNavTile Href="components/legacy/editeur" Title="@Text["DemoEditorTitle"]" Tone="OmniTone.Info" DoubleWidth="true">
            <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
        </OmniNavTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 3.6]" Title="@Text["DemoPagesGain"]">
            <Icon><OmniIcon Name="OmniIconName.ChartLineUp" /></Icon>
        </OmniStatTile>
        @* Tuiles cliquables : elles gardent leur place dans la grille (même taille, DoubleWidth respecté). Une carte avec OnClick
           est un seul bouton, donc son contenu est du contenu phrasé (des span) ; une tuile chiffre avec Href est un seul lien. *@
        <OmniCard Id="demo-click-card" OnClick="@(() => CardClicks++)" DoubleWidth="true">
            <HeaderContent>@Text["DemoLayoutClickCardTitle"]</HeaderContent>
            <ChildContent>@Text["DemoLayoutClickCardText"] <strong id="demo-click-card-count">@Text["DemoLayoutClickCardCount", CardClicks]</strong></ChildContent>
        </OmniCard>
        <OmniStatTile Id="demo-link-tile" Href="components/legacy/grille" Value="@Text["DemoPagesTokensValue", 5.1]" Title="@Text["DemoGridTitle"]">
            <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
        </OmniStatTile>
    </OmniTileGrid>

    @* EqualHeights="false" : chaque tuile garde la hauteur de son contenu, alignée en haut de sa rangée, au lieu
       d'être étirée à celle de la plus haute (largeurs inchangées). Des tuiles de faits de 4, 1, 2 et 2 lignes ;
       la deuxième a un libellé long et une valeur courte, sur une seule ligne dans cette tuile étroite. *@
    <OmniTileGrid Id="demo-tile-grid-natural" Columns="4" EqualHeights="false">
        <OmniFactTile Id="demo-natural-tall" Title="@Text["DemoPagesFactSource"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactRepository"]">
                    <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
                    <ChildContent>omni-europe-blazor</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactBranch"]">
                    <Icon><OmniIcon Name="OmniIconName.Graph" /></Icon>
                    <ChildContent>release/1.9.0</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="Commit">
                    <Icon><OmniIcon Name="OmniIconName.GitCommit" /></Icon>
                    <ChildContent>9f3c2a1</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:14:02Z</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-natural-short" Title="@Text["DemoPagesFactRun"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.Rows" /></Icon>
                    <ChildContent>2</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-natural-status" Title="@Text["DemoPagesFactRun"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStatus"]">
                    <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    <ChildContent><OmniBadge Tone="OmniTone.Success">@Text["DemoPagesFactSucceeded"]</OmniBadge></ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactSteps"]">
                    <Icon><OmniIcon Name="OmniIconName.Rows" /></Icon>
                    <ChildContent>5 / 5</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-natural-timeline" Title="@Text["DemoPagesFactTimeline"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStarted"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:21:07Z</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.Timer" /></Icon>
                    <ChildContent>1h44min</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
    </OmniTileGrid>

    @* MinColumnWidth : le nombre de colonnes suit la largeur de la grille elle-même (pas celle de la fenêtre) :
       le plus grand nombre qui garde chaque colonne à 18rem au moins, au plus Columns, une au minimum. À côté
       d'un menu latéral, la grille a moins de colonnes, plus larges, au lieu de quatre tuiles étroites ; une
       tuile DoubleWidth occupe deux colonnes là où la grille en a deux, sinon une seule. *@
    <OmniTileGrid Id="demo-tile-grid-fluid" Columns="4" MinColumnWidth="18rem">
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 12.4]" Title="@Text["DemoPagesTokensToday"]">
            <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
        </OmniStatTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 8.2]" Title="@Text["DemoPagesWeekly"]">
            <Icon><OmniIcon Name="OmniIconName.CalendarCheck" /></Icon>
        </OmniStatTile>
        <OmniNavTile Href="components/legacy/editeur" Title="@Text["DemoEditorTitle"]" Tone="OmniTone.Info" DoubleWidth="true">
            <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
        </OmniNavTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 3.6]" Title="@Text["DemoPagesGain"]">
            <Icon><OmniIcon Name="OmniIconName.ChartLineUp" /></Icon>
        </OmniStatTile>
    </OmniTileGrid>

    @* UniformSize : la règle des tuiles de l'application, en option d'une grille. Les tuiles ont à peu près la
       même largeur (le nombre de colonnes suit la largeur de la grille elle-même, 18rem au moins chacune,
       --omni-tile-min-width, Columns au plus) et exactement la même hauteur (celle de la plus haute, jamais moins
       que --omni-tile-height, le jeton de la densité), quel que soit leur contenu : ici une tuile chiffre sans
       détail, une tuile de faits de trois lignes, une tuile de navigation DoubleWidth (deux tuiles côte à côte là
       où la grille a deux colonnes, une seule sinon) et une carte au texte long. *@
    <OmniTileGrid Id="demo-tile-grid-uniform" Columns="4" UniformSize="true">
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 12.4]" Title="@Text["DemoPagesTokensToday"]">
            <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
        </OmniStatTile>
        <OmniFactTile Id="demo-uniform-facts" Title="@Text["DemoPagesFactSource"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactRepository"]">
                    <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
                    <ChildContent>omni-europe-blazor</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactBranch"]">
                    <Icon><OmniIcon Name="OmniIconName.Graph" /></Icon>
                    <ChildContent>release/1.9.0</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="Commit">
                    <Icon><OmniIcon Name="OmniIconName.GitCommit" /></Icon>
                    <ChildContent>9f3c2a1</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniNavTile Href="components/legacy/editeur" Title="@Text["DemoEditorTitle"]" Description="@Text["DemoGridSummary"]" Tone="OmniTone.Info" DoubleWidth="true">
            <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
        </OmniNavTile>
        <OmniCard><ChildContent>@Text["DemoLayoutStretchedText"]</ChildContent></OmniCard>
    </OmniTileGrid>
</OmniStack>
