<OmniStack Gap="OmniSpacing.Large">
    <OmniRow Gap="OmniSpacing.Medium">
        <OmniColumn Span="12" MediumSpan="6" LargeSpan="4">
            <OmniCard>
                <Header><OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoLayoutFluidColumn"]</OmniHeading></Header>
                <ChildContent>@Text["DemoLayoutFluidColumnText"]</ChildContent>
                <Footer><OmniBadge Tone="OmniTone.Neutral">12 / 6 / 4</OmniBadge></Footer>
            </OmniCard>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="6" LargeSpan="4">
            <OmniCard>
                <Header><OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoLayoutCardWithHeader"]</OmniHeading></Header>
                <ChildContent>@Text["DemoLayoutCardWithHeaderText"]</ChildContent>
            </OmniCard>
        </OmniColumn>
        <OmniColumn Span="12" LargeSpan="4">
            <OmniCard>
                <ChildContent>@Text["DemoLayoutBodyOnly"]</ChildContent>
            </OmniCard>
        </OmniColumn>
    </OmniRow>

    <OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small" Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <OmniBadge Tone="OmniTone.Accent">@Text["DemoLayoutStart"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Neutral">@Text["DemoLayoutMiddle"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Success">@Text["DemoLayoutEnd"]</OmniBadge>
    </OmniStack>

    <OmniFieldset>
        <Legend>@Text["DemoLayoutFieldGroup"]</Legend>
        <ChildContent>
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
                <OmniBadge Tone="OmniTone.Neutral">@Text["DemoLayoutOne"]</OmniBadge>
                <OmniBadge Tone="OmniTone.Neutral">@Text["DemoLayoutTwo"]</OmniBadge>
            </OmniStack>
        </ChildContent>
    </OmniFieldset>

    <OmniFieldset Collapsible="true" Expanded="false">
        <Legend>@Text["DemoLayoutAdvanced"]</Legend>
        <ChildContent>@Text["DemoLayoutAdvancedText"]</ChildContent>
    </OmniFieldset>

    @* Lié dans les deux sens : ExpandedChanged rapporte ce que fait le lecteur. Sans lui, le groupe
       ne charge aucun script, comme avant. *@
    <OmniFieldset Id="demo-fieldset-bound" Collapsible="true" @bind-Expanded="OptionsExpanded">
        <Legend>@Text["DemoLayoutTracked"]</Legend>
        <ChildContent>@Text["DemoLayoutTrackedText"]</ChildContent>
    </OmniFieldset>
    <p id="demo-fieldset-state">@(OptionsExpanded ? Text["DemoLayoutTrackedExpanded"] : Text["DemoLayoutTrackedCollapsed"])</p>

    <OmniFieldset Disabled="true">
        <Legend>@Text["DemoLayoutDisabledGroup"]</Legend>
        <ChildContent>@Text["DemoLayoutDisabledGroupText"]</ChildContent>
    </OmniFieldset>

    @* Séparateurs : un filet fin entre des blocs, espacé par l'écart de la pile qui le porte (OmniDivider
       n'a aucune marge). Horizontal dans une pile verticale, vertical dans une rangée. *@
    <OmniCard>
        <ChildContent>
            <OmniStack Gap="OmniSpacing.Medium">
                <p>@Text["DemoLayoutDividerProject"]</p>
                <OmniDivider />
                <p>@Text["DemoLayoutDividerArchitecture"]</p>
                <OmniDivider />
                <p>@Text["DemoLayoutDividerPipelines"]</p>
                <OmniDivider />
                <p>@Text["DemoLayoutDividerTodo"]</p>
            </OmniStack>
        </ChildContent>
    </OmniCard>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Stretch">
        <OmniBadge Tone="OmniTone.Neutral">@Text["DemoLayoutDividerDraft"]</OmniBadge>
        <OmniDivider Orientation="OmniStackOrientation.Vertical" />
        <OmniBadge Tone="OmniTone.Info">@Text["DemoLayoutDividerReview"]</OmniBadge>
        <OmniDivider Orientation="OmniStackOrientation.Vertical" />
        <OmniBadge Tone="OmniTone.Success">@Text["DemoLayoutDividerPublished"]</OmniBadge>
    </OmniStack>

    @* L'échelle d'espacement, du plus serré au plus large. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniRow Gap="OmniSpacing.None"><OmniBadge>@Text["DemoLayoutGapNone1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapNone2"]</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.XSmall"><OmniBadge>@Text["DemoLayoutGapXSmall1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapXSmall2"]</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Small"><OmniBadge>@Text["DemoLayoutGapSmall1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapSmall2"]</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Medium"><OmniBadge>@Text["DemoLayoutGapMedium1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapMedium2"]</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Large"><OmniBadge>@Text["DemoLayoutGapLarge1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapLarge2"]</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.XLarge"><OmniBadge>@Text["DemoLayoutGapXLarge1"]</OmniBadge><OmniBadge>@Text["DemoLayoutGapXLarge2"]</OmniBadge></OmniRow>
    </OmniStack>

    @* Les quatre répartitions horizontales et les quatre alignements verticaux. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniRow Justify="OmniJustification.Start" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">@Text["DemoLayoutAlignStart"]</OmniBadge>
        </OmniRow>
        <OmniRow Justify="OmniJustification.Center" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">@Text["DemoLayoutAlignCenter"]</OmniBadge>
        </OmniRow>
        <OmniRow Justify="OmniJustification.End" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">@Text["DemoLayoutAlignEnd"]</OmniBadge>
        </OmniRow>
    </OmniStack>

    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Start">
        <OmniBadge>@Text["DemoLayoutTop"]</OmniBadge>
        <OmniCard><ChildContent>@Text["DemoLayoutTopText"]</ChildContent></OmniCard>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.End">
        <OmniBadge>@Text["DemoLayoutBottom"]</OmniBadge>
        <OmniCard><ChildContent>@Text["DemoLayoutBottomText"]</ChildContent></OmniCard>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Stretch">
        <OmniCard><ChildContent>@Text["DemoLayoutStretched"]</ChildContent></OmniCard>
        <OmniCard><ChildContent>@Text["DemoLayoutStretchedText"]</ChildContent></OmniCard>
    </OmniStack>

    @* Rangées trop étroites : défiler garde chaque bouton à sa taille, replier ne garde que les icônes. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Overflow="OmniStackOverflow.Scroll">
        <OmniButton><OmniIcon Name="OmniIconName.Check" /><span>@Text["DemoLayoutApproveFile"]</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Filter" /><span>@Text["DemoLayoutFilterDocuments"]</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Close" /><span>@Text["DemoLayoutCloseRequest"]</span></OmniButton>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Overflow="OmniStackOverflow.Collapse">
        <OmniButton><OmniIcon Name="OmniIconName.Check" /><span>@Text["DemoLayoutApproveFile"]</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Filter" /><span>@Text["DemoLayoutFilterDocuments"]</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Close" /><span>@Text["DemoLayoutCloseRequest"]</span></OmniButton>
    </OmniStack>

    @* Grille de tuiles (OmniTileGrid) : toutes les tuiles du paquet y ont la même largeur et la même hauteur,
       celle de la plus haute, quel que soit leur contenu ; DoubleWidth en étale une sur deux colonnes. Les
       mots qui ne tiennent pas passent à la ligne ou sont coupés dans la tuile, rien ne déborde. *@
    <OmniTileGrid Id="demo-tile-grid" Columns="4">
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 12.4]" Label="@Text["DemoPagesTokensToday"]" Detail="@Text["DemoPagesTokensReset", new TimeOnly(18, 0)]">
            <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
        </OmniStatTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 8.2]" Label="@Text["DemoPagesWeekly"]">
            <Icon><OmniIcon Name="OmniIconName.CalendarCheck" /></Icon>
        </OmniStatTile>
        <OmniNavTile Href="composants/grille" Title="@Text["DemoGridTitle"]" Description="@Text["DemoGridSummary"]">
            <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
        </OmniNavTile>
        <OmniCard><ChildContent>@Text["DemoLayoutStretchedText"]</ChildContent></OmniCard>
        <OmniSelectableCard Title="Linux" Description="Debian, Ubuntu, Fedora" Multiple="true" @bind-Value="TileChoice">
            <Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon>
        </OmniSelectableCard>
        <OmniNavTile Href="composants/editeur" Title="@Text["DemoEditorTitle"]" Tone="OmniTone.Info" DoubleWidth="true">
            <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
        </OmniNavTile>
        <OmniStatTile Value="@Text["DemoPagesTokensValue", 3.6]" Label="@Text["DemoPagesGain"]">
            <Icon><OmniIcon Name="OmniIconName.ChartLineUp" /></Icon>
        </OmniStatTile>
        @* Tuiles cliquables : elles gardent leur place dans la grille (même taille, DoubleWidth respecté). Une carte avec OnClick
           est un seul bouton, donc son contenu est du contenu phrasé (des span) ; une tuile chiffre avec Href est un seul lien. *@
        <OmniCard Id="demo-click-card" OnClick="@(() => CardClicks++)" DoubleWidth="true">
            <Header>@Text["DemoLayoutClickCardTitle"]</Header>
            <ChildContent>@Text["DemoLayoutClickCardText"] <strong id="demo-click-card-count">@Text["DemoLayoutClickCardCount", CardClicks]</strong></ChildContent>
        </OmniCard>
        <OmniStatTile Id="demo-link-tile" Href="composants/grille" Value="@Text["DemoPagesTokensValue", 5.1]" Label="@Text["DemoGridTitle"]">
            <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
        </OmniStatTile>
    </OmniTileGrid>

    @* Réglages : une carte par thème, chaque réglage dans son encadré, le contrôle sur sa ligne. *@
    <OmniSettingsSection Title="@Text["DemoLayoutNotifications"]" Description="@Text["DemoLayoutNotificationsText"]">
        <OmniSettingsTile Title="@Text["DemoLayoutEmailAlerts"]" Description="@Text["DemoLayoutEmailAlertsText"]">
            <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
            <ChildContent><OmniSwitch @bind-Value="EmailAlerts" aria-label="@Text["DemoLayoutEmailAlerts"]" /></ChildContent>
        </OmniSettingsTile>
        <OmniSettingsTile Title="@Text["DemoLayoutWeeklyDigest"]" Description="@Text["DemoLayoutWeeklyDigestText"]">
            <Icon><OmniIcon Name="OmniIconName.Check" /></Icon>
            <ChildContent><OmniSwitch @bind-Value="WeeklyDigest" aria-label="@Text["DemoLayoutWeeklyDigest"]" /></ChildContent>
        </OmniSettingsTile>
    </OmniSettingsSection>

    @* Densité : chaque carte porte la sienne (Density), qui l'emporte sur celle de la page pour tout ce
       qu'elle contient. Hauteur des contrôles, marges, cases et interrupteurs la suivent ; un champ
       désactivé et un champ en lecture seule restent distincts dans les trois. *@
    <OmniRow Gap="OmniSpacing.Medium" Wrap="true" Align="OmniAlignment.Start">
        @foreach (var level in Densities)
        {
            <OmniColumn Span="12" LargeSpan="4">
                <OmniCard Id="@($"demo-density-{level.Key}")" Density="level.Density">
                    <Header><OmniHeading Level="OmniHeadingLevel.H4">@Text[level.TitleKey]</OmniHeading></Header>
                    <ChildContent>
                        <OmniStack Gap="OmniSpacing.Small">
                            <OmniFormField For="@($"density-{level.Key}-name")" Label="@Text["DemoLayoutServerName"]" Required="true" Description="@Text["DemoLayoutServerNameText"]">
                                <OmniTextBox Id="@($"density-{level.Key}-name")" @bind-Value="ServerName" />
                            </OmniFormField>
                            <OmniFormField For="@($"density-{level.Key}-id")" Label="@Text["DemoLayoutIdentifierReadOnly"]">
                                <OmniTextBox Id="@($"density-{level.Key}-id")" @bind-Value="ServerId" ReadOnly="true" />
                            </OmniFormField>
                            <OmniFormField For="@($"density-{level.Key}-zone")" Label="@Text["DemoLayoutZoneDisabled"]" Disabled="true">
                                <OmniTextBox Id="@($"density-{level.Key}-zone")" @bind-Value="ServerZone" Disabled="true" />
                            </OmniFormField>
                            <OmniCheckBox Id="@($"density-{level.Key}-lock")" @bind-Value="LockedRestore" aria-label="@Text["DemoLayoutLockedRestore"]" />
                            <OmniRow Gap="OmniSpacing.Small" Wrap="true">
                                <OmniButton><OmniIcon Name="OmniIconName.Save" /><span>@Text["DemoLayoutSave"]</span></OmniButton>
                                <OmniButton Variant="OmniButtonVariant.Secondary"><OmniIcon Name="OmniIconName.Close" /><span>@Text["DemoLayoutCancel"]</span></OmniButton>
                                <OmniBadge Tone="OmniTone.Info">@Text["DemoLayoutAlertCount", 3]</OmniBadge>
                            </OmniRow>
                            <OmniAlert Severity="OmniSeverity.Success" Title="@Text["DemoLayoutDeployed"]">@Text["DemoLayoutDeployedText"]</OmniAlert>
                            <OmniSettingsTile Title="@Text["DemoLayoutEmailAlerts"]" Description="@Text["DemoLayoutEachChange"]">
                                <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon>
                                <ChildContent><OmniSwitch @bind-Value="EmailAlerts" /></ChildContent>
                            </OmniSettingsTile>
                        </OmniStack>
                    </ChildContent>
                </OmniCard>
            </OmniColumn>
        }
    </OmniRow>

    @* Densité propre à un composant : dans une page confortable, chacun de ces composants porte la sienne. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniAlert Severity="OmniSeverity.Info" Density="OmniDensity.Spacious">@Text["DemoLayoutSpaciousAlert"]</OmniAlert>
        <OmniTabs Label="@Text["DemoLayoutCompactTabs"]" Density="OmniDensity.Compact" @bind-Value="DensityTab">
            <OmniTabsItem Key="general" Title="@Text["DemoLayoutGeneral"]">@Text["DemoLayoutGeneralText"]</OmniTabsItem>
            <OmniTabsItem Key="securite" Title="@Text["DemoLayoutSecurity"]">@Text["DemoLayoutSecurityText"]</OmniTabsItem>
        </OmniTabs>
        <OmniSettingsTile Title="@Text["DemoLayoutSpaciousTile"]" Description="@Text["DemoLayoutOwnDensity"]" Density="OmniDensity.Spacious">
            <ChildContent><OmniSwitch @bind-Value="WeeklyDigest" /></ChildContent>
        </OmniSettingsTile>
    </OmniStack>
</OmniStack>
