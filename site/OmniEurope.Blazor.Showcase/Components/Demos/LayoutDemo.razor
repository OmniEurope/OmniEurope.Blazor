<OmniStack Gap="OmniSpacing.Large">
    <OmniRow Gap="OmniSpacing.Medium">
        <OmniColumn Span="12" MediumSpan="6" LargeSpan="4">
            <OmniCard>
                <Header><OmniHeading Level="OmniHeadingLevel.H4">Colonne fluide</OmniHeading></Header>
                <ChildContent>Pleine largeur en petit écran, un tiers en grand.</ChildContent>
                <Footer><OmniBadge Tone="OmniTone.Neutral">12 / 6 / 4</OmniBadge></Footer>
            </OmniCard>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="6" LargeSpan="4">
            <OmniCard>
                <Header><OmniHeading Level="OmniHeadingLevel.H4">Carte avec entête</OmniHeading></Header>
                <ChildContent>Entête, corps et pied sont trois zones distinctes.</ChildContent>
            </OmniCard>
        </OmniColumn>
        <OmniColumn Span="12" LargeSpan="4">
            <OmniCard>
                <ChildContent>Une carte peut n'avoir que son corps.</ChildContent>
            </OmniCard>
        </OmniColumn>
    </OmniRow>

    <OmniStack Orientation="OmniStackOrientation.Horizontal" Wrap="true" Gap="OmniSpacing.Small" Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <OmniBadge Tone="OmniTone.Accent">Début</OmniBadge>
        <OmniBadge Tone="OmniTone.Neutral">Milieu</OmniBadge>
        <OmniBadge Tone="OmniTone.Success">Fin</OmniBadge>
    </OmniStack>

    <OmniFieldset>
        <Legend>Groupe de champs</Legend>
        <ChildContent>
            <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
                <OmniBadge Tone="OmniTone.Neutral">Un</OmniBadge>
                <OmniBadge Tone="OmniTone.Neutral">Deux</OmniBadge>
            </OmniStack>
        </ChildContent>
    </OmniFieldset>

    <OmniFieldset Collapsible="true" Expanded="false">
        <Legend>Réglages avancés</Legend>
        <ChildContent>Un groupe replié à l'ouverture, que le lecteur déplie s'il en a besoin.</ChildContent>
    </OmniFieldset>

    @* Lié dans les deux sens : ExpandedChanged rapporte ce que fait le lecteur. Sans lui, le groupe
       ne charge aucun script, comme avant. *@
    <OmniFieldset Id="demo-fieldset-bound" Collapsible="true" @bind-Expanded="OptionsExpanded">
        <Legend>Options suivies</Legend>
        <ChildContent>L'état replié est connu de la page, qui peut le retenir.</ChildContent>
    </OmniFieldset>
    <p id="demo-fieldset-state">Options suivies : @(OptionsExpanded ? "dépliées" : "repliées")</p>

    <OmniFieldset Disabled="true">
        <Legend>Groupe désactivé</Legend>
        <ChildContent>Tout ce que ce groupe contient devient inopérant d'un seul geste.</ChildContent>
    </OmniFieldset>

    @* L'échelle d'espacement, du plus serré au plus large. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniRow Gap="OmniSpacing.None"><OmniBadge>Aucun</OmniBadge><OmniBadge>écart</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.XSmall"><OmniBadge>Très</OmniBadge><OmniBadge>serré</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Small"><OmniBadge>Serré</OmniBadge><OmniBadge>petit</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Medium"><OmniBadge>Courant</OmniBadge><OmniBadge>moyen</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.Large"><OmniBadge>Aéré</OmniBadge><OmniBadge>grand</OmniBadge></OmniRow>
        <OmniRow Gap="OmniSpacing.XLarge"><OmniBadge>Très</OmniBadge><OmniBadge>aéré</OmniBadge></OmniRow>
    </OmniStack>

    @* Les quatre répartitions horizontales et les quatre alignements verticaux. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniRow Justify="OmniJustification.Start" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">Aligné au début</OmniBadge>
        </OmniRow>
        <OmniRow Justify="OmniJustification.Center" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">Centré</OmniBadge>
        </OmniRow>
        <OmniRow Justify="OmniJustification.End" Gap="OmniSpacing.Small">
            <OmniBadge Tone="OmniTone.Accent">Aligné à la fin</OmniBadge>
        </OmniRow>
    </OmniStack>

    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Start">
        <OmniBadge>En haut</OmniBadge>
        <OmniCard><ChildContent>Une carte plus haute que ses voisines.</ChildContent></OmniCard>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.End">
        <OmniBadge>En bas</OmniBadge>
        <OmniCard><ChildContent>Le badge se cale sur le bas de la rangée.</ChildContent></OmniCard>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Stretch">
        <OmniCard><ChildContent>Étirée</ChildContent></OmniCard>
        <OmniCard><ChildContent>Les deux cartes prennent la même hauteur.</ChildContent></OmniCard>
    </OmniStack>

    @* Rangées trop étroites : défiler garde chaque bouton à sa taille, replier ne garde que les icônes. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Overflow="OmniStackOverflow.Scroll">
        <OmniButton><OmniIcon Name="OmniIconName.Check" /><span>Valider le dossier</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Filter" /><span>Filtrer les pièces</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Close" /><span>Clore la demande</span></OmniButton>
    </OmniStack>
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Overflow="OmniStackOverflow.Collapse">
        <OmniButton><OmniIcon Name="OmniIconName.Check" /><span>Valider le dossier</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Filter" /><span>Filtrer les pièces</span></OmniButton>
        <OmniButton><OmniIcon Name="OmniIconName.Close" /><span>Clore la demande</span></OmniButton>
    </OmniStack>

    @* Réglages : une carte par thème, chaque réglage dans son encadré, le contrôle sur sa ligne. *@
    <OmniSettingsSection Title="Notifications" Description="Ce que l'application vous signale, et comment.">
        <OmniSettingsTile Title="Alertes par courriel" Description="Un message à chaque changement de statut.">
            <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
            <ChildContent><OmniSwitch @bind-Value="EmailAlerts" aria-label="Alertes par courriel" /></ChildContent>
        </OmniSettingsTile>
        <OmniSettingsTile Title="Résumé hebdomadaire" Description="Les dossiers de la semaine, le lundi matin.">
            <Icon><OmniIcon Name="OmniIconName.Check" /></Icon>
            <ChildContent><OmniSwitch @bind-Value="WeeklyDigest" aria-label="Résumé hebdomadaire" /></ChildContent>
        </OmniSettingsTile>
    </OmniSettingsSection>

    @* Densité : chaque carte porte la sienne (Density), qui l'emporte sur celle de la page pour tout ce
       qu'elle contient. Hauteur des contrôles, marges, cases et interrupteurs la suivent ; un champ
       désactivé et un champ en lecture seule restent distincts dans les trois. *@
    <OmniRow Gap="OmniSpacing.Medium" Wrap="true" Align="OmniAlignment.Start">
        @foreach (var level in Densities)
        {
            <OmniColumn Span="12" LargeSpan="4">
                <OmniCard Id="@($"demo-density-{level.Key}")" Density="level.Density">
                    <Header><OmniHeading Level="OmniHeadingLevel.H4">@level.Title</OmniHeading></Header>
                    <ChildContent>
                        <OmniStack Gap="OmniSpacing.Small">
                            <OmniFormField For="@($"density-{level.Key}-name")" Label="Nom du serveur" Required="true" Description="Visible dans la console.">
                                <OmniTextBox Id="@($"density-{level.Key}-name")" @bind-Value="ServerName" />
                            </OmniFormField>
                            <OmniFormField For="@($"density-{level.Key}-id")" Label="Identifiant, lecture seule">
                                <OmniTextBox Id="@($"density-{level.Key}-id")" @bind-Value="ServerId" ReadOnly="true" />
                            </OmniFormField>
                            <OmniFormField For="@($"density-{level.Key}-zone")" Label="Zone, désactivée" Disabled="true">
                                <OmniTextBox Id="@($"density-{level.Key}-zone")" @bind-Value="ServerZone" Disabled="true" />
                            </OmniFormField>
                            <OmniCheckBox Id="@($"density-{level.Key}-lock")" @bind-Value="LockedRestore" aria-label="Restauration verrouillée" />
                            <OmniRow Gap="OmniSpacing.Small" Wrap="true">
                                <OmniButton><OmniIcon Name="OmniIconName.Save" /><span>Enregistrer</span></OmniButton>
                                <OmniButton Variant="OmniButtonVariant.Secondary"><OmniIcon Name="OmniIconName.Close" /><span>Annuler</span></OmniButton>
                                <OmniBadge Tone="OmniTone.Info">3 alertes</OmniBadge>
                            </OmniRow>
                            <OmniAlert Severity="OmniSeverity.Success" Title="Déploiement terminé">La version 1.0.1 est en ligne.</OmniAlert>
                            <OmniSettingsTile Title="Alertes par courriel" Description="À chaque changement.">
                                <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon>
                                <ChildContent><OmniSwitch @bind-Value="EmailAlerts" /></ChildContent>
                            </OmniSettingsTile>
                        </OmniStack>
                    </ChildContent>
                </OmniCard>
            </OmniColumn>
        }
    </OmniRow>

    @* Densité propre à un composant : dans une page confortable, chacun de ces composants porte la sienne. *@
    <OmniStack Gap="OmniSpacing.Small">
        <OmniAlert Severity="OmniSeverity.Info" Density="OmniDensity.Spacious">Une alerte aérée dans une page confortable.</OmniAlert>
        <OmniTabs Label="Onglets compacts" Density="OmniDensity.Compact" @bind-Value="DensityTab">
            <OmniTabsItem Key="general" Title="Général">Réglages généraux.</OmniTabsItem>
            <OmniTabsItem Key="securite" Title="Sécurité">Accès et jetons.</OmniTabsItem>
        </OmniTabs>
        <OmniSettingsTile Title="Tuile aérée" Description="Sa propre densité." Density="OmniDensity.Spacious">
            <ChildContent><OmniSwitch @bind-Value="WeeklyDigest" /></ChildContent>
        </OmniSettingsTile>
    </OmniStack>
</OmniStack>
