<OmniStack Gap="OmniSpacing.Large">
    <OmniToggleButton @bind-Value="ReadOnly">@Text["DemoDiagramReadOnly"]</OmniToggleButton>
    <OmniMindMap Id="demo-mindmap"
                 @bind-Document="Map"
                 @bind-ViewState="View"
                 ReadOnly="ReadOnly"
                 Label="@Text["DemoDiagramMindMapLabel"]"
                 ContextLabels="Labels">
        <ToolbarContent>
            <OmniMindMapToolbar />
        </ToolbarContent>
        <PanelContent>
            <OmniMindMapNodeProperties />
        </PanelContent>
    </OmniMindMap>
    <OmniGitGraph TItem="string" Items="RecentCommits" KeyOf="CommitId" ParentsOf="CommitParents"
                  Label="@Text["DemoDiagramGitGraphLabel"]">
        <RowTemplate Context="commit"><code>@commit</code></RowTemplate>
    </OmniGitGraph>
    <p>@Summary</p>
</OmniStack>
