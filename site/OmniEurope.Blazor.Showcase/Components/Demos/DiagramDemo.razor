<OmniStack Gap="OmniSpacing.Large">
    <OmniToggleButton @bind-Value="ReadOnly">Lecture seule</OmniToggleButton>
    <OmniMindMap Id="demo-mindmap"
                 @bind-Document="Map"
                 @bind-ViewState="View"
                 ReadOnly="ReadOnly"
                 AriaLabel="Carte mentale : préparer un déménagement"
                 ContextLabels="Labels">
        <ToolbarContent>
            <OmniMindMapToolbar />
        </ToolbarContent>
        <PanelContent>
            <OmniMindMapNodeProperties />
        </PanelContent>
    </OmniMindMap>
    <OmniGitGraph TItem="string" Items="RecentCommits" IdOf="CommitId" ParentsOf="CommitParents"
                  Label="Historique avec une branche fusionnée">
        <RowTemplate Context="commit"><code>@commit</code></RowTemplate>
    </OmniGitGraph>
    <p>@Summary</p>
</OmniStack>
