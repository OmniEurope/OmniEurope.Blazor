<OmniStack Gap="OmniSpacing.Large">
    <OmniRow Gap="OmniSpacing.Small" Wrap="true">
        <OmniToggleButton @bind-Value="ReadOnly">@Text["DemoDiagramReadOnly"]</OmniToggleButton>
        @* Directed : chaque lien part du bord d'un nœud et finit par une flèche sur le bord de l'autre. *@
        <OmniToggleButton Id="demo-mindmap-directed" @bind-Value="Directed">@Text["DemoDiagramDirected"]</OmniToggleButton>
    </OmniRow>
    <OmniMindMap Id="demo-mindmap"
                 @bind-Document="Map"
                 @bind-ViewState="View"
                 ReadOnly="ReadOnly"
                 Directed="Directed"
                 Label="@Text["DemoDiagramMindMapLabel"]"
                 ContextLabels="Labels">
        <ToolbarContent>
            <OmniMindMapToolbar />
        </ToolbarContent>
        <PanelContent>
            <OmniMindMapNodeProperties />
        </PanelContent>
    </OmniMindMap>
    <OmniGitGraph TItem="string" Items="RecentCommits" KeyOf="CommitId" ParentsOf="CommitParents"
                  Label="@Text["DemoDiagramGitGraphLabel"]">
        <RowTemplate Context="commit"><code>@commit</code></RowTemplate>
    </OmniGitGraph>
    <p>@Summary</p>
</OmniStack>
