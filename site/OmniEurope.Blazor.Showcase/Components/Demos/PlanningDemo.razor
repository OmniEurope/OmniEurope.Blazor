<OmniStack Gap="OmniSpacing.Large">
    @* Le Gantt tient son échelle lui-même ; la vitrine la lie pour montrer les trois zooms. Le
       planning est placé autour de la date du jour, que le Gantt lit sur l'horloge du composant. *@
    <OmniGantt Tasks="Tasks"
               @bind-Scale="Scale"
               SelectedTaskId="@SelectedTaskId"
               OnTaskClick="@(task => SelectedTaskId = task.Id)"
               Label="@Text["DemoPlanningGanttLabel"]" />
    <OmniText Tone="OmniTextTone.Muted">@Text["DemoPlanningScaleShown", ScaleName]</OmniText>

    <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoPlanningMonthHeading"]</OmniHeading>
    <OmniGantt Tasks="Tasks" Scale="OmniCalendarView.Month" ShowGroups="false" ShowScalePicker="false" Label="@Text["DemoPlanningMonthLabel"]" />
    <OmniGantt Tasks="Tasks" Scale="OmniCalendarView.Day" ShowDependencies="false" ShowToday="false" ShowScalePicker="false" Label="@Text["DemoPlanningDayLabel"]" />

    <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoPlanningRunHeading"]</OmniHeading>
    @* L'étape en cours s'arrête à l'heure de l'horloge du composant, lue à chaque rendu du parent. *@
    <OmniStepTimeline Steps="Steps" Label="@Text["DemoPlanningRunLabel", 42]" />

    <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoPlanningTimelineHeading"]</OmniHeading>
    <OmniTimeline Label="@Text["DemoPlanningTimelineStart"]" Layout="OmniTimelineLayout.Start">
        <OmniTimelineItem Title="@Text["DemoPlanningFiled"]" DateText="@DayText(2)">@Text["DemoPlanningFiledText"]</OmniTimelineItem>
        <OmniTimelineItem Title="@Text["DemoPlanningDecision"]" DateText="@DayText(24)">@Text["DemoPlanningDecisionText"]</OmniTimelineItem>
    </OmniTimeline>
    <OmniTimeline Label="@Text["DemoPlanningTimelineAlternateStart"]" Layout="OmniTimelineLayout.AlternateStart">
        <OmniTimelineItem Title="@Text["DemoPlanningFiled"]" DateText="@DayText(2)">@Text["DemoPlanningFiledText"]</OmniTimelineItem>
        <OmniTimelineItem Title="@Text["DemoPlanningReview"]" DateText="@DayText(9)">@Text["DemoPlanningReviewText"]</OmniTimelineItem>
        <OmniTimelineItem Title="@Text["DemoPlanningDecision"]" DateText="@DayText(24)">@Text["DemoPlanningDecisionText"]</OmniTimelineItem>
    </OmniTimeline>
    @* Le titre d'une entrée est un titre de niveau 3 par défaut ; Level l'accorde au plan de la page. *@
    <OmniTimeline Label="@Text["DemoPlanningTimelineAlternateEnd"]" Layout="OmniTimelineLayout.AlternateEnd">
        <OmniTimelineItem Title="@Text["DemoPlanningFiled"]" DateText="@DayText(2)" Level="OmniHeadingLevel.H5">@Text["DemoPlanningFiledText"]</OmniTimelineItem>
        <OmniTimelineItem Title="@Text["DemoPlanningReview"]" DateText="@DayText(9)" Level="OmniHeadingLevel.H5">@Text["DemoPlanningReviewText"]</OmniTimelineItem>
    </OmniTimeline>
</OmniStack>
