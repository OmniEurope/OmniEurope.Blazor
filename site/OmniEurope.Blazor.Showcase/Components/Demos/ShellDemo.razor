@* The application shell, shown in miniature: the same components this site is itself built from.
   Its menu slides open and shut (Transition Smooth); the next ones switch at once. *@
<OmniThemeScope Appearance="OmniAppearance.Light" Density="OmniDensity.Compact">
    <OmniLayout Width="OmniLayoutWidth.Content">
        <OmniHeader>
            <OmniSidebarToggle Open="SidebarOpen" OpenChanged="@(value => SidebarOpen = value)"
                               Controls="shell-demo-sidebar" AriaLabel="Afficher ou masquer le menu" />
            <OmniHeading Level="OmniHeadingLevel.H4">Mon application</OmniHeading>
            <OmniAppearanceToggle Appearance="Appearance" AppearanceChanged="@(value => Appearance = value)"
                                  AriaLabel="Changer l'apparence" />
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Open="SidebarOpen" AriaLabel="Menu de la démonstration" Position="OmniSidebarPosition.Start"
                         Transition="OmniSidebarTransition.Smooth">
                <OmniPanelMenu Label="Sections" DisplayStyle="OmniPanelMenuDisplayStyle.IconAndText">
                    <OmniPanelMenuItem Text="Tableau de bord" Href="composants/coquille" Match="OmniNavMatch.Exact" />
                    <OmniPanelMenuItem Text="Dossiers" Expanded="true">
                        <OmniPanelMenuItem Text="En cours" Href="composants/coquille/en-cours" />
                        <OmniPanelMenuItem Text="Archivés" Href="composants/coquille/archives" />
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="Réglages" Href="composants/coquille/reglages" />
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain AriaLabelledBy="shell-demo-title">
                <OmniHeading Id="shell-demo-title" Level="OmniHeadingLevel.H5">Contenu principal</OmniHeading>
                <p>L'apparence retenue ici est @(Appearance is OmniAppearance.Dark ? "sombre" : "claire").</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* La même coquille dans l'autre arrangement : pleine largeur, menu à droite, densité aérée, et une
   apparence qui suit le réglage du système au lieu d'être imposée. *@
<OmniThemeScope Appearance="OmniAppearance.System" Density="OmniDensity.Spacious">
    <OmniLayout Width="OmniLayoutWidth.Wide">
        <OmniHeader>
            <OmniHeading Level="OmniHeadingLevel.H4">Console d'exploitation</OmniHeading>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Open="true" AriaLabel="Menu secondaire" Position="OmniSidebarPosition.End">
                <OmniPanelMenu Label="Outils" DisplayStyle="OmniPanelMenuDisplayStyle.Icon">
                    <OmniPanelMenuItem Text="Journaux" Href="composants/coquille" Match="OmniNavMatch.Prefix">
                        <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="Action ponctuelle" Match="OmniNavMatch.None">
                        <Icon><OmniIcon Name="OmniIconName.Filter" /></Icon>
                    </OmniPanelMenuItem>
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain AriaLabelledBy="shell-demo-wide-title">
                <OmniHeading Id="shell-demo-wide-title" Level="OmniHeadingLevel.H5">Vue large</OmniHeading>
                <p>La zone de contenu court d'un bord à l'autre, sans colonne de lecture centrée.</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* Le menu flotte au-dessus du contenu, qui garde sa largeur, et laisse un rail d'icônes une fois
   fermé ; un clic sur le voile le referme. *@
<OmniThemeScope Appearance="OmniAppearance.Light" Density="OmniDensity.Compact">
    <OmniLayout Width="OmniLayoutWidth.Content">
        <OmniHeader>
            <OmniSidebarToggle Open="RailOpen" OpenChanged="@(value => RailOpen = value)"
                               Controls="shell-demo-rail" AriaLabel="Afficher ou masquer le menu flottant" />
            <OmniHeading Level="OmniHeadingLevel.H4">Menu flottant</OmniHeading>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Id="shell-demo-rail" Open="RailOpen" OpenChanged="@(value => RailOpen = value)"
                         Reveal="OmniSidebarReveal.Overlay" Collapse="OmniSidebarCollapse.Icons" Backdrop="true"
                         AriaLabel="Menu flottant de la démonstration">
                <OmniPanelMenu Label="Sections" DisplayStyle="OmniPanelMenuDisplayStyle.IconAndText">
                    <OmniPanelMenuItem Text="Journaux" Href="composants/coquille" Match="OmniNavMatch.Exact">
                        <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="Filtres" Match="OmniNavMatch.None">
                        <Icon><OmniIcon Name="OmniIconName.Filter" /></Icon>
                    </OmniPanelMenuItem>
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain AriaLabelledBy="shell-demo-rail-title">
                <OmniHeading Id="shell-demo-rail-title" Level="OmniHeadingLevel.H5">Contenu</OmniHeading>
                <p>Ouvrir le menu ne décale pas ce texte : le panneau passe par-dessus.</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* L'élément principal défile de lui-même : la coquille garde toute la largeur, le contenu se centre
   (ContentWidth) et la barre de défilement reste au bord droit, jamais au bord de la colonne. *@
<OmniThemeScope Appearance="OmniAppearance.Light" Density="OmniDensity.Compact">
    <div class="demo-shell-viewport">
        <OmniLayout>
            <OmniHeader>
                <OmniHeading Level="OmniHeadingLevel.H4">Contenu centré, défilement au bord</OmniHeading>
            </OmniHeader>
            <OmniBody>
                <OmniSidebar Open="true" AriaLabel="Menu de la démonstration défilante">
                    <OmniPanelMenu Label="Sections" DisplayStyle="OmniPanelMenuDisplayStyle.Icon">
                        <OmniPanelMenuItem Text="Journaux" Href="composants/coquille" Match="OmniNavMatch.Exact">
                            <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                        </OmniPanelMenuItem>
                    </OmniPanelMenu>
                </OmniSidebar>
                <OmniMain Scrollable="true" ContentWidth="OmniLayoutWidth.Content" AriaLabelledBy="shell-demo-scroll-title">
                    <OmniHeading Id="shell-demo-scroll-title" Level="OmniHeadingLevel.H5">Colonne de lecture</OmniHeading>
                    @foreach (var paragraph in ScrollParagraphs)
                    {
                        <p>@paragraph</p>
                    }
                </OmniMain>
            </OmniBody>
        </OmniLayout>
    </div>
</OmniThemeScope>
