@* The application shell, shown in miniature: the same components this site is itself built from.
   Its menu slides open and shut (Transition Smooth); the next ones switch at once. *@
@* SnapshotKey : la portée garde l'instantané de ce qu'elle peint, qu'omni-boot.js rejoue au prochain démarrage. *@
<OmniThemeScope Appearance="Appearance" Density="OmniDensity.Compact" SnapshotKey="omnieurope.showcase.shell-theme">
    <OmniLayout>
        <OmniHeader>
            <OmniSidebarToggle Open="SidebarOpen" OpenChanged="@(value => SidebarOpen = value)"
                               Controls="shell-demo-sidebar" Reveal="OmniSidebarReveal.Push" Label="@Text["DemoShellToggleMenu"]" />
            <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoShellAppName"]</OmniHeading>
            <OmniButton Id="shell-demo-appearance" Variant="OmniButtonVariant.Ghost" Label="@Text["DemoShellChangeAppearance"]" OnClick="ToggleAppearance">
                <OmniIcon Name="@(Appearance == OmniAppearance.Dark ? OmniIconName.ThemeLight : OmniIconName.ThemeDark)" />
            </OmniButton>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Id="shell-demo-sidebar" Open="SidebarOpen" OpenChanged="@(value => SidebarOpen = value)" Label="@Text["DemoShellMenu"]" Position="OmniSidebarPosition.Start">
                <OmniPanelMenu Label="@Text["DemoShellSections"]" DisplayStyle="OmniPanelMenuDisplayStyle.IconAndText">
                    <OmniPanelMenuItem Text="@Text["DemoShellDashboard"]" Href="composants/coquille" Match="OmniNavMatch.Exact">
                        <Icon><OmniIcon Name="OmniIconName.Home" /></Icon>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="@Text["DemoShellFolders"]" Expanded="true">
                        <Icon><OmniIcon Name="OmniIconName.Folder" /></Icon>
                        <ChildContent>
                            <OmniPanelMenuItem Text="@Text["DemoShellInProgress"]" Href="composants/coquille#en-cours" Match="OmniNavMatch.None" />
                            <OmniPanelMenuItem Text="@Text["DemoShellArchived"]" Href="composants/coquille#archives" Match="OmniNavMatch.None" />
                        </ChildContent>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="@Text["DemoShellSettings"]" Href="composants/coquille#reglages" Match="OmniNavMatch.None">
                        <Icon><OmniIcon Name="OmniIconName.Settings" /></Icon>
                    </OmniPanelMenuItem>
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain ContentWidth="OmniLayoutWidth.Content" AriaLabelledBy="shell-demo-title">
                <OmniHeading Id="shell-demo-title" Level="OmniHeadingLevel.H5">@Text["DemoShellMainContent"]</OmniHeading>
                <p>@(Appearance is OmniAppearance.Dark ? Text["DemoShellAppearanceDark"] : Text["DemoShellAppearanceLight"])</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* La même coquille dans l'autre arrangement : pleine largeur, menu à droite, densité aérée, une
   apparence qui suit le réglage du système au lieu d'être imposée, et l'en-tête en bandeau d'accent. *@
<OmniThemeScope Appearance="OmniAppearance.System" Density="OmniDensity.Spacious">
    <OmniLayout>
        <OmniHeader Tone="OmniHeaderTone.Accent">
            <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoShellConsole"]</OmniHeading>
            <OmniButton Size="OmniControlSize.Small" Variant="OmniButtonVariant.Secondary"
                        aria-controls="shell-demo-right-sidebar" aria-expanded="@RightSidebarOpen.ToString().ToLowerInvariant()"
                        OnClick="@(() => RightSidebarOpen = !RightSidebarOpen)">@Text["ShellToggle"]</OmniButton>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Id="shell-demo-right-sidebar" Open="RightSidebarOpen" Label="@Text["DemoShellSecondaryMenu"]"
                         Position="OmniSidebarPosition.End" Collapse="OmniSidebarCollapse.Hidden"
                         Transition="OmniSidebarTransition.Instant">
                <OmniPanelMenu Label="@Text["DemoShellTools"]" DisplayStyle="OmniPanelMenuDisplayStyle.Icon">
                    <OmniPanelMenuItem Text="@Text["DemoShellLogs"]" Href="composants/coquille" Match="OmniNavMatch.Prefix">
                        <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="@Text["DemoShellOneOffAction"]" Match="OmniNavMatch.None">
                        <Icon><OmniIcon Name="OmniIconName.Filter" /></Icon>
                    </OmniPanelMenuItem>
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain ContentWidth="OmniLayoutWidth.Wide" AriaLabelledBy="shell-demo-wide-title">
                <OmniHeading Id="shell-demo-wide-title" Level="OmniHeadingLevel.H5">@Text["DemoShellWideView"]</OmniHeading>
                <p>@Text["DemoShellWideText"]</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* Le menu flotte au-dessus du contenu, qui garde sa largeur, et laisse un rail d'icônes une fois
   fermé ; un clic sur le voile le referme. *@
<OmniThemeScope Appearance="OmniAppearance.Light" Density="OmniDensity.Compact">
    <OmniLayout>
        <OmniHeader>
            <OmniSidebarToggle Open="RailOpen" OpenChanged="@(value => RailOpen = value)"
                               Controls="shell-demo-rail" Reveal="OmniSidebarReveal.Overlay" Label="@Text["DemoShellToggleFloatingMenu"]" />
            <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoShellFloatingMenu"]</OmniHeading>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Id="shell-demo-rail" Open="RailOpen" OpenChanged="@(value => RailOpen = value)"
                         Reveal="OmniSidebarReveal.Overlay" Collapse="OmniSidebarCollapse.Icons" Backdrop="true"
                         Label="@Text["DemoShellFloatingMenuLabel"]">
                <OmniPanelMenu Label="@Text["DemoShellSections"]" DisplayStyle="OmniPanelMenuDisplayStyle.IconAndText" Density="OmniDensity.Spacious">
                    <OmniPanelMenuItem Text="@Text["DemoShellLogs"]" Href="composants/coquille" Match="OmniNavMatch.Exact">
                        <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    </OmniPanelMenuItem>
                    <OmniPanelMenuItem Text="@Text["DemoShellFilters"]" Match="OmniNavMatch.None">
                        <Icon><OmniIcon Name="OmniIconName.Filter" /></Icon>
                    </OmniPanelMenuItem>
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain ContentWidth="OmniLayoutWidth.Content" AriaLabelledBy="shell-demo-rail-title">
                <OmniHeading Id="shell-demo-rail-title" Level="OmniHeadingLevel.H5">@Text["DemoShellContent"]</OmniHeading>
                <p>@Text["DemoShellFloatingText"]</p>
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>

@* L'élément principal défile de lui-même : la coquille garde toute la largeur, le contenu se centre
   (ContentWidth) et la barre de défilement reste au bord droit, jamais au bord de la colonne. *@
<OmniThemeScope Appearance="OmniAppearance.Light" Density="OmniDensity.Compact">
    <div class="demo-shell-viewport">
        <OmniLayout>
            <OmniHeader>
                <OmniHeading Level="OmniHeadingLevel.H4">@Text["DemoShellScrollTitle"]</OmniHeading>
            </OmniHeader>
            <OmniBody>
                <OmniSidebar Open="true" Label="@Text["DemoShellScrollMenu"]">
                    <OmniPanelMenu Label="@Text["DemoShellSections"]" DisplayStyle="OmniPanelMenuDisplayStyle.Icon">
                        <OmniPanelMenuItem Text="@Text["DemoShellLogs"]" Href="composants/coquille" Match="OmniNavMatch.Exact">
                            <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                        </OmniPanelMenuItem>
                    </OmniPanelMenu>
                </OmniSidebar>
                <OmniMain Id="shell-demo-scroll-main" Scrollable="true" AutoHideScrollbar="true" ContentWidth="OmniLayoutWidth.Content" AriaLabelledBy="shell-demo-scroll-title">
                    <OmniHeading Id="shell-demo-scroll-title" Level="OmniHeadingLevel.H5">@Text["DemoShellReadingColumn"]</OmniHeading>
                    @foreach (var paragraph in ScrollParagraphs)
                    {
                        <p>@Text[paragraph]</p>
                    }
                </OmniMain>
            </OmniBody>
        </OmniLayout>
    </div>
</OmniThemeScope>

@* Des onglets dans un cadre de hauteur fixe : seul le panneau choisi défile (ScrollablePanels), et la
   molette tournée n'importe où dans le cadre, sur la barre d'onglets comprise, le fait défiler
   (WheelScrollScope). *@
<div id="shell-demo-tabs-scope" class="demo-tabs-scope">
    <OmniTabs Label="@Text["DemoShellSections"]" ScrollablePanels="true" WheelScrollScope="#shell-demo-tabs-scope">
        <OmniTabsItem Key="reading" Title="@Text["DemoShellReadingColumn"]">
            @foreach (var paragraph in ScrollParagraphs)
            {
                <p>@Text[paragraph]</p>
            }
        </OmniTabsItem>
        <OmniTabsItem Key="wide" Title="@Text["DemoShellWideView"]"><p>@Text["DemoShellWideText"]</p></OmniTabsItem>
    </OmniTabs>
</div>

@* A host-owned startup splash sits outside Blazor's root. This demo exercises the safe absence path. *@
<OmniBootSplash SplashId="showcase-shell-splash" OnHidden="@(found => SplashFound = found)" />
<p>@(SplashFound is null ? Text["DemoShellSplashChecking"] : SplashFound.Value ? Text["DemoShellSplashRemoved"] : Text["DemoShellSplashAbsent"])</p>
