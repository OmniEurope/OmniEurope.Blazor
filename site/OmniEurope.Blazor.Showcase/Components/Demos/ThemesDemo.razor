@* Un thème donne la forme, une palette les couleurs, et toute palette peint tout thème : Preset et
   Palette d'OmniThemeScope, ou OmniThemePreset.With pour composer soi-même. L'aperçu ne lie rien :
   le scope, les réglages et la fenêtre suivent OmniAppearanceState, l'apparence de l'utilisateur que le
   paquet garde comme préférence (localStorage ici, la base de l'hôte quand il en fournit une) ; elle
   revient au rechargement et passe d'un onglet à l'autre. Le thème, la palette, l'apparence et la
   densité ne changent que le scope et son contenu. La taille du texte et celle des contrôles
   s'appliquent à toute la page (racine du document, les tailles étant en rem) tant que le scope est là,
   et sont retirées en quittant la démonstration. La largeur du contenu élargit l'élément principal de
   la vitrine elle-même (OmniMain le plus externe). Les exemples fixes, eux, lient leurs paramètres et
   ne suivent pas l'état. *@
@implements IDisposable

<div class="demo-themes">
    <OmniThemeScope Class="@(Appearance.FullWidth ? "demo-themes__live" : "demo-themes__live demo-themes__live--centred")">
        <OmniAppearanceSettings />
        @* La même fenêtre ouverte depuis une entrée de menu (« Thème ») : thème et palette côte à côte,
           les échelles, la densité et la police. Un nouveau thème y remet la palette et la police à
           celles du thème, comme dans les réglages ; « Aléatoire » tire un thème et une palette. *@
        <OmniButton Id="demo-appearance-window" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => _windowOpen = true)"><Icon><OmniIcon Name="OmniIconName.Palette" /></Icon><ChildContent><span>@Text["DemoThemesAppearanceWindow"]</span></ChildContent></OmniButton>
        <OmniAppearanceWindow @bind-Open="_windowOpen" />
        <OmniCard>
            <HeaderContent><OmniHeading Level="OmniHeadingLevel.H4">@Text["ThemesLivePreview", Caption(LiveSample)]</OmniHeading></HeaderContent>
            <ChildContent>
                <OmniStack Gap="OmniSpacing.Small">
                    <OmniRow Gap="OmniSpacing.Small" Wrap="true" Align="OmniAlignment.Center">
                        <OmniButton><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@Text["ThemesSave"]</span></ChildContent></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@Text["ThemesCancel"]</span></ChildContent></OmniButton>
                        <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Solid">@Text["ThemesBadge"]</OmniBadge>
                    </OmniRow>
                    <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid">@Text["ThemesAlert"]</OmniAlert>
                </OmniStack>
            </ChildContent>
        </OmniCard>
    </OmniThemeScope>
    @foreach (var sample in Samples)
    {
        <OmniThemeScope Appearance="sample.Appearance" Preset="sample.Theme" Palette="sample.Palette">
            <OmniCard>
                <HeaderContent>
                    <OmniHeading Level="OmniHeadingLevel.H4">@Caption(sample)</OmniHeading>
                </HeaderContent>
                <ChildContent>
                    <OmniStack Gap="OmniSpacing.Small">
                        <p>@(sample.Theme?.Description ?? sample.Palette?.Description)</p>
                        <OmniRow Gap="OmniSpacing.Small" Wrap="true" Align="OmniAlignment.Center">
                            <OmniButton><Icon><OmniIcon Name="OmniIconName.Save" /></Icon><ChildContent><span>@Text["ThemesSave"]</span></ChildContent></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Secondary"><Icon><OmniIcon Name="OmniIconName.Close" /></Icon><ChildContent><span>@Text["ThemesCancel"]</span></ChildContent></OmniButton>
                            <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Solid">@Text["ThemesBadge"]</OmniBadge>
                        </OmniRow>
                        <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid">@Text["ThemesAlert"]</OmniAlert>
                    </OmniStack>
                </ChildContent>
            </OmniCard>
        </OmniThemeScope>
    }
</div>
