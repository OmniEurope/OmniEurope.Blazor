@* Un thème donne la forme, une palette les couleurs, et toute palette peint tout thème : Preset et
   Palette d'OmniThemeScope, ou OmniThemePreset.With pour composer soi-même. Le thème, la palette,
   l'apparence et la densité ne changent que le scope et son contenu. La taille du texte, elle,
   s'applique à toute la page (racine du document, les tailles étant en rem) et est retirée en
   quittant la démonstration. Une palette seule garde la forme livrée. Le personnalisateur applique
   la même combinaison à tout le site. *@
@implements IAsyncDisposable

<div class="demo-themes">
    <OmniThemeScope Appearance="_appearance" Preset="_preset" Palette="_palette" Density="_density" Class="demo-themes__live">
        <OmniAppearanceSettings @bind-Appearance="_appearance" @bind-Preset="_preset" @bind-Palette="_palette"
                                @bind-TextSizeLevel="_textSizeLevel" @bind-Density="_density" />
        @* La même fenêtre ouverte depuis une entrée de menu (« Thème ») : thème et palette, puis les
           échelles. Un nouveau thème y remet la palette à celle du thème, comme dans les réglages. *@
        <OmniButton Id="demo-appearance-window" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => _windowOpen = true)"><OmniIcon Name="OmniIconName.Palette" /><span>Fenêtre d'apparence</span></OmniButton>
        <OmniAppearanceWindow @bind-Open="_windowOpen" @bind-Preset="_preset" @bind-Palette="_palette"
                              @bind-TextSizeLevel="_textSizeLevel" @bind-Density="_density" />
        <OmniCard>
            <Header><OmniHeading Level="OmniHeadingLevel.H4">@Text["ThemesLivePreview", Caption(LiveSample)]</OmniHeading></Header>
            <ChildContent>
                <OmniStack Gap="OmniSpacing.Small">
                    <OmniRow Gap="OmniSpacing.Small" Wrap="true" Align="OmniAlignment.Center">
                        <OmniButton><OmniIcon Name="OmniIconName.Save" /><span>@Text["ThemesSave"]</span></OmniButton>
                        <OmniButton Variant="OmniButtonVariant.Secondary"><OmniIcon Name="OmniIconName.Close" /><span>@Text["ThemesCancel"]</span></OmniButton>
                        <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Solid">@Text["ThemesBadge"]</OmniBadge>
                    </OmniRow>
                    <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid">@Text["ThemesAlert"]</OmniAlert>
                </OmniStack>
            </ChildContent>
        </OmniCard>
    </OmniThemeScope>
    @foreach (var sample in Samples)
    {
        <OmniThemeScope Appearance="sample.Appearance" Preset="sample.Theme" Palette="sample.Palette">
            <OmniCard>
                <Header>
                    <OmniHeading Level="OmniHeadingLevel.H4">@Caption(sample)</OmniHeading>
                </Header>
                <ChildContent>
                    <OmniStack Gap="OmniSpacing.Small">
                        <p>@(sample.Theme?.Description ?? sample.Palette?.Description)</p>
                        <OmniRow Gap="OmniSpacing.Small" Wrap="true" Align="OmniAlignment.Center">
                            <OmniButton><OmniIcon Name="OmniIconName.Save" /><span>@Text["ThemesSave"]</span></OmniButton>
                            <OmniButton Variant="OmniButtonVariant.Secondary"><OmniIcon Name="OmniIconName.Close" /><span>@Text["ThemesCancel"]</span></OmniButton>
                            <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Solid">@Text["ThemesBadge"]</OmniBadge>
                        </OmniRow>
                        <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid">@Text["ThemesAlert"]</OmniAlert>
                    </OmniStack>
                </ChildContent>
            </OmniCard>
        </OmniThemeScope>
    }
</div>
