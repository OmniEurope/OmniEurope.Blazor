<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
    <OmniBadge Variant="OmniBadgeVariant.Neutral">Neutre</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Accent">Accent</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success">Succès</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Warning">Avertissement</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Danger">Danger</OmniBadge>
</OmniStack>
@* En contour, la teinte de la variante passe du fond au trait. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
    <OmniBadge Variant="OmniBadgeVariant.Accent" Fill="OmniBadgeFill.Outline">Contour</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success" Fill="OmniBadgeFill.Outline">Validé</OmniBadge>
</OmniStack>
