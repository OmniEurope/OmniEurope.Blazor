@* Tonal : la teinte de la variante mêlée à la surface, plus légère que le plein par défaut. *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Neutral" Fill="OmniFill.Tonal">@Text["DemoBadgesNeutral"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Accent" Fill="OmniFill.Tonal">@Text["DemoBadgesAccent"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Info" Fill="OmniFill.Tonal">@Text["DemoBadgesInfo"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Tonal">@Text["DemoBadgesSuccess"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Fill="OmniFill.Tonal">@Text["DemoBadgesWarning"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Fill="OmniFill.Tonal">@Text["DemoBadgesDanger"]</OmniBadge>
</OmniStack>
@* En contour, la teinte de la variante passe du fond au trait. *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Neutral" Fill="OmniFill.Outline">@Text["DemoBadgesDraft"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Accent" Fill="OmniFill.Outline">@Text["DemoBadgesOutline"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Outline">@Text["DemoBadgesApproved"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Fill="OmniFill.Outline">@Text["DemoBadgesPending"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Fill="OmniFill.Outline">@Text["DemoBadgesRejected"]</OmniBadge>
</OmniStack>
@* Plein, par défaut : lettres blanches sur un fond du ton assez profond pour les lire à 4,5:1, dans tous les thèmes. *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Neutral" Fill="OmniFill.Solid">@Text["DemoBadgesDraft"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Accent" Fill="OmniFill.Solid">@Text["DemoBadgesNew"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Info" Fill="OmniFill.Solid">@Text["DemoBadgesInReview"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Solid">@Text["DemoBadgesPublished"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Fill="OmniFill.Solid">@Text["DemoBadgesPending"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Fill="OmniFill.Solid">@Text["DemoBadgesFailed"]</OmniBadge>
</OmniStack>
@* Ink : White par défaut ; WhiteOutlined, un contour noir de 1 px autour des lettres blanches, pour un badge
   posé sur une image ou une couleur chargée ; Black, des lettres noires sans contour sur un fond du ton
   éclairci pour elles. *@
<OmniStack Id="demo-badge-ink-white" Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Info" Ink="OmniBadgeInk.White">@Text["DemoBadgesInReview"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Ink="OmniBadgeInk.White">@Text["DemoBadgesPending"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Ink="OmniBadgeInk.White">@Text["DemoBadgesFailed"]</OmniBadge>
</OmniStack>
<OmniStack Id="demo-badge-ink-white-outlined" Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Info" Ink="OmniBadgeInk.WhiteOutlined">@Text["DemoBadgesInReview"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Ink="OmniBadgeInk.WhiteOutlined">@Text["DemoBadgesPending"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Ink="OmniBadgeInk.WhiteOutlined">@Text["DemoBadgesFailed"]</OmniBadge>
</OmniStack>
<OmniStack Id="demo-badge-ink-black" Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true">
    <OmniBadge Tone="OmniTone.Neutral" Ink="OmniBadgeInk.Black">@Text["DemoBadgesDraft"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Accent" Ink="OmniBadgeInk.Black">@Text["DemoBadgesNew"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Info" Ink="OmniBadgeInk.Black">@Text["DemoBadgesInReview"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Success" Ink="OmniBadgeInk.Black">@Text["DemoBadgesPublished"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Warning" Ink="OmniBadgeInk.Black">@Text["DemoBadgesPending"]</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger" Ink="OmniBadgeInk.Black">@Text["DemoBadgesFailed"]</OmniBadge>
</OmniStack>
@* Un compteur reste au moins carré. L'icône passe par Icon et prend la taille du texte du badge ;
   seule, elle donne un badge carré ; une taille posée sur l'icône l'emporte. *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small" Wrap="true" Align="OmniAlignment.Center">
    <OmniBadge Tone="OmniTone.Accent">3</OmniBadge>
    <OmniBadge Tone="OmniTone.Danger">128</OmniBadge>
    <OmniBadge Tone="OmniTone.Success"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon><ChildContent>@Text["DemoBadgesPublished"]</ChildContent></OmniBadge>
    <OmniBadge Tone="OmniTone.Info"><Icon><OmniIcon Name="OmniIconName.Info" Label="@Text["DemoBadgesInfo"]" /></Icon></OmniBadge>
    <OmniBadge Tone="OmniTone.Warning"><Icon><OmniIcon Name="OmniIconName.Warning" Size="OmniControlSize.Medium" /></Icon><ChildContent>@Text["DemoBadgesFixedSize"]</ChildContent></OmniBadge>
</OmniStack>
@* Largeur commune : des mots de longueurs différentes s'alignent sur la même largeur dans une colonne ou
   une liste quand ils portent le même pas (Width). C'est un plancher : un texte plus long élargit son
   badge, rien n'est coupé. Sans Width, la largeur du contenu. *@
<OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Large" Align="OmniAlignment.Start" Wrap="true">
    <OmniStack Id="demo-badge-width-small" Gap="OmniSpacing.Small" Align="OmniAlignment.Start">
        <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Tonal" Width="OmniBadgeWidth.Small">SPF</OmniBadge>
        <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Tonal" Width="OmniBadgeWidth.Small">DKIM</OmniBadge>
        <OmniBadge Tone="OmniTone.Warning" Fill="OmniFill.Tonal" Width="OmniBadgeWidth.Small">DMARC</OmniBadge>
    </OmniStack>
    <OmniStack Id="demo-badge-width-medium" Gap="OmniSpacing.Small" Align="OmniAlignment.Start">
        <OmniBadge Tone="OmniTone.Danger" Width="OmniBadgeWidth.Medium">@Text["DemoBadgesFailed"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Warning" Width="OmniBadgeWidth.Medium">@Text["DemoBadgesPending"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Accent" Width="OmniBadgeWidth.Medium">@Text["DemoBadgesNew"]</OmniBadge>
    </OmniStack>
    <OmniStack Id="demo-badge-width-large" Gap="OmniSpacing.Small" Align="OmniAlignment.Start">
        <OmniBadge Tone="OmniTone.Info" Fill="OmniFill.Outline" Width="OmniBadgeWidth.Large">@Text["DemoBadgesInReview"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Success" Fill="OmniFill.Outline" Width="OmniBadgeWidth.Large">@Text["DemoBadgesPublished"]</OmniBadge>
        <OmniBadge Tone="OmniTone.Danger" Fill="OmniFill.Outline" Width="OmniBadgeWidth.Large">@Text["DemoBadgesRejected"]</OmniBadge>
    </OmniStack>
</OmniStack>
