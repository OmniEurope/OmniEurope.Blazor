@* Tonal : la teinte de la variante mêlée à la surface, plus légère que le plein par défaut. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
    <OmniBadge Variant="OmniBadgeVariant.Neutral" Fill="OmniBadgeFill.Filled">Neutre</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Accent" Fill="OmniBadgeFill.Filled">Accent</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Info" Fill="OmniBadgeFill.Filled">Information</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success" Fill="OmniBadgeFill.Filled">Succès</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Warning" Fill="OmniBadgeFill.Filled">Avertissement</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Danger" Fill="OmniBadgeFill.Filled">Danger</OmniBadge>
</OmniStack>
@* En contour, la teinte de la variante passe du fond au trait. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
    <OmniBadge Variant="OmniBadgeVariant.Neutral" Fill="OmniBadgeFill.Outline">Brouillon</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Accent" Fill="OmniBadgeFill.Outline">Contour</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success" Fill="OmniBadgeFill.Outline">Validé</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Warning" Fill="OmniBadgeFill.Outline">En attente</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Danger" Fill="OmniBadgeFill.Outline">Rejeté</OmniBadge>
</OmniStack>
@* Plein, par défaut : exactement le fond et le texte du bouton de même intention. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
    <OmniBadge Variant="OmniBadgeVariant.Neutral" Fill="OmniBadgeFill.Solid">Brouillon</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Accent" Fill="OmniBadgeFill.Solid">Nouveau</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Info" Fill="OmniBadgeFill.Solid">En revue</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success" Fill="OmniBadgeFill.Solid">Publié</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Warning" Fill="OmniBadgeFill.Solid">En attente</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Danger" Fill="OmniBadgeFill.Solid">Échec</OmniBadge>
</OmniStack>
@* Un compteur reste au moins carré. L'icône passe par Icon et prend la taille du texte du badge ;
   seule, elle donne un badge carré ; une taille posée sur l'icône l'emporte. *@
<OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
    <OmniBadge Variant="OmniBadgeVariant.Accent">3</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Danger">128</OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Success" Text="Publié"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon></OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Info"><Icon><OmniIcon Name="OmniIconName.Info" AriaLabel="Information" /></Icon></OmniBadge>
    <OmniBadge Variant="OmniBadgeVariant.Warning" Text="Taille imposée"><Icon><OmniIcon Name="OmniIconName.Warning" Size="OmniControlSize.Medium" /></Icon></OmniBadge>
</OmniStack>
