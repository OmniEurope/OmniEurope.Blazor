<OmniStack Gap="OmniSpacing.Large">
    <OmniChart Title="Évolution mensuelle" Description="Valeur au survol et au clavier">
        <OmniGridLines />
        <OmniCategoryAxis Labels="Months" />
        <OmniValueAxis TickCount="5" />
        <OmniAxisTitle Text="Mois" />
        <OmniLineSeries Title="Dépôts" ColorIndex="0" Data="Deposits" />
        <OmniMarkers ColorIndex="0" Data="Deposits" Radius="3" />
        <OmniAreaSeries Title="Décisions" ColorIndex="1" Data="Decisions" />
        <OmniSeriesDataLabels Data="Deposits" />
        <OmniLegend Label="Séries" Position="OmniLegendPosition.Right" />
    </OmniChart>

    @* Thirty days: the chart widens on its own, the day labels thin out without overlapping, and the
       long series names go below the drawing. *@
    <OmniChart Title="Audience quotidienne sur trente jours">
        <OmniGridLines />
        <OmniCategoryAxis Labels="Days" />
        <OmniValueAxis Maximum="400" TickCount="4" />
        <OmniColumnSeries Title="Pages vues par jour" ColorIndex="1" Data="PageViews" />
        <OmniLineSeries Title="Visiteurs uniques par jour" ColorIndex="0" Data="Visitors" />
        <OmniLegend Position="OmniLegendPosition.Bottom" />
    </OmniChart>

    <OmniChart Title="Répartition empilée">
        <OmniCategoryAxis Labels="Months" />
        <OmniValueAxis />
        <OmniColumnSeries Stacked="true" Title="Entrants" ColorIndex="0" Data="Deposits" />
        <OmniColumnSeries Stacked="true" Title="Sortants" ColorIndex="2" Data="Decisions" />
        <OmniAreaSeries Stacked="true" Title="Stock" ColorIndex="3" Data="Backlog" />
    </OmniChart>

    <OmniChart Title="Comparatif horizontal">
        <OmniCategoryAxis Labels="Countries" />
        <OmniValueAxis />
        <OmniColumnSeries Horizontal="true" Title="Dossiers par pays" ColorIndex="4" Data="ByCountry" />
    </OmniChart>

    @* Horizontal and stacked: the bars of a country sit end to end, the legend reads the series. *@
    <OmniChart Title="Dossiers traités et en attente, par pays">
        <OmniCategoryAxis Labels="Countries" />
        <OmniValueAxis Automatic="true" />
        <OmniColumnSeries Horizontal="true" Stacked="true" Title="Traités" ColorIndex="0" Data="ByCountry" />
        <OmniColumnSeries Horizontal="true" Stacked="true" Title="En attente" ColorIndex="2" Data="ByCountryPending" />
        <OmniLegend Position="OmniLegendPosition.Bottom" />
    </OmniChart>

    <OmniChart Title="Parts par origine">
        <OmniPieSeries Title="Origine" Data="Slices" />
    </OmniChart>

    <OmniChart Title="Parts par origine, en anneau">
        <OmniPieSeries Donut="true" Title="Origine" Data="Slices" />
    </OmniChart>

    <OmniArcGauge Label="Taux de traitement">
        <OmniArcGaugeScale Minimum="0" Maximum="100">
            <OmniArcGaugeScaleValue Value="72" ColorIndex="1"
                                    FormatValue="FormatPercent" />
        </OmniArcGaugeScale>
    </OmniArcGauge>
</OmniStack>
