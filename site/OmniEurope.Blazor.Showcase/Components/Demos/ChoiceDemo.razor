@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="this">
    <OmniStack Gap="OmniSpacing.Large">
        <OmniRadioButtonList TValue="string" Label="@Text["DemoChoiceShippingLabel"]" Name="choice-shipping"
                             Options="Shipping" @bind-Value="Method" />

        <OmniCheckBoxList TValue="string" Label="@Text["DemoChoiceExtrasLabel"]" Options="Extras" @bind-Value="Selected" />

        <OmniSelectBar TValue="string" Label="@Text["DemoChoicePeriodLabel"]" Options="Periods" @bind-Value="Period" />

        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium">
            <OmniToggleButton @bind-Value="Pinned">@Text["DemoChoicePin"]</OmniToggleButton>
            <OmniToggleButton Value="false" Disabled="true">@Text["DemoChoiceUnavailable"]</OmniToggleButton>
            <OmniToggleButton Value="true" Busy="true">@Text["DemoChoiceSaving"]</OmniToggleButton>
        </OmniStack>

        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Wrap="true">
            <OmniCheckBox Id="choice-labelled-check" @bind-Value="Pinned">@Text["DemoChoiceLabelledCheck"]</OmniCheckBox>
            <OmniCheckBox Id="choice-nullable-check" @bind-Value="Partial">@Text["DemoChoiceTriStateCheck"]</OmniCheckBox>
            <OmniSwitch Id="choice-nullable-switch" @bind-Value="Partial">@Text["DemoChoiceTriStateSwitch"]</OmniSwitch>
            <span>@Text["DemoChoiceTriStateValue", Partial is null ? Text["DemoChoiceIndeterminate"] : Partial.Value ? Text["DemoChoiceOn"] : Text["DemoChoiceOff"]]</span>
        </OmniStack>
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Wrap="true">
            <OmniCheckBox Id="choice-text-first-check" TextFirst="true" @bind-Value="Pinned">@Text["DemoChoiceTextFirstCheck"]</OmniCheckBox>
            <OmniSwitch Id="choice-text-first-switch" TextFirst="true" @bind-Value="Pinned">@Text["DemoChoiceTextFirstSwitch"]</OmniSwitch>
        </OmniStack>

        @* Cartes à choisir : l'encadré et la teinte d'accent montrent le choix, sans coche qui déplacerait
           le texte. Le groupe lie le choix : une seule carte dans l'ordre de tabulation, les flèches
           déplacent le choix. Multiple en fait des cases, liées à une liste. Seule, une carte lie un
           booléen. *@
        <OmniSelectableCardGroup TValue="string" TSelection="string" Label="@Text["DemoChoicePlatformLabel"]" @bind-Value="Platform">
            <OmniSelectableCard Choice="@("linux")" Title="Linux" Description="Debian, Ubuntu, Fedora">
                <Icon><OmniIcon Name="OmniIconName.TerminalWindow" /></Icon>
            </OmniSelectableCard>
            <OmniSelectableCard Choice="@("windows")" Title="Windows" Description="@Text["DemoChoiceWindowsDescription"]">
                <Icon><OmniIcon Name="OmniIconName.WindowsLogo" /></Icon>
            </OmniSelectableCard>
        </OmniSelectableCardGroup>
        <OmniSelectableCardGroup Options="Features" Multiple="true" Label="@Text["DemoChoiceFeaturesLabel"]" @bind-Value="AgentFeatures" />
        <OmniSelectableCard Title="@Text["DemoChoiceRunnerTitle"]" Description="@Text["DemoChoiceRunnerDescription"]" Multiple="true" @bind-Value="Runner">
            <Icon><OmniIcon Name="OmniIconName.RocketLaunch" /></Icon>
        </OmniSelectableCard>
        <OmniSelectableCard Title="Docker" Description="@Text["DemoChoiceDockerDescription"]" Multiple="true" Value="true" Disabled="true">
            <Icon><OmniIcon Name="OmniIconName.Package" /></Icon>
        </OmniSelectableCard>
        <OmniRating @bind-Value="Rating" Label="@Text["DemoChoiceRating"]" />
        <OmniRating Value="ReadonlyRating" ValueExpression="@(() => ReadonlyRating)" ReadOnly="true" Label="@Text["DemoChoiceRatingReadOnly"]" />
        <OmniRating Value="ReadonlyRating" ValueExpression="@(() => ReadonlyRating)" Disabled="true" Label="@Text["DemoChoiceRatingDisabled"]" />
    </OmniStack>
</EditForm>
