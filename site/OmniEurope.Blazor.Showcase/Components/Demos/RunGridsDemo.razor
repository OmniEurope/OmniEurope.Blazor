@* Les deux grilles de la maquette (PLAN-004 T15, T17 b). La première, sans alternance (AllowAlternatingRows="false", les lignes alternant par défaut), triée par
   pipeline : la colonne triée est teintée (HighlightActiveColumn), plus légèrement que la ligne
   choisie, pour qu'elles se distinguent là où elles se croisent ; la ligne survolée se teinte aussi.
   La seconde alterne ses lignes, comme toute grille par défaut, et garde son en-tête collé en haut quand elle défile (MaxHeight). La
   durée, un nombre, s'aligne à la fin ; le statut est une pastille compacte (classe omni-status).
   Sa barre d'en-tête porte des boutons d'export de la taille des autres boutons de la page
   (BarButtonSize="OmniControlSize.Medium"), au lieu des boutons compacts par défaut. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniDataGrid TItem="PipelineRun" Id="runs-sorted"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  ScrollMode="OmniDataGridScrollMode.Paged"
                  Items="Recent"
                  Caption="@Text["RunsSortedCaption"]"
                  Filterable="false"
                  AllowAlternatingRows="false"
                  AllowSorting="true"
                  HighlightActiveColumn="true"
                  HighlightRowOnHover="true"
                  SelectionMode="OmniDataGridSelectionMode.Single"
                  KeyOf="run => run.Run"
                  @bind-Value="SortedSelection">
        <Columns>
            <OmniDataGridColumn TItem="PipelineRun" Property="Run" Title="@Text["RunsRun"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Pipeline" Title="@Text["RunsPipeline"]" SortOrder="OmniDataGridSortOrder.Ascending" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Seconds" Title="@Text["RunsSeconds"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Status" Title="@Text["RunsStatus"]">
                <Template Context="run"><span class="@($"omni-status omni-status--{run.Tone}")">@run.Status</span></Template>
            </OmniDataGridColumn>
        </Columns>
    </OmniDataGrid>

    <OmniDataGrid TItem="PipelineRun" Id="runs-striped"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  ScrollMode="OmniDataGridScrollMode.Paged"
                  Items="History"
                  Caption="@Text["RunsStripedCaption"]"
                  Filterable="false"
                  HighlightRowOnHover="true"
                  MaxHeight="15rem"
                  ShowHeaderBar="true"
                  BarButtonSize="OmniControlSize.Medium"
                  SelectionMode="OmniDataGridSelectionMode.Single"
                  KeyOf="run => run.Run"
                  @bind-Value="StripedSelection">
        <Columns>
            <OmniDataGridColumn TItem="PipelineRun" Property="Run" Title="@Text["RunsRun"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Pipeline" Title="@Text["RunsPipeline"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Trigger" Title="@Text["RunsTrigger"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Seconds" Title="@Text["RunsSeconds"]" />
            <OmniDataGridColumn TItem="PipelineRun" Property="Status" Title="@Text["RunsStatus"]">
                <Template Context="run"><span class="@($"omni-status omni-status--{run.Tone}")">@run.Status</span></Template>
            </OmniDataGridColumn>
        </Columns>
    </OmniDataGrid>
</OmniStack>
