<OmniStack Gap="OmniSpacing.Large">
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
        <OmniButton Id="pages-demo-load" Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="LoadAsync">
            <OmniIcon Name="OmniIconName.Refresh" /><span>Recharger la fiche</span>
        </OmniButton>
        <OmniButton Id="pages-demo-missing" Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="ShowMissing">
            <OmniIcon Name="OmniIconName.Search" /><span>Fiche introuvable</span>
        </OmniButton>
    </OmniStack>

    @* L'en-tête est peint avant l'arrivée de la fiche ; le fil d'Ariane vient du service, dont la
       page remplace le dernier maillon quand le nom est connu. *@
    <OmniDetailShell Id="pages-demo-shell" State="State" BackHref="composants/pages"
                     NotFoundDescription="La fiche demandée a été retirée ou n'a jamais existé.">
        <Header>
            <OmniPageHeader ShowBack="true" BackHref="composants/pages" Subtitle="Machine virtuelle de la zone Paris.">
                <Badges>
                    <OmniBadge Variant="OmniBadgeVariant.Success">En ligne</OmniBadge>
                </Badges>
                <Actions>
                    <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small"><OmniIcon Name="OmniIconName.Edit" /><span>Modifier</span></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" Size="OmniControlSize.Small"><OmniIcon Name="OmniIconName.Delete" /><span>Retirer</span></OmniButton>
                </Actions>
                <Filters>
                    <OmniBadge Variant="OmniBadgeVariant.Neutral">Production</OmniBadge>
                    <OmniBadge Variant="OmniBadgeVariant.Neutral">Linux</OmniBadge>
                </Filters>
            </OmniPageHeader>
        </Header>
        <ChildContent>
            <OmniDescriptionList Id="pages-demo-essentials" Columns="2">
                <OmniDescriptionItem Label="Nom">srv-paris-01</OmniDescriptionItem>
                <OmniDescriptionItem Label="Système">Debian 13</OmniDescriptionItem>
                <OmniDescriptionItem Label="Adresse IP">10.0.4.21</OmniDescriptionItem>
                <OmniDescriptionItem Label="Jeton d'accès">
                    <ChildContent>@(TokenShown ? "7f3a-91c2-0bd4" : "••••-••••-••••")</ChildContent>
                    <Actions>
                        <OmniButton Id="pages-demo-reveal" Variant="OmniButtonVariant.Ghost" Size="OmniControlSize.Small"
                                    AriaLabel="@(TokenShown ? "Masquer le jeton" : "Afficher le jeton")"
                                    OnClick="@(_ => TokenShown = !TokenShown)">
                            <OmniIcon Name="@(TokenShown ? OmniIconName.EyeSlash : OmniIconName.Eye)" />
                        </OmniButton>
                    </Actions>
                </OmniDescriptionItem>
                <OmniDescriptionItem Label="Dernier signal">
                    <OmniRelativeTime Id="pages-demo-heartbeat" Value="Heartbeat" RefreshInterval="TimeSpan.FromSeconds(15)" />
                </OmniDescriptionItem>
                <OmniDescriptionItem Label="Certificat">
                    <OmniRelativeTime Value="CertificateExpiry" Format="d MMMM yyyy" />
                </OmniDescriptionItem>
            </OmniDescriptionList>
        </ChildContent>
    </OmniDetailShell>

    @* Le titre reste un paragraphe par défaut ; Level en fait un titre quand l'état vide ouvre une section. *@
    <OmniEmptyState Title="Aucune sauvegarde" Description="Les sauvegardes planifiées apparaîtront ici après leur première exécution.">
        <Actions>
            <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small"><OmniIcon Name="OmniIconName.Add" /><span>Planifier</span></OmniButton>
        </Actions>
    </OmniEmptyState>
    <OmniEmptyState Level="OmniHeadingLevel.H3" Title="Aucun résultat" Description="Aucun serveur ne correspond au filtre.">
        <Icon><OmniIcon Name="OmniIconName.Search" Size="OmniControlSize.Large" /></Icon>
    </OmniEmptyState>
</OmniStack>
