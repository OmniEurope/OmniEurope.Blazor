<OmniStack Gap="OmniSpacing.Large">
    <OmniStack Orientation="OmniOrientation.Horizontal" Gap="OmniSpacing.Small">
        <OmniButton Id="pages-demo-load" Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="LoadAsync">
            <Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@Text["DemoPagesReload"]</span></ChildContent>
        </OmniButton>
        <OmniButton Id="pages-demo-missing" Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="ShowMissing">
            <Icon><OmniIcon Name="OmniIconName.Search" /></Icon><ChildContent><span>@Text["DemoPagesMissing"]</span></ChildContent>
        </OmniButton>
    </OmniStack>

    @* L'en-tête est peint avant l'arrivée de la fiche ; le fil d'Ariane vient du service, dont la
       page remplace le dernier maillon quand le nom est connu. *@
    <OmniDetailShell Id="pages-demo-shell" State="State" BackHref="components/legacy/pages"
                     NotFoundDescription="@Text["DemoPagesNotFound"]">
        <HeaderContent>
            @* Ligne 1 : retour (Primary par défaut), titre, badges, actions et menu « ⋮ » ; ligne 2 : le fil
               d'Ariane, qui finit par le titre. Le sous-titre passe sous le bloc, la ligne 2 portant le fil.
               Framed dessine le cadre ; sans lui, le bloc est posé sur la page, à la même hauteur fixe. Sans
               BackHref, le retour fait un pas en arrière dans l'historique, comme le bouton du navigateur. *@
            <OmniPageHeader Framed="true" ShowBack="true" Subtitle="@Text["DemoPagesSubtitle"]">
                <Badges>
                    <OmniBadge Tone="OmniTone.Success">@Text["DemoPagesOnline"]</OmniBadge>
                </Badges>
                <ActionsContent>
                    <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small"><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent><span>@Text["DemoPagesEdit"]</span></ChildContent></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" Size="OmniControlSize.Small"><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent><span>@Text["DemoPagesRemove"]</span></ChildContent></OmniButton>
                </ActionsContent>
                <MenuContent>
                    <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon><ChildContent>@Text["DemoPagesDuplicate"]</ChildContent></OmniMenuItem>
                    <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon><ChildContent>@Text["DemoPagesArchive"]</ChildContent></OmniMenuItem>
                </MenuContent>
                <Filters>
                    <OmniBadge Tone="OmniTone.Neutral">@Text["DemoPagesProduction"]</OmniBadge>
                    <OmniBadge Tone="OmniTone.Neutral">Linux</OmniBadge>
                </Filters>
            </OmniPageHeader>
        </HeaderContent>
        <ChildContent>
            <OmniDescriptionList Id="pages-demo-essentials" Columns="2">
                <OmniDescriptionItem Term="@Text["DemoPagesName"]">srv-paris-01</OmniDescriptionItem>
                <OmniDescriptionItem Term="@Text["DemoPagesSystem"]"><Icon><OmniIcon Name="OmniIconName.Monitor" /></Icon><ChildContent>Debian 13</ChildContent></OmniDescriptionItem>
                <OmniDescriptionItem Term="@Text["DemoPagesIpAddress"]"><Icon><OmniIcon Name="OmniIconName.Globe" /></Icon><ChildContent>10.0.4.21</ChildContent></OmniDescriptionItem>
                <OmniDescriptionItem Term="@Text["DemoPagesToken"]">
                    <ChildContent>@(TokenShown ? "7f3a-91c2-0bd4" : "••••-••••-••••")</ChildContent>
                    <ActionsContent>
                        <OmniButton Id="pages-demo-reveal" Variant="OmniButtonVariant.Ghost" Size="OmniControlSize.Small"
                                    Label="@(TokenShown ? Text["DemoPagesHideToken"] : Text["DemoPagesShowToken"])"
                                    OnClick="@(_ => TokenShown = !TokenShown)">
                            <Icon><OmniIcon Name="@(TokenShown ? OmniIconName.EyeSlash : OmniIconName.Eye)" /></Icon>
                        </OmniButton>
                    </ActionsContent>
                </OmniDescriptionItem>
                <OmniDescriptionItem Term="@Text["DemoPagesLastSignal"]">
                    <OmniRelativeTime Id="pages-demo-heartbeat" Value="Heartbeat" RefreshInterval="TimeSpan.FromSeconds(15)" />
                </OmniDescriptionItem>
                <OmniDescriptionItem Term="@Text["DemoPagesCertificate"]">
                    <OmniRelativeTime Value="CertificateExpiry" Format="d MMMM yyyy" />
                </OmniDescriptionItem>
            </OmniDescriptionList>
        </ChildContent>
    </OmniDetailShell>

    @* PinnedActionsContent : l'action qui doit rester à portée n'est jamais repliée derrière « Voir plus ».
       Large, elle finit la ligne 1 juste avant le menu « ⋮ » ; sous 40rem, elle prend une ligne sous la
       ligne 1, alignée à la fin, le menu restant à l'extrémité de la ligne du titre, « Voir plus »
       fermé comme ouvert. ActionsContent (le bouton scindé) et les badges se replient comme ailleurs. *@
    <OmniPageHeader Id="pages-demo-pinned" Level="OmniHeadingLevel.H2" Framed="true" ShowBack="true" ShowTrail="false"
                    Title="@Text["DemoPagesPipelineRun", "2842"]">
        <Icon><OmniIcon Name="OmniIconName.RocketLaunch" /></Icon>
        <Badges>
            <OmniBadge Tone="OmniTone.Success">@Text["DemoPagesOnline"]</OmniBadge>
            <OmniBadge Tone="OmniTone.Neutral">@Text["DemoPagesProduction"]</OmniBadge>
        </Badges>
        <ActionsContent>
            <OmniSplitButton Id="pages-demo-pinned-split" Size="OmniControlSize.Small" Text="@Text["DemoPagesEdit"]">
                <Icon><OmniIcon Name="OmniIconName.Edit" /></Icon>
                <ChildContent>
                    <OmniMenuItem>@Text["DemoPagesDuplicate"]</OmniMenuItem>
                </ChildContent>
            </OmniSplitButton>
        </ActionsContent>
        <PinnedActionsContent>
            <OmniButton Id="pages-demo-pinned-relaunch" Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small"><Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@Text["DemoPagesRerun"]</span></ChildContent></OmniButton>
        </PinnedActionsContent>
        <MenuContent>
            <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Edit" /></Icon><ChildContent>@Text["DemoPagesEdit"]</ChildContent></OmniMenuItem>
            <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Copy" /></Icon><ChildContent>@Text["DemoPagesDuplicate"]</ChildContent></OmniMenuItem>
            <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Archive" /></Icon><ChildContent>@Text["DemoPagesArchive"]</ChildContent></OmniMenuItem>
            <OmniMenuItem><Icon><OmniIcon Name="OmniIconName.Delete" /></Icon><ChildContent>@Text["DemoPagesRemove"]</ChildContent></OmniMenuItem>
        </MenuContent>
    </OmniPageHeader>

    @* Le titre reste un paragraphe par défaut ; Level en fait un titre quand l'état vide ouvre une section. *@
    <OmniEmptyState Title="@Text["DemoPagesNoBackup"]" Description="@Text["DemoPagesNoBackupText"]">
        <ActionsContent>
            <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small"><Icon><OmniIcon Name="OmniIconName.Add" /></Icon><ChildContent><span>@Text["DemoPagesSchedule"]</span></ChildContent></OmniButton>
        </ActionsContent>
    </OmniEmptyState>
    <OmniEmptyState Level="OmniHeadingLevel.H3" Title="@Text["DemoPagesNoResult"]" Description="@Text["DemoPagesNoResultText"]">
        <Icon><OmniIcon Name="OmniIconName.Search" Size="OmniControlSize.Large" /></Icon>
    </OmniEmptyState>

    @* Tuiles de statistique : la seconde, cliquable, est un vrai bouton nommé par son libellé et sa valeur.
       Le libellé reste sur une ligne : plus petit quand il ne tient pas dans sa colonne, puis coupé de
       points de suspension, son texte entier dans l'infobulle (troisième tuile, réduite sur une colonne étroite). *@
    <OmniRow Gap="OmniSpacing.Small">
        <OmniColumn Span="12" MediumSpan="4">
            <OmniStatTile Value="@Text["DemoPagesTokensValue", 12.4]" Title="@Text["DemoPagesTokensToday"]" Detail="@Text["DemoPagesTokensReset", ResetTime]">
                <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
            </OmniStatTile>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniStatTile Value="@WeeklyShare" Title="@Text["DemoPagesWeekly"]" OnClick="@(() => { })">
                <Icon><OmniIcon Name="OmniIconName.CalendarCheck" /></Icon>
            </OmniStatTile>
        </OmniColumn>
        <OmniColumn Span="6" MediumSpan="3">
            <OmniStatTile Id="demo-stat-tile-gain" Value="@Gain" Title="@Text["DemoPagesGain"]">
                <Icon><OmniIcon Name="OmniIconName.ChartLineUp" /></Icon>
            </OmniStatTile>
        </OmniColumn>
    </OmniRow>

    @* Tuiles de faits (OmniFactTile) : un titre, puis des lignes icône, libellé, valeur sur trois colonnes
       communes, donc alignées d'une ligne à l'autre et d'une tuile à l'autre de la grille. Trois contenus de
       longueurs différentes dans une même OmniTileGrid : même hauteur, une valeur trop longue est coupée de
       points de suspension et lue en entier dans l'infobulle. La première porte des valeurs-liens, la deuxième
       un badge (petit), la troisième est un seul lien (Href), titre aligné au début, une ligne sans icône. *@
    <OmniTileGrid Id="demo-fact-tile-grid" Columns="3">
        <OmniFactTile Id="demo-fact-tile-source" Title="@Text["DemoPagesFactSource"]">
            <Icon><OmniIcon Name="OmniIconName.FolderOpen" /></Icon>
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactRepository"]" Href="components/legacy/pages">
                    <Icon><OmniIcon Name="OmniIconName.Database" /></Icon>
                    <ChildContent>omni-europe-blazor-showcase-demo</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactBranch"]" Href="components/legacy/grille">
                    <Icon><OmniIcon Name="OmniIconName.Graph" /></Icon>
                    <ChildContent>release/1.9.0-alignement-des-tuiles</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="Commit">
                    <Icon><OmniIcon Name="OmniIconName.GitCommit" /></Icon>
                    <ChildContent>9f3c2a1</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-fact-tile-run" Title="@Text["DemoPagesFactRun"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStatus"]">
                    <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    <ChildContent><OmniBadge Tone="OmniTone.Success">@Text["DemoPagesFactSucceeded"]</OmniBadge></ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactSteps"]">
                    <Icon><OmniIcon Name="OmniIconName.Rows" /></Icon>
                    <ChildContent>5 / 5</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-fact-tile-timeline" Title="@Text["DemoPagesFactTimeline"]" TitleAlign="OmniAlignment.Start" Href="components/legacy/pages">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStarted"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:21:07 +02:00 (Europe/Paris)</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactDuration"]">
                    <ChildContent>1h44min</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
    </OmniTileGrid>

    @* Quatre tuiles de faits sur une même rangée (Columns="4") : chacune est étroite, donc chaque ligne décide
       seule : libellé et valeur sur une même ligne quand ils tiennent ensemble (les secondes lignes), la valeur
       sous le libellé sinon (les premières lignes : un libellé de 16 caractères et une valeur de 20 s'affichent
       en entier, sans points de suspension). *@
    <OmniTileGrid Id="demo-fact-tile-narrow-grid" Columns="4">
        <OmniFactTile Id="demo-fact-tile-narrow-source" Title="@Text["DemoPagesFactSource"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:14:02Z</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactBranch"]">
                    <Icon><OmniIcon Name="OmniIconName.Graph" /></Icon>
                    <ChildContent>release/1.9.0</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-fact-tile-narrow-run" Title="@Text["DemoPagesFactRun"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:14:02Z</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactStatus"]">
                    <Icon><OmniIcon Name="OmniIconName.Info" /></Icon>
                    <ChildContent><OmniBadge Tone="OmniTone.Success">@Text["DemoPagesFactSucceeded"]</OmniBadge></ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-fact-tile-narrow-timeline" Title="@Text["DemoPagesFactTimeline"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:14:02Z</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.Timer" /></Icon>
                    <ChildContent>1h44min</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
        <OmniFactTile Id="demo-fact-tile-narrow-steps" Title="@Text["DemoPagesFactSteps"]">
            <ChildContent>
                <OmniFactTileRow Term="@Text["DemoPagesFactStepDuration"]">
                    <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
                    <ChildContent>2026-10-23 08:14:02Z</ChildContent>
                </OmniFactTileRow>
                <OmniFactTileRow Term="@Text["DemoPagesFactSteps"]">
                    <Icon><OmniIcon Name="OmniIconName.Rows" /></Icon>
                    <ChildContent>5 / 5</ChildContent>
                </OmniFactTileRow>
            </ChildContent>
        </OmniFactTile>
    </OmniTileGrid>

    @* Tuiles de navigation : chacune est un vrai lien, son icône sur un carré à la teinte de son ton ;
       au survol, seule l'ombre change. Elles prennent la hauteur de leur colonne. *@
    <OmniRow Gap="OmniSpacing.Medium">
        <OmniColumn Span="12" MediumSpan="4">
            <OmniNavTile Href="components/legacy/grille" Title="@Text["DemoGridTitle"]" Description="@Text["DemoGridSummary"]">
                <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
            </OmniNavTile>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniNavTile Href="components/legacy/editeur" Title="@Text["DemoEditorTitle"]" Tone="OmniTone.Info">
                <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
            </OmniNavTile>
        </OmniColumn>
        <OmniColumn Span="12" MediumSpan="4">
            <OmniNavTile Href="components/icons" Title="@Text["DemoPagesIconsTitle"]" Description="@Text["DemoPagesIconsSummary"]" Tone="OmniTone.Success">
                <Icon><OmniIcon Name="OmniIconName.Image" /></Icon>
            </OmniNavTile>
        </OmniColumn>
    </OmniRow>

    @* FitTitle : en six colonnes, le titre rétrécit pour tenir sur une ligne, sans couper de mot, aligné à gauche. *@
    <OmniRow Gap="OmniSpacing.Medium">
        <OmniColumn Span="6" MediumSpan="2">
            <OmniNavTile Href="components/legacy/grille" Title="@Text["DemoGridTitle"]" FitTitle="true">
                <Icon><OmniIcon Name="OmniIconName.Table" /></Icon>
            </OmniNavTile>
        </OmniColumn>
        <OmniColumn Span="6" MediumSpan="2">
            <OmniNavTile Href="components/legacy/editeur" Title="@Text["DemoEditorTitle"]" Tone="OmniTone.Info" FitTitle="true">
                <Icon><OmniIcon Name="OmniIconName.FileDoc" /></Icon>
            </OmniNavTile>
        </OmniColumn>
        <OmniColumn Span="6" MediumSpan="2">
            <OmniNavTile Href="components/icons" Title="@Text["DemoPagesIconsTitle"]" Tone="OmniTone.Success" FitTitle="true">
                <Icon><OmniIcon Name="OmniIconName.Image" /></Icon>
            </OmniNavTile>
        </OmniColumn>
    </OmniRow>
</OmniStack>
