<OmniStack Gap="OmniSpacing.Medium">
    <OmniHeading Level="OmniHeadingLevel.H1">@Text["DemoTypographyLevelHeading", 1]</OmniHeading>
    <OmniHeading Level="OmniHeadingLevel.H2">@Text["DemoTypographyLevelHeading", 2]</OmniHeading>
    <OmniHeading Level="OmniHeadingLevel.H3" Tone="OmniTextTone.Accent">@Text["DemoTypographyAccentHeading"]</OmniHeading>
    <OmniHeading Level="OmniHeadingLevel.H4" Tone="OmniTextTone.Muted">@Text["DemoTypographyMutedHeading"]</OmniHeading>
    <OmniHeading Level="OmniHeadingLevel.H5">@Text["DemoTypographyLevelHeading", 5]</OmniHeading>
    <OmniHeading Level="OmniHeadingLevel.H6">@Text["DemoTypographyLevelHeading", 6]</OmniHeading>

    <OmniText Element="OmniTextElement.Paragraph">
        @Text["DemoTypographyParagraph"]
    </OmniText>
    <OmniText Element="OmniTextElement.Paragraph" Tone="OmniTextTone.Muted">
        @Text["DemoTypographySecondary"]
    </OmniText>
    <OmniText Element="OmniTextElement.Small" Tone="OmniTextTone.Danger">@Text["DemoTypographyError"]</OmniText>
    <OmniText Element="OmniTextElement.Strong" Tone="OmniTextTone.Neutral">@Text["DemoTypographyStrong"]</OmniText>
    <OmniText Element="OmniTextElement.Emphasis">@Text["DemoTypographyEmphasis"]</OmniText>
    <OmniText Element="OmniTextElement.Span" Tone="OmniTextTone.Success">@Text["DemoTypographySuccess"]</OmniText>
    <OmniText Element="OmniTextElement.Paragraph" Truncate="true">
        @Text["DemoTypographyTruncated"]
    </OmniText>

    <OmniLabel For="typography-demo-field" Required="true">@Text["DemoTypographyLabel"]</OmniLabel>
    <OmniLink Href="documentation">@Text["DemoTypographyInternalLink"]</OmniLink>
    <OmniLink Href="https://learn.microsoft.com/aspnet/core/blazor" NewTab="true">@Text["DemoTypographyExternalLink"]</OmniLink>
</OmniStack>
