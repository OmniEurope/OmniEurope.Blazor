<OmniStack Gap="OmniSpacing.Medium">
    @* Plein : la sévérité peint le fond, dessiné comme un bouton. Information et succès sur un fond
       clair à texte sombre, attention et danger sur un fond profond à texte clair. Le disque porte le
       glyphe de la sévérité. *@
    <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Solid" Title="@Text["DemoAlertsMaintenance"]">
        @Text["DemoAlertsMaintenanceText"]
    </OmniAlert>
    <OmniAlert Severity="OmniSeverity.Success" Fill="OmniFill.Solid" Title="@Text["DemoAlertsPublished"]">
        @Text["DemoAlertsPublishedText"]
    </OmniAlert>
    <OmniAlert Severity="OmniSeverity.Warning" Fill="OmniFill.Solid" Title="@Text["DemoAlertsCertificate"]" Dismissible="true">
        @Text["DemoAlertsCertificateText", 12]
    </OmniAlert>
    <OmniAlert Severity="OmniSeverity.Danger" Fill="OmniFill.Solid" Title="@Text["DemoAlertsFailure"]">
        @Text["DemoAlertsFailureText"]
    </OmniAlert>
    @* En contour : la surface de la page, un filet de la sévérité, le texte de la page ; le disque
       garde le fond et le glyphe de la sévérité. *@
    <OmniAlert Severity="OmniSeverity.Info" Title="@Text["DemoAlertsInfo"]">
        @Text["DemoAlertsInfoText"]
    </OmniAlert>
    <OmniAlert Severity="OmniSeverity.Success" Title="@Text["DemoAlertsSaved"]">
        @Text["DemoAlertsSavedText"]
    </OmniAlert>
    @* Tonal : une teinte légère de la sévérité derrière le texte de la page, sans filet. *@
    <OmniAlert Severity="OmniSeverity.Info" Fill="OmniFill.Tonal" Title="@Text["DemoAlertsNew"]">
        @Text["DemoAlertsNewText"]
    </OmniAlert>
    @* Icon remplace le glyphe dans le disque par une icône de l'application. *@
    <OmniAlert Severity="OmniSeverity.Warning" Title="@Text["DemoAlertsCaution"]">
        <Icon><OmniIcon Name="OmniIconName.Warning" /></Icon>
        <ChildContent>@Text["DemoAlertsCautionText"]</ChildContent>
    </OmniAlert>
    <OmniAlert Severity="OmniSeverity.Danger">
        @Text["DemoAlertsTooLarge"]
    </OmniAlert>
    @* Dismissible ajoute la croix ; sans lui, une alerte reste affichée. *@
    <OmniAlert Severity="OmniSeverity.Info" Title="@Text["DemoAlertsTip"]" Dismissible="true">
        @Text["DemoAlertsTipText"]
    </OmniAlert>
</OmniStack>
