<OmniStack Gap="OmniSpacing.Large">
    <OmniSpreadsheet Id="demo-sheet"
                     @bind-Value="Budget"
                     Label="@Text["DemoSpreadsheetLabel"]"
                     ActiveCellChanged="@(address => Active = address)" />

    <p>@Text["DemoSpreadsheetStatus", Active, Budget.Evaluate("E7").ToDisplayString()]</p>

    <OmniSpreadsheet Id="demo-sheet-readonly"
                     Value="@Budget"
                     ReadOnly="true"
                     ShowFormulaBar="false"
                     ShowGridLines="false"
                     Label="@Text["DemoSpreadsheetReadOnlyLabel"]" />
</OmniStack>
