@using Microsoft.AspNetCore.Components.Forms

<OmniStack Gap="OmniSpacing.Large">
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(_ => Count++)">
            Primaire
        </OmniButton>
        <OmniButton Variant="OmniButtonVariant.Secondary">Secondaire</OmniButton>
        <OmniButton Variant="OmniButtonVariant.Ghost">Discret</OmniButton>
        <OmniButton Variant="OmniButtonVariant.Success">Valider</OmniButton>
        <OmniButton Variant="OmniButtonVariant.Warning">Suspendre</OmniButton>
        <OmniButton Variant="OmniButtonVariant.Info">Détails</OmniButton>
        <OmniButton Variant="OmniButtonVariant.Danger">Supprimer</OmniButton>
        <OmniButton Disabled="true">Indisponible</OmniButton>
        <OmniButton Busy="true">Enregistrement</OmniButton>
    </OmniStack>

    @* Busy garde le contenu et la taille exacts du repos : un voile respire par-dessus. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
        <OmniButton Id="demo-save" Busy="Saving" OnClick="SaveAsync">
            <OmniIcon Name="OmniIconName.Check" />
            <span>Enregistrer</span>
        </OmniButton>
        <OmniSplitButton Id="demo-split" Text="Publier" Busy="Saving" OnClick="SaveAsync" />
        <OmniToggleButton Id="demo-toggle" @bind-Value="Pinned" Busy="Saving">Épingler</OmniToggleButton>
    </OmniStack>

    @* Trois tailles réellement distinctes : hauteur, marge et corps de texte changent ensemble. Une
       icône seule rend le bouton carré à sa taille ; le bouton bascule et le bouton partagé suivent. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
        <OmniButton Size="OmniControlSize.Small">Petit</OmniButton>
        <OmniButton Size="OmniControlSize.Medium">Moyen</OmniButton>
        <OmniButton Size="OmniControlSize.Large">Grand</OmniButton>
        <OmniButton Size="OmniControlSize.Small" Variant="OmniButtonVariant.Secondary" AriaLabel="Rechercher"><OmniIcon Name="OmniIconName.Search" /></OmniButton>
        <OmniButton Size="OmniControlSize.Medium" Variant="OmniButtonVariant.Secondary" AriaLabel="Rechercher"><OmniIcon Name="OmniIconName.Search" /></OmniButton>
        <OmniButton Size="OmniControlSize.Large" Variant="OmniButtonVariant.Secondary" AriaLabel="Rechercher"><OmniIcon Name="OmniIconName.Search" /></OmniButton>
    </OmniStack>

    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
        <OmniToggleButton Size="OmniControlSize.Small" @bind-Value="Pinned">Épingler</OmniToggleButton>
        <OmniToggleButton Size="OmniControlSize.Large" @bind-Value="Pinned">Épingler</OmniToggleButton>
        <OmniToggleButton @bind-Value="Pinned" aria-label="Épingler"><OmniIcon Name="OmniIconName.Pin" /></OmniToggleButton>
        <OmniSplitButton Size="OmniControlSize.Small" Text="Publier" OnClick="SaveAsync" />
        <OmniSplitButton Size="OmniControlSize.Large" Text="Publier" OnClick="SaveAsync" />
    </OmniStack>

    @* Le bouton partagé prend les variantes d'OmniButton, les deux parties ensemble ; Secondary, son
       apparence d'origine, reste la valeur par défaut. Une icône peut précéder le texte de la partie
       principale, le chevron du menu ne change pas. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
        <OmniSplitButton Id="demo-split-primary" Text="Publier" Variant="OmniButtonVariant.Primary" Icon="OmniIconName.RocketLaunch" OnClick="@(() => Count++)">
            <OmniSplitButtonItem OnClick="@(() => Count++)">Publier plus tard</OmniSplitButtonItem>
        </OmniSplitButton>
        <OmniSplitButton Text="Brouillon" Variant="OmniButtonVariant.Secondary" Icon="OmniIconName.Save" OnClick="@(() => Count++)" />
        <OmniSplitButton Text="Aperçu" Variant="OmniButtonVariant.Ghost" OnClick="@(() => Count++)" />
        <OmniSplitButton Text="Valider" Variant="OmniButtonVariant.Success" Icon="OmniIconName.Check" OnClick="@(() => Count++)" />
        <OmniSplitButton Text="Suspendre" Variant="OmniButtonVariant.Warning" Icon="OmniIconName.Pause" OnClick="@(() => Count++)" />
        <OmniSplitButton Text="Consulter" Variant="OmniButtonVariant.Info" Icon="OmniIconName.Info" OnClick="@(() => Count++)" />
        <OmniSplitButton Text="Supprimer" Variant="OmniButtonVariant.Danger" Icon="OmniIconName.Delete" OnClick="@(() => Count++)" />
    </OmniStack>

    @* Dans un formulaire, le type décide de ce que le bouton déclenche. *@
    <EditForm Model="this" OnValidSubmit="SendAsync">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium">
            <OmniButton Id="demo-send" ButtonType="OmniButtonType.Submit" Busy="Sending">Envoyer</OmniButton>
            <OmniButton ButtonType="OmniButtonType.Reset" Variant="OmniButtonVariant.Ghost">Réinitialiser</OmniButton>
            <OmniButton ButtonType="OmniButtonType.Button" Variant="OmniButtonVariant.Secondary">Sans effet sur le formulaire</OmniButton>
        </OmniStack>
    </EditForm>
</OmniStack>

<p>Clics sur le bouton primaire : @Count. Envois du formulaire : <span id="demo-sent">@Sent</span>.</p>
