<OmniStack Gap="OmniSpacing.Large">
    <OmniDataList TItem="GridRow" Items="Page" Virtualize="false">
        <ItemTemplate>
            <OmniCard>
                <Header><OmniHeading Level="OmniHeadingLevel.H5">@context.Reference</OmniHeading></Header>
                <ChildContent>@context.Applicant, @context.Country</ChildContent>
                <Footer><OmniBadge Tone="OmniTone.Neutral">@context.Amount.ToString("C0")</OmniBadge></Footer>
            </OmniCard>
        </ItemTemplate>
        <EmptyContent>@Text["DemoDataListEmpty"]</EmptyContent>
        <LoadingContent>@Text["DemoDataListLoading"]</LoadingContent>
    </OmniDataList>

    <OmniPager Label="@Text["DemoDataListPager"]"
               Page="PageNumber"
               PageChanged="@(value => PageNumber = value)"
               PageSize="PageSize"
               PageSizeChanged="ChangePageSize"
               PageSizeOptions="Sizes"
               PageCount="PageCount"
               NumericPageCount="5"
               ShowFirstLast="true"
               HorizontalAlign="OmniJustification.Center" />

    @* Export Markdown pour une IA, hors grille : toutes les lignes annoncées, lues page par page par le
       fournisseur, pas seulement la page de cartes affichée ; en-tête avec le titre, le tri, la limite,
       l'heure et le compte. Une grille exporte par ses propres barres (ShowFooterBar, FooterBarExport). *@
    <OmniMarkdownExportButton TItem="GridRow" Export="CreateExport" FileName="@Text["DemoGridExportFileName"]" />
</OmniStack>

<OmniLogViewer Lines="LogLines" Label="@Text["DemoDataListLog"]" ShowLevels="true"
               ShowLevelFilter="true" ShowSearch="true" Height="14rem" />

<OmniKanban TItem="GridRow" Columns="WorkflowColumns" Items="KanbanRows"
            ColumnOf="WorkflowColumnOf" KeyOf="WorkflowKeyOf" ItemLabel="WorkflowLabelOf" OnItemMove="MoveWorkflowRow"
            Label="@Text["DemoDataListKanban"]">
    <CardTemplate Context="row">
        <strong>@row.Reference</strong> : @row.Applicant
    </CardTemplate>
</OmniKanban>
