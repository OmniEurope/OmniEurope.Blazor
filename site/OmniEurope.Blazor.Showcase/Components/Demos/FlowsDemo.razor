@using Microsoft.AspNetCore.Components.Forms

<OmniStack Gap="OmniSpacing.Large">
    @* Suivant reste grisé tant que le nom manque (CanContinue) ; l'étape des options répond au clic
       par une validation qui peut refuser (Validate). Une étape déjà atteinte se rouvre d'un clic. *@
    <EditForm Model="Model">
        <OmniWizard Id="flows-demo-wizard" @bind-Value="Step" FinishText="@Text["DemoFlowsCreateServer"]"
                    OnFinish="Finish" OnCancel="Reset">
            <OmniWizardStep Title="@Text["DemoFlowsStepIdentity"]" CanContinue="@(!string.IsNullOrWhiteSpace(Model.Name))">
                <OmniFormField For="flows-demo-name" Required="true" Description="@Text["DemoFlowsNameHelp"]">
                    <LabelContent>@Text["DemoFlowsServerName"]</LabelContent>
                    <ChildContent>
                        <OmniTextBox Id="flows-demo-name" @bind-Value="Model.Name" Placeholder="srv-paris-02" />
                    </ChildContent>
                </OmniFormField>
            </OmniWizardStep>
            <OmniWizardStep Title="@Text["DemoFlowsStepOptions"]" Validate="ValidateOptionsAsync">
                <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small" Align="OmniAlignment.Center">
                    <OmniCheckBox Id="flows-demo-backup" @bind-Value="Model.Backup" />
                    <OmniLabel For="flows-demo-backup">@Text["DemoFlowsDailyBackup"]</OmniLabel>
                </OmniStack>
                @if (OptionsRefused)
                {
                    <OmniAlert Severity="OmniSeverity.Warning" Live="true">@Text["DemoFlowsBackupRequired"]</OmniAlert>
                }
            </OmniWizardStep>
            <OmniWizardStep Title="@Text["DemoFlowsStepSummary"]">
                <OmniDescriptionList>
                    <OmniDescriptionItem Label="@Text["DemoFlowsSummaryName"]">@Model.Name</OmniDescriptionItem>
                    <OmniDescriptionItem Label="@Text["DemoFlowsSummaryBackup"]">@(Model.Backup ? Text["DemoFlowsBackupDaily"] : Text["DemoFlowsBackupNone"])</OmniDescriptionItem>
                </OmniDescriptionList>
            </OmniWizardStep>
        </OmniWizard>
    </EditForm>
    <p id="flows-demo-outcome">@Text["DemoFlowsOutcome", Outcome ?? Text["DemoFlowsOutcomePending"]]</p>

    @* Dans un dialogue, Échap et la croix sont ceux du dialogue ; l'assistant n'y ajoute rien. *@
    <OmniButton Id="flows-demo-open" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => DialogOpen = true)">
        <OmniIcon Name="OmniIconName.Add" /><span>@Text["DemoFlowsWizardInDialog"]</span>
    </OmniButton>
    <OmniDialog Title="@Text["DemoFlowsInviteTitle"]" Open="DialogOpen" OpenChanged="@(value => DialogOpen = value)">
        <OmniWizard Label="@Text["DemoFlowsInviteSteps"]" FinishText="@Text["DemoFlowsInvite"]" OnFinish="@(() => DialogOpen = false)">
            <OmniWizardStep Title="@Text["DemoFlowsStepAddress"]"><p>@Text["DemoFlowsAddressBody"]</p></OmniWizardStep>
            <OmniWizardStep Title="@Text["DemoFlowsStepRole"]"><p>@Text["DemoFlowsRoleBody"]</p></OmniWizardStep>
        </OmniWizard>
    </OmniDialog>

    @* La coquille ne porte aucune authentification : le formulaire et son envoi sont ceux de l'hôte.
       OmniReturnUrl ne rend qu'un chemin de l'application, jamais une adresse extérieure. *@
    <div class="showcase-preview-frame">
        @* SignUpHref : le lien d'inscription discret en tête du pied, jamais un second bouton. *@
        <OmniLoginShell Description="@Text["DemoFlowsLoginDescription"]" SignUpHref="composants/parcours">
            <Logo><OmniIcon Name="OmniIconName.ShieldCheck" Size="OmniControlSize.Large" Label="@Text["DemoFlowsLoginLogo"]" /></Logo>
            <ChildContent>
                <EditForm Model="Credentials" OnSubmit="SubmitSignIn">
                    <OmniStack Gap="OmniSpacing.Medium">
                        <OmniFormField For="flows-demo-user">
                            <LabelContent>@Text["DemoFlowsUser"]</LabelContent>
                            <ChildContent><OmniTextBox Id="flows-demo-user" @bind-Value="Credentials.Name" Autocomplete="username" /></ChildContent>
                        </OmniFormField>
                        <OmniFormField For="flows-demo-password">
                            <LabelContent>@Text["DemoFlowsPassword"]</LabelContent>
                            <ChildContent><OmniPassword Id="flows-demo-password" @bind-Value="Credentials.Secret" Revealable="true" Autocomplete="current-password" /></ChildContent>
                        </OmniFormField>
                        <OmniButton ButtonType="OmniButtonType.Submit"><OmniIcon Name="OmniIconName.SignIn" /><span>@Text["DemoFlowsSignIn"]</span></OmniButton>
                    </OmniStack>
                </EditForm>
            </ChildContent>
            <Footer>
                @if (SignInNote is not null)
                {
                    <p role="status">@SignInNote</p>
                }
                <p>@Text["DemoFlowsReturnAfterSignIn", OmniReturnUrl.Resolve("/projets/12?onglet=journal")]</p>
                <p>@Text["DemoFlowsExternalRefused", OmniReturnUrl.Resolve("//exemple.invalid/piege")]</p>
            </Footer>
        </OmniLoginShell>
    </div>

    @* L'hôte pilote l'état, le compte à rebours et les rappels ; le composant ne tient aucune connexion. *@
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Small">
        <OmniButton Id="flows-demo-drop" Variant="OmniButtonVariant.Warning" OnClick="DropAsync">
            <OmniIcon Name="OmniIconName.Offline" /><span>@Text["DemoFlowsSimulateDrop"]</span>
        </OmniButton>
        <OmniButton Id="flows-demo-reject" Variant="OmniButtonVariant.Danger" OnClick="Reject">
            <OmniIcon Name="OmniIconName.Prohibit" /><span>@Text["DemoFlowsSimulateReject"]</span>
        </OmniButton>
    </OmniStack>
    <OmniConnectionOverlay Id="flows-demo-connection" State="Connection" TimeUntilRetry="TimeSpan.FromSeconds(Countdown)" Busy="Reconnecting"
                           Reason="@Reason" OnReconnect="ReconnectAsync" OnReload="@(() => Connection = OmniConnectionState.Connected)" />
    <p id="flows-demo-connection-state">@Text["DemoFlowsConnection", ConnectionText]</p>
</OmniStack>
