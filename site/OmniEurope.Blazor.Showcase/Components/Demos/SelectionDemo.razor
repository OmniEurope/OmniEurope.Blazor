@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="this">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniFormField For="demo-country">
            <Label>Pays</Label>
            <ChildContent>
                <OmniDropDown TValue="string" Id="demo-country" Options="Countries" @bind-Value="Country" Placeholder="Choisir un pays" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-city">
            <Label>Villes desservies</Label>
            <ChildContent>
                <OmniListBox TValue="string" Id="demo-city" Options="Cities" @bind-Value="City" VisibleRows="4" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-tags">
            <Label>Étiquettes</Label>
            <ChildContent>
                <OmniMultiSelect TValue="string" Id="demo-tags" Options="Tags" @bind-Value="SelectedTags"
                                 Presentation="OmniMultiSelectPresentation.List" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="demo-tags-compact">
            <Label>Étiquettes, forme compacte</Label>
            <ChildContent>
                <OmniMultiSelect TValue="string" Id="demo-tags-compact" Options="Tags" @bind-Value="CompactTags"
                                 Presentation="OmniMultiSelectPresentation.Compact"
                                 Placeholder="Choisir des étiquettes" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="demo-tags-filterable">
            <Label>Étiquettes, recherche et création</Label>
            <ChildContent>
                <OmniMultiSelect TValue="string" Id="demo-tags-filterable" Options="EditableTags"
                                 @bind-Value="FilterableTags"
                                 Presentation="OmniMultiSelectPresentation.Compact"
                                 Placeholder="Choisir des étiquettes"
                                 Filterable="true" @bind-FilterText="TagSearch"
                                 FilterPlaceholder="Rechercher une étiquette">
                    <OptionTemplate Context="tag">
                        <svg class="demo-tag-swatch" viewBox="0 0 10 10" focusable="false" aria-hidden="true">
                            <circle cx="5" cy="5" r="5" fill="@SwatchOf(tag.Value)" />
                        </svg>
                        <span>@tag.Text</span>
                    </OptionTemplate>
                    <FooterTemplate>
                        @if (CanCreateSearchedTag)
                        {
                            <OmniButton Variant="OmniButtonVariant.Ghost" Size="OmniControlSize.Small" OnClick="CreateSearchedTag">
                                + @TagSearch
                            </OmniButton>
                        }
                    </FooterTemplate>
                </OmniMultiSelect>
            </ChildContent>
        </OmniFormField>
    </OmniStack>
</EditForm>
