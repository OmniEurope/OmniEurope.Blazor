@* The grid at full stretch: selection, grouping, editing, frozen columns and the two filter
   controls the column header can host. The row of selectors above it drives the display settings
   live, so every value the parameters accept can be seen rather than merely described. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniRow Gap="OmniSpacing.Medium" Wrap="true" Align="OmniAlignment.End">
        <OmniFormField For="grid-lines">
            <LabelContent>@Text["DemoGridAdvancedLines"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridLines" Id="grid-lines" Options="LineOptions" @bind-Value="Lines" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-density">
            <LabelContent>@Text["DemoGridAdvancedDensity"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDensity" Id="grid-density" Options="DensityOptions" @bind-Value="Density" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-pager">
            <LabelContent>@Text["DemoGridAdvancedPager"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridPosition" Id="grid-pager" Options="PagerOptions" @bind-Value="Pager" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-selection">
            <LabelContent>@Text["DemoGridAdvancedSelection"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridSelectionMode" Id="grid-selection" Options="SelectionOptions" @bind-Value="Mode" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-filter">
            <LabelContent>@Text["DemoGridAdvancedFilters"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridFilterMode" Id="grid-filter" Options="FilterOptions" @bind-Value="Filters" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-edit">
            <LabelContent>@Text["DemoGridAdvancedEdit"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridRowMode" Id="grid-edit" Options="EditOptions" @bind-Value="Edit" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-expand">
            <LabelContent>@Text["DemoGridAdvancedExpand"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridRowMode" Id="grid-expand" Options="ExpandOptions" @bind-Value="Expand" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-footer">
            <LabelContent>@Text["DemoGridAdvancedFooter"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridPosition" Id="grid-footer" Options="FooterOptions" @bind-Value="Footer" />
            </ChildContent>
        </OmniFormField>
    </OmniRow>

<OmniDataGrid TItem="GridRow"
              Items="Rows"
              Caption="@Text["DemoGridAdvancedCaption"]"
              HeaderWrap="OmniDataGridHeaderWrap.Wrap"
              AllowSorting="true"
              Filterable="true"
              AllowGrouping="true"
              AllowColumnResize="true"
              AllowRowSelectOnRowClick="true"
              ScrollMode="OmniDataGridScrollMode.Paged"
              AllGroupsExpanded="true"
              AlwaysShowPager="true"
              PageSize="4"
              SelectionMode="Mode"
              EditMode="Edit"
              ExpandMode="Expand"
              FooterPosition="Footer"
              FilterMode="Filters"
              PagerPosition="Pager"
              Density="Density"
              Value="Selection"
              ValueChanged="@(value => Selection = value)"
              OnCellDoubleClick="ReadCell"
              HighlightColumnOnHover="true"
              GridLines="Lines">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Frozen="true" HighlightOnHover="false" FilterOperators="ReferenceOperators" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]"
                            FilterType="OmniDataGridColumnFilterType.Combo" FilterSearchable="true">
            <FilterTemplate>
                @* The same control the column would raise on its own, placed by hand to show that a
                   host can take the filter over without losing what the grid provides. *@
                <OmniDataGridFilterCombo Value="@context.Value"
                                         ValueChanged="@(value => context.ValueChanged(value))"
                                         Suggestions="@context.Suggestions"
                                         Placeholder="@context.Placeholder"
                                         MaxSuggestions="6" />
            </FilterTemplate>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoGridColumnCountry"]" Groupable="true"
                            FilterType="OmniDataGridColumnFilterType.MultiSelect"
                            FilterValues="CountryValues">
            <FilterTemplate>
                <OmniDataGridFilterMultiSelect Value="@context.Value"
                                               ValueChanged="@(value => context.ValueChanged(value))"
                                               Suggestions="@context.Suggestions"
                                               Placeholder="@context.Placeholder"
                                               Filterable="true"
                                               MaxSuggestions="8"
                                               Presentation="@(context.InPopover ? OmniMultiSelectPresentation.List : OmniMultiSelectPresentation.Compact)" />
            </FilterTemplate>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="GridRow" Property="Filed" Title="@Text["GridFiledColumn"]" FormatString="{0:g}"
                            FilterType="OmniDataGridColumnFilterType.DateRange">
            <FilterTemplate>
                @* A day alone covers the whole day; IncludesTime would pick the hours too. *@
                <OmniDataGridFilterDateRange Value="@context.Value"
                                             ValueChanged="@(value => context.ValueChanged(value))" />
            </FilterTemplate>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="GridRow" Property="Amount" Title="@Text["DemoGridColumnAmount"]" FormatString="{0:C0}" FilterType="OmniDataGridColumnFilterType.Number"
                            TextAlign="OmniDataGridTextAlign.End">
            <FooterContent>@Text["DemoGridAdvancedTotal", Rows.Sum(row => row.Amount)]</FooterContent>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

<p>@Text["DemoGridAdvancedRetained", Selection.Count == 0 ? Text["DemoGridAdvancedRetainedNone"].Value : string.Join(", ", Selection.Select(row => row.Reference))]</p>
<p role="status">@(CellRead ?? Text["DemoGridAdvancedCellHint"].Value)</p>
</OmniStack>
