@* The grid in its everyday form, with one column of each filter shape and each text alignment. The
   columns say nothing about their filter and follow the grid, which filters by default; Amount takes
   itself out with Filterable="false". Its footer bar, inside the table's frame, carries the export
   buttons at its end (FooterBarExport), each with its format written beside the icon
   (ShowExportButtonText): each writes every row the filters select and not the page on
   screen. Every format is on by default; Markdown, CSV and Excel come from the package, while PDF only gets
   a button in a host that registers an IOmniTableExportRenderer, which this static site does not. *@
<OmniDataGrid TItem="GridRow"
              Items="Rows"
              ShowFooterBar="true"
              FooterBarExport="OmniDataGridBarExport.End"
              ShowExportButtonText="true"
              ExportFileName="@Text["DemoGridExportFileName"]"
              Caption="@Text["DemoGridOpenCases"]"
              AllowSorting="true"
              ScrollMode="OmniDataGridScrollMode.Paged"
              PageSize="5"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            TextAlign="OmniAlignment.Start" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            SortOrder="OmniDataGridSortOrder.Ascending" />
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoGridColumnCountry"]"
                            FilterType="OmniDataGridColumnFilterType.Select"
                            TextAlign="OmniAlignment.Center" />
        <OmniDataGridColumn TItem="GridRow" Property="Amount" Filterable="false" Title="@Text["DemoGridColumnAmount"]" FormatString="{0:C0}"
                            TextAlign="OmniAlignment.End"
                            SortOrder="OmniDataGridSortOrder.Descending" />
    </Columns>
</OmniDataGrid>

@* Le dessin de la maquette : un cadre habillé comme une carte, un en-tête fin et collant, la durée
   (un nombre) alignée à la fin en chiffres de même chasse sans rien demander, le statut en pastille
   compacte (classe omni-status), la ligne choisie teintée et en gras, la colonne triée teintée plus
   légèrement (HighlightActiveColumn), des séparateurs de lignes sans alternance (AllowAlternatingRows="false" : les lignes alternent par défaut), et toutes les lignes sans pagination (ScrollMode All)
   sous un plafond de hauteur. Filterable="false" sur la grille : aucune colonne ne montre de filtre,
   comme les grilles qui suivent. *@
<OmniDataGrid TItem="RunRow" Id="demo-grid-runs"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              Items="Runs"
              ScrollMode="OmniDataGridScrollMode.All"
              Caption="@Text["DemoGridRecentRuns"]"
              AllowSorting="true"
              Filterable="false"
              AllowAlternatingRows="false"
              HighlightActiveColumn="true"
              MaxHeight="17rem"
              SelectionMode="OmniDataGridSelectionMode.Single"
              KeyOf="run => run.Run"
              @bind-Value="SelectedRuns">
    <Columns>
        <OmniDataGridColumn TItem="RunRow" Property="Run" Title="@Text["RunsRun"]" />
        <OmniDataGridColumn TItem="RunRow" Property="Pipeline" Title="@Text["RunsPipeline"]" SortOrder="OmniDataGridSortOrder.Ascending" />
        <OmniDataGridColumn TItem="RunRow" Property="Seconds" Title="@Text["RunsSeconds"]" />
        <OmniDataGridColumn TItem="RunRow" Property="Status" Title="@Text["RunsStatus"]">
            <Template Context="run"><span class="@($"omni-status omni-status--{run.Tone}")">@run.Status</span></Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@* Une valeur longue dans une colonne étroite : la cellule de texte tient sur une ligne et finit par
   des points de suspension au lieu de déborder sur la colonne voisine ; la cellule à gabarit (le
   badge du pays) n'est pas rognée. *@
<OmniDataGrid TItem="GridRow" Id="demo-grid-narrow"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              Items="NarrowRows"
              Caption="@Text["DemoGridNarrowCaption"]"
              Filterable="false"
              ScrollMode="OmniDataGridScrollMode.All">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Width="7rem" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Width="11rem" />
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoGridColumnCountry"]">
            <Template Context="row"><OmniBadge Tone="OmniTone.Info">@row.Country</OmniBadge></Template>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@* Un titre n'est jamais coupé en HeaderWrap.Wrap (le défaut), même sous une largeur déclarée : chaque
   colonne déclare 4rem, moins que son titre d'un seul mot avec ses icônes de tri et de filtre, et ne
   descend jamais sous ce mot (omni-grid.js). La largeur déclarée reste la largeur préférée : un titre
   plus court qu'elle la laisse telle quelle. Seul HeaderWrap="Truncate" coupe un titre. *@
<OmniDataGrid TItem="GridRow" Id="demo-grid-title-floor"
              Items="FewRows"
              Caption="@Text["DemoGridTitleFloorCaption"]"
              ScrollMode="OmniDataGridScrollMode.All">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Width="4rem" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Width="4rem" />
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoGridColumnCountry"]" Width="4rem" />
        <OmniDataGridColumn TItem="GridRow" Property="Amount" Title="@Text["DemoGridColumnAmount"]" FormatString="{0:C0}" Width="4rem" />
    </Columns>
</OmniDataGrid>

@* Virtualisée avec MaxHeight : la grille prend la hauteur de ses lignes jusqu'au plafond, puis
   défile en ne rendant que sa fenêtre. Trois lignes restent courtes, dix mille défilent. La seconde
   ajuste Demandeur à son contenu au double clic sur son bord (AllowColumnAutoFit), en mesurant aussi
   le demandeur très long du dossier D-07777, loin hors de la fenêtre ; Référence s'en retire
   (AutoFit="false"). *@
<OmniDataGrid TItem="GridRow" Id="demo-grid-capped-short"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              Items="FewRows"
              Caption="@Text["DemoGridShortCaption"]"
              Filterable="false"
              ScrollMode="OmniDataGridScrollMode.Virtual"
              MaxHeight="18rem">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" />
    </Columns>
</OmniDataGrid>

<OmniDataGrid TItem="GridRow" Id="demo-grid-capped-long"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              Items="ManyRows"
              Caption="@Text["DemoGridLongCaption"]"
              Filterable="false"
              AllowColumnAutoFit="true"
              ScrollMode="OmniDataGridScrollMode.Virtual"
              MaxHeight="18rem">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" AutoFit="false" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" />
    </Columns>
</OmniDataGrid>

@* Sans largeur déclarée, une colonne prend celle de sa valeur la plus longue, titre compris : le nom du
   paquet s'affiche en entier. Truncate="true" rend la colonne de description à la largeur que la
   mise en page lui laisse : sa valeur finit par des points de suspension et reste lisible en entier dans
   l'infobulle. Une largeur déclarée (Width) ou choisie au glisser (AllowColumnResize) l'emporte toujours.
   Le cadre étroit (22rem) donne à chaque colonne moins que le nom le plus long. *@
<div class="demo-grid-fit-box">
    <OmniDataGrid TItem="PackageRow" Id="demo-grid-fit"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  Items="Packages"
                  Caption="@Text["DemoGridFitCaption"]"
                  Filterable="false"
                  AllowColumnResize="true"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="PackageRow" Property="Name" Title="@Text["DemoGridFitColumnPackage"]" />
            <OmniDataGridColumn TItem="PackageRow" Property="Description" Title="@Text["DemoGridFitColumnDescription"]" Truncate="true" />
        </Columns>
    </OmniDataGrid>
</div>

@* Colonnes à la largeur de leur contenu (ColumnSizing Content) : chaque colonne prend la largeur de sa
   valeur la plus large, son en-tête sur une ligne avec ses icônes de tri et de filtre compris, mesurée sur
   toutes les lignes chargées. Les largeurs déclarées (Width) sont ignorées : le contenu décide, et MinWidth
   reste un plancher. La place restante va aux colonnes marquées Grow (le nom et le projet) ; un cadre plus
   étroit resserre les colonnes jusqu'à leur contenu, puis la grille défile de côté sans rien couper. *@
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="SiteRow" Id="demo-grid-sizing"
                  Items="Sites"
                  Caption="@Text["DemoGridSizingCaption"]"
                  ColumnSizing="OmniDataGridColumnSizing.Content"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="SiteRow" Property="Name" Title="@Text["DemoGridSizingName"]" MinWidth="9rem" Grow="true" />
            <OmniDataGridColumn TItem="SiteRow" Property="Online" Title="@Text["DemoGridSizingStatus"]" Width="9rem">
                <Template Context="site">
                    <OmniBadge Tone="@(site.Online ? OmniTone.Success : OmniTone.Neutral)">@Text[site.Online ? "DemoGridSizingOnline" : "DemoGridSizingOffline"]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SiteRow" Property="Visitors" Title="@Text["DemoGridSizingVisitors"]" Width="8rem" />
            <OmniDataGridColumn TItem="SiteRow" Property="Project" Title="@Text["DemoGridSizingProject"]" MinWidth="8rem" Grow="true" />
            <OmniDataGridColumn TItem="SiteRow" Property="Since" Title="@Text["DemoGridSizingSince"]" Width="10rem" FormatString="{0:d}" />
        </Columns>
    </OmniDataGrid>
</div>

@* Les mêmes colonnes chargées par la grille elle-même (Load), un instant après son premier rendu : la table
   reste masquée pendant le chargement et apparaît directement aux largeurs des lignes reçues. *@
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="SiteRow" Id="demo-grid-sizing-remote"
                  Load="LoadSitesAsync"
                  Caption="@Text["DemoGridSizingCaption"]"
                  ColumnSizing="OmniDataGridColumnSizing.Content"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="SiteRow" Property="Name" Title="@Text["DemoGridSizingName"]" MinWidth="9rem" Grow="true" />
            <OmniDataGridColumn TItem="SiteRow" Property="Online" Title="@Text["DemoGridSizingStatus"]">
                <Template Context="site">
                    <OmniBadge Tone="@(site.Online ? OmniTone.Success : OmniTone.Neutral)">@Text[site.Online ? "DemoGridSizingOnline" : "DemoGridSizingOffline"]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SiteRow" Property="Visitors" Title="@Text["DemoGridSizingVisitors"]" />
            <OmniDataGridColumn TItem="SiteRow" Property="Project" Title="@Text["DemoGridSizingProject"]" MinWidth="8rem" Grow="true" />
            <OmniDataGridColumn TItem="SiteRow" Property="Since" Title="@Text["DemoGridSizingSince"]" FormatString="{0:d}" />
        </Columns>
    </OmniDataGrid>
</div>

@* Les mêmes colonnes en mode par défaut (Declared) : chaque Width est la largeur de la colonne, quel que soit
   son contenu, et un titre qui ne tient pas passe à la ligne. *@
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="SiteRow" Id="demo-grid-sizing-declared"
                  Items="Sites"
                  Caption="@Text["DemoGridSizingDeclaredCaption"]"
                  ColumnSizing="OmniDataGridColumnSizing.Declared"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="SiteRow" Property="Name" Title="@Text["DemoGridSizingName"]" MinWidth="9rem" />
            <OmniDataGridColumn TItem="SiteRow" Property="Online" Title="@Text["DemoGridSizingStatus"]" Width="9rem">
                <Template Context="site">
                    <OmniBadge Tone="@(site.Online ? OmniTone.Success : OmniTone.Neutral)">@Text[site.Online ? "DemoGridSizingOnline" : "DemoGridSizingOffline"]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SiteRow" Property="Visitors" Title="@Text["DemoGridSizingVisitors"]" Width="8rem" />
            <OmniDataGridColumn TItem="SiteRow" Property="Project" Title="@Text["DemoGridSizingProject"]" MinWidth="8rem" />
            <OmniDataGridColumn TItem="SiteRow" Property="Since" Title="@Text["DemoGridSizingSince"]" Width="10rem" FormatString="{0:d}" />
        </Columns>
    </OmniDataGrid>
</div>

@* Sans colonne Grow, la place restante se partage à parts égales entre toutes les colonnes, chacune gardant
   au moins la largeur de son contenu. *@
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="SiteRow" Id="demo-grid-sizing-shared"
                  Items="Sites"
                  Caption="@Text["DemoGridSizingCaption"]"
                  ColumnSizing="OmniDataGridColumnSizing.Content"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="SiteRow" Property="Name" Title="@Text["DemoGridSizingName"]" />
            <OmniDataGridColumn TItem="SiteRow" Property="Visitors" Title="@Text["DemoGridSizingVisitors"]" />
            <OmniDataGridColumn TItem="SiteRow" Property="Project" Title="@Text["DemoGridSizingProject"]" />
        </Columns>
    </OmniDataGrid>
</div>

@* Toutes les colonnes ont un modèle (Template) et les lignes n'arrivent qu'après le premier rendu : les
   colonnes, d'abord à la largeur de leurs en-têtes, prennent celle des cellules qui arrivent. *@
<OmniButton Id="demo-grid-sizing-templates-load" Variant="OmniButtonVariant.Secondary" OnClick="LoadTemplatedSitesAsync">
    <Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon><ChildContent><span>@Text["DemoFeedbackSimulateLoad"]</span></ChildContent>
</OmniButton>
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="SiteRow" Id="demo-grid-sizing-templates"
                  Items="TemplatedSites"
                  Busy="TemplatedSitesLoading"
                  AllowColumnResize="true"
                  AllowColumnAutoFit="true"
                  Caption="@Text["DemoGridSizingCaption"]"
                  ColumnSizing="OmniDataGridColumnSizing.Content"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="SiteRow" Property="Name" Title="@Text["DemoGridSizingName"]" Frozen="true">
                <Template Context="site"><OmniLink Href="documentation">@site.Name</OmniLink></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SiteRow" Property="Project" Title="@Text["DemoGridSizingProject"]">
                <Template Context="site"><span>@site.Project</span></Template>
            </OmniDataGridColumn>
            <OmniDataGridColumn TItem="SiteRow" Property="Online" Title="@Text["DemoGridSizingStatus"]">
                <Template Context="site">
                    <OmniBadge Tone="@(site.Online ? OmniTone.Success : OmniTone.Neutral)">@Text[site.Online ? "DemoGridSizingOnline" : "DemoGridSizingOffline"]</OmniBadge>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </OmniDataGrid>
</div>

@* Une colonne de texte long qui demande le retour à la ligne (Wrap) : elle n'a pas de largeur propre, elle
   prend la place que les autres lui laissent et passe à la ligne au lieu d'être coupée. *@
<div class="demo-grid-sizing-box">
    <OmniDataGrid TItem="PackageRow" Id="demo-grid-sizing-wrap"
                  Items="Packages"
                  Caption="@Text["DemoGridSizingCaption"]"
                  Filterable="false"
                  ColumnSizing="OmniDataGridColumnSizing.Content"
                  ScrollMode="OmniDataGridScrollMode.All">
        <Columns>
            <OmniDataGridColumn TItem="PackageRow" Property="Name" Title="@Text["DemoGridFitColumnPackage"]" />
            <OmniDataGridColumn TItem="PackageRow" Property="Description" Title="@Text["DemoGridFitColumnDescription"]" Wrap="true" MinWidth="12rem" />
        </Columns>
    </OmniDataGrid>
</div>

@* Un compte de résultat en arbre (ChildrenOf) : les catégories, toujours ouvertes (CanToggleTreeRow),
   portent leurs sous-totaux, qui s'ouvrent d'un clic sur la ligne (ToggleTreeOnRowClick) ou par leur
   chevron, Droite et Gauche au clavier ; les deux boutons ouvrent et ferment tout. Le tri range les
   frères sous leur parent ; la colonne survolée se teinte (HighlightColumnOnHover). Les trois boutons sont
   le contenu de la barre d'en-tête (HeaderBarContent), qui ne porte pas d'export (HeaderBarExport None) ; le
   troisième écrit le tableau construit par la page, toutes lignes ouvertes, en classeur Excel
   (OmniTableExportDownloader). La barre de pied exporte en Markdown seul, à son début (ExportCsv,
   ExportExcel et ExportPdf à false). *@
<OmniDataGrid @ref="StatementGrid" TItem="StatementLine" Id="demo-grid-tree"
              ScrollMode="OmniDataGridScrollMode.Paged"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              Items="Statement"
              Caption="@Text["DemoGridTreeCaption"]"
              KeyOf="line => line.Id"
              ChildrenOf="line => line.Children"
              CanToggleTreeRow="line => line.Level > 0"
              ToggleTreeOnRowClick="true"
              HighlightColumnOnHover="true"
              Filterable="false"
              ShowHeaderBar="true"
              HeaderBarExport="OmniDataGridBarExport.None"
              ShowFooterBar="true"
              FooterBarExport="OmniDataGridBarExport.Start"
              ExportCsv="false"
              ExportExcel="false"
              ExportPdf="false"
              ExportFileName="@Text["DemoGridExportFileName"]">
    <HeaderBarContent>
        <OmniRow Gap="OmniSpacing.Small">
            <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="ExpandStatementAsync">
                <Icon><OmniIcon Name="OmniIconName.CornersOut" /></Icon><ChildContent><span>@Text["DemoGridTreeExpandAll"]</span></ChildContent>
            </OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="CollapseStatementAsync">
                <Icon><OmniIcon Name="OmniIconName.CornersIn" /></Icon><ChildContent><span>@Text["DemoGridTreeCollapseAll"]</span></ChildContent>
            </OmniButton>
            <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="ExportStatementAsync">
                <Icon><OmniIcon Name="OmniIconName.FileXls" /></Icon><ChildContent><span>@Text["DemoGridTreeExport"]</span></ChildContent>
            </OmniButton>
        </OmniRow>
    </HeaderBarContent>
    <Columns>
        <OmniDataGridColumn TItem="StatementLine" Property="Label" Title="@Text["DemoGridTreeColumnItem"]" HighlightOnHover="false" />
        <OmniDataGridColumn TItem="StatementLine" Property="Previous" Title="2025" FormatString="{0:C0}" />
        <OmniDataGridColumn TItem="StatementLine" Property="Current" Title="2026" FormatString="{0:C0}" />
        <OmniDataGridColumn TItem="StatementLine" Property="Variation" Title="@Text["DemoGridTreeVariation"]" FormatString="{0:P1}" />
    </Columns>
</OmniDataGrid>

@* Une grille modifiable (EditTemplate) : le crayon ou un double clic (OnRowDoubleClick vers EditRowAsync)
   met la ligne en édition, et le champ de la cellule double-cliquée, sinon le premier, prend le focus,
   son texte sélectionné pour taper directement. Entrée enregistre la ligne et Échap l'annule ; Entrée ne
   clique pas la ligne. Ses lignes gardent en édition la hauteur de lecture. *@
<p class="demo-hint">@Text["DemoGridEditHint"]</p>
<OmniDataGrid TItem="EditableFile" Id="demo-grid-edit" @ref="EditGrid"
              ScrollMode="OmniDataGridScrollMode.Paged"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate"
              EditTrigger="OmniDataGridEditTrigger.Action"
              Items="EditableFiles"
              Caption="@Text["DemoGridEditCaption"]"
              KeyOf="@(file => file.Reference)"
              OnRowEdit="KeepOriginal" OnRowEditCancel="RestoreOriginal"
              OnRowDoubleClick="@(args => EditGrid!.EditRowAsync(args.Item))">
    <Columns>
        <OmniDataGridColumn TItem="EditableFile" Property="Reference" Title="@Text["DemoGridColumnReference"]" Filterable="false" />
        <OmniDataGridColumn TItem="EditableFile" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Filterable="false">
            <EditTemplate Context="file"><OmniTextBox @bind-Value="file.Applicant" aria-label="@Text["DemoGridColumnApplicant"]" /></EditTemplate>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="EditableFile" Property="Country" Title="@Text["DemoGridColumnCountry"]" Filterable="false">
            <EditTemplate Context="file"><OmniTextBox @bind-Value="file.Country" aria-label="@Text["DemoGridColumnCountry"]" /></EditTemplate>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@* EditTrigger="Cell" : un simple clic n'importe où dans une cellule qui a un EditTemplate (Demandeur ou Pays,
   vide comprise) met la ligne en édition et donne le focus au champ de cette cellule, son texte sélectionné.
   Le bouton Détails de la cellule Pays garde son clic. Tab atteint chaque cellule par son bouton, Entrée
   ou Espace la modifie ; Référence, sans EditTemplate, n'ouvre rien. Entrée enregistre et Échap annule par
   la colonne d'édition, qui reste. *@
<p class="demo-hint">@Text["DemoGridEditCellHint"]</p>
<p id="demo-grid-edit-cell-clicks" class="demo-hint">@Text["DemoAccordionClicks", CellEditDetails]</p>
<OmniDataGrid TItem="EditableFile" Id="demo-grid-edit-cell"
              EditTrigger="OmniDataGridEditTrigger.Cell"
              ScrollMode="OmniDataGridScrollMode.All"
              Items="CellEditFiles"
              Caption="@Text["DemoGridEditCellCaption"]"
              KeyOf="@(file => file.Reference)"
              OnRowEdit="KeepOriginal" OnRowEditCancel="RestoreOriginal">
    <Columns>
        <OmniDataGridColumn TItem="EditableFile" Property="Reference" Title="@Text["DemoGridColumnReference"]" Filterable="false" />
        <OmniDataGridColumn TItem="EditableFile" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Filterable="false">
            <EditTemplate Context="file"><OmniTextBox @bind-Value="file.Applicant" aria-label="@Text["DemoGridColumnApplicant"]" /></EditTemplate>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="EditableFile" Property="Country" Title="@Text["DemoGridColumnCountry"]" Filterable="false">
            <Template Context="file">
                <span>@file.Country</span>
                <OmniButton Class="demo-grid-edit-cell-details" Variant="OmniButtonVariant.Ghost" Size="OmniControlSize.Small" Label="@Text["DemoAccordionDetails"]" OnClick="CountCellEditDetails"><Icon><OmniIcon Name="OmniIconName.Info" /></Icon></OmniButton>
            </Template>
            <EditTemplate Context="file"><OmniTextBox @bind-Value="file.Country" aria-label="@Text["DemoGridColumnCountry"]" /></EditTemplate>
        </OmniDataGridColumn>
    </Columns>
</OmniDataGrid>

@* Une grille voilée par LoadingContent dont les premières lignes portent une image (un fichier du site,
   la politique de sécurité n'en admet pas d'autre) : elle reste voilée tant que ces images ne sont pas
   arrivées, au plus deux secondes, puis s'affiche. La sonde des scripts retarde cette image pour le vérifier. *@
<OmniDataGrid TItem="GridRow" Id="demo-grid-pictures"
              Items="PictureRows"
              Caption="@Text["DemoGridFillCaption"]">
    <LoadingContent>@Text["DemoDataListLoading"]</LoadingContent>
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Filterable="false" />
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoMediaIconImage"]" Filterable="false">
            <Template Context="row"><OmniImage Source="showcase-sample.svg?grid-preparation" Alt="@Text["DemoMediaIconImage"]" Width="48" Height="32" Fit="OmniImageFit.Cover" Loading="OmniImageLoading.Eager" /></Template>
        </OmniDataGridColumn>
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Filterable="false" />
    </Columns>
</OmniDataGrid>

@* Une grille qui occupe ce qui reste de son cadre (FillAvailableHeight, plancher MinHeight) : virtualisée,
   groupée par pays, chaque ligne à la même hauteur (FixedRowHeight), voilée par LoadingContent jusqu'à
   son premier rendu prêt. La molette tournée n'importe où dans le cadre fait défiler ses lignes
   (WheelScrollScope) ; un pays choisi dans le filtre, ou un demandeur pris dans les suggestions, ferme le
   menu (HideFilterMenuOnSelect) ; le double clic sur le bord de Montant ajuste la colonne au montant le
   plus large des deux mille dossiers, rendus ou non. *@
<div id="demo-grid-scope" class="demo-grid-scope">
    <p class="demo-hint">@Text["DemoGridScopeHint"]</p>
    <OmniDataGrid TItem="GridRow" Id="demo-grid-fill"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  Items="FillRows"
                  Caption="@Text["DemoGridFillCaption"]"
                  ScrollMode="OmniDataGridScrollMode.Virtual"
                  AllowGrouping="true"
                  Groups="FillGrouping"
                  GroupsChanged="@(value => FillGrouping = value)"
                  AllGroupsExpanded="true"
                  FixedRowHeight="true"
                  EstimatedRowHeight="36"
                  FillAvailableHeight="true"
                  MinHeight="8rem"
                  WheelScrollScope="#demo-grid-scope"
                  HideFilterMenuOnSelect="true"
                  AllowColumnAutoFit="true">
        <LoadingContent>@Text["DemoDataListLoading"]</LoadingContent>
        <Columns>
            <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Filterable="false" AutoFit="false" />
            <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" FilterType="OmniDataGridColumnFilterType.Combo" />
            <OmniDataGridColumn TItem="GridRow" Property="Country" Title="@Text["DemoGridColumnCountry"]" FilterType="OmniDataGridColumnFilterType.Select" Groupable="true" />
            <OmniDataGridColumn TItem="GridRow" Property="Amount" Title="@Text["DemoGridColumnAmount"]" FormatString="{0:C0}" Filterable="false"
                                TextAlign="OmniAlignment.End" />
        </Columns>
    </OmniDataGrid>
</div>

@* Un aperçu de hauteur fixe qui défile lui-même, des réglages au-dessus, une grille en dessous qui
   prend le reste (FillAvailableHeight, plancher MinHeight) avec sa barre d'export. Quand les réglages
   dépassent la partie visible de l'aperçu, il ne reste rien à la grille : elle garde alors son plancher
   et l'aperçu défile jusqu'à elle. « Pagination : Aucune » la fait défiler virtuellement, les autres
   valeurs la paginent. *@
<div id="demo-grid-fill-box" class="demo-grid-fill-box">
    <OmniRow Gap="OmniSpacing.Medium" Wrap="true" Align="OmniAlignment.End">
        <OmniFormField For="grid-fill-box-pager">
            <LabelContent>@Text["DemoGridAdvancedPager"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="string" Id="grid-fill-box-pager" Options="FillBoxPagerOptions" @bind-Value="FillBoxPager" />
            </ChildContent>
        </OmniFormField>
        <OmniFormField For="grid-fill-box-lines">
            <LabelContent>@Text["DemoGridAdvancedLines"]</LabelContent>
            <ChildContent>
                <OmniDropDown TValue="OmniDataGridLines" Id="grid-fill-box-lines" Options="FillBoxLineOptions" @bind-Value="FillBoxLines" />
            </ChildContent>
        </OmniFormField>
    </OmniRow>
    <OmniDataGrid TItem="GridRow" Id="demo-grid-fill-box-grid"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  Items="FillRows"
                  Caption="@Text["DemoGridFillCaption"]"
                  ScrollMode="@(FillBoxPaged ? OmniDataGridScrollMode.Paged : OmniDataGridScrollMode.Virtual)"
                  PagerPlacement="FillBoxPagerPlacement"
                  PageSize="20"
                  GridLines="FillBoxLines"
                  FillAvailableHeight="true"
                  MinHeight="12rem"
                  ShowHeaderBar="true"
                  ExportFileName="@Text["DemoGridExportFileName"]">
        <Columns>
            <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="@Text["DemoGridColumnReference"]" Filterable="false" />
            <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="@Text["DemoGridColumnApplicant"]" Filterable="false" />
            <OmniDataGridColumn TItem="GridRow" Property="Amount" Title="@Text["DemoGridColumnAmount"]" FormatString="{0:C0}" Filterable="false"
                                TextAlign="OmniAlignment.End" />
        </Columns>
    </OmniDataGrid>
</div>
