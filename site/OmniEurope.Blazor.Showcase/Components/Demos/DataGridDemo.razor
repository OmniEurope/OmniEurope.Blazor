@* The grid in its everyday form, with one column of each filter shape and each text alignment. *@
<OmniDataGrid TItem="GridRow"
              Items="Rows"
              Caption="Dossiers ouverts"
              AllowSorting="true"
              AllowFiltering="true"
              AllowPaging="true"
              AllowAlternatingRows="true"
              PageSize="5"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="Référence"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            TextAlign="OmniDataGridTextAlign.Start" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="Demandeur"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            SortOrder="OmniDataGridSortOrder.Ascending" />
        <OmniDataGridColumn TItem="GridRow" Property="Country" Title="Pays"
                            FilterType="OmniDataGridColumnFilterType.Select"
                            TextAlign="OmniDataGridTextAlign.Center" />
        <OmniDataGridColumn TItem="GridRow" Property="Amount" Title="Montant" FormatString="{0:C0}"
                            TextAlign="OmniDataGridTextAlign.End"
                            SortOrder="OmniDataGridSortOrder.Descending" />
    </Columns>
</OmniDataGrid>

@* Virtualisée avec MaxHeight : la grille prend la hauteur de ses lignes jusqu'au plafond, puis
   défile en ne rendant que sa fenêtre. Trois lignes restent courtes, dix mille défilent. *@
<OmniDataGrid TItem="GridRow" Id="demo-grid-capped-short"
              Items="FewRows"
              Caption="Trois dossiers, hauteur de contenu"
              AllowVirtualization="true"
              MaxHeight="18rem">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="Référence" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="Demandeur" />
    </Columns>
</OmniDataGrid>

<OmniDataGrid TItem="GridRow" Id="demo-grid-capped-long"
              Items="ManyRows"
              Caption="Dix mille dossiers, plafond de 18rem"
              AllowVirtualization="true"
              MaxHeight="18rem">
    <Columns>
        <OmniDataGridColumn TItem="GridRow" Property="Reference" Title="Référence" />
        <OmniDataGridColumn TItem="GridRow" Property="Applicant" Title="Demandeur" />
    </Columns>
</OmniDataGrid>
