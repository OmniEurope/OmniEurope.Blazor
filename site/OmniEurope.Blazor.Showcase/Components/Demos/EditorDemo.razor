@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="this">
    <OmniStack Gap="OmniSpacing.Large">
        <OmniHtmlEditor Id="editor-body"
                        @bind-Value="Body"
                        Label="Corps du courrier"
                        Rows="8"
                        ShowPreview="true"
                        EnableBold="true"
                        EnableItalic="true"
                        EnableIndent="true"
                        EnableOutdent="true"
                        EnableSubscript="true"
                        EnableSuperscript="true"
                        Commands="Commands"
                        CustomTools="Tools" />

        <OmniHtmlEditor Id="editor-source"
                        @bind-Value="Body"
                        Label="Source du courrier"
                        Mode="OmniHtmlEditorMode.Source"
                        Rows="6"
                        ShowPreview="true" />

        <OmniDocumentEditor Id="editor-document"
                            @bind-Value="Report"
                            Label="Rapport"
                            FileName="rapport"
                            Rows="12" />

        @* The gallery runs under the strict policy, which Monaco cannot: the code editor is shown
           with its plain text engine, the one it falls back to wherever Monaco is not served. *@
        <OmniCodeEditor Id="editor-code"
                        @bind-Value="Settings"
                        Label="Réglages JSON"
                        Language="json"
                        Engine="OmniCodeEditorEngine.PlainText"
                        Height="10rem" />

        @* Les icônes des barres d'outils des éditeurs, telles que le catalogue les expose. *@
        <OmniRow Gap="OmniSpacing.Small">
            <OmniIcon Name="OmniIconName.TextB" AriaLabel="Gras" />
            <OmniIcon Name="OmniIconName.TextItalic" AriaLabel="Italique" />
            <OmniIcon Name="OmniIconName.TextUnderline" AriaLabel="Souligné" />
            <OmniIcon Name="OmniIconName.TextStrikethrough" AriaLabel="Barré" />
            <OmniIcon Name="OmniIconName.TextSubscript" AriaLabel="Indice" />
            <OmniIcon Name="OmniIconName.TextSuperscript" AriaLabel="Exposant" />
            <OmniIcon Name="OmniIconName.ListBullets" AriaLabel="Liste à puces" />
            <OmniIcon Name="OmniIconName.TextIndent" AriaLabel="Augmenter le retrait" />
            <OmniIcon Name="OmniIconName.TextOutdent" AriaLabel="Réduire le retrait" />
            <OmniIcon Name="OmniIconName.Quotes" AriaLabel="Citation" />
            <OmniIcon Name="OmniIconName.Code" AriaLabel="Code en ligne" />
            <OmniIcon Name="OmniIconName.CodeBlock" AriaLabel="Bloc de code" />
            <OmniIcon Name="OmniIconName.Link" AriaLabel="Lien" />
            <OmniIcon Name="OmniIconName.LinkBreak" AriaLabel="Retirer le lien" />
            <OmniIcon Name="OmniIconName.TextAlignLeft" AriaLabel="Aligner à gauche" />
            <OmniIcon Name="OmniIconName.TextAlignCenter" AriaLabel="Centrer" />
            <OmniIcon Name="OmniIconName.TextAlignRight" AriaLabel="Aligner à droite" />
            <OmniIcon Name="OmniIconName.TextAlignJustify" AriaLabel="Justifier" />
            <OmniIcon Name="OmniIconName.ArrowUUpLeft" AriaLabel="Annuler" />
            <OmniIcon Name="OmniIconName.ArrowUUpRight" AriaLabel="Rétablir" />
            <OmniIcon Name="OmniIconName.Eraser" AriaLabel="Effacer la mise en forme" />
            <OmniIcon Name="OmniIconName.FileHtml" AriaLabel="Source HTML" />
            <OmniIcon Name="OmniIconName.Table" AriaLabel="Tableau" />
        </OmniRow>

        @* Un seul fichier : le champ en lecture seule soudé au bouton Parcourir ; un clic sur l'un ou
           l'autre, ou Entrée, ouvre la fenêtre de sélection. *@
        <OmniFormField For="editor-manifest" Text="Manifeste de déploiement" Description="Un seul fichier, ouvre la fenêtre de sélection du système.">
            <OmniUpload Display="OmniUploadDisplay.Field"
                        InputId="editor-manifest"
                        MaximumFileSize="1048576"
                        @bind-Files="Manifest"
                        Upload="UploadAsync" />
        </OmniFormField>

        @* Liste réduite : les trois pièces les plus récentes, le compte, Afficher tout et Tout retirer. *@
        <OmniUpload Multiple="true"
                    MaximumFiles="6"
                    MaximumFileSize="1048576"
                    AllowedContentTypes="Accepted"
                    InputId="editor-attachments"
                    @bind-Files="Attachments"
                    Upload="UploadAsync"
                    Validate="ValidateAsync"
                    UploadErrorMessage="Le dépôt a échoué."
                    ReducedList="true"
                    Density="OmniDensity.Comfortable" />

        <p>Pièces déposées : @(Uploaded.Count == 0 ? "aucune" : string.Join(", ", Uploaded))</p>
    </OmniStack>
</EditForm>

<OmniStack Gap="OmniSpacing.Medium">
    <OmniCodeBlock Code="dotnet test OmniEurope.Blazor.slnx" Label="Commande de test" Language="shell" />
    <OmniCodeViewer Code="@ViewerCode" Title="Exemple de configuration" Language="json"
                    HighlightedLines="ViewerHighlights" />
    <OmniUnifiedDiff Diff="@ExampleDiff" />
</OmniStack>

<OmniDiffViewer Original="@OriginalConfiguration" Modified="@ChangedConfiguration"
                Engine="OmniCodeEditorEngine.PlainText" Language="json"
                Label="Comparer deux configurations" Height="18rem" />
