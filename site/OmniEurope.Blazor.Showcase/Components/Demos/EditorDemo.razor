@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="this">
    <OmniStack Gap="OmniSpacing.Large">
        <OmniHtmlEditor Id="editor-body"
                        @bind-Value="Body"
                        Label="@Text["DemoEditorBodyLabel"]"
                        Rows="8"
                        ShowPreview="true"
                        Commands="Commands" />

        <OmniHtmlEditor Id="editor-source"
                        @bind-Value="Body"
                        Label="@Text["DemoEditorSourceLabel"]"
                        Mode="OmniHtmlEditorMode.Source"
                        Rows="6"
                        ShowPreview="true" />

        <OmniHtmlEditor Id="editor-annotated"
                        @bind-Value="Annotated"
                        Label="@Text["DemoEditorAnnotatedLabel"]"
                        Rows="6"
                        Extensions="[AnnotationExtension]"
                        Commands="AnnotatedCommands"
                        SelectionChanged="ShowSelection" />
        <p id="editor-annotated-path" aria-live="polite">@Text["DemoEditorPosition", SelectionPath ?? Text["DemoEditorOutsideText"]]</p>

        @* Une extension : ses commandes et raccourci (Ctrl+Maj+N), sa politique, un clic sur une note
           qui la marque relue, un menu contextuel ; la casse, les caractères spéciaux, l'import de
           tableau et l'affichage des blocs sont des commandes intégrées. *@
        <OmniHtmlEditor Id="editor-extended"
                        @bind-Value="Extended"
                        Label="@Text["DemoEditorExtendedLabel"]"
                        Rows="6"
                        Commands="ExtendedCommands"
                        Extensions="[NoteExtension]" />

        <OmniHtmlEditor Id="editor-document"
                        @bind-Value="Report"
                        Label="@Text["DemoEditorReportLabel"]"
                        Sheet="true"
                        ShowStatusBar="true"
                        Commands="OmniHtmlEditorCommands.Document"
                        FileName="@Text["DemoEditorReportFileName"]"
                        Rows="12" />

        @* The gallery runs under the strict policy, which Monaco cannot: the code editor is shown
           with its plain text engine, the one it falls back to wherever Monaco is not served. *@
        <OmniCodeEditor Id="editor-code"
                        @bind-Value="Settings"
                        Label="@Text["DemoEditorCodeLabel"]"
                        Language="json"
                        Engine="OmniCodeEditorEngine.PlainText"
                        Height="10rem" />

        @* Les icônes des barres d'outils des éditeurs, telles que le catalogue les expose. *@
        <OmniRow Gap="OmniSpacing.Small">
            <OmniIcon Name="OmniIconName.TextB" Label="@Text["DemoEditorIconBold"]" />
            <OmniIcon Name="OmniIconName.TextItalic" Label="@Text["DemoEditorIconItalic"]" />
            <OmniIcon Name="OmniIconName.TextUnderline" Label="@Text["DemoEditorIconUnderline"]" />
            <OmniIcon Name="OmniIconName.TextStrikethrough" Label="@Text["DemoEditorIconStrikethrough"]" />
            <OmniIcon Name="OmniIconName.TextSubscript" Label="@Text["DemoEditorIconSubscript"]" />
            <OmniIcon Name="OmniIconName.TextSuperscript" Label="@Text["DemoEditorIconSuperscript"]" />
            <OmniIcon Name="OmniIconName.ListBullets" Label="@Text["DemoEditorIconBulletList"]" />
            <OmniIcon Name="OmniIconName.TextIndent" Label="@Text["DemoEditorIconIndent"]" />
            <OmniIcon Name="OmniIconName.TextOutdent" Label="@Text["DemoEditorIconOutdent"]" />
            <OmniIcon Name="OmniIconName.Quotes" Label="@Text["DemoEditorIconQuote"]" />
            <OmniIcon Name="OmniIconName.Code" Label="@Text["DemoEditorIconInlineCode"]" />
            <OmniIcon Name="OmniIconName.CodeBlock" Label="@Text["DemoEditorIconCodeBlock"]" />
            <OmniIcon Name="OmniIconName.Link" Label="@Text["DemoEditorIconLink"]" />
            <OmniIcon Name="OmniIconName.LinkBreak" Label="@Text["DemoEditorIconUnlink"]" />
            <OmniIcon Name="OmniIconName.TextAlignLeft" Label="@Text["DemoEditorIconAlignLeft"]" />
            <OmniIcon Name="OmniIconName.TextAlignCenter" Label="@Text["DemoEditorIconAlignCenter"]" />
            <OmniIcon Name="OmniIconName.TextAlignRight" Label="@Text["DemoEditorIconAlignRight"]" />
            <OmniIcon Name="OmniIconName.TextAlignJustify" Label="@Text["DemoEditorIconJustify"]" />
            <OmniIcon Name="OmniIconName.ArrowUUpLeft" Label="@Text["DemoEditorIconUndo"]" />
            <OmniIcon Name="OmniIconName.ArrowUUpRight" Label="@Text["DemoEditorIconRedo"]" />
            <OmniIcon Name="OmniIconName.Eraser" Label="@Text["DemoEditorIconClearFormatting"]" />
            <OmniIcon Name="OmniIconName.FileHtml" Label="@Text["DemoEditorIconHtmlSource"]" />
            <OmniIcon Name="OmniIconName.Table" Label="@Text["DemoEditorIconTable"]" />
        </OmniRow>

        @* Un seul fichier : le champ en lecture seule soudé au bouton Parcourir ; un clic sur l'un ou
           l'autre, ou Entrée, ouvre la fenêtre de sélection. *@
        <OmniFormField For="editor-manifest" Label="@Text["DemoEditorManifest"]" Description="@Text["DemoEditorManifestHelp"]">
            <OmniUpload Display="OmniUploadDisplay.Field"
                        Id="editor-manifest"
                        Accept=".json,.yaml,.yml"
                        MaximumFileSize="1048576"
                        @bind-Files="Manifest"
                        Upload="UploadAsync" />
        </OmniFormField>

        @* Liste réduite : les trois pièces les plus récentes, le compte, Afficher tout et Tout retirer. *@
        <OmniUpload Multiple="true"
                    MaximumFiles="6"
                    MaximumFileSize="1048576"
                    AllowedContentTypes="Accepted"
                    Id="editor-attachments"
                    @bind-Files="Attachments"
                    Upload="UploadAsync"
                    UploadErrorMessage="@Text["DemoEditorUploadFailed"]"
                    ReducedList="true" />

        <p>@Text["DemoEditorUploaded", Uploaded.Count == 0 ? Text["DemoEditorNoUpload"] : string.Join(", ", Uploaded)]</p>
    </OmniStack>
</EditForm>

<OmniStack Gap="OmniSpacing.Medium">
    <OmniCodeBlock Code="dotnet test OmniEurope.Blazor.slnx" Title="@Text["DemoEditorTestCommand"]" Language="shell" />
    <OmniCodeViewer Code="@ViewerCode" Title="@Text["DemoEditorConfigurationSample"]" Language="json"
                    HighlightedLines="ViewerHighlights" />
    @* Un extrait garde les numéros de ses lignes dans le fichier : FirstLineNumber. *@
    <OmniCodeViewer Code="@ExcerptCode" Title="@Text["DemoEditorExcerptTitle", 41, 43]" Language="csharp" FirstLineNumber="41"
                    HighlightedLines="ExcerptHighlights" ShowWrapToggle="false" />
    <OmniUnifiedDiff Diff="@ExampleDiff" />
</OmniStack>

<OmniDiffViewer Original="@OriginalConfiguration" Modified="@ChangedConfiguration"
                Engine="OmniCodeEditorEngine.PlainText" Language="json"
                Label="@Text["DemoEditorCompareLabel"]" Height="18rem" />
