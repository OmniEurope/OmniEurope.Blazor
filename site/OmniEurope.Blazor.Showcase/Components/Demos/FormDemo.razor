@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Model">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniFormField For="demo-name" Required="true" Description="Tel qu'il apparaîtra sur la facture.">
            <Label>Nom complet</Label>
            <ChildContent>
                <OmniTextBox Id="demo-name" @bind-Value="Model.Name" Placeholder="Camille Durand" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-notes">
            <Label>Remarques</Label>
            <ChildContent>
                <OmniTextArea Id="demo-notes" @bind-Value="Model.Notes" Rows="3" MaxLength="200" ShowCount="true" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-email" Description="Le type choisit le clavier mobile et l'autofill du navigateur.">
            <Label>Adresse e-mail</Label>
            <ChildContent>
                <OmniTextBox Id="demo-email" Type="OmniTextBoxType.Email" Autocomplete="email"
                             @bind-Value="Model.Email" Placeholder="camille@exemple.eu" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-phone">
            <Label>Téléphone</Label>
            <ChildContent>
                <OmniTextBox Id="demo-phone" Type="OmniTextBoxType.Tel" Autocomplete="tel"
                             @bind-Value="Model.Phone" Placeholder="+32 2 000 00 00" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-website">
            <Label>Site web</Label>
            <ChildContent>
                <OmniTextBox Id="demo-website" Type="OmniTextBoxType.Url" Autocomplete="url"
                             @bind-Value="Model.Website" Placeholder="https://exemple.eu" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-search">
            <Label>Rechercher</Label>
            <ChildContent>
                <OmniTextBox Id="demo-search" Type="OmniTextBoxType.Search" @bind-Value="Model.Search"
                             Placeholder="Filtrer la liste" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="demo-budget">
            <Label>Budget</Label>
            <ChildContent>
                <OmniSlider Id="demo-budget" @bind-Value="Model.Budget" Minimum="0" Maximum="100" Step="5" ShowValue="true" />
            </ChildContent>
        </OmniFormField>

        <OmniCheckBox Id="demo-terms" @bind-Value="Model.Accepted" />
        <OmniSwitch Id="demo-alerts" @bind-Value="Model.Alerts">Recevoir les alertes</OmniSwitch>
    </OmniStack>
</EditForm>
