@using Microsoft.AspNetCore.Components.Forms

@* The text fields, check boxes, switches and dynamic form of this demo moved to the gallery pages
   Text fields, Check boxes and switches, and Validation. The sliders stay until the slider page takes them. *@
<EditForm Model="Model">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniFormField For="demo-budget">
            <LabelContent>@Text["DemoFormBudget"]</LabelContent>
            <ChildContent>
                <OmniSlider Id="demo-budget" @bind-Value="Model.Budget" Minimum="0" SelectableMinimum="5" Maximum="100" Step="5" ShowValue="true" />
                <OmniSlider Id="demo-budget-vertical" Orientation="OmniOrientation.Vertical" @bind-Value="Model.Budget" Minimum="0" SelectableMinimum="5" Maximum="100" Step="5" ShowValue="true"
                            aria-label="@Text["DemoFormBudget"]" />
            </ChildContent>
        </OmniFormField>
    </OmniStack>
</EditForm>
