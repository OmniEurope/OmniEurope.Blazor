<OmniStack Gap="OmniSpacing.Large">
    <OmniBreadcrumb Label="@Text["DemoNavigationBreadcrumb"]">
        <OmniBreadcrumbItem Href="">@Text["DemoNavigationHome"]</OmniBreadcrumbItem>
        <OmniBreadcrumbItem Href="composants">@Text["DemoNavigationComponents"]</OmniBreadcrumbItem>
        <OmniBreadcrumbItem Current="true">@Text["DemoNavigationCurrent"]</OmniBreadcrumbItem>
    </OmniBreadcrumb>

    <OmniTabs Label="@Text["DemoNavigationSections"]" @bind-Value="Tab">
        <OmniTabsItem Key="resume" Title="@Text["DemoNavigationTabSummary"]">@Text["DemoNavigationTabSummaryText", 14]</OmniTabsItem>
        <OmniTabsItem Key="pieces" Title="@Text["DemoNavigationDocuments"]">@Text["DemoNavigationDocumentsText"]</OmniTabsItem>
        <OmniTabsItem Key="historique" Title="@Text["DemoNavigationHistory"]">@Text["DemoNavigationHistoryText"]</OmniTabsItem>
    </OmniTabs>

    <OmniSteps Label="@Text["DemoNavigationProgress"]" @bind-Value="Step">
        <OmniStepsItem Index="0" Title="@Text["DemoNavigationFiling"]"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon><ChildContent>@Text["DemoNavigationFilingText"]</ChildContent></OmniStepsItem>
        <OmniStepsItem Index="1" Title="@Text["DemoNavigationReview"]">@Text["DemoNavigationReviewText"]</OmniStepsItem>
        <OmniStepsItem Index="2" Title="@Text["DemoNavigationDecision"]">@Text["DemoNavigationDecisionText"]</OmniStepsItem>
    </OmniSteps>
</OmniStack>
