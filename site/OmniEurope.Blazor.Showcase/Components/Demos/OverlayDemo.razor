<OmniStack Gap="OmniSpacing.Large">
    <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium">
        <OmniButton Variant="OmniButtonVariant.Primary" OnClick="@(_ => DialogOpen = true)">
            Ouvrir la boîte de dialogue
        </OmniButton>

        <OmniSplitButton Text="Enregistrer" MenuLabel="Autres enregistrements"
                         OnClick="@(() => Last = "Enregistrer")">
            <OmniSplitButtonItem OnClick="@(() => Last = "Enregistrer et fermer")">Enregistrer et fermer</OmniSplitButtonItem>
            <OmniSplitButtonItem OnClick="@(() => Last = "Enregistrer une copie")">Enregistrer une copie</OmniSplitButtonItem>
            <OmniSplitButtonItem Disabled="true">Publier, indisponible</OmniSplitButtonItem>
        </OmniSplitButton>

        <OmniContextMenu MenuLabel="Actions du dossier" Open="MenuOpen"
                         OpenChanged="@(value => MenuOpen = value)">
            <TriggerContent>Actions</TriggerContent>
            <ChildContent>
                <button type="button" @onclick="@(() => Last = "Dupliquer")">Dupliquer</button>
                <button type="button" @onclick="@(() => Last = "Exporter")">Exporter</button>
            </ChildContent>
        </OmniContextMenu>

        @* Panneau non modal : un clic ailleurs ou Échap le ferme, Échap rend le focus au bouton. *@
        <OmniPopover Label="Tâches en cours" TriggerLabel="Tâches en cours">
            <TriggerContent><OmniIcon Name="OmniIconName.Hourglass" /> <span>3</span></TriggerContent>
            <ChildContent>
                <p>Sauvegarde nocturne, étape 2 sur 4.</p>
                <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small"
                            OnClick="@(_ => Last = "Suivi ouvert")">Voir le suivi</OmniButton>
            </ChildContent>
        </OmniPopover>

        <OmniPopover Label="Filtre rapide" Placement="OmniPopoverPlacement.BottomStart"
                     TriggerVariant="OmniButtonVariant.Secondary">
            <TriggerContent>Filtrer</TriggerContent>
            <ChildContent>
                <p>Le panneau s'aligne sur le début du bouton.</p>
            </ChildContent>
        </OmniPopover>

        <OmniProfileMenu Label="Menu du compte">
            <Summary>Camille Durand</Summary>
            <ChildContent>
                <OmniProfileMenuItem Href="documentation">Mon profil</OmniProfileMenuItem>
                <OmniProfileMenuItem OnClick="@(() => Last = "Déconnexion")">Se déconnecter</OmniProfileMenuItem>
                <OmniProfileMenuItem Disabled="true">Administration, indisponible</OmniProfileMenuItem>
            </ChildContent>
        </OmniProfileMenu>
    </OmniStack>

    @* Dialogues ouverts par OmniOverlayService : CloseOnBackdropClick="false" ignore le clic sur le
       voile (la croix et Échap ferment toujours) ; Dismissible="false" retire la croix, ignore Échap
       et le voile, annonce un alertdialog, et seul son contenu le ferme par CloseDialog. *@
    <OmniComponentsHost OverlayService="Overlays">
        <OmniStack Orientation="OmniStackOrientation.Horizontal" Gap="OmniSpacing.Medium">
            <OmniButton Id="demo-dialog-sticky" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => OpenStickyDialog())">
                Dialogue qui ignore le voile
            </OmniButton>
            <OmniButton Id="demo-dialog-blocking" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => OpenBlockingDialog())">
                Dialogue à fermeture imposée
            </OmniButton>
        </OmniStack>
    </OmniComponentsHost>

    <p>Dernière action : @(Last ?? "aucune")</p>

    <OmniNotification Severity="OmniNotificationSeverity.Information" Title="Information"
                      Message="Le traitement de nuit démarrera à 23 h." />
    <OmniNotification Severity="OmniNotificationSeverity.Success" Title="Terminé"
                      Message="Les 14 pièces ont été importées." Dismissible="true"
                      OnDismiss="@(() => Last = "Notification fermée")" />
    <OmniNotification Severity="OmniNotificationSeverity.Warning" Message="Le quota est presque atteint." />
    <OmniNotification Severity="OmniNotificationSeverity.Error" Title="Échec"
                      Message="La connexion au service a échoué." />

    <OmniDialog Title="Confirmer la suppression" Open="DialogOpen"
                OpenChanged="@(value => DialogOpen = value)"
                CloseOnEscape="true" CloseOnBackdrop="true" CloseLabel="Fermer">
        <ChildContent>
            <p>Cette action retire le dossier de la liste. Elle est réversible pendant trente jours.</p>
        </ChildContent>
        @* Convention du paquet : l'action d'abord, Annuler (Danger) après elle, au bout du pied,
           chacun avec son icône. OmniOverlayService.ConfirmAsync la suit d'office. *@
        <Footer>
            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(_ => Confirm())"><OmniIcon Name="OmniIconName.Delete" /><span>Supprimer</span></OmniButton>
            <OmniButton Variant="OmniButtonVariant.Danger" OnClick="@(_ => DialogOpen = false)"><OmniIcon Name="OmniIconName.Close" /><span>Annuler</span></OmniButton>
        </Footer>
    </OmniDialog>
</OmniStack>
