<OmniStack Gap="OmniSpacing.Large">
    <OmniTree TValue="string" Label="Arborescence des dossiers" Multiple="true"
              @bind-Value="Selected">
        <OmniTreeItem TValue="string" Value="@("europe")" Text="Europe" Expanded="true">
            <OmniTreeItem TValue="string" Value="@("be")" Text="Belgique" Expanded="true">
                <OmniTreeItem TValue="string" Value="@("bru")" Text="Bruxelles, capitale">
                    <TextContent><OmniIcon Name="OmniIconName.Buildings" /> <span>Bruxelles</span> <em>capitale</em></TextContent>
                </OmniTreeItem>
                <OmniTreeItem TValue="string" Value="@("anv")" Text="Anvers" />
            </OmniTreeItem>
            <OmniTreeItem TValue="string" Value="@("fr")" Text="France">
                <OmniTreeItem TValue="string" Value="@("par")" Text="Paris" />
                <OmniTreeItem TValue="string" Value="@("lyo")" Text="Lyon" />
            </OmniTreeItem>
            <OmniTreeItem TValue="string" Value="@("lu")" Text="Luxembourg" Disabled="true" />
        </OmniTreeItem>
        <OmniTreeItem TValue="string" Value="@("archives")" Text="Archives, chargées à l'ouverture"
                      LoadChildren="LoadArchivesAsync">
            @foreach (var year in Archives)
            {
                <OmniTreeItem TValue="string" Value="@year" Text="@year" />
            }
        </OmniTreeItem>
    </OmniTree>

    <p>Sélection : @(Selected.Count == 0 ? "aucune" : string.Join(", ", Selected))</p>
</OmniStack>
