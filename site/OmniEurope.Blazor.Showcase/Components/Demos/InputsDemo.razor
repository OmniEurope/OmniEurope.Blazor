@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Model">
    <OmniStack Gap="OmniSpacing.Medium">
        @* Les trois sélecteurs ouvrent leur panneau sur le calque des surfaces flottantes ; un seul
           panneau est ouvert à la fois. *@
        <OmniFormField For="inputs-date" Description="@Text["DemoInputsDateHelp"]">
            <LabelContent>@Text["DemoInputsDate"]</LabelContent>
            <ChildContent>
                <OmniDatePicker Id="inputs-date" @bind-Value="Model.Date"
                                Minimum="Floor" Maximum="Ceiling" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-start" Description="@Text["DemoInputsStartHelp", 5]">
            <LabelContent>@Text["DemoInputsStart"]</LabelContent>
            <ChildContent>
                <OmniTimePicker Id="inputs-start" @bind-Value="Model.Start" Step="TimeSpan.FromMinutes(5)" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-appointment" Description="@Text["DemoInputsAppointmentHelp"]">
            <LabelContent>@Text["DemoInputsAppointment"]</LabelContent>
            <ChildContent>
                <OmniDateTimePicker Id="inputs-appointment" @bind-Value="Model.Appointment"
                                    Minimum="AppointmentFloor" Maximum="AppointmentCeiling" />
            </ChildContent>
        </OmniFormField>
        <p id="inputs-picked">@PickedSummary</p>

        @* Dans un dialogue, le calendrier s'ouvre par-dessus : fixé à la fenêtre, il ne crée pas de barre
           de défilement dans le dialogue, et il reste sous son champ quand on déplace le dialogue. *@
        <OmniButton Id="inputs-dialog-open" Variant="OmniButtonVariant.Secondary" OnClick="@(_ => DialogOpen = true)"><Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon><ChildContent><span>@Text["DemoInputsDialog"]</span></ChildContent></OmniButton>
        <OmniDialog Id="inputs-dialog" Title="@Text["DemoInputsDate"]" @bind-Open="DialogOpen" Size="OmniDialogSize.Small" Draggable="true">
            <OmniFormField For="inputs-dialog-date">
                <LabelContent>@Text["DemoInputsDate"]</LabelContent>
                <ChildContent>
                    <OmniDatePicker Id="inputs-dialog-date" @bind-Value="Model.DialogDate" />
                </ChildContent>
            </OmniFormField>
        </OmniDialog>

        <OmniFormField For="inputs-color">
            <LabelContent>@Text["DemoInputsColor"]</LabelContent>
            <ChildContent>
                <OmniColorPicker Id="inputs-color" @bind-Value="Model.Color" ShowValue="true" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-city" Description="@Text["DemoInputsCityHelp"]">
            <LabelContent>@Text["DemoInputsCity"]</LabelContent>
            <ChildContent>
                <OmniAutocomplete TValue="string" Id="inputs-city" @bind-Value="Model.City"
                                  Search="SearchCitiesAsync" MinimumLength="2"
                                  Debounce="TimeSpan.FromMilliseconds(150)" Placeholder="@Text["DemoInputsCityPlaceholder"]"
                                  HighlightMatches="true" />
            </ChildContent>
        </OmniFormField>

        @* Saisie libre (AllowFreeText) : une suggestion se choisit comme ci-dessus, et un nom absent de la
           liste devient la valeur quand on quitte le champ ou qu'on appuie sur Entrée sans suggestion en
           surbrillance. *@
        <OmniFormField For="inputs-model" Description="@Text["DemoInputsModelHelp"]">
            <LabelContent>@Text["DemoInputsModel"]</LabelContent>
            <ChildContent>
                <OmniAutocomplete TValue="string" Id="inputs-model" @bind-Value="Model.Model"
                                  Search="SearchModelsAsync" MinimumLength="0" ShowToggle="true" AllowFreeText="true" />
            </ChildContent>
        </OmniFormField>
        <p id="inputs-model-value" aria-live="polite">@Text["DemoInputsModelValue", Model.Model ?? "-"]</p>
    </OmniStack>
</EditForm>
