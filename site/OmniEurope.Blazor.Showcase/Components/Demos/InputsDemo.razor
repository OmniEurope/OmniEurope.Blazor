@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Model">
    <OmniStack Gap="OmniSpacing.Medium">
        <OmniFormField For="inputs-amount">
            <LabelContent>@Text["DemoInputsAmount"]</LabelContent>
            <ChildContent>
                <OmniNumeric TValue="decimal" Id="inputs-amount" @bind-Value="Model.Amount"
                             Minimum="0" Maximum="100000" Step="50" Placeholder="0" />
            </ChildContent>
        </OmniFormField>

        @* Clamp ramène une saisie hors bornes à la borne la plus proche, dans le modèle comme dans le
           champ. Sans lui, la valeur est prise telle quelle, comme avant. *@
        <OmniFormField For="inputs-quantity" Description="@Text["DemoInputsQuantityHelp", 0, 20]">
            <LabelContent>@Text["DemoInputsQuantity"]</LabelContent>
            <ChildContent>
                <OmniNumeric TValue="int" Id="inputs-quantity" @bind-Value="Model.Quantity"
                             Minimum="0" Maximum="20" Clamp="true" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-secret" Description="@Text["DemoInputsPasswordHelp"]">
            <LabelContent>@Text["DemoInputsPassword"]</LabelContent>
            <ChildContent>
                <OmniPassword Id="inputs-secret" @bind-Value="Model.Secret" Revealable="true"
                              Autocomplete="new-password" />
            </ChildContent>
        </OmniFormField>

        @* Les trois sélecteurs ouvrent leur panneau sur le calque des surfaces flottantes ; un seul
           panneau est ouvert à la fois. *@
        <OmniFormField For="inputs-date" Description="@Text["DemoInputsDateHelp"]">
            <LabelContent>@Text["DemoInputsDate"]</LabelContent>
            <ChildContent>
                <OmniDatePicker Id="inputs-date" @bind-Value="Model.Date"
                                Minimum="Floor" Maximum="Ceiling" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-start" Description="@Text["DemoInputsStartHelp", 5]">
            <LabelContent>@Text["DemoInputsStart"]</LabelContent>
            <ChildContent>
                <OmniTimePicker Id="inputs-start" @bind-Value="Model.Start" Step="TimeSpan.FromMinutes(5)" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-appointment" Description="@Text["DemoInputsAppointmentHelp"]">
            <LabelContent>@Text["DemoInputsAppointment"]</LabelContent>
            <ChildContent>
                <OmniDateTimePicker Id="inputs-appointment" @bind-Value="Model.Appointment"
                                    Minimum="AppointmentFloor" Maximum="AppointmentCeiling" />
            </ChildContent>
        </OmniFormField>
        <p id="inputs-picked">@PickedSummary</p>

        <OmniFormField For="inputs-color">
            <LabelContent>@Text["DemoInputsColor"]</LabelContent>
            <ChildContent>
                <OmniColorPicker Id="inputs-color" @bind-Value="Model.Color" ShowValue="true" />
            </ChildContent>
        </OmniFormField>

        <OmniFormField For="inputs-city" Description="@Text["DemoInputsCityHelp"]">
            <LabelContent>@Text["DemoInputsCity"]</LabelContent>
            <ChildContent>
                <OmniAutocomplete TValue="string" Id="inputs-city" @bind-Value="Model.City"
                                  Search="SearchCitiesAsync" MinimumLength="2"
                                  Debounce="TimeSpan.FromMilliseconds(150)" Placeholder="@Text["DemoInputsCityPlaceholder"]"
                                  HighlightMatches="true" />
            </ChildContent>
        </OmniFormField>
    </OmniStack>
</EditForm>
