@using Microsoft.AspNetCore.Components.Forms

@* La coquille d'application de la maquette (PLAN-004 T18 b) : barre supérieure avec bouton de repli,
   recherche, cloche à pastille et menu de compte fermé au repos ; menu latéral à icônes qui se replie
   en rail d'icônes ; contenu. Le menu ne navigue pas : il marque la section choisie.
   La pastille de la cloche, la loupe du champ de recherche, le logo et l'avatar sont dessinés par la
   feuille de la vitrine (app.css) : le paquet n'a pas de composant pour eux. *@
<div class="demo-appshell">
    <OmniLayout>
        @* Le bouton de repli passe par SidebarToggle : l'en-tête le pose lui-même sur l'axe des icônes du
           rail, quel que soit le contenu qui suit. *@
        <OmniHeader>
            <SidebarToggle>
                <OmniSidebarToggle Controls="appshell-menu" Open="MenuOpen" OpenChanged="@(value => MenuOpen = value)"
                                   Label="@Text["ShellToggle"]" />
            </SidebarToggle>
            <ChildContent>
                <span class="demo-appbar__brand">
                    <span class="demo-appbar__logo" aria-hidden="true">@Text["ShellLogo"]</span>
                    <span>@Text["ShellBrand"]</span>
                </span>
                <EditForm Model="this" class="demo-appbar__search" role="search">
                    <OmniIcon Name="OmniIconName.Search" />
                    <OmniTextBox Id="appshell-search" Type="OmniTextBoxType.Search" aria-label="@Text["ShellSearch"]"
                                 Placeholder="@Text["ShellSearchPlaceholder"]" @bind-Value="Search" />
                </EditForm>
                <span class="demo-appbar__actions">
                    <OmniButton Variant="OmniButtonVariant.Ghost" Label="@Text["ShellHelp"]">
                        <OmniIcon Name="OmniIconName.Question" />
                    </OmniButton>
                    <span class="demo-appbar__bell">
                        <OmniButton Variant="OmniButtonVariant.Ghost" Label="@Text["ShellNotifications", Unread]">
                            <OmniIcon Name="OmniIconName.Bell" />
                        </OmniButton>
                        <span class="demo-appbar__dot" aria-hidden="true"></span>
                    </span>
                    @* The standard app menu of the package: name and role, the language, the mode, the theme, the
                       settings, then the version and signing out; in the showcase every action only reports itself. *@
                    <OmniAppMenu UserName="admin" Role="@Text["ShellAccount"]" Class="demo-appbar__account"
                                 Languages="@Languages" Language="@LanguageCode" LanguageChanged="@(code => LanguageCode = code)"
                                 Appearance="MenuAppearance" AppearanceChanged="@(value => MenuAppearance = value)"
                                 OnTheme="@(() => Last = Text["ShellAppearance"])" OnSettings="@(() => Last = Text["ShellSettings"])"
                                 Version="@Text["ShellBrand"]" OnSignOut="@(() => Last = Text["ShellSignOut"])" />
                </span>
                @* The caption buttons of a borderless desktop window; in the showcase they only report the click. *@
                <OmniWindowControls OnMinimize="@(() => Last = Text["DemoAppShellMinimize"])"
                                    OnMaximizeRestore="@(() => { Maximized = !Maximized; Last = Text["DemoAppShellMaximize"]; })"
                                    IsMaximized="Maximized" OnClose="@(() => Last = Text["DemoAppShellClose"])" />
            </ChildContent>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Id="appshell-menu" Open="MenuOpen" OpenChanged="@(value => MenuOpen = value)"
                         Collapse="OmniSidebarCollapse.Icons" Transition="OmniSidebarTransition.Smooth"
                         Label="@Text["ShellMenu"]">
                <OmniPanelMenu Label="@Text["ShellMenu"]" DisplayStyle="OmniPanelMenuDisplayStyle.IconAndText" CanNavigate="SelectAsync">
                    @foreach (var section in Sections)
                    {
                        <OmniPanelMenuItem Text="@Text[section.TextKey]" Href="@($"composants/coquille-application#{section.Key}")"
                                           Current="@(Selected == section.Key)" Match="OmniNavMatch.None">
                            <Icon><OmniIcon Name="section.Icon" /></Icon>
                        </OmniPanelMenuItem>
                    }
                </OmniPanelMenu>
            </OmniSidebar>
            <OmniMain AriaLabelledBy="appshell-title">
                <OmniHeading Id="appshell-title" Level="OmniHeadingLevel.H3">@Text[Sections.Single(section => section.Key == Selected).TextKey]</OmniHeading>
                <div class="demo-appshell__tiles">
                    <OmniCard><OmniHeading Level="OmniHeadingLevel.H4">1</OmniHeading><p>@Text["ShellServersOnline"]</p></OmniCard>
                    <OmniCard><OmniHeading Level="OmniHeadingLevel.H4">2</OmniHeading><p>@Text["ShellAppsTracked"]</p></OmniCard>
                    <OmniCard><OmniHeading Level="OmniHeadingLevel.H4">0</OmniHeading><p>@Text["ShellPipelinesRunning"]</p></OmniCard>
                </div>
                <OmniSkeleton Shape="OmniSkeletonShape.Text" LineCount="2" Label="@Text["ShellLoading"]" />
                @if (Last is not null)
                {
                    <p>@Text["ShellLastAction", Last]</p>
                }
            </OmniMain>
        </OmniBody>
    </OmniLayout>
</div>
