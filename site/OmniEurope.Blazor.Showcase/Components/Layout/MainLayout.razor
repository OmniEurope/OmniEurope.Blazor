@inherits LayoutComponentBase

<OmniThemeScope Id="showcase-theme" Appearance="CurrentAppearance" Density="Theme.Density" BackdropMotion="Theme.BackdropMotion">
    <OmniLayout>
        <OmniHeader Sticky="true">
            <a class="showcase-brand" href="">OmniEurope.Blazor</a>
            <OmniBadge Tone="OmniTone.Accent">@Text["HeaderBadge"]</OmniBadge>
            <span class="showcase-header__spacer"></span>
            <LanguageSelector />
            <OmniButton Variant="OmniButtonVariant.Ghost" Disabled="Theme.Theme.DarkOnly" OnClick="@(_ => ToggleModeAsync())">
                @(Theme.EffectiveMode is ThemeMode.Dark ? Text["ModeLight"] : Text["ModeDark"])
            </OmniButton>
        </OmniHeader>
        <OmniBody>
            <OmniSidebar Label="@Text["SidebarLabel"]" Open="true">
                <OmniPanelMenu Label="@Text["MenuLabel"]">
                    <OmniPanelMenuItem Href="" Text="@Text["NavShowcase"]" Match="OmniNavMatch.Exact" />
                    <OmniPanelMenuItem Href="documentation" Text="@Text["NavDocumentation"]" />
                    <OmniPanelMenuItem Href="composants" Text="@Text["NavComponents"]" />
                    <OmniPanelMenuItem Href="personnalisation" Text="@Text["NavCustomize"]" />
                </OmniPanelMenu>
            </OmniSidebar>
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    <OmniMain ContentWidth="OmniLayoutWidth.Wide">@Body</OmniMain>
                </ChildContent>
                <ErrorContent Context="error">
                    <OmniMain ContentWidth="OmniLayoutWidth.Wide">
                        <OmniAlert Severity="OmniSeverity.Danger" Title="@Text["ErrorTitle"]">
                            @Text["ErrorMessage"]
                            <OmniButton OnClick="@(_ => RecoverAsync())">@Text["Retry"]</OmniButton>
                        </OmniAlert>
                    </OmniMain>
                </ErrorContent>
            </ErrorBoundary>
        </OmniBody>
    </OmniLayout>
</OmniThemeScope>
