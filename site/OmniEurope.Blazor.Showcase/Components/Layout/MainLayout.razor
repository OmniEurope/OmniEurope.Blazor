@inherits LayoutComponentBase
@using OmniEurope.Blazor.Showcase.Components.Gallery
@using OmniEurope.Blazor.Showcase.Localization

@* The OE shell (STD-SHELL): one theme scope around the whole site, the header with the sidebar toggle and the
   application menu at its end, the loading bar under it, then the sidebar and the main area. The application
   only fills their slots. The theme is handed over painted (palette and hand edits included): a theme with a
   canvas backdrop draws it behind every page, as in a real application. ThemeState still pushes the same
   tokens through the CSSOM, so the two writers agree. *@
<OmniThemeScope Id="showcase-theme" Appearance="CurrentAppearance" Density="Theme.Density" Preset="Theme.Painted" BackdropMotion="Theme.BackdropMotion">
    @* The host draws the dialogs and notifications the pages ask for through OmniOverlayService; it
       receives the injected instance, so a dialog content reaching the service by injection gets the same. *@
    <OmniComponentsHost OverlayService="@Overlay">
    <OmniLayout>
        @* Le premier arrêt de Tab : il mène au contenu par-dessus l'en-tête et la navigation. *@
        <OmniSkipLink />
        <OmniHeader Sticky="true" Brand="OmniEurope.Blazor" BrandHref="/">
            <SidebarToggle>
                <OmniSidebarToggle Controls="@SidebarId" Open="_sidebarOpen" OpenChanged="SetSidebarOpen"
                                   Reveal="EffectiveReveal" Label="@Text["ToggleMenu"]" />
            </SidebarToggle>
            <ChildContent>
                <OmniBadge Class="showcase-header__badge" Tone="OmniTone.Accent">@Text["HeaderBadge"]</OmniBadge>
                <span class="showcase-header__spacer"></span>
                @* The standard application menu: mode, theme (it opens the appearance window), language and
                   version. The showcase has neither an account nor a settings page of its own. *@
                <OmniAppMenu Appearance="MenuAppearance" AppearanceChanged="SetAppearanceAsync"
                             Preset="LookPreset" OnThemeOpen="OpenAppearanceWindow"
                             Languages="ShowcaseLanguageSwitcher.Languages" Language="@ShowcaseLanguageSwitcher.Current"
                             LanguageChanged="ChangeLanguageAsync" Version="@VersionLine" />
            </ChildContent>
        </OmniHeader>
        <OmniLoadingBar Mode="OmniLoadingBarMode.Continuous" Label="@Text["Loading"]" />
        <OmniBody>
            @* Two independent axes: what opening does to the content (pushed on a wide screen, overlaid on a
               phone, where it also gets a veil) and what closing leaves (a rail of icons, nothing on a phone). *@
            <OmniSidebar Id="@SidebarId" Label="@Text["SidebarLabel"]" CloseLabel="@Text["CloseMenu"]"
                         Open="_sidebarOpen" OpenChanged="SetSidebarOpen"
                         Reveal="EffectiveReveal" Collapse="EffectiveCollapse"
                         Transition="OmniSidebarTransition.Smooth" Backdrop="_narrowViewport">
                @* Inside the gallery its menu replaces the site's, as on a site of its own; its first entry,
                   and the brand in the header, lead back to the other sections. *@
                @if (InGallery)
                {
                    <GalleryMenu />
                }
                else
                {
                    <OmniPanelMenu Label="@Text["MenuLabel"]">
                        <OmniPanelMenuItem Href="" Text="@Text["NavShowcase"]" Match="OmniNavMatch.Exact">
                            <Icon><OmniIcon Name="OmniIconName.Home" /></Icon>
                        </OmniPanelMenuItem>
                        <OmniPanelMenuItem Href="documentation" Text="@Text["NavDocumentation"]">
                            <Icon><OmniIcon Name="OmniIconName.BookOpen" /></Icon>
                        </OmniPanelMenuItem>
                        <OmniPanelMenuItem Href="components" Text="@Text["NavComponents"]">
                            <Icon><OmniIcon Name="OmniIconName.Flask" /></Icon>
                        </OmniPanelMenuItem>
                        <OmniPanelMenuItem Href="customizer" Text="@Text["NavCustomize"]">
                            <Icon><OmniIcon Name="OmniIconName.Palette" /></Icon>
                        </OmniPanelMenuItem>
                    </OmniPanelMenu>
                }
            </OmniSidebar>
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    <OmniMain ContentWidth="OmniLayoutWidth.Wide">@Body</OmniMain>
                </ChildContent>
                <ErrorContent Context="error">
                    <OmniMain ContentWidth="OmniLayoutWidth.Wide">
                        <OmniAlert Severity="OmniSeverity.Danger" Title="@Text["ErrorTitle"]">
                            @Text["ErrorMessage"]
                            <OmniButton OnClick="@(_ => RecoverAsync())">@Text["Retry"]</OmniButton>
                        </OmniAlert>
                    </OmniMain>
                </ErrorContent>
            </ErrorBoundary>
        </OmniBody>
    </OmniLayout>
    @* The window of the look, opened by the Theme row of the application menu. It writes the same state as
       the customizer and the gallery pages, so the page, the menus and the customizer always agree. *@
    <OmniAppearanceWindow Open="_appearanceWindowOpen" OpenChanged="SetAppearanceWindowOpen"
                          Appearance="MenuAppearance" AppearanceChanged="SetAppearanceAsync"
                          Preset="LookPreset" PresetChanged="SetPresetAsync"
                          Palette="WindowPalette" PaletteChanged="SetPaletteAsync"
                          Density="Theme.Density" DensityChanged="SetDensityAsync"
                          BackdropMotion="Theme.BackdropMotion" BackdropMotionChanged="SetBackdropMotionAsync" />
    </OmniComponentsHost>
</OmniThemeScope>

@* Retire l'écran de démarrage de index.html une fois l'application rendue : fondu, puis suppression. *@
<OmniBootSplash />
