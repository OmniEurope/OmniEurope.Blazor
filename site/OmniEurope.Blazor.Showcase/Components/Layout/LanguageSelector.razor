@* The language of the showcase: the 24 official EU languages, each under its own name. A page keeps
   the culture it started with, so a choice is saved in the browser and the page reloads in it. *@
<OmniDropDown TValue="string" Class="showcase-language" Options="Options"
              @bind-Value="Selected" @bind-Value:after="SwitchAsync"
              Label="@Text["LanguageSelectorLabel"]" />
