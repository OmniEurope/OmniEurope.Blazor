<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- STD-WASMOPT: the showcase runs in fr-FR (Program.cs), so only the ICU shard of the European
         languages (English, French, Italian, German, Spanish) is shipped, loaded whatever the browser
         language; invariant globalization would format amounts with the generic currency sign. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorIcuDataFileName>icudt_EFIGS.dat</BlazorIcuDataFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="../../src/OmniEurope.Blazor/OmniEurope.Blazor.csproj" />
  </ItemGroup>

  <!-- Every demo is embedded as the very file that gets compiled, so the gallery shows the source
       it actually executed instead of a transcription that can drift away from it. -->
  <ItemGroup>
    <EmbeddedResource Include="Components/Demos/**/*.razor" />
  </ItemGroup>
</Project>
