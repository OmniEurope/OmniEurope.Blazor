<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- STD-WASMOPT: the showcase runs in English (en-IE) or French (fr-FR), picked in its header
         (Program.cs, Localization/ShowcaseLanguages.cs). Both are in the EFIGS ICU shard, so that shard
         is loaded whatever the browser language, instead of the full ICU data the 24 languages needed;
         invariant globalization would format amounts with the generic currency sign. The satellite
         assemblies of the referenced packages are limited to the same two languages. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorIcuDataFileName>icudt_EFIGS.dat</BlazorIcuDataFileName>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="../../src/OmniEurope.Blazor/OmniEurope.Blazor.csproj" />
    <ProjectReference Include="../OmniEurope.Blazor.Showcase.Examples/OmniEurope.Blazor.Showcase.Examples.csproj" />
    <ProjectReference Include="../OmniEurope.Blazor.Showcase.Shared/OmniEurope.Blazor.Showcase.Shared.csproj" />
  </ItemGroup>

  <!-- STD-CFGOVERRIDE: the local launcher writes wwwroot/appsettings.Local.json (the API address of this
       checkout, Preferences/ShowcaseApiConfiguration.cs). It is a developer file: never published, so a
       published copy of the site never points at a developer machine. -->
  <ItemGroup>
    <Content Update="wwwroot/appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
