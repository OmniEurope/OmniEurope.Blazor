<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- STD-WASMOPT: the showcase runs in the language picked in its header, one of the 24 official
         EU languages (Program.cs, Localization/ShowcaseLanguages.cs). No ICU shard covers them all
         (EFIGS lacks Bulgarian, Greek, Polish...), so the full ICU data is loaded, with the satellite
         resource assemblies of every culture; invariant globalization would format amounts with the
         generic currency sign. No SatelliteResourceLanguages filter: every culture is published. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="../../src/OmniEurope.Blazor/OmniEurope.Blazor.csproj" />
  </ItemGroup>

  <!-- Every demo is embedded as the very file that gets compiled, so the gallery shows the source
       it actually executed instead of a transcription that can drift away from it. -->
  <ItemGroup>
    <EmbeddedResource Include="Components/Demos/**/*.razor" />
  </ItemGroup>
</Project>
