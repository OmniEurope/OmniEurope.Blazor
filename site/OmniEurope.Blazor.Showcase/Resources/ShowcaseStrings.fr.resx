  <data name="DocsCspTitle" xml:space="preserve"><value>Politique de sécurité</value></data>
  <data name="DocsCspBody" xml:space="preserve"><value>La bibliothèque n'exige aucune permission au-delà de celles-ci, ni style en ligne, ni évaluation dynamique de script.</value></data>
