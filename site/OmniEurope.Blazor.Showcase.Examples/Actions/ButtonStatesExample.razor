@* Every variant at rest, disabled, busy and as an icon alone: one variant per row, one state per column.
   Busy keeps the content and the exact size of the button at rest: a veil breathes over it and it
   ignores clicks, as a disabled one does. *@
<OmniStack Gap="OmniSpacing.Medium">
    <table>
        <caption class="omni-visually-hidden">Buttons by variant and state</caption>
        <thead>
            <tr>
                <th scope="col">Variant</th>
                <th scope="col">At rest</th>
                <th scope="col">Disabled</th>
                <th scope="col">Busy</th>
                <th scope="col">Icon only</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sample in ButtonSample.All)
            {
                <tr>
                    <th scope="row">@sample.Name</th>
                    <td>
                        <OmniButton Variant="sample.Variant" OnClick="CountClick">
                            <OmniIcon Name="@sample.Icon" />
                            <span>@sample.Action</span>
                        </OmniButton>
                    </td>
                    <td>
                        <OmniButton Variant="sample.Variant" Disabled="true" OnClick="CountClick">
                            <OmniIcon Name="@sample.Icon" />
                            <span>@sample.Action</span>
                        </OmniButton>
                    </td>
                    <td>
                        <OmniButton Variant="sample.Variant" Busy="true" OnClick="CountClick">
                            <OmniIcon Name="@sample.Icon" />
                            <span>@sample.Action</span>
                        </OmniButton>
                    </td>
                    <td>
                        <OmniButton Variant="sample.Variant" Label="@sample.Action" title="@sample.Action" OnClick="CountClick">
                            <OmniIcon Name="@sample.Icon" />
                        </OmniButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <OmniText Tone="OmniTextTone.Muted">Clicks: @ClickCount. Disabled and busy buttons do not count.</OmniText>
</OmniStack>
