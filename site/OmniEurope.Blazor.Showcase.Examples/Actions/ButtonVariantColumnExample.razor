@* The four variants a screen uses most, the principal action first, one button each. A gallery page
   shows this column three times, at rest, hovered and pressed, to compare the three states of a
   variant at a glance. *@
<OmniStack Gap="OmniSpacing.Small" Align="OmniAlignment.Start">
    <OmniButton Variant="OmniButtonVariant.Primary"><span>Primary</span></OmniButton>
    <OmniButton Variant="OmniButtonVariant.Success"><span>Success</span></OmniButton>
    <OmniButton Variant="OmniButtonVariant.Secondary"><span>Secondary</span></OmniButton>
    <OmniButton Variant="OmniButtonVariant.Ghost"><span>Ghost</span></OmniButton>
</OmniStack>
