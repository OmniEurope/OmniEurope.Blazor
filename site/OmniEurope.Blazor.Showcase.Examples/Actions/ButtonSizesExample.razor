@* Every variant at the three sizes: one variant per row, one size per column, so height, padding and text
   size read across a row and the variants read down a column. With IconOnly, the button turns into a
   square at its size, its name kept as the accessible label and the tooltip. *@
<OmniStack Gap="OmniSpacing.Medium">
    <table>
        <caption class="omni-visually-hidden">@(IconOnly ? "Icon-only buttons by variant and size" : "Buttons by variant and size")</caption>
        <thead>
            <tr>
                <th scope="col">Variant</th>
                @foreach (var size in Sizes)
                {
                    <th scope="col">@size</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var sample in ButtonSample.All)
            {
                <tr>
                    <th scope="row">@sample.Name</th>
                    @foreach (var size in Sizes)
                    {
                        <td>
                            @if (IconOnly)
                            {
                                <OmniButton Variant="sample.Variant" Size="size" Label="@sample.Action" title="@sample.Action" OnClick="CountClick">
                                    <OmniIcon Name="@sample.Icon" />
                                </OmniButton>
                            }
                            else
                            {
                                <OmniButton Variant="sample.Variant" Size="size" OnClick="CountClick">
                                    <OmniIcon Name="@sample.Icon" />
                                    <span>@sample.Action</span>
                                </OmniButton>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <OmniText Tone="OmniTextTone.Muted">Clicks: @ClickCount.</OmniText>
</OmniStack>
