@* One badge whose tone, fill, label and icon are parameters. An empty label would leave a dot without
   text, so the badge keeps a sample word instead. *@
<OmniRow Justify="OmniJustification.Center" Align="OmniAlignment.Center">
    <OmniBadge Tone="Tone" Fill="Fill" Shape="Shape">
        @if (WithIcon)
        {
            <OmniIcon Name="OmniIconName.Tag" Size="OmniControlSize.Small" />
        }
        <span>@DisplayedLabel</span>
    </OmniBadge>
</OmniRow>
