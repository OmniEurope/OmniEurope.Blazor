@* Badges where they live: next to the label of a row they qualify. *@
<OmniStack Gap="OmniSpacing.Small">
    <OmniRow Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <span>Unread messages</span>
        <OmniBadge Tone="OmniTone.Accent">12</OmniBadge>
    </OmniRow>
    <OmniDivider />
    <OmniRow Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <span>Deployment</span>
        <OmniBadge Tone="OmniTone.Success">
            <OmniIcon Name="OmniIconName.CheckCircle" Size="OmniControlSize.Small" />
            <span>Online</span>
        </OmniBadge>
    </OmniRow>
    <OmniDivider />
    <OmniRow Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <span>Storage quota</span>
        <OmniBadge Tone="OmniTone.Warning">90 %</OmniBadge>
    </OmniRow>
    <OmniDivider />
    <OmniRow Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <span>Last payment</span>
        <OmniBadge Tone="OmniTone.Danger">
            <OmniIcon Name="OmniIconName.Error" Size="OmniControlSize.Small" />
            <span>Rejected</span>
        </OmniBadge>
    </OmniRow>
    <OmniDivider />
    <OmniRow Justify="OmniJustification.Between" Align="OmniAlignment.Center">
        <span>Annual report</span>
        <OmniBadge Tone="OmniTone.Neutral" Fill="OmniFill.Outline">Draft</OmniBadge>
    </OmniRow>
</OmniStack>
