@* A theme scope repaints and respaces everything inside it, and nothing outside: appearance, density,
   theme, palette, font and the moving backdrop are parameters of OmniThemeScope. The sample sits in the
   main area of the scope with no opaque card between them, so the colour field or the canvas a theme
   lays behind its content stays visible; a host gives the scope a visible edge. *@
<OmniThemeScope Appearance="Appearance" Density="Density" Preset="Preset" Palette="Palette" Font="Font" BackdropMotion="BackdropMotion">
    <OmniMain ContentWidth="@(FullWidth ? OmniLayoutWidth.FullWidth : OmniLayoutWidth.Content)">
        <ThemeSample />
    </OmniMain>
</OmniThemeScope>
