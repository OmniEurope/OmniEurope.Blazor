@* One heading and one paragraph whose every setting is a parameter. They sit in a group a host can frame
   narrower than the card, so that Truncate always has a line to cut. *@
<OmniStack Gap="OmniSpacing.Small">
    <OmniStack Gap="OmniSpacing.Small" role="group" aria-label="Typography preview">
        <OmniHeading Level="Level" Tone="HeadingTone">@DisplayedHeading</OmniHeading>
        <OmniText Element="Element" Tone="TextTone" Truncate="Truncate">@LongSample</OmniText>
    </OmniStack>
    <OmniText Tone="OmniTextTone.Muted">@RenderedAs</OmniText>
</OmniStack>
