@* Links, in the same tab or in a new one (rel="noopener noreferrer" is added for you), listed as bullets. An
   icon-only link is named by its Label. Without Href a link is an action (a button of the same look); in a
   grid cell, StopPropagation keeps its click and key press from the row, so OnRowClick is not raised. *@
<OmniStack Gap="OmniSpacing.Small">
    <ul>
        @foreach (var link in Links)
        {
            <li>
                <OmniLink Href="@link.Href" NewTab="@NewTab">
                    <span>@link.Text</span>
                </OmniLink>
            </li>
        }
        <li>
            <OmniTooltip Text="An icon-only link is named by its accessible label.">
                <OmniLink Href="" NewTab="@NewTab" Label="Gallery home">
                    <OmniIcon Name="OmniIconName.Home" />
                </OmniLink>
            </OmniTooltip>
        </li>
    </ul>
    <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
        <OmniIcon Name="OmniIconName.Info" />
        <OmniText>@(NewTab ? "Target: new tab (target=\"_blank\")." : "Target: same tab.")</OmniText>
    </OmniStack>
    <OmniDataGrid TItem="SampleCase" Id="links-action-grid" Items="Cases" KeyOf="item => item.Number"
                  Caption="Cases" OnRowClick="OnRowClick">
        <Columns>
            <OmniDataGridColumn TItem="SampleCase" Key="number" Title="Case" Property="item => item.Number" />
            <OmniDataGridColumn TItem="SampleCase" Key="action" Title="Action">
                <Template Context="item">
                    <OmniLink StopPropagation="true" OnClick="() => Open(item)">Open @item.Number</OmniLink>
                </Template>
            </OmniDataGridColumn>
        </Columns>
    </OmniDataGrid>
    <OmniText Id="links-action-activity">@Activity</OmniText>
</OmniStack>
