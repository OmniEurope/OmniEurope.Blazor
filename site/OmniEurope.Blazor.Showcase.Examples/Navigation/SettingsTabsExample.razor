@using Microsoft.AspNetCore.Components.Forms

@* A settings page in tabs: one icon tab per topic, one section per tab, one tile per setting, the control
   on the right. A switch in a tile takes the name of the tile as its label, and a click anywhere on the
   tile toggles it. *@
<EditForm Model="Model">
    <OmniTabs Label="Settings" @bind-Value="Tab">
        <OmniTabsItem Key="general" Title="General">
            <Icon><OmniIcon Name="OmniIconName.Settings" /></Icon>
            <ChildContent>
                @* Paired: two tiles per row, stacked under about 24rem; the folder, wider, takes the whole row. *@
                <OmniSettingsSection Title="General" Description="Where the files go and how the application starts." Paired="true">
                    <OmniSettingsTile Title="Output folder" Description="Where the builds drop their packages." FullWidth="true">
                        <Icon><OmniIcon Name="OmniIconName.FolderOpen" /></Icon>
                        <ChildContent>
                            <OmniStack Orientation="OmniOrientation.Horizontal" Align="OmniAlignment.Center" Gap="OmniSpacing.Small">
                                <OmniTextBox Id="settings-folder" aria-label="Output folder" @bind-Value="Model.Folder" />
                                <OmniButton Variant="OmniButtonVariant.Secondary">
                                    <Icon><OmniIcon Name="OmniIconName.Folder" /></Icon>
                                    <ChildContent><span>Browse</span></ChildContent>
                                </OmniButton>
                            </OmniStack>
                        </ChildContent>
                    </OmniSettingsTile>
                    <OmniSettingsTile Title="Start with the session" Description="The agent starts when you sign in.">
                        <Icon><OmniIcon Name="OmniIconName.Play" /></Icon>
                        <ChildContent><OmniSwitch Id="settings-startup" @bind-Value="Model.StartWithSystem" /></ChildContent>
                    </OmniSettingsTile>
                    <OmniSettingsTile Title="Language" Description="The language of the interface.">
                        <Icon><OmniIcon Name="OmniIconName.Globe" /></Icon>
                        <ChildContent>
                            <OmniDropDown TValue="string" Id="settings-language" Label="Language" Options="Languages" @bind-Value="Model.Language" />
                        </ChildContent>
                    </OmniSettingsTile>
                </OmniSettingsSection>
            </ChildContent>
        </OmniTabsItem>
        <OmniTabsItem Key="display" Title="Display">
            <Icon><OmniIcon Name="OmniIconName.Palette" /></Icon>
            <ChildContent>
                <OmniSettingsSection Title="Display" Description="How the interface looks.">
                    <OmniSettingsTile Title="Dark mode" Description="Follow the system, or force one mode.">
                        <Icon><OmniIcon Name="OmniIconName.ThemeDark" /></Icon>
                        <ChildContent>
                            <OmniDropDown TValue="string" Id="settings-mode" Label="Dark mode" Options="Modes" @bind-Value="Model.Mode" />
                        </ChildContent>
                    </OmniSettingsTile>
                    <OmniSettingsTile Title="Compact interface" Description="Tighter rows, for small screens.">
                        <Icon><OmniIcon Name="OmniIconName.Rows" /></Icon>
                        <ChildContent><OmniSwitch Id="settings-compact" @bind-Value="Model.Compact" /></ChildContent>
                    </OmniSettingsTile>
                </OmniSettingsSection>
            </ChildContent>
        </OmniTabsItem>
        <OmniTabsItem Key="notifications" Title="Notifications">
            <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon>
            <ChildContent>
                <OmniSettingsSection Title="Notifications" Description="What you hear about, and where.">
                    <OmniSettingsTile Title="Failed runs" Description="A message for each failed run.">
                        <Icon><OmniIcon Name="OmniIconName.Warning" /></Icon>
                        <ChildContent><OmniSwitch Id="settings-failures" @bind-Value="Model.Failures" /></ChildContent>
                    </OmniSettingsTile>
                    <OmniSettingsTile Title="Daily digest" Description="One summary a day, sent to this address.">
                        <Icon><OmniIcon Name="OmniIconName.At" /></Icon>
                        <ChildContent>
                            <OmniTextBox Id="settings-digest" Type="OmniTextBoxType.Email" aria-label="Digest address" @bind-Value="Model.DigestAddress" />
                        </ChildContent>
                    </OmniSettingsTile>
                </OmniSettingsSection>
            </ChildContent>
        </OmniTabsItem>
        <OmniTabsItem Key="project" Title="Project">
            <Icon><OmniIcon Name="OmniIconName.ShieldWarning" /></Icon>
            <ChildContent>
                @* A danger zone: irreversible actions, each behind the confirmation of the package
                   (OmniOverlayService.ConfirmAsync), hence a components host of its own. The deletion keeps
                   its button busy for a second and a half, the reset fails on purpose and its error goes
                   through OnConfirmError, the transfer is disabled. Nothing is really erased. *@
                <OmniComponentsHost OverlayService="Overlays">
                    <OmniSettingsDangerZone Description="These actions cannot be undone.">
                        <OmniSettingsDangerAction Id="settings-delete-project" Title="Delete the project"
                                                  Description="Removes the project and every run it holds."
                                                  ConfirmMessage="The project and its runs will be deleted. This is only a demonstration: nothing is erased."
                                                  OnConfirm="DeleteProjectAsync" />
                        <OmniSettingsDangerAction Title="Reset the history" Description="Forgets every past run, and keeps the project."
                                                  ActionText="Reset"
                                                  ConfirmTitle="Reset the history"
                                                  ConfirmMessage="Every past run will be forgotten. The reset fails on purpose, to show OnConfirmError."
                                                  ConfirmText="Reset the history"
                                                  OnConfirm="ResetHistoryAsync" OnConfirmError="ReportResetFailure">
                            <Icon><OmniIcon Name="OmniIconName.Reset" /></Icon>
                        </OmniSettingsDangerAction>
                        <OmniSettingsDangerAction Title="Transfer the project" Description="Hands the project over to another owner."
                                                  ActionText="Transfer" Disabled="true">
                            <Icon><OmniIcon Name="OmniIconName.Swap" /></Icon>
                        </OmniSettingsDangerAction>
                    </OmniSettingsDangerZone>
                </OmniComponentsHost>
            </ChildContent>
        </OmniTabsItem>
    </OmniTabs>
</EditForm>
