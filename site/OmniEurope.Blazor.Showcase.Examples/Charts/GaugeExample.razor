@* An arc gauge on a scale. Without bounds of its own, the value takes those of its scale, and it is clamped to
   them: the arc never goes past its ends. *@
<OmniArcGauge Label="Processing rate">
    <OmniArcGaugeScale Minimum="Minimum" Maximum="Maximum">
        <OmniArcGaugeScaleValue Value="Value" ColorIndex="ColorIndex" FormatValue="FormatGaugeValue" />
    </OmniArcGaugeScale>
</OmniArcGauge>
