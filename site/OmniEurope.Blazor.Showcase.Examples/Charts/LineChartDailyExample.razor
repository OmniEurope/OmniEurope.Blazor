@* Thirty days: the chart widens on its own, the day labels thin out without overlapping, and the long series
   names go below the drawing. One hover text per day names both series (SharedTooltip), and the visitors line
   is dashed. *@
<OmniChart Label="Daily audience over thirty days" SharedTooltip="true">
    <OmniGridLines />
    <OmniCategoryAxis Labels="Days" />
    <OmniValueAxis Maximum="400" TickCount="4" />
    <OmniColumnSeries Title="Page views per day" ColorIndex="1" Data="PageViews" />
    <OmniLineSeries Title="Unique visitors per day" ColorIndex="0" Data="Visitors" Dashed="true" />
    <OmniLegend Placement="OmniLegendPlacement.Bottom" />
</OmniChart>
