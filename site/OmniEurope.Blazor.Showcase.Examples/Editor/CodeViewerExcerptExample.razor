@* A configuration with one line highlighted, then an excerpt of a file that keeps the line numbers it has there
   (FirstLineNumber) and hides the wrap toggle. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniCodeViewer Code="@ConfigurationCode" Title="Configuration sample" Language="json" HighlightedLines="ConfigurationHighlights" />
    <OmniCodeViewer Code="@ExcerptCode" Title="Excerpt, lines 41 to 43" Language="csharp" FirstLineNumber="41"
                    HighlightedLines="ExcerptHighlights" ShowWrapToggle="false" />
</OmniStack>
