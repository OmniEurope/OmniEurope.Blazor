@* One gauge, every setting a parameter. ValueText replaces the percentage on screen and for screen
   readers; left null, the component writes its own. The group around the gauge is the stage a host can
   frame, so the preview keeps its height when the gauge turns from linear to circular. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniStack role="group" aria-label="Progress preview">
        <OmniProgressBar Shape="Shape"
                         Tone="Tone"
                         Value="Value"
                         Indeterminate="Indeterminate"
                         ShowValue="ShowValue"
                         Label="@Label"
                         ValueText="@ValueText" />
    </OmniStack>
    <OmniText Tone="OmniTextTone.Muted">@Echo</OmniText>
</OmniStack>
