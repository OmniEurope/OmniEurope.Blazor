@* Several values stacked on one total (Segments): the words of a lesson discovered, known and mastered. The legend
   names the colours for sighted readers; a screen reader hears each segment from the bar's own announced text. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniProgressBar Id="progress-segments-line" Label="Lesson progress" Maximum="30" Segments="Lesson" ShowLegend="true" ShowValue="true" />
    <OmniProgressBar Id="progress-segments-ring" Label="Lesson progress, ring" Shape="OmniProgressShape.Circular" Maximum="30" Segments="Lesson" ShowLegend="true" />
</OmniStack>
