@* The logo of a site as its loader: it floats and never turns. Pass the mark of your own site as the
   content; an icon stands in for it here. *@
<OmniRow Gap="OmniSpacing.Large" Align="OmniAlignment.Center">
    <OmniLogoLoader Size="OmniControlSize.Small" Label="Loading">
        <OmniIcon Name="OmniIconName.Airplane" />
    </OmniLogoLoader>
    <OmniLogoLoader Label="Loading">
        <OmniIcon Name="OmniIconName.Airplane" />
    </OmniLogoLoader>
    <OmniLogoLoader Size="OmniControlSize.Large" Label="Loading">
        <OmniIcon Name="OmniIconName.Airplane" />
    </OmniLogoLoader>
</OmniRow>
