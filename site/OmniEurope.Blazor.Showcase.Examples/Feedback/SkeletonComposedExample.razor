@* A composed placeholder takes the shape of what it replaces while it loads: an avatar beside two lines,
   a picture beside four. Each piece stays decorative and one name announces the loading. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniRow Gap="OmniSpacing.Medium" Align="OmniAlignment.Center" role="status">
        <span class="omni-visually-hidden">Loading the profile</span>
        <OmniColumn Span="2"><OmniSkeleton Shape="OmniSkeletonShape.Circle" /></OmniColumn>
        <OmniColumn><OmniSkeleton LineCount="2" /></OmniColumn>
    </OmniRow>
    <OmniRow Gap="OmniSpacing.Medium" Align="OmniAlignment.Center">
        <OmniColumn Span="4"><OmniSkeleton Shape="OmniSkeletonShape.Rectangle" /></OmniColumn>
        <OmniColumn><OmniSkeleton LineCount="4" /></OmniColumn>
    </OmniRow>
</OmniStack>
