@* A log viewer: a line per level, a level filter, a search, and a tail that follows the end until the
   reader scrolls up. A line as long as real ones are scrolls sideways rather than wrapping. *@
<OmniLogViewer Lines="LogLines" Label="Processing log" ShowLevels="true"
               ShowLevelFilter="true" ShowSearch="true" Height="14rem" />
