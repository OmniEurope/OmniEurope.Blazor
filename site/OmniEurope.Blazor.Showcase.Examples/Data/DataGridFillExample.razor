@* A grid that takes what is left of its frame (FillAvailableHeight, MinHeight floor): virtualized, grouped by
   country, every row the same height (FixedRowHeight), veiled by LoadingContent until its first ready render.
   The wheel turned anywhere in the frame scrolls its rows (WheelScrollScope); a country picked in the filter,
   or an applicant taken from the suggestions, closes the menu (HideFilterMenuOnSelect); a double click on the
   edge of Amount, drawn narrower than its widest amount, fits the column to the widest of the two thousand
   files, rendered or not. *@
<div id="demo-grid-scope">
    <OmniText Tone="OmniTextTone.Muted">Turn the wheel anywhere in this frame to scroll the grid.</OmniText>
    <OmniDataGrid TItem="CaseRow" Id="demo-grid-fill"
                  HeaderWrap="OmniDataGridHeaderWrap.Truncate"
                  Items="CaseData.Fill"
                  Caption="Two thousand files"
                  ScrollMode="OmniDataGridScrollMode.Virtual"
                  AllowGrouping="true"
                  Groups="_grouping"
                  GroupsChanged="@(value => _grouping = value)"
                  AllGroupsExpanded="true"
                  FixedRowHeight="true"
                  EstimatedRowHeight="36"
                  FillAvailableHeight="true"
                  MinHeight="8rem"
                  WheelScrollScope="#demo-grid-scope"
                  HideFilterMenuOnSelect="true"
                  AllowColumnAutoFit="true">
        <LoadingContent>Loading...</LoadingContent>
        <Columns>
            <OmniDataGridColumn TItem="CaseRow" Property="Reference" Title="Reference" Filterable="false" AutoFit="false" />
            <OmniDataGridColumn TItem="CaseRow" Property="Applicant" Title="Applicant" FilterType="OmniDataGridColumnFilterType.Combo" />
            <OmniDataGridColumn TItem="CaseRow" Property="Country" Title="Country" FilterType="OmniDataGridColumnFilterType.Select" Groupable="true" />
            <OmniDataGridColumn TItem="CaseRow" Property="Amount" Title="Amount" FormatString="{0:C0}" Filterable="false"
                                Width="8rem" TextAlign="OmniAlignment.End" />
        </Columns>
    </OmniDataGrid>
</div>
