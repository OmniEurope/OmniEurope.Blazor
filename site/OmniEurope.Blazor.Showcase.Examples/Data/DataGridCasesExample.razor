@* The grid in its everyday form, with one column of each filter shape and each text alignment. The
   columns say nothing about their filter and follow the grid, which filters by default; Amount takes
   itself out with Filterable="false". Its footer bar, inside the table's frame, carries the export buttons
   at its end (FooterBarExport), each with its format written beside the icon (ShowExportButtonText): each
   writes every row the filters select and not the page on screen. Every format is on by default; Markdown,
   CSV and Excel come from the package, while PDF only gets a button in a host that registers an
   IOmniTableExportRenderer, which this static site does not. *@
<OmniDataGrid TItem="CaseRow"
              Items="CaseData.Rows"
              ShowFooterBar="true"
              FooterBarExport="OmniDataGridBarExport.End"
              ShowExportButtonText="true"
              ExportFileName="open-cases"
              Caption="Open cases"
              AllowSorting="true"
              ScrollMode="OmniDataGridScrollMode.Paged"
              PageSize="5"
              HeaderWrap="OmniDataGridHeaderWrap.Truncate">
    <Columns>
        <OmniDataGridColumn TItem="CaseRow" Property="Reference" Title="Reference"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            TextAlign="OmniAlignment.Start" />
        <OmniDataGridColumn TItem="CaseRow" Property="Applicant" Title="Applicant"
                            FilterType="OmniDataGridColumnFilterType.Text"
                            SortOrder="OmniDataGridSortOrder.Ascending" />
        <OmniDataGridColumn TItem="CaseRow" Property="Country" Title="Country"
                            FilterType="OmniDataGridColumnFilterType.Select"
                            TextAlign="OmniAlignment.Center" />
        <OmniDataGridColumn TItem="CaseRow" Property="Amount" Filterable="false" Title="Amount" FormatString="{0:C0}"
                            TextAlign="OmniAlignment.End"
                            SortOrder="OmniDataGridSortOrder.Descending" />
    </Columns>
</OmniDataGrid>
