@* A file field that checks the count, size and type of the files, as a single-file field and as a several-file
   field whose list grows and shrinks one line at a time. The Upload callback reads each accepted file in the
   browser and reports its progress: nothing is sent to a server. The checks (count, size, type) also run in the
   browser, on what it says about the files: they never replace a check on the server. *@
<OmniStack Gap="OmniSpacing.Large">
    <OmniAlert Severity="OmniSeverity.Info">The files you choose are read in your browser and never leave your computer: no request is sent to a server.</OmniAlert>

    <OmniStack Gap="OmniSpacing.Small">
        <OmniHeading Level="OmniHeadingLevel.H3">Single file</OmniHeading>
        <OmniLabel For="upload-single">Supporting document</OmniLabel>
        <OmniUpload Id="upload-single"
                    @bind-Files="SingleFiles"
                    MaximumFileSize="MaximumFileSize"
                    AllowedContentTypes="AllowedContentTypes"
                    Disabled="Disabled"
                    Upload="ReadAsync"
                    OnFileRemove="OnFileRemoved" />
        <OmniText Tone="OmniTextTone.Muted">@AcceptedTypesEcho</OmniText>
    </OmniStack>

    <OmniStack Gap="OmniSpacing.Small">
        <OmniHeading Level="OmniHeadingLevel.H3">Several files</OmniHeading>
        <OmniLabel For="upload-multiple">Case attachments</OmniLabel>
        <OmniUpload Id="upload-multiple"
                    Multiple="true"
                    @bind-Files="AttachedFiles"
                    MaximumFiles="MaximumFiles"
                    MaximumFileSize="MaximumFileSize"
                    AllowedContentTypes="AllowedContentTypes"
                    Disabled="Disabled"
                    Upload="ReadAsync"
                    OnFileRemove="OnFileRemoved" />
        <OmniText Tone="OmniTextTone.Muted">@AttachedEcho</OmniText>
        <OmniText Tone="OmniTextTone.Muted">Last file removed: <strong>@(LastRemoved ?? "none")</strong></OmniText>
    </OmniStack>

    <OmniStack Gap="OmniSpacing.Small">
        <OmniHeading Level="OmniHeadingLevel.H3">Read in the browser</OmniHeading>
        @if (ReadFiles.Count == 0)
        {
            <OmniText Tone="OmniTextTone.Muted">No file accepted yet. A refused selection leaves this list as it was.</OmniText>
        }
        else
        {
            <div>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Type</th>
                            <th scope="col">Size</th>
                            <th scope="col">Modified</th>
                            <th scope="col">Read in the browser</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in ReadFiles)
                        {
                            <tr>
                                <td>@file.Name</td>
                                <td><code>@file.ContentType</code></td>
                                <td>@file.Size</td>
                                <td>@file.Modified</td>
                                <td>@file.Content</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <OmniText Tone="OmniTextTone.Muted">@TotalEcho</OmniText>
        }
    </OmniStack>
</OmniStack>
