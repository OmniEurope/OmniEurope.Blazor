@* Size: Small is the compact tile (tighter padding, a smaller value), Medium the standard one, Large the roomy one.
   The value starts from the size of the tile and still shrinks to fit its width. The same figures in the three. *@
<OmniStack Gap="OmniSpacing.Medium">
    <OmniTileGrid Id="demo-stat-tile-size-small" Columns="3">
        <OmniStatTile Size="OmniControlSize.Small" Value="12,4 k" Title="Tokens today">
            <Icon><OmniIcon Name="OmniIconName.ChartBar" /></Icon>
        </OmniStatTile>
        <OmniStatTile Size="OmniControlSize.Small" Value="08/11/2026 10:27" Title="Updated">
            <Icon><OmniIcon Name="OmniIconName.CalendarBlank" /></Icon>
        </OmniStatTile>
