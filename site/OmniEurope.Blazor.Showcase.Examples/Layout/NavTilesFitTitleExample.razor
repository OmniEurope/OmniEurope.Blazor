@* FitTitle: on six narrow columns the title shrinks to stay on one line, aligned to the start, without
   breaking a word; a title still too long for the smallest size ends with an ellipsis. *@
<OmniRow Gap="OmniSpacing.Medium">
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/breadcrumbs-links" Title="Breadcrumbs and links" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.ArrowRight" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/profile-menu" Title="Profile menu" Tone="OmniTone.Info" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.User" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/icons" Title="Icons and pictograms" Tone="OmniTone.Success" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.Image" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/notifications" Title="Notifications" Tone="OmniTone.Warning" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.Bell" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/settings-sections" Title="Settings sections" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.Settings" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="6" MediumSpan="2">
        <OmniNavTile Href="components/stat-tiles" Title="Stat tiles" Tone="OmniTone.Info" FitTitle="FitTitle">
            <Icon><OmniIcon Name="OmniIconName.ChartBar" /></Icon>
        </OmniNavTile>
    </OmniColumn>
</OmniRow>
