@* A favorite toggle on a navigation tile: IsFavorite draws the star in the corner, bound two ways. The star is a
   sibling of the link, so toggling it never opens the destination. *@
<OmniRow Gap="OmniSpacing.Medium" Id="gallery-nav-tile-favorites">
    <OmniColumn Span="12" MediumSpan="4">
        <OmniNavTile Id="gallery-nav-tile-favorite-cards" Href="components/cards" Title="Cards" Description="Content framed in a header, a body and a footer" @bind-IsFavorite="CardsFavorite">
            <Icon><OmniIcon Name="OmniIconName.Cards" /></Icon>
        </OmniNavTile>
    </OmniColumn>
    <OmniColumn Span="12" MediumSpan="4">
        <OmniNavTile Id="gallery-nav-tile-favorite-stats" Href="components/stat-tiles" Title="Stat tiles" Description="A figure, its label and a detail line" @bind-IsFavorite="StatsFavorite">
            <Icon><OmniIcon Name="OmniIconName.ChartBar" /></Icon>
        </OmniNavTile>
    </OmniColumn>
</OmniRow>
