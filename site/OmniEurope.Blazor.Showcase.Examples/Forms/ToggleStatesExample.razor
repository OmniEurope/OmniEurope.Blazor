@* Each control in each state: true, false, null, then disabled with a value and disabled at null. A control
   without a third state shows n/a in the null columns. Every cell has its own value: the controls need a
   bound expression, and a shared value would flip a whole row at once. *@
<table>
    <thead>
        <tr>
            <th scope="col">Control</th>
            <th scope="col">True</th>
            <th scope="col">False</th>
            <th scope="col">Null</th>
            <th scope="col">Disabled</th>
            <th scope="col">Disabled null</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">Check box</th>
            <td><OmniCheckBox @bind-Value="CheckTrue" aria-label="Check box, true" /></td>
            <td><OmniCheckBox @bind-Value="CheckFalse" aria-label="Check box, false" /></td>
            <td>n/a</td>
            <td><OmniCheckBox @bind-Value="CheckDisabled" Disabled="true" aria-label="Check box, disabled" /></td>
            <td>n/a</td>
        </tr>
        <tr>
            <th scope="row">Three-state check box</th>
            <td><OmniCheckBox @bind-Value="NullableCheckTrue" aria-label="Three-state check box, true" /></td>
            <td><OmniCheckBox @bind-Value="NullableCheckFalse" aria-label="Three-state check box, false" /></td>
            <td><OmniCheckBox @bind-Value="NullableCheckNull" aria-label="Three-state check box, null" /></td>
            <td><OmniCheckBox @bind-Value="NullableCheckDisabled" Disabled="true" aria-label="Three-state check box, disabled" /></td>
            <td><OmniCheckBox @bind-Value="NullableCheckDisabledNull" Disabled="true" aria-label="Three-state check box, disabled null" /></td>
        </tr>
        <tr>
            <th scope="row">Switch</th>
            <td><OmniSwitch @bind-Value="SwitchTrue" aria-label="Switch, true" /></td>
            <td><OmniSwitch @bind-Value="SwitchFalse" aria-label="Switch, false" /></td>
            <td>n/a</td>
            <td><OmniSwitch @bind-Value="SwitchDisabled" Disabled="true" aria-label="Switch, disabled" /></td>
            <td>n/a</td>
        </tr>
        <tr>
            <th scope="row">Three-state switch</th>
            <td><OmniSwitch @bind-Value="NullableSwitchTrue" aria-label="Three-state switch, true" /></td>
            <td><OmniSwitch @bind-Value="NullableSwitchFalse" aria-label="Three-state switch, false" /></td>
            <td><OmniSwitch @bind-Value="NullableSwitchNull" aria-label="Three-state switch, null" /></td>
            <td><OmniSwitch @bind-Value="NullableSwitchDisabled" Disabled="true" aria-label="Three-state switch, disabled" /></td>
            <td><OmniSwitch @bind-Value="NullableSwitchDisabledNull" Disabled="true" aria-label="Three-state switch, disabled null" /></td>
        </tr>
    </tbody>
</table>
