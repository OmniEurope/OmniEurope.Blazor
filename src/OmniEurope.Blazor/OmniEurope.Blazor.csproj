<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- The package ships lib/net10.0 and lib/net11.0 (user decision 2026-11-11, net9.0 dropped): a .NET 10
         consumer keeps the 10.0 framework packages, a .NET 11 consumer gets the 11.0 ones. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single net11.0 of Directory.Build.props, or the outer build would not fan out. -->
    <TargetFramework></TargetFramework>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors): the
         file ships in the package so consumers get IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nullability attributes only on the public and protected surface, where consumers read them:
         on private and internal members they only weighed down the assembly. -->
    <Features>$(Features);nullablePublicOnly</Features>
    <PackageId>OmniEurope.Blazor</PackageId>
    <Version>1.12.2</Version>
    <Authors>OmniEurope contributors</Authors>
    <Company>OmniEurope</Company>
    <Description>Accessible, themeable Blazor components that run under a strict Content Security Policy, on Server, WebAssembly, Interactive Auto and MAUI Blazor Hybrid.</Description>
    <PackageTags>blazor;components;csp;accessibility;eupl</PackageTags>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/OmniEurope/OmniEurope.Blazor</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <!-- The built-in icon outlines, read once by Internal/PhosphorIconGlyphs.cs. -->
    <EmbeddedResource Include="Internal\PhosphorIcons.txt" LogicalName="OmniEurope.Blazor.PhosphorIcons.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/sbom.cdx.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-packages.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../eng/vendored-assets.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-licenses/*" Pack="true" PackagePath="compliance/licenses/" />
    <!-- OE0001 ships beside the library; Directory.Build.props references the analyzer project, which
         builds it first. The compiler that loads it provides Roslyn: nothing else is packed. -->
    <None Include="../OmniEurope.Blazor.Analyzers/bin/$(Configuration)/netstandard2.0/OmniEurope.Blazor.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

  <Import Project="../../eng/OmniEurope.Stylesheet.targets" />
</Project>

