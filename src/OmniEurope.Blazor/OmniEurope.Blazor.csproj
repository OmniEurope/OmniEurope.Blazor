<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- The package ships lib/net10.0 and lib/net11.0 (user decision 2026-11-11, net9.0 dropped): a .NET 10
         consumer keeps the 10.0 framework packages, a .NET 11 consumer gets the 11.0 ones. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Clears the single net11.0 of Directory.Build.props, or the outer build would not fan out. -->
    <TargetFramework></TargetFramework>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors): the
         file ships in the package so consumers get IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nullability attributes only on the public and protected surface, where consumers read them:
         on private and internal members they only weighed down the assembly. -->
    <Features>$(Features);nullablePublicOnly</Features>
    <PackageId>OmniEurope.Blazor</PackageId>
    <Version>1.15.2</Version>
    <Authors>OmniEurope contributors</Authors>
    <Company>OmniEurope</Company>
    <Description>Accessible, themeable Blazor components that run under a strict Content Security Policy, on Server, WebAssembly, Interactive Auto and MAUI Blazor Hybrid.</Description>
    <PackageTags>blazor;components;csp;accessibility;eupl</PackageTags>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/OmniEurope/OmniEurope.Blazor</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Deterministic pack (Deterministic is on in Directory.Build.props): NuGet stamps every ZIP entry with
       DeterministicTimestamp instead of the pack time, so two packs of one build are byte for byte identical
       (eng/Test-DeterministicPack.ps1 proves it in CI); a date string, not a boolean ("true" is ignored).
       The stamp is the commit time of HEAD, never a constant: NuGet gives the extracted files that time, and
       the WebAssembly SDK converts a DLL to webcil only when it is newer than the previous webcil output, so a
       constant older than any build left consumers on the previous OE version after an upgrade (1.14.0,
       reported by Astranya). A later release commit always carries a later stamp. -->
  <Target Name="_OmniSetPackTimestampFromCommit" BeforeTargets="GenerateNuspec" Condition="'$(DeterministicTimestamp)' == ''">
    <PropertyGroup>
      <!-- Exec runs a .cmd batch on Windows, where a single % is swallowed. -->
      <_OmniCommitTimeFormat Condition="'$(OS)' == 'Windows_NT'">%25%25cI</_OmniCommitTimeFormat>
      <_OmniCommitTimeFormat Condition="'$(OS)' != 'Windows_NT'">%25cI</_OmniCommitTimeFormat>
    </PropertyGroup>
    <Exec Command="git log -1 --format=$(_OmniCommitTimeFormat) HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="DeterministicTimestamp" />
    </Exec>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DeterministicTimestamp)', '^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(Z|[+-]\d\d:\d\d)$'))"
           Text="Pack needs the commit time of HEAD for DeterministicTimestamp (git log returned '$(DeterministicTimestamp)'). Pack from a git checkout or pass -p:DeterministicTimestamp=yyyy-MM-ddTHH:mm:ssZ." />
  </Target>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <!-- The built-in icon outlines, read once by Internal/PhosphorIconGlyphs.cs. -->
    <EmbeddedResource Include="Internal\PhosphorIcons.txt" LogicalName="OmniEurope.Blazor.PhosphorIcons.txt" />
    <!-- Drops a WebAssembly consumer's stale OE webcil output after an upgrade (see the file). -->
    <None Remove="buildTransitive/OmniEurope.Blazor.targets" />
    <None Include="buildTransitive/OmniEurope.Blazor.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/sbom.cdx.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-packages.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../eng/vendored-assets.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-licenses/*" Pack="true" PackagePath="compliance/licenses/" />
    <!-- OE0001 ships beside the library; Directory.Build.props references the analyzer project, which
         builds it first. The compiler that loads it provides Roslyn: nothing else is packed. -->
    <None Include="../OmniEurope.Blazor.Analyzers/bin/$(Configuration)/netstandard2.0/OmniEurope.Blazor.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

  <Import Project="../../eng/OmniEurope.Stylesheet.targets" />
</Project>

