<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <EnforceRazorCodeBehind>true</EnforceRazorCodeBehind>
    <PackageId>OmniEurope.Blazor</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>OmniEurope contributors</Authors>
    <Company>OmniEurope</Company>
    <Description>Composants Blazor accessibles et compatibles avec une CSP stricte.</Description>
    <PackageTags>blazor;components;csp;accessibility;eupl</PackageTags>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/OmniEurope/OmniEurope.Blazor</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/sbom.cdx.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-packages.json" Pack="true" PackagePath="compliance/" />
    <None Include="../../docs/third-party-licenses/*" Pack="true" PackagePath="compliance/licenses/" />
  </ItemGroup>
</Project>

