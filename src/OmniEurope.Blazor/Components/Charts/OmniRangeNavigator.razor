@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* An overview of every category of the chart, in small columns, under two native range inputs that
   share its width: each input is a slider of the browser (pointer, touch and keyboard, with its
   values), its track transparent so only its handle catches the pointer. The role slider is the
   input's own, written out so it reads in the markup. *@
@if (Count > 0)
{
    <div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-range-navigator", StartOnTop ? "omni-range-navigator--start-on-top" : null)" role="group" aria-label="@LocalizeOr(Label, "RangeNavigatorLabel")">
        <div class="omni-range-navigator__track">
            <svg class="omni-range-navigator__overview" viewBox="@ViewBox" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <rect class="omni-range-navigator__window" x="@N(Start - 0.5)" y="0" width="@N(End - Start + 1)" height="100" />
                @for (var index = 0; index < Totals.Count; index++)
                {
                    var column = Column(index);
                    <rect class="@ColumnClass(index)" x="@N(index - 0.35)" y="@N(column.Y)" width="0.7" height="@N(column.Height)" />
                }
            </svg>
            <input type="range" role="slider" class="omni-range-navigator__handle omni-range-navigator__handle--start"
                   min="0" max="@Last" step="1"
                   aria-label="@LocalizeOr(StartLabel, "RangeNavigatorStart")"
                   aria-valuemin="0" aria-valuemax="@Last" aria-valuenow="@Start" aria-valuetext="@Name(Start)"
                   @bind:get="Start" @bind:set="SetStartAsync" @bind:event="oninput" />
            <input type="range" role="slider" class="omni-range-navigator__handle omni-range-navigator__handle--end"
                   min="0" max="@Last" step="1"
                   aria-label="@LocalizeOr(EndLabel, "RangeNavigatorEnd")"
                   aria-valuemin="0" aria-valuemax="@Last" aria-valuenow="@End" aria-valuetext="@Name(End)"
                   @bind:get="End" @bind:set="SetEndAsync" @bind:event="oninput" />
        </div>
        @* Graduations of the categories under the overview, thinned as the category axis is (the first
           and the last always), in the units of the chart's drawing, as wide as it, so their text is the size
           of the chart's axis text and scales with the width as it does. *@
        <svg class="omni-range-navigator__ticks" viewBox="@TicksViewBox" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            @foreach (var tick in Ticks())
            {
                <g><line x1="@N(tick.X)" y1="0" x2="@N(tick.X)" y2="0.9" /><text x="@N(tick.TextX)" y="4" text-anchor="@tick.Anchor">@tick.Text</text></g>
            }
        </svg>
        @* What the handles name, for the eye; a screen reader hears it as the value of each slider. *@
        <div class="omni-range-navigator__values" aria-hidden="true"><span>@Name(Start)</span><span>@Name(End)</span></div>
    </div>
}
