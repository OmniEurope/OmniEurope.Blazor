@namespace OmniEurope.Blazor.Components
@* When every label does not fit, only one every so many is drawn (the first and the last always),
   so labels never overlap into an unreadable block; each point's hover text still names its
   category, and the chart's data table lists them all. *@
<g class="omni-chart__axis omni-chart__axis--category">
    @if (Context.Horizontal)
    {
        <line x1="@N(Context.PlotLeft)" y1="@N(OmniChartContext.PlotTop)" x2="@N(Context.PlotLeft)" y2="@N(OmniChartContext.PlotBottom)" />
        @foreach (var index in Context.VisibleCategoryIndexes(Labels))
        {
            <g><text x="@N(Context.PlotLeft - 1.5)" y="@N(Context.CategoryPosition(index, Labels.Count))" text-anchor="end" dominant-baseline="central">@Labels[index]</text></g>
        }
    }
    else
    {
        <line x1="@N(Context.PlotLeft)" y1="@N(OmniChartContext.PlotBottom)" x2="@N(Context.PlotRight)" y2="@N(OmniChartContext.PlotBottom)" />
        @foreach (var index in Context.VisibleCategoryIndexes(Labels))
        {
            <g><text x="@N(Context.CategoryPosition(index, Labels.Count))" y="@N(OmniChartContext.PlotBottom + 4.5)" text-anchor="middle">@Labels[index]</text></g>
        }
    }
</g>

@implements IDisposable
