@namespace OmniEurope.Blazor.Components
<g class="omni-chart__labels">
    @for (var index = 0; index < Data.Count; index++)
    {
        var point = Data[index];
        var projected = Projected(index);
        var text = point.Label ?? Formatter?.Invoke(point.Y) ?? OmniChartGeometry.Number(point.Y);
        @* Above the point, or past the end of a horizontal bar. *@
        if (ChartContext?.Horizontal == true)
        {
            <g><text x="@OmniChartGeometry.Number(projected.X + 1.5)" y="@OmniChartGeometry.Number(projected.Y)" dominant-baseline="central">@text</text></g>
        }
        else
        {
            <g><text x="@OmniChartGeometry.Number(projected.X)" y="@OmniChartGeometry.Number(projected.Y - 3)" text-anchor="middle">@text</text></g>
        }
    }
</g>

@implements IDisposable
