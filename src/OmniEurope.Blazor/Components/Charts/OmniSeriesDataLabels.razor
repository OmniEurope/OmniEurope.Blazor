@namespace OmniEurope.Blazor.Components
@if (!Hidden)
{
<g class="@LabelsClass">
    @* Above the point, or past the end of a horizontal bar; with Inside, in the bar. A label that would
       leave the plot is anchored to the plot edge it would cross (recette R1-8). A label that would
       overlap the previous one kept is masked (recette R1-12): its point then carries the value as a
       hover text instead. *@
    @foreach (var label in Layout())
    {
        if (label.Visible)
        {
            <g><text x="@OmniChartGeometry.Number(label.X)" y="@OmniChartGeometry.Number(label.Y)" text-anchor="@label.Anchor" dominant-baseline="@label.Baseline">@label.Text</text></g>
        }
        else
        {
            <circle class="omni-chart__label-hit" cx="@OmniChartGeometry.Number(label.Point.X)" cy="@OmniChartGeometry.Number(label.Point.Y)" r="2"><title>@label.Text</title></circle>
        }
    }
</g>
}

@implements IDisposable
