@namespace OmniEurope.Blazor.Components
@if (!Hidden)
{
<g class="@LabelsClass">
    @for (var index = 0; index < Data.Count; index++)
    {
        var point = Data[index];
        var projected = Projected(index);
        var text = Text(point);
        @* Above the point, or past the end of a horizontal bar; with Inside, in the bar. *@
        if (Inside && ChartContext?.Horizontal == true)
        {
            <g><text x="@OmniChartGeometry.Number(Origin(index).X + 1.5)" y="@OmniChartGeometry.Number(projected.Y)" dominant-baseline="central">@text</text></g>
        }
        else if (Inside)
        {
            <g><text x="@OmniChartGeometry.Number(projected.X)" y="@OmniChartGeometry.Number(projected.Y + 1.5)" text-anchor="middle" dominant-baseline="hanging">@text</text></g>
        }
        else if (ChartContext?.Horizontal == true)
        {
            <g><text x="@OmniChartGeometry.Number(projected.X + 1.5)" y="@OmniChartGeometry.Number(projected.Y)" dominant-baseline="central">@text</text></g>
        }
        else
        {
            <g><text x="@OmniChartGeometry.Number(projected.X)" y="@OmniChartGeometry.Number(projected.Y - 3)" text-anchor="middle">@text</text></g>
        }
    }
</g>
}

@implements IDisposable
