@namespace OmniEurope.Blazor.Components
@if (!Hidden)
{
<g class="omni-chart__markers @ColorClass">
    @for (var index = 0; index < Data.Count; index++)
    {
        @* Outside the range an OmniRangeNavigator shows, the point is not drawn. *@
        if (ChartContext?.InRange(index) == false)
        {
            continue;
        }
        var point = Data[index];
        var projected = Projected(index);
        <circle cx="@OmniChartGeometry.Number(projected.X)" cy="@OmniChartGeometry.Number(projected.Y)" r="@OmniChartGeometry.Number(Radius)"><title>@(ChartContext?.PointTitle(index, point) ?? point.Label ?? OmniChartGeometry.Display(point.Y))</title></circle>
    }
</g>
}

@implements IDisposable
