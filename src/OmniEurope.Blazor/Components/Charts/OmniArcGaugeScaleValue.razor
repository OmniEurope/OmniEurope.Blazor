@namespace OmniEurope.Blazor.Components
<g class="omni-arc-gauge__value @ColorClass">
    <path d="@ValuePath" />
    <text class="omni-arc-gauge__value-text" x="50" y="44" text-anchor="middle" dominant-baseline="central" aria-hidden="@(!ShowValue)" visibility="@(ShowValue ? "visible" : "hidden")">@DisplayValue</text>
</g>
