@namespace OmniEurope.Blazor.Components
@* On the right the legend takes the column right of the plot, which the chart narrows while such a
   legend is present, so an entry never covers a data point. Below, the chart draws it in HTML after
   the drawing, and this part draws nothing inside it. *@
@if (!Below)
{
    <g class="omni-chart__legend" aria-label="@EffectiveLabel">
        @for (var index = 0; index < Items.Count; index++)
        {
            var top = OmniChartContext.PlotTop + (index * 5);
            <rect class="omni-chart-color-@Registration.ColorOf(index)" x="@N(LegendLeft)" y="@N(top)" width="3" height="3" rx="0.5" />
            <g><text x="@N(LegendLeft + 4.5)" y="@N(top + 1.5)" dominant-baseline="central">@Items[index]</text></g>
        }
    </g>
}

@implements IDisposable
