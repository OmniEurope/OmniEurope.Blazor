@namespace OmniEurope.Blazor.Components
@* On the right the legend takes the column right of the plot, which the chart narrows while such a
   legend is present, so an entry never covers a data point. Below or above, the chart draws it in
   HTML after or before the drawing, and this part draws nothing inside it. *@
@if (!Outside)
{
    var entries = Entries;
    @* Named for a legend drawn in an SVG of the host; inside a chart, the image and its data table speak.
       An entry that hides its series is a button of the keyboard too (Tab, then Enter or Space, which the
       page keys of the focus module turn into a click); the drawing stays one image for assistive
       technologies, which read the data table. *@
    <g class="omni-chart__legend" aria-label="@EffectiveLabel" @onfocusin="EnableKeysAsync">
        @for (var index = 0; index < entries.Count; index++)
        {
            var entry = entries[index];
            var top = OmniChartContext.PlotTop + (index * 5);
            @if (CanToggle(entry))
            {
                <g class="@EntryClass(entry)" role="button" tabindex="0" aria-label="@entry.Text"
                   aria-pressed="@(ChartContext!.IsEntryHidden(entry) ? "false" : "true")" data-omni-key-button
                   @onclick="() => Toggle(entry)">
                    <rect class="omni-chart-color-@entry.ColorSlot" x="@N(LegendLeft)" y="@N(top)" width="3" height="3" rx="0.5" />
                    <g><text x="@N(LegendLeft + 4.5)" y="@N(top + 1.5)" dominant-baseline="central">@entry.Text</text></g>
                </g>
            }
            else
            {
                <rect class="omni-chart-color-@entry.ColorSlot" x="@N(LegendLeft)" y="@N(top)" width="3" height="3" rx="0.5" />
                <g><text x="@N(LegendLeft + 4.5)" y="@N(top + 1.5)" dominant-baseline="central">@entry.Text</text></g>
            }
        }
    </g>
}

@implements IDisposable
