@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<figure @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-chart", MinWidthClass)">
    @* A legend above the chart is the same HTML list as one below, placed before the drawing. *@
    @foreach (var legend in _context.LegendsAbove)
    {
        var entries = _context.LegendEntries(legend);
        <ul class="omni-chart__legend omni-chart__legend--above" aria-label="@legend.Label">
            @foreach (var entry in entries)
            {
                <li class="@LegendItemClass(entry)">
                    @if (OmniChartContext.CanToggle(legend, entry))
                    {
                        <button type="button" class="omni-chart__legend-toggle" aria-pressed="@(_context.IsEntryHidden(entry) ? "false" : "true")" @onclick="() => ToggleSeries(entry)"><span class="omni-chart__swatch omni-chart-color-@entry.ColorSlot" aria-hidden="true"></span>@entry.Text</button>
                    }
                    else
                    {
                        <span class="omni-chart__swatch omni-chart-color-@entry.ColorSlot" aria-hidden="true"></span>@entry.Text
                    }
                </li>
            }
        </ul>
    }
    @* One image for assistive technology, named by the title and described by the description when
       there is one; what the drawing shows is read from the data table after it. *@
    <svg class="@SvgClass" viewBox="@ViewBox" role="img" aria-labelledby="@TitleId" aria-describedby="@(HasDescription ? DescriptionId : null)" preserveAspectRatio="xMidYMid meet">
        <title id="@TitleId">@Title</title>
        @if (HasDescription)
        {
            <desc id="@DescriptionId">@Description</desc>
        }
        @* Not fixed: every render of the chart refreshes every part, so a part registered late (a legend
           narrowing the plot, a series turning it into bands) moves the parts that rendered before it. *@
        @* The shared tooltip comes last: its bands lie over the series, and it renders after the
           parts have registered their points and the value axis its format. *@
        @* While an OmniRangeNavigator shows a range, the parts are clipped a little outside the view box:
           a decoration that walks every point of its own (data labels) has those outside the range sent
           far above it. The group is always there, so the parts keep their place when the range starts. *@
        @if (ClipId is not null)
        {
            <clipPath id="@ClipId"><rect x="@ClipLeft" y="-10" width="@ClipWidth" height="120" /></clipPath>
        }
        <g class="omni-chart__parts" clip-path="@ClipReference"><CascadingValue Value="_context" IsFixed="false">@ChildContent@SharedTooltipLayer</CascadingValue></g>
    </svg>
    @* HTML parts under the drawing, such as an OmniRangeNavigator: they share the layout of the chart
       under a name of their own, so a part written in the drawing by mistake can tell. *@
    @if (FooterContent is not null)
    {
        <CascadingValue Name="@OmniChartContext.FooterName" Value="_context" IsFixed="false">@FooterContent</CascadingValue>
    }
    @* A legend below the chart is HTML: it wraps on a narrow screen and keeps the page's text size,
       where text inside the drawing shrinks with it. *@
    @foreach (var legend in _context.LegendsBelow)
    {
        var entries = _context.LegendEntries(legend);
        <ul class="omni-chart__legend omni-chart__legend--below" aria-label="@legend.Label">
            @foreach (var entry in entries)
            {
                <li class="@LegendItemClass(entry)">
                    @if (OmniChartContext.CanToggle(legend, entry))
                    {
                        <button type="button" class="omni-chart__legend-toggle" aria-pressed="@(_context.IsEntryHidden(entry) ? "false" : "true")" @onclick="() => ToggleSeries(entry)"><span class="omni-chart__swatch omni-chart-color-@entry.ColorSlot" aria-hidden="true"></span>@entry.Text</button>
                    }
                    else
                    {
                        <span class="omni-chart__swatch omni-chart-color-@entry.ColorSlot" aria-hidden="true"></span>@entry.Text
                    }
                </li>
            }
        </ul>
    }
    @if (DataTableContent is not null)
    {
        <div class="omni-chart__data">@DataTableContent</div>
    }
    else
    {
        @* Without a table of the host, the chart writes its own for screen readers: one row per
           category, one column per series, and one table per pie. They sit in a hidden block: a table
           ignores the 1px height of the hiding class, keeps the height of its rows and lengthened the
           page under the chart; a block takes it and clips them. *@
        var series = _context.TableSeries;
        var pies = _context.Pies;
        if (series.Count > 0 || pies.Count > 0)
        {
            <div class="omni-chart__tables omni-visually-hidden">
                @if (series.Count > 0)
                {
                    var rows = series.Max(item => item.Data.Count);
                    <table class="omni-chart__table">
                        <caption>@Title</caption>
                        <thead>
                            <tr>
                                <th scope="col">@Localize("ChartCategoryColumn")</th>
                                @for (var column = 0; column < series.Count; column++)
                                {
                                    <th scope="col">@SeriesName(series[column], column)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var row = 0; row < rows; row++)
                            {
                                @* The table follows the range an OmniRangeNavigator shows, like the drawing. *@
                                if (!_context.InRange(row))
                                {
                                    continue;
                                }
                                <tr>
                                    <th scope="row">@RowName(series, row)</th>
                                    @foreach (var item in series)
                                    {
                                        <td>@(row < item.Data.Count ? OmniChartGeometry.Display(item.Data[row].Y) : null)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @foreach (var pie in pies)
                {
                    <table class="omni-chart__table">
                        <caption>@(string.IsNullOrWhiteSpace(pie.Title) ? Title : pie.Title)</caption>
                        <thead>
                            <tr>
                                <th scope="col">@Localize("ChartCategoryColumn")</th>
                                <th scope="col">@Localize("ChartValueColumn")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slice in pie.Slices)
                            {
                                <tr>
                                    <th scope="row">@slice.Label</th>
                                    <td>@OmniChartGeometry.Display(slice.Value)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</figure>

@implements IDisposable
