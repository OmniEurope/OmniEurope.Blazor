@namespace OmniEurope.Blazor.Components
<g class="omni-chart__grid-lines" aria-hidden="true">
    @* One line per band boundary of the plot, the axis itself excepted: with as many grid lines as
       value ticks, each line runs through a tick. *@
    @for (var index = 1; index <= Count; index++)
    {
        if (Context.Horizontal)
        {
            var x = Context.PlotLeft + (index * (Context.PlotRight - Context.PlotLeft) / Count);
            <line x1="@N(x)" y1="@N(OmniChartContext.PlotTop)" x2="@N(x)" y2="@N(OmniChartContext.PlotBottom)" />
        }
        else
        {
            var y = OmniChartContext.PlotBottom - (index * (OmniChartContext.PlotBottom - OmniChartContext.PlotTop) / Count);
            <line x1="@N(Context.PlotLeft)" y1="@N(y)" x2="@N(Context.PlotRight)" y2="@N(y)" />
        }
    }
</g>
