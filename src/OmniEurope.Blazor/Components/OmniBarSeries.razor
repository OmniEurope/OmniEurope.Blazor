<g class="omni-chart__bars @ColorClass" aria-label="@Title">
    @for (var index = 0; index < Data.Count; index++)
    {
        var point = Data[index];
        var height = 80d / Math.Max(1, Data.Count);
        <rect x="10" y="@OmniChartGeometry.Number(10 + index * height)" width="@OmniChartGeometry.Number(OmniChartGeometry.Clamp(point.Y) * 0.8)" height="@OmniChartGeometry.Number(height * 0.75)"><title>@(point.Label ?? point.Y.ToString())</title></rect>
    }
</g>

@code {
    [Parameter] public IReadOnlyList<OmniChartPoint> Data { get; set; } = Array.Empty<OmniChartPoint>();
    [Parameter] public string? Title { get; set; }
    [Parameter] public int ColorIndex { get; set; }
    private string ColorClass => $"omni-chart-color-{Math.Abs(ColorIndex) % 8}";
}
