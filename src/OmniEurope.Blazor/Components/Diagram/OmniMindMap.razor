@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div @attributes="AdditionalAttributes"
     id="@BaseId"
     class="@Css("omni-mindmap", ReadOnly ? "omni-mindmap--readonly" : null)">
    <CascadingValue Value="this" IsFixed="true">
        @ToolbarContent
        <div class="omni-mindmap__workspace">
            <div class="omni-mindmap__frame">
                @if (_selection.IsLinking)
                {
                    <div class="omni-mindmap__banner">
                        <span>@LinkBannerText</span>
                        <span class="omni-mindmap__banner-hint">@Localize("MindMapLinkCancelHint")</span>
                    </div>
                }
                <svg @ref="_canvas"
                     id="@CanvasId"
                     class="@CanvasCss"
                     role="application"
                     tabindex="0"
                     aria-label="@EffectiveLabel"
                     aria-describedby="@HintId"
                     aria-activedescendant="@ActiveDescendant"
                     data-omni-readonly="@(ReadOnly ? "true" : "false")"
                     data-omni-linking="@(_selection.IsLinking ? "true" : "false")"
                     @onkeydown="_keyboard.KeyDownAsync">
                    @if (Directed)
                    {
                        <defs>
                            <marker id="@ArrowId" class="omni-mindmap__arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
                                <path class="omni-mindmap__arrow-head" d="M 0 0 L 10 5 L 0 10 z" />
                            </marker>
                        </defs>
                    }
                    <g class="omni-mindmap__viewport"
                       transform="@MindMapGeometry.View(_viewport.PanX, _viewport.PanY, _viewport.Zoom)"
                       data-pan-x="@MindMapGeometry.Format(_viewport.PanX)"
                       data-pan-y="@MindMapGeometry.Format(_viewport.PanY)"
                       data-zoom="@MindMapGeometry.Format(_viewport.Zoom)">
                        <g class="omni-mindmap__edges">
                            @foreach (var edge in _model.RenderedEdges)
                            {
                                <g @key="edge.Index"
                                   class="@(edge.Index == _selection.EdgeIndex ? "omni-mindmap__edge omni-mindmap__edge--selected" : "omni-mindmap__edge")"
                                   data-omni-edge="@edge.Index"
                                   data-from="@edge.From.Id"
                                   data-to="@edge.To.Id"
                                   data-omni-directed="@(Directed ? "true" : null)">
                                    <path class="omni-mindmap__edge-hit" d="@EdgePath(edge)" />
                                    <path class="omni-mindmap__edge-line" d="@EdgePath(edge)" marker-end="@ArrowReference" />
                                </g>
                            }
                        </g>
                        <g class="omni-mindmap__nodes">
                            @foreach (var node in _model.Drawable)
                            {
                                var size = SizeOf(node);
                                <g @key="node.Id"
                                   id="@NodeElementId(node.Id)"
                                   class="@NodeCss(node)"
                                   role="img"
                                   aria-label="@NodeAccessibleName(node)"
                                   transform="@MindMapGeometry.Translate(node.X, node.Y)"
                                   data-omni-node="@node.Id"
                                   data-omni-selected="@(_selection.IsSelected(node.Id) ? "true" : null)"
                                   data-x="@MindMapGeometry.Format(node.X)"
                                   data-y="@MindMapGeometry.Format(node.Y)">
                                    @foreach (var note in _model.NotesOf(node.Id))
                                    {
                                        var noteSize = _sizes.NoteSize(note);
                                        <g class="omni-mindmap__note" transform="@MindMapGeometry.Translate((size.Width / 2) + 30, -40)">
                                            <line class="omni-mindmap__note-connector" x1="0" y1="0" x2="-30" y2="40" />
                                            <rect class="omni-mindmap__note-shape"
                                                  x="0"
                                                  y="@MindMapGeometry.Format((-noteSize.Height / 2) - 6)"
                                                  width="@MindMapGeometry.Format(noteSize.Width + 16)"
                                                  height="@MindMapGeometry.Format(noteSize.Height + 12)"
                                                  rx="4" />
                                            <text class="omni-mindmap__note-text" x="8" y="2" font-size="12" dominant-baseline="central" data-omni-measure="@MindMapLabelSizes.NoteKey(note.Index)">@note.Note.Text</text>
                                        </g>
                                    }
                                    <rect class="omni-mindmap__node-shape"
                                          x="@MindMapGeometry.Format(-size.Width / 2)"
                                          y="@MindMapGeometry.Format(-size.Height / 2)"
                                          width="@MindMapGeometry.Format(size.Width)"
                                          height="@MindMapGeometry.Format(size.Height)"
                                          rx="10"
                                          ry="10" />
                                    @if (NodeTemplate is not null)
                                    {
                                        @* The host's content, sized by the box; the node keeps its label as its accessible name. *@
                                        <foreignObject class="omni-mindmap__node-content"
                                                       x="@MindMapGeometry.Format(-size.Width / 2)"
                                                       y="@MindMapGeometry.Format(-size.Height / 2)"
                                                       width="@MindMapGeometry.Format(size.Width)"
                                                       height="@MindMapGeometry.Format(size.Height)">
                                            <div class="omni-mindmap__node-template">@NodeTemplate(node)</div>
                                        </foreignObject>
                                    }
                                    else
                                    {
                                        <g><text class="@LabelCss(node)"
                                              x="0"
                                              y="0"
                                              text-anchor="middle"
                                              dominant-baseline="central"
                                              font-size="@MindMapLabelSizes.FontSizeOf(node)"
                                              data-omni-measure="@MindMapLabelSizes.NodeKey(node.Id)">@node.Label</text></g>
                                    }
                                </g>
                            }
                        </g>
                    </g>
                    <rect class="omni-mindmap__lasso" x="0" y="0" width="0" height="0" visibility="hidden" />
                    @if (_menu.State is { } menu)
                    {
                        <foreignObject class="omni-mindmap__menu-host"
                                       x="@MindMapGeometry.Format(_menu.Left(menu))"
                                       y="@MindMapGeometry.Format(_menu.Top(menu))"
                                       width="@MindMapGeometry.Format(MenuWidth)"
                                       height="@MindMapGeometry.Format(_menu.Height(menu))">
                            <div class="omni-mindmap__menu"
                                 role="menu"
                                 tabindex="-1"
                                 aria-label="@Localize("MindMapMenuLabel")"
                                 @onkeydown="_menu.KeyDownAsync"
                                 @onkeydown:stopPropagation="true">
                                @if (menu.NodeId is not null)
                                {
                                    @if (!ReadOnly)
                                    {
                                        <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.RenameAsync">@RenameLabel</button>
                                        <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.DuplicateAsync">@DuplicateLabel</button>
                                        <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.LinkAsync">@AddLinkLabel</button>
                                    }
                                    <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.CenterAsync">@CenterLabel</button>
                                    @if (!ReadOnly)
                                    {
                                        <div class="omni-mindmap__menu-separator" role="separator"></div>
                                        <div class="omni-mindmap__menu-colors" role="group" aria-label="@Localize("MindMapNodeColor")">
                                            @foreach (var group in OmniMindMapGroups.Palette)
                                            {
                                                <button type="button"
                                                        class="@($"omni-mindmap__swatch omni-mindmap__swatch--{group}")"
                                                        role="menuitemradio"
                                                        tabindex="-1"
                                                        aria-checked="@(_menu.IsNodeGroup(menu, group) ? "true" : "false")"
                                                        aria-label="@GroupName(group)"
                                                        title="@GroupName(group)"
                                                        @onclick="() => _menu.ColorAsync(group)"></button>
                                            }
                                        </div>
                                        <div class="omni-mindmap__menu-separator" role="separator"></div>
                                        <button type="button" class="omni-mindmap__menu-item omni-mindmap__menu-item--danger" role="menuitem" tabindex="-1" @onclick="_menu.DeleteAsync">@DeleteLabel</button>
                                    }
                                }
                                else
                                {
                                    @if (!ReadOnly)
                                    {
                                        <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.AddNodeAsync">@AddNodeLabel</button>
                                        <div class="omni-mindmap__menu-separator" role="separator"></div>
                                        <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.AutoLayoutAsync">@AutoLayoutLabel</button>
                                    }
                                    <button type="button" class="omni-mindmap__menu-item" role="menuitem" tabindex="-1" @onclick="_menu.FitViewAsync">@FitViewLabel</button>
                                }
                            </div>
                        </foreignObject>
                    }
                </svg>
            </div>
            @PanelContent
        </div>
        <p id="@HintId" class="omni-visually-hidden">@KeyboardHint</p>
        <div class="omni-visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_announcement</div>
    </CascadingValue>
</div>
