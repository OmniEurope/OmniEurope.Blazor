@inherits OmniComponentBase

<section id="@Id" class="@Css("omni-card")" @attributes="AdditionalAttributes">
    @if (Header is not null)
    {
        <header class="omni-card__header">@Header</header>
    }
    <div class="omni-card__body">@ChildContent</div>
    @if (Footer is not null)
    {
        <footer class="omni-card__footer">@Footer</footer>
    }
</section>

@code {
    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }
}

