@inherits OmniComponentBase

<nav @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-pager")" aria-label="@Label">
    <button type="button" class="omni-pager__button" disabled="@(Page <= 1 || Disabled)" aria-label="Page précédente" @onclick="() => SelectAsync(Page - 1)">‹</button>
    <span class="omni-pager__status" aria-live="polite">Page @Page sur @PageCount</span>
    <button type="button" class="omni-pager__button" disabled="@(Page >= PageCount || Disabled)" aria-label="Page suivante" @onclick="() => SelectAsync(Page + 1)">›</button>
</nav>

@code {
    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public int PageCount { get; set; } = 1;

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Pagination";

    [Parameter]
    public bool Disabled { get; set; }

    private Task SelectAsync(int page) => Disabled || page < 1 || page > PageCount ? Task.CompletedTask : PageChanged.InvokeAsync(page);
}
