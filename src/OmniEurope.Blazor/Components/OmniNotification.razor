@inherits OmniComponentBase

<article @attributes="AdditionalAttributes"
         id="@Id"
         class="@Css("omni-notification", SeverityClass)"
         role="@Role"
         aria-live="@LiveMode">
    <div class="omni-notification__content">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <strong class="omni-notification__title">@Title</strong>
        }
        <span>@Message</span>
    </div>
    @if (Dismissible)
    {
        <button type="button" class="omni-notification__dismiss" aria-label="Ignorer la notification" @onclick="OnDismiss">×</button>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public OmniNotificationSeverity Severity { get; set; }

    [Parameter]
    public bool Dismissible { get; set; } = true;

    [Parameter]
    public EventCallback OnDismiss { get; set; }

    private string SeverityClass => $"omni-notification--{Severity.ToString().ToLowerInvariant()}";
    private string Role => Severity == OmniNotificationSeverity.Error ? "alert" : "status";
    private string LiveMode => Severity == OmniNotificationSeverity.Error ? "assertive" : "polite";
}
