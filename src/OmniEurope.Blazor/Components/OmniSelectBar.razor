@typeparam TValue
@inherits OmniInputBase<TValue>

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@InputCss("omni-select-bar")"
     role="radiogroup"
     aria-label="@Label"
     aria-invalid="@AriaInvalid">
    @foreach (var option in Options)
    {
        <OmniSelectBarItem TValue="TValue"
                           Value="@option.Value"
                           Selected="@IsSelected(option.Value)"
                           Disabled="@(Disabled || option.Disabled)"
                           SelectedValueChanged="Select">@option.Text</OmniSelectBarItem>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OmniOption<TValue>> Options { get; set; } = Array.Empty<OmniOption<TValue>>();

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool IsSelected(TValue value) => EqualityComparer<TValue>.Default.Equals(CurrentValue, value);

    private void Select(TValue? value)
    {
        if (!Disabled)
        {
            CurrentValue = value!;
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = "La sélection segmentée n'est pas valide.";
        return false;
    }
}
