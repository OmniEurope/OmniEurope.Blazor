@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<section @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-step-timeline", VisibleColumns.Count > 0 ? "omni-step-timeline--columns" : null)" aria-label="@EffectiveLabel">
    @if (Layout.Bars.Count > 0)
    {
        @* The axis every track shares: the start of the run on the left, its length on the right. *@
        <div class="omni-step-timeline__row omni-step-timeline__head" aria-hidden="true">
            <span></span>
            <span class="omni-step-timeline__scale">
                <span>@StepTimelineLayout.Format(TimeSpan.Zero)</span>
                <span>@StepTimelineLayout.Format(Layout.Total)</span>
            </span>
            <span></span>
            @if (VisibleColumns.Count > 0)
            {
                <span class="omni-step-timeline__columns">
                    @foreach (var column in VisibleColumns)
                    {
                        <span class="omni-step-timeline__column" title="@column.Description">@column.Title</span>
                    }
                </span>
            }
        </div>
        <ol class="omni-step-timeline__steps">
            @foreach (var bar in Layout.Bars)
            {
                var progress = StepTimelineLayout.ProgressOf(bar);
                <li class="@RowCss(bar.Step)">
                    <span class="omni-step-timeline__name">@bar.Step.Name</span>
                    @* Percentages are SVG lengths: the bar is placed by geometry attributes, never by a style. *@
                    <svg class="omni-step-timeline__track" aria-hidden="true" focusable="false">
                        <rect class="omni-step-timeline__rail" x="0" y="0" width="100%" height="100%" rx="3" />
                        <rect class="omni-step-timeline__bar" x="@Percent(bar.OffsetPercent)" y="0" width="@Percent(bar.WidthPercent)" height="100%" rx="3" />
                        @if (progress is { } fill)
                        {
                            <rect class="omni-step-timeline__progress" x="@Percent(bar.OffsetPercent)" y="0" width="@Percent(bar.WidthPercent * fill.Fill)" height="100%" rx="3" />
                            @if (fill.Overrun > 0)
                            {
                                <rect class="omni-step-timeline__overrun" x="@Percent(bar.OffsetPercent)" y="0" width="@Percent(bar.WidthPercent * fill.Overrun)" height="100%" rx="3" />
                            }
                        }
                    </svg>
                    <span class="omni-visually-hidden">@Describe(bar)</span>
                    <span class="omni-step-timeline__duration">@StepTimelineLayout.Format(bar.Duration)</span>
                    @if (progress is { } described)
                    {
                        <span class="omni-visually-hidden">@DescribeProgress(described)</span>
                    }
                    @if (VisibleColumns.Count > 0)
                    {
                        <span class="omni-step-timeline__columns">
                            @foreach (var column in VisibleColumns)
                            {
                                var cell = column.Value(bar.Step);
                                @* The header row is hidden from assistive technology, so each value is heard with its title. *@
                                <span class="omni-step-timeline__column">
                                    <span aria-hidden="true">@cell</span>
                                    @if (!string.IsNullOrEmpty(cell))
                                    {
                                        <span class="omni-visually-hidden">@Localize("StepTimelineColumnValue", column.Title, cell)</span>
                                    }
                                </span>
                            }
                        </span>
                    }
                </li>
            }
        </ol>
    }
    @if (Layout.NeverStarted.Count > 0)
    {
        @* Named rather than drawn: a bar for a step that never ran would put a shape on the time axis
           for something that occupied none of it. *@
        <p class="omni-step-timeline__never">
            <span class="omni-step-timeline__never-label">@Localize("StepTimelineNeverStarted")</span>
            @string.Join(", ", Layout.NeverStarted.Select(step => step.Name))
        </p>
    }
</section>
