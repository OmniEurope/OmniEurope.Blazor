@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@{
    // The time and title of an appointment, as a button when the host listens for clicks, then its
    // move button when appointments can be moved. The day list adds the end time and the description.
    void AppointmentBody(OmniSchedulerAppointment appointment, bool detailed)
    {
        var time = detailed
            ? $"{appointment.Start.ToString("t", Formats)}–{appointment.End.ToString("t", Formats)}"
            : appointment.Start.ToString("t", Formats);
        if (Clickable)
        {
            <button type="button" class="omni-scheduler__open" @onclick="() => ClickAsync(appointment)"><time datetime="@appointment.Start.ToString("O")">@time</time> <strong>@appointment.Title</strong></button>
        }
        else
        {
            <time datetime="@appointment.Start.ToString("O")">@time</time><strong>@appointment.Title</strong>
        }
        if (detailed && !string.IsNullOrWhiteSpace(appointment.Description))
        {
            <span>@appointment.Description</span>
        }
        if (Movable)
        {
            <button type="button" class="omni-scheduler__move" aria-label="@Text("SchedulerMoveAppointment", appointment.Title)" aria-pressed="@(_moving?.Local.Id == appointment.Id ? "true" : "false")" @onclick="() => PickUp(appointment)"><span aria-hidden="true">⇄</span></button>
        }
    }

    // An appointment in a week day, a month day or a time-grid cell.
    void AppointmentItem(OmniSchedulerAppointment appointment)
    {
        <div class="@AppointmentCss(appointment)" data-omni-scheduler-appointment="@appointment.Id" draggable="@(Movable ? "true" : null)" @ondragstart="() => StartDrag(appointment)" @ondragend="EndDrag">
            @{ AppointmentBody(appointment, false); }
        </div>
    }

    // The free area of a slot or a day as a button, under its appointments, while the host listens for
    // slot clicks and nothing is being moved; its accessible name gives the date, and the time of a slot.
    void SlotButton(DateOnly day, int? slotIndex)
    {
        if (SlotClickable && _moving is null)
        {
            var slot = CreateSlot(day, slotIndex);
            <button type="button" class="omni-scheduler__slot" aria-label="@SlotLabel(slot, slotIndex is not null)" @onclick="() => SlotClickAsync(slot)"><span class="omni-scheduler__slot-mark" aria-hidden="true">+</span></button>
        }
    }

    // While an appointment is picked up, the button that puts it in this cell.
    void PlaceButton(MoveTarget target)
    {
        if (_moving is { } moving && CanPlace(target))
        {
            <button type="button" class="omni-scheduler__place" aria-label="@Text("SchedulerMoveHere", moving.Local.Title, TargetLabel(moving, target))" @onclick="() => PlaceAsync(target)">@Text("SchedulerMoveHereShort")</button>
        }
    }
}

<section @ref="_root" @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-scheduler", _moving is null ? null : "omni-scheduler--moving")" aria-busy="@(_loading ? "true" : "false")" @onkeydown="OnKeyDown">
    <header class="omni-scheduler__header">
        <button type="button" class="omni-button" aria-label="@Text("SchedulerPreviousPeriod")" @onclick="PreviousAsync">‹</button>
        <button type="button" class="omni-button" @onclick="TodayAsync">@Text("Today")</button>
        <button type="button" class="omni-button" aria-label="@Text("SchedulerNextPeriod")" @onclick="NextAsync">›</button>
        @if (_moving is not null)
        {
            <button type="button" class="omni-button omni-scheduler__cancel" @onclick="CancelMove">@Text("SchedulerMoveCancel")</button>
        }
        <div class="omni-select-bar" role="radiogroup" aria-label="@Text("SchedulerViewLabel")">
            @foreach (var view in Enum.GetValues<OmniCalendarView>())
            {
                <button type="button" class="@ViewClass(view)" role="radio" aria-checked="@(_view == view ? "true" : "false")" @onclick="() => ChangeViewAsync(view)">@ViewLabel(view)</button>
            }
        </div>
    </header>
    @if (_error is not null)
    {
        <div class="omni-scheduler__state" role="alert">
            @if (ErrorContent is not null)
            {
                @ErrorContent(_error)
            }
            else
            {
                @Text("SchedulerLoadFailed")
            }
            <button type="button" class="omni-button" @onclick="ReloadAsync">@Text("Retry")</button>
        </div>
    }
    else if (_loading)
    {
        <div class="omni-scheduler__state" role="status">
            @if (LoadingContent is not null)
            {
                @LoadingContent
            }
            else
            {
                @Text("Loading")
            }
        </div>
    }
    else
    {
        var date = LocalDate;
        var appointments = LocalAppointments;
        var today = LocalToday;
        @if (_view != OmniCalendarView.Month && HasTimeGrid)
        {
            var days = _view == OmniCalendarView.Day
                ? new[] { DateOnly.FromDateTime(date.Date) }
                : WeekDays(date).Select(day => DateOnly.FromDateTime(day.Date)).ToArray();
            <div class="omni-scheduler-view omni-scheduler-grid" role="region" aria-label="@Text(_view == OmniCalendarView.Day ? "DayViewLabel" : "WeekViewLabel")">
                <table class="omni-scheduler-grid__table">
                    <thead>
                        <tr>
                            <th scope="col" class="omni-scheduler-grid__time"><span class="omni-visually-hidden">@Text("SchedulerTimeColumn")</span></th>
                            @foreach (var day in days)
                            {
                                <th scope="col" class="@DayCss("omni-scheduler-grid__day", day, today)" aria-current="@(day == today ? "date" : null)">@day.ToString("ddd d", Formats)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var slot = 0; slot < SlotCount; slot++)
                        {
                            var slotIndex = slot;
                            var slotStart = SlotStart(slotIndex);
                            <tr>
                                <th scope="row" class="omni-scheduler-grid__time"><time datetime="@slotStart.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)">@slotStart.ToString("t", Formats)</time></th>
                                @foreach (var day in days)
                                {
                                    var target = new MoveTarget(day, slotIndex);
                                    <td class="@PastCss(TargetCss(DayCss("omni-scheduler-grid__cell", day, today), target), day, slotIndex)"
                                        @ondragenter="() => DragEnter(target)"
                                        @ondragover:preventDefault="@Movable"
                                        @ondrop="() => DropAsync(target)"
                                        @ondrop:preventDefault="@Movable">
                                        @{ SlotButton(day, slotIndex); }
                                        @foreach (var appointment in AppointmentsInSlot(appointments, day, slotIndex))
                                        {
                                            AppointmentItem(appointment);
                                        }
                                        @{ PlaceButton(target); }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @switch (_view)
            {
                case OmniCalendarView.Day:
                    <section class="@PastCss("omni-scheduler-view omni-day-view", DateOnly.FromDateTime(date.Date), null)" aria-label="@Text("DayViewLabel")">
                        @{ SlotButton(DateOnly.FromDateTime(date.Date), null); }
                        @* The date of a view is not a heading: the host decides the outline of its page. *@
                        <p class="omni-scheduler__date"><time datetime="@date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@date.ToString("D", Formats)</time></p>
                        <ol class="omni-scheduler__appointments">
                            @foreach (var appointment in AppointmentsOn(appointments, date.Date))
                            {
                                <li class="@AppointmentCss(appointment)" data-omni-scheduler-appointment="@appointment.Id" data-start="@appointment.Start.ToString("O")" data-end="@appointment.End.ToString("O")" data-duration-minutes="@DurationMinutes(appointment)">@{ AppointmentBody(appointment, true); }</li>
                            }
                        </ol>
                    </section>
                    break;
                case OmniCalendarView.Week:
                    <section class="omni-scheduler-view omni-week-view" aria-label="@Text("WeekViewLabel")">
                        @foreach (var weekDay in WeekDays(date))
                        {
                            var day = DateOnly.FromDateTime(weekDay.Date);
                            var target = new MoveTarget(day, null);
                            <article class="@PastCss(TargetCss(DayCss("omni-week-view__day", day, today), target), day, null)" aria-current="@(day == today ? "date" : null)"
                                     @ondragenter="() => DragEnter(target)"
                                     @ondragover:preventDefault="@Movable"
                                     @ondrop="() => DropAsync(target)"
                                     @ondrop:preventDefault="@Movable">
                                @{ SlotButton(day, null); }
                                <time class="omni-scheduler__date" datetime="@day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@weekDay.ToString("ddd d", Formats)</time>
                                @foreach (var appointment in AppointmentsOn(appointments, weekDay.Date))
                                {
                                    AppointmentItem(appointment);
                                }
                                @{ PlaceButton(target); }
                            </article>
                        }
                    </section>
                    break;
                default:
                    @* A table of weeks: each day number is heard with the day name of its column. The rows
                       are display: contents, so the seven-column grid of the stylesheet lays out the cells. *@
                    <section class="omni-scheduler-view omni-month-view" role="table" aria-label="@Text("MonthViewLabel")">
                        <div class="omni-month-view__week" role="row">
                            @foreach (var dayName in MonthDayNames)
                            {
                                <div class="omni-month-view__weekday" role="columnheader">@dayName</div>
                            }
                        </div>
                        @foreach (var week in MonthCells(date).Chunk(7))
                        {
                            <div class="omni-month-view__week" role="row">
                                @foreach (var cell in week)
                                {
                                    if (cell is not { } day)
                                    {
                                        <div class="omni-month-view__day omni-month-view__day--outside" role="cell"></div>
                                    }
                                    else
                                    {
                                        var target = new MoveTarget(day, null);
                                        <div class="@PastCss(TargetCss(DayCss("omni-month-view__day", day, today), target), day, null)" role="cell" aria-current="@(day == today ? "date" : null)" data-date="@day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                                             @ondragenter="() => DragEnter(target)"
                                             @ondragover:preventDefault="@Movable"
                                             @ondrop="() => DropAsync(target)"
                                             @ondrop:preventDefault="@Movable">
                                            @{ SlotButton(day, null); }
                                            <time class="omni-scheduler__date" datetime="@day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@day.Day.ToString(Formats)</time>
                                            @foreach (var appointment in AppointmentsOn(appointments, day.ToDateTime(TimeOnly.MinValue)))
                                            {
                                                AppointmentItem(appointment);
                                            }
                                            @{ PlaceButton(target); }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </section>
                    break;
            }
        }
    }
    <div class="omni-visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_announcement</div>
</section>
