@inherits OmniComponentBase
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-upload")">
    <InputFile class="omni-input omni-upload__input"
               OnChange="HandleFilesAsync"
               multiple="@Multiple"
               accept="@Accept"
               disabled="@(Disabled || _uploading)" />

    @if (_files.Count > 0)
    {
        <ul class="omni-upload__files" aria-label="Fichiers sélectionnés">
            @foreach (var file in _files)
            {
                <li><span>@file.Name</span><span>@FormatSize(file.Size)</span></li>
            }
        </ul>
    }

    @if (_uploading || _progress > 0)
    {
        <OmniProgressBar Value="@_progress" Label="Téléversement" />
    }
    @if (_uploading)
    {
        <button type="button" class="omni-button omni-upload__cancel" @onclick="Cancel">Annuler</button>
    }
    else if (_canRetry)
    {
        <button type="button" class="omni-button omni-upload__retry" @onclick="RetryAsync">Réessayer</button>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="@MessageClass" role="status" aria-live="polite">@_message</p>
    }
</div>

@code {
    private CancellationTokenSource? _uploadCancellation;
    private IReadOnlyList<IBrowserFile> _files = Array.Empty<IBrowserFile>();
    private bool _uploading;
    private bool _canRetry;
    private double _progress;
    private string? _message;
    private bool _hasError;

    [Parameter]
    public bool Multiple { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public int MaximumFiles { get; set; } = 10;

    [Parameter]
    public long MaximumFileSize { get; set; } = 10 * 1024 * 1024;

    [Parameter]
    public IReadOnlyList<string> AllowedContentTypes { get; set; } = Array.Empty<string>();

    [Parameter]
    public Func<OmniUploadRequest, Task>? Upload { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<IBrowserFile>> FilesSelected { get; set; }

    private string? Accept => AllowedContentTypes.Count == 0 ? null : string.Join(',', AllowedContentTypes);
    private string MessageClass => Css("omni-upload__message", _hasError ? "omni-upload__message--error" : null);

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        Cancel();
        _canRetry = false;
        _progress = 0;
        _hasError = false;

        try
        {
            _files = Multiple ? args.GetMultipleFiles(MaximumFiles + 1) : [args.File];
        }
        catch (InvalidOperationException)
        {
            SetError($"Vous pouvez sélectionner au maximum {MaximumFiles} fichiers.");
            return;
        }

        if (_files.Count > MaximumFiles)
        {
            SetError($"Vous pouvez sélectionner au maximum {MaximumFiles} fichiers.");
            return;
        }

        var oversized = _files.FirstOrDefault(file => file.Size > MaximumFileSize);
        if (oversized is not null)
        {
            SetError($"Le fichier {oversized.Name} dépasse la taille maximale autorisée.");
            return;
        }

        var rejected = _files.FirstOrDefault(file => AllowedContentTypes.Count > 0
            && !AllowedContentTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase));
        if (rejected is not null)
        {
            SetError($"Le type du fichier {rejected.Name} n'est pas autorisé.");
            return;
        }

        await FilesSelected.InvokeAsync(_files);
        if (Upload is null)
        {
            _message = _files.Count == 1 ? "1 fichier sélectionné." : $"{_files.Count} fichiers sélectionnés.";
            return;
        }

        await StartUploadAsync();
    }

    private async Task StartUploadAsync()
    {
        if (Upload is null || _files.Count == 0)
        {
            return;
        }

        _uploadCancellation?.Dispose();
        _uploadCancellation = new CancellationTokenSource();
        _uploading = true;
        _canRetry = false;
        _hasError = false;
        _message = "Téléversement en cours.";

        try
        {
            var request = new OmniUploadRequest(_files, _uploadCancellation.Token, ReportProgress);
            await Upload(request);
            _progress = 100;
            _message = "Téléversement terminé.";
        }
        catch (OperationCanceledException) when (_uploadCancellation.IsCancellationRequested)
        {
            _message = "Téléversement annulé.";
            _canRetry = true;
        }
        catch (Exception exception)
        {
            SetError($"Le téléversement a échoué : {exception.Message}");
            _canRetry = true;
        }
        finally
        {
            _uploading = false;
        }
    }

    private void ReportProgress(double percentage)
    {
        _progress = percentage;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Cancel() => _uploadCancellation?.Cancel();
    private Task RetryAsync() => StartUploadAsync();

    private void SetError(string message)
    {
        _hasError = true;
        _message = message;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.##} Mo",
        >= 1024 => $"{bytes / 1024d:0.##} Ko",
        _ => $"{bytes} o"
    };

    public ValueTask DisposeAsync()
    {
        _uploadCancellation?.Cancel();
        _uploadCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
