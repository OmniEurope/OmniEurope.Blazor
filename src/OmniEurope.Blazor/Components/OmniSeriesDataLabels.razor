<g class="omni-chart__labels">
    @foreach (var point in Data)
    {
        <g><text x="@OmniChartGeometry.Number(OmniChartGeometry.Clamp(point.X))" y="@OmniChartGeometry.Number(97 - OmniChartGeometry.Clamp(point.Y))" text-anchor="middle">@(point.Label ?? Formatter?.Invoke(point.Y) ?? OmniChartGeometry.Number(point.Y))</text></g>
    }
</g>

@code {
    [Parameter] public IReadOnlyList<OmniChartPoint> Data { get; set; } = Array.Empty<OmniChartPoint>();
    [Parameter] public Func<double, string>? Formatter { get; set; }
}
