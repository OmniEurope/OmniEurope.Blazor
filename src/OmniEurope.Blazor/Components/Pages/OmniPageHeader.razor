@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable

@* The chrome of a page in one block of fixed height, so every page starts its content at the same
   place. Line 1: back, icon, title, badges, actions and the "⋮" menu. Line 2, always reserved: the
   ancestors ending with the title (so the title is not written twice), or the subtitle when the page
   has no ancestor. A title longer than its line scrolls sideways, a chevron showing on each side that
   still has text (omni-page-header.js). The badges and actions fold behind a "Show more" toggle on a
   phone, and at any width once line 1 has no room for them (omni-page-header.js marks the frame
   data-compact). Under the block: the subtitle when line 2 carries the trail, then the filters. *@
<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-page-header")">
    <div @ref="_frame" class="@FrameClass">
        <div class="omni-page-header__row">
            @if (ShowBack)
            {
                <OmniButton Variant="BackVariant"
                            Class="omni-page-header__back"
                            Label="@EffectiveBackLabel"
                            title="@EffectiveBackLabel"
                            OnClick="GoBackAsync"><OmniIcon Name="OmniIconName.ArrowLeft" /></OmniButton>
            }
            @if (Icon is not null)
            {
                @* Set in the font of the title so the icon can be placed on the middle of its capitals. *@
                <span class="omni-page-header__icon omni-heading @IconLevelClass" aria-hidden="true">@Icon</span>
            }
            @if (TitleLoading)
            {
                <OmniSkeleton Shape="OmniSkeletonShape.Text" Class="omni-page-header__title-loading" Label="@Localize("LoadingLabel")" />
            }
            else
            {
                <OmniButton Variant="OmniButtonVariant.Ghost"
                            Class="omni-page-header__scroll omni-page-header__scroll--start"
                            Label="@Localize("PageHeaderScrollTitleStart")"
                            title="@Localize("PageHeaderScrollTitleStart")"><OmniIcon Name="OmniIconName.ChevronLeft" /></OmniButton>
                <OmniHeading Level="Level" Class="omni-page-header__title">@EffectiveTitle</OmniHeading>
                <OmniButton Variant="OmniButtonVariant.Ghost"
                            Class="omni-page-header__scroll omni-page-header__scroll--end"
                            Label="@Localize("PageHeaderScrollTitleEnd")"
                            title="@Localize("PageHeaderScrollTitleEnd")"><OmniIcon Name="OmniIconName.ChevronRight" /></OmniButton>
            }
            @if (HasDetails)
            {
                <OmniButton Variant="OmniButtonVariant.Ghost"
                            Class="omni-page-header__toggle"
                            Label="@Localize("PageHeaderShowMore")"
                            title="@Localize("PageHeaderShowMore")"
                            aria-expanded="@(_expanded ? "true" : "false")"
                            aria-controls="@DetailsId"
                            OnClick="ToggleDetails"><OmniIcon Name="@(_expanded ? OmniIconName.ChevronUp : OmniIconName.ChevronDown)" /></OmniButton>
                <div id="@DetailsId" class="@DetailsClass">
                    @if (Badges is not null)
                    {
                        <div class="omni-page-header__badges">@Badges</div>
                    }
                    @if (Actions is not null)
                    {
                        <div class="omni-page-header__actions">@Actions</div>
                    }
                </div>
            }
            @if (MenuContent is not null)
            {
                <OmniOverflowMenu Class="omni-page-header__menu">@MenuContent</OmniOverflowMenu>
            }
        </div>
        <div class="omni-page-header__trail">
            @if (TrailShown)
            {
                <OmniBreadcrumb Label="@(TrailLabel ?? string.Empty)">
                    @foreach (var entry in TrailAncestors)
                    {
                        if (entry.Loading)
                        {
                            <li class="omni-breadcrumb__item omni-page-header__crumb-loading">
                                <OmniSkeleton Shape="OmniSkeletonShape.Text" Label="@Localize("LoadingLabel")" />
                            </li>
                        }
                        else
                        {
                            <OmniBreadcrumbItem Href="@entry.Href">@entry.Text</OmniBreadcrumbItem>
                        }
                    }
                    @if (TitleLoading)
                    {
                        <li class="omni-breadcrumb__item omni-page-header__crumb-loading">
                            <OmniSkeleton Shape="OmniSkeletonShape.Text" Label="@Localize("LoadingLabel")" />
                        </li>
                    }
                    else
                    {
                        <OmniBreadcrumbItem Current="true">@EffectiveTitle</OmniBreadcrumbItem>
                    }
                </OmniBreadcrumb>
            }
            else if (HasSubtitle)
            {
                <p class="omni-page-header__trail-text">@Subtitle</p>
            }
        </div>
    </div>
    @if (TrailShown && HasSubtitle)
    {
        <p class="omni-page-header__subtitle">@Subtitle</p>
    }
    @if (Filters is not null)
    {
        <div class="omni-page-header__filters">@Filters</div>
    }
</div>
