@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-description-list__item")">
    <dt class="omni-description-list__label">@if (Icon is not null) { <span class="omni-description-list__icon" aria-hidden="true">@Icon</span> }@Term</dt>
    <dd class="omni-description-list__value">
        <div class="omni-description-list__content">@ChildContent</div>
        @if (ActionsContent is not null)
        {
            <div class="omni-description-list__actions">@ActionsContent</div>
        }
    </dd>
</div>
