@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IDisposable

@* A tile that leads to a part of the site: the icon on a square tinted with its tone, the title and
   an optional description, the whole tile one real link (a middle click opens it in a tab, the
   browser shows where it goes). Hovered, its border, background and shadow take its tone; it never moves. Disabled, the
   tile has no href: it is not a link any more, cannot take focus, is announced as an unavailable link
   (aria-disabled) and is drawn attenuated, at the same size. With IsFavorite set, the link and the star
   toggle are siblings in a host box: a button nested in a link is invalid, and a click on the star must
   never follow the link. *@
@{
    RenderFragment tile = @<a @attributes="AdditionalAttributes" id="@Id" href="@LinkTarget" role="@(Disabled ? "link" : null)" aria-disabled="@(Disabled ? "true" : null)" class="@Css("omni-nav-tile", ToneClass, Disabled ? "omni-nav-tile--disabled" : null, DoubleWidth && IsFavorite is null ? "omni-tile--double" : null, FitTitle ? (TileGrid is null ? $"omni-nav-tile--fit omni-nav-tile--fit-{FitBucket}" : "omni-nav-tile--fit omni-nav-tile--fit-grid") : null, AlignClass("icon", IconAlign), AlignClass("title", TitleAlign))">
        @if (Icon is not null)
        {
            <span class="omni-nav-tile__icon" aria-hidden="true">@Icon</span>
        }
        <span class="omni-nav-tile__title">@Title</span>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span class="omni-nav-tile__description">@Description</span>
        }
    </a>;
}
@if (IsFavorite is null)
{
    @tile
}
else
{
    <div class="@Css("omni-nav-tile-host", DoubleWidth ? "omni-tile--double" : null)">
        @tile
        <button type="button"
                class="@Css("omni-nav-tile__favorite", IsFavorite.Value ? "omni-nav-tile__favorite--on" : null)"
                aria-pressed="@(IsFavorite.Value ? "true" : "false")"
                aria-label="@FavoriteName"
                title="@FavoriteName"
                @onclick="ToggleFavoriteAsync">
            <OmniIcon Name="@(IsFavorite.Value ? OmniIconName.StarFilled : OmniIconName.Star)" />
        </button>
    </div>
}
