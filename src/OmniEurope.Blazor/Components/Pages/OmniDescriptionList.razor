@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* A definition list, so each value is announced with its label. Items flow into the columns asked
   for and fall back to one column on a narrow screen. *@
<dl id="@Id" class="@Css("omni-description-list", ColumnsClass)" @attributes="AdditionalAttributes">@ChildContent</dl>
