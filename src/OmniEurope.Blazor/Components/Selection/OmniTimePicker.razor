@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<TimeOnly?>

<div @ref="_root" class="omni-date omni-date--time">
    <div class="omni-date__field">
        <input @attributes="AdditionalAttributes"
               id="@Id"
               class="@InputCss("omni-input", "omni-time-picker")"
               type="text"
               inputmode="numeric"
               autocomplete="off"
               placeholder="@EffectivePlaceholder"
               value="@CurrentValueAsString"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-invalid="@AriaInvalid"
               aria-describedby="@AriaDescribedBy"
               @onchange="HandleChange" />
        <button @ref="_toggle"
                type="button"
                class="omni-date__toggle"
                aria-label="@ToggleLabel"
                aria-haspopup="dialog"
                aria-expanded="@(Popup.IsOpen ? "true" : "false")"
                aria-controls="@(Popup.IsOpen ? PanelId : null)"
                disabled="@(Disabled || ReadOnly)"
                @onclick="Toggle">
            <svg class="omni-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        </button>
    </div>
    @if (Popup.IsOpen)
    {
        <div @ref="_panel" id="@PanelId" class="omni-calendar omni-calendar--time" role="dialog" aria-label="@ToggleLabel">
            @TimeContent
            <div class="omni-calendar__foot">
                <OmniButton Variant="OmniButtonVariant.Ghost" Disabled="@NowIsOutside" OnClick="SelectNow">@Localize("TimePickerNow")</OmniButton>
                <OmniButton Variant="OmniButtonVariant.Primary" OnClick="Confirm">@Localize("TimePickerConfirm")</OmniButton>
            </div>
        </div>
    }
</div>
