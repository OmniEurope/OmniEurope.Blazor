@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject Microsoft.Extensions.Logging.ILogger<OmniUpload> Logger

@* Id goes on the native file control, the focusable element, so an OmniFormField For= names it. *@
<div @attributes="AdditionalAttributes" class="@RootClass">
    @if (ReadOnly)
    {
        @* Read-only: the files held are listed and the group takes the focus; nothing offers to choose, drop
           or remove a file, so the native file control is not drawn. *@
        <div id="@Id" class="omni-upload__readonly" role="group" tabindex="0" aria-label="@Localize("UploadAttachedFiles")">
            @if ((ReadOnlyShowsFiles ? Files.Count : _files.Count) == 0)
            {
                <span class="omni-input omni-upload__field-value omni-upload__field-value--empty">@Localize("UploadNoFile")</span>
            }
            else if (ReadOnlyShowsFiles)
            {
                <ul class="omni-upload__list">
                    @foreach (var file in Files)
                    {
                        <li class="omni-upload__file">
                            <span class="omni-upload__file-icon" aria-hidden="true"><OmniIcon Name="@IconFor(file.Name, file.ContentType)" /></span>
                            <span class="omni-upload__file-name">@file.Name</span>
                            <span class="omni-upload__file-meta"><span class="omni-upload__file-size">@FormatSize(file.Size)</span></span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <ul class="omni-upload__list">
                    @foreach (var file in _files)
                    {
                        <li class="omni-upload__file">
                            <span class="omni-upload__file-icon" aria-hidden="true"><OmniIcon Name="@IconFor(file.Name, file.ContentType)" /></span>
                            <span class="omni-upload__file-name">@file.Name</span>
                            <span class="omni-upload__file-meta"><span class="omni-upload__file-size">@FormatSize(file.Size)</span></span>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    else if (IsField)
    {
        @* A read-only field welded to a Browse button. The native file control covers both, invisible,
           as it covers the zone: a click on the field or on the button opens the picker, Enter or
           Space on the focused control too, and a file dropped on them lands in it, with no script.
           The field and the button only paint what the control holds and offers. *@
        <div class="omni-upload__field"
             @ondragenter="() => SetDragging(true)"
             @ondragleave="() => SetDragging(false)"
             @ondrop="() => SetDragging(false)">
            <span id="@FieldValueId" class="@FieldValueClass">@(FieldText ?? Localize("UploadNoFile"))</span>
            <span class="omni-button omni-button--primary omni-button--medium omni-upload__field-button" aria-hidden="true">
                <span class="omni-button__content">
                    <OmniIcon Name="OmniIconName.Document" />
                    <span>@Localize("UploadBrowseButton")</span>
                </span>
            </span>
            <InputFile class="omni-upload__input"
                       id="@Id"
                       OnChange="HandleFilesAsync"
                       accept="@EffectiveAccept"
                       disabled="@(Disabled || _uploading)"
                       aria-describedby="@($"{FieldValueId} {HintId}")" />
        </div>
        <span id="@HintId" class="omni-upload__hint">@Hint</span>
    }
    else
    {
        @* The native file control covers the whole zone, invisible: a click opens the picker and a file
           dropped anywhere on the zone lands in it, with no script. The drag events only paint the zone. *@
        <div class="omni-upload__zone"
             @ondragenter="() => SetDragging(true)"
             @ondragleave="() => SetDragging(false)"
             @ondrop="() => SetDragging(false)">
            <InputFile class="omni-upload__input"
                       id="@Id"
                       OnChange="HandleFilesAsync"
                       multiple="@Multiple"
                       accept="@EffectiveAccept"
                       disabled="@(Disabled || _uploading)"
                       aria-describedby="@HintId" />
            <span class="omni-disc omni-upload__disc" aria-hidden="true"><OmniIcon Name="OmniIconName.Upload" Class="omni-upload__icon" /></span>
            <span class="omni-upload__prompt">
                @Localize(Multiple ? "UploadDropMany" : "UploadDropOne")
                <span class="omni-upload__browse">@Localize("UploadBrowse")</span>
            </span>
            <span id="@HintId" class="omni-upload__hint">@Hint</span>
        </div>

        @if (IsBound)
        {
            @if (Files.Count > 0)
            {
                <ul id="@ListId" class="omni-upload__list" aria-label="@Localize("UploadAttachedFiles")">
                    @for (var index = FirstShown; index < Files.Count; index++)
                    {
                        var file = Files[index];
                        var position = index;
                        <li class="omni-upload__file">
                            <span class="omni-upload__file-icon" aria-hidden="true"><OmniIcon Name="@IconFor(file.Name, file.ContentType)" /></span>
                            <span class="omni-upload__file-name">@file.Name</span>
                            <span class="omni-upload__file-meta"><span class="omni-upload__file-size">@FormatSize(file.Size)</span></span>
                            <span class="omni-upload__actions">
                                <button type="button"
                                        class="omni-upload__remove"
                                        aria-label="@Localize("UploadRemove", file.Name)"
                                        title="@Localize("UploadRemove", file.Name)"
                                        disabled="@(Disabled || _uploading)"
                                        @onclick="() => RemoveAsync(position)">
                                    <OmniIcon Name="OmniIconName.Close" Size="OmniControlSize.Small" />
                                </button>
                            </span>
                        </li>
                    }
                </ul>
            }
        }
        else if (_files.Count > 0)
        {
            <ul id="@ListId" class="omni-upload__files omni-upload__list" aria-label="@Localize("UploadSelectedFiles")">
                @for (var index = FirstShown; index < _files.Count; index++)
                {
                    var file = _files[index];
                    <li class="omni-upload__file">
                        <span class="omni-upload__file-icon" aria-hidden="true"><OmniIcon Name="@IconFor(file.Name, file.ContentType)" /></span>
                        <span class="omni-upload__file-name">@file.Name</span>
                        <span class="omni-upload__file-meta"><span class="omni-upload__file-size">@FormatSize(file.Size)</span></span>
                    </li>
                }
            </ul>
        }

        @if (ReducedList)
        {
            @* Always under the list: the count, Show all or Show less when more than the three most
               recent files are held, and Remove all pushed to the end. *@
            <div class="omni-upload__toolbar">
                <span class="omni-upload__count" aria-live="polite">@CountText</span>
                @if (Collapsible)
                {
                    <OmniButton Variant="OmniButtonVariant.Ghost"
                                Size="OmniControlSize.Small"
                                Class="omni-upload__show-all"
                                aria-expanded="@(_showAll ? "true" : "false")"
                                aria-controls="@ListId"
                                OnClick="ToggleShowAll">
                        <Icon><span class="omni-upload__chevron" aria-hidden="true"><OmniIcon Name="OmniIconName.ChevronDown" /></span></Icon>
                        <ChildContent><span>@(_showAll ? Localize("UploadShowLess") : Localize("UploadShowAll", ListedCount))</span></ChildContent>
                    </OmniButton>
                }
                <OmniButton Variant="OmniButtonVariant.Ghost"
                            Size="OmniControlSize.Small"
                            Class="omni-upload__clear"
                            Disabled="@(ListedCount == 0 || Disabled || _uploading)"
                            OnClick="RemoveAllAsync">
                    <Icon><OmniIcon Name="OmniIconName.Delete" /></Icon>
                    <ChildContent><span>@Localize("UploadRemoveAll")</span></ChildContent>
                </OmniButton>
            </div>
        }
    }

    @if (_uploading || _progress > 0)
    {
        <OmniProgressBar Value="@_progress" Label="@Localize("UploadProgressLabel")" />
    }
    @if (_uploading)
    {
        <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" Class="omni-upload__cancel" OnClick="Cancel">
            <Icon><OmniIcon Name="OmniIconName.Close" /></Icon>
            <ChildContent><span>@Localize("Cancel")</span></ChildContent>
        </OmniButton>
    }
    else if (_canRetry)
    {
        <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" Class="omni-upload__retry" OnClick="RetryAsync">
            <Icon><OmniIcon Name="OmniIconName.Refresh" /></Icon>
            <ChildContent><span>@Localize("Retry")</span></ChildContent>
        </OmniButton>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="@MessageClass" role="status" aria-live="polite">@_message</p>
    }
</div>
