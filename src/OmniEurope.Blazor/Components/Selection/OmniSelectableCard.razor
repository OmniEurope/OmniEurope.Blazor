@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IDisposable

@* A card the user picks: one choice among several (a radio) or one of many options (a check box). The
   choice shows by the accent frame and tint, and on a check box card by a drawn box that is checked
   (recette R2-4): the box is decorative (aria-hidden, no input, never focusable), the card itself is the
   one control, so role and aria-checked are announced once. The box keeps its size whether checked or
   not, and the frame keeps one width in every state, so the text never moves. A card that cannot change
   stays focusable and says so (aria-disabled), so a choice forced on by another one is still read out.
   Inside a radio OmniSelectableCardGroup only one card is in the tab order, and the arrows move the
   choice. Layout, the same for every card: the first line is the head (the box when shown, the icon
   when given, and the title, centred on one line); the description and the ChildContent follow below,
   from the inline-start edge of the card (under the box) over its whole content width, so a narrow tile
   of an OmniTileGrid does not squeeze them into a column beside the box and the icon. Only spans inside
   the button; the accessible name is the title then the description. *@
<button @attributes="AdditionalAttributes"
        @ref="_element"
        id="@Id"
        type="button"
        class="@Css("omni-selectable-card", IsSelected ? "omni-selectable-card--selected" : null, DoubleWidth ? "omni-tile--double" : null)"
        role="@(IsMultiple ? "checkbox" : "radio")"
        aria-checked="@(IsSelected ? "true" : "false")"
        aria-disabled="@(IsDisabled ? "true" : null)"
        aria-readonly="@(IsReadOnly && IsMultiple ? "true" : null)"
        tabindex="@TabIndex"
        @onclick="ToggleAsync"
        @onkeydown="HandleKeyDownAsync">
    <span class="omni-selectable-card__head">
        @if (BoxShown)
        {
            <span class="omni-selectable-card__box" aria-hidden="true"></span>
        }
        @if (Icon is not null)
        {
            <span class="omni-selectable-card__icon" aria-hidden="true">@Icon</span>
        }
        <span class="omni-selectable-card__title">@Title</span>
    </span>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <span class="omni-selectable-card__description">@Description</span>
    }
    @if (ChildContent is not null)
    {
        <span class="omni-selectable-card__extra">@ChildContent</span>
    }
</button>
