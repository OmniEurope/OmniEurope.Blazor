@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

@if (AllowFiltering)
{
    <OmniAutocomplete TValue="TValue"
                      Id="@Id"
                      Value="@CurrentValue"
                      ValueChanged="HandleAutocompleteChangeAsync"
                      ValueExpression="@ValueExpression"
                      Search="SearchOptionsAsync"
                      FormatValue="FormatValue"
                      MinimumLength="0"
                      Placeholder="@EffectivePlaceholder"
                      AriaLabel="@EffectiveAriaLabel"
                      Disabled="@Disabled"
                      AriaDescribedBy="@AriaDescribedBy"
                      @attributes="AdditionalAttributes" />
}
else
{
    <select @attributes="AdditionalAttributes"
            id="@Id"
            class="@InputCss("omni-input", "omni-drop-down")"
            disabled="@Disabled"
            aria-label="@EffectiveAriaLabel"
            aria-invalid="@AriaInvalid"
            aria-describedby="@AriaDescribedBy"
            value="@SelectedOptionValue"
            @onchange="HandleChange">
        @if (AllowsEmpty)
        {
            <option value="">@EffectivePlaceholder</option>
        }
        @foreach (var group in IndexedOptions.GroupBy(entry => entry.Option.Group))
        {
            if (group.Key is null)
            {
                @foreach (var entry in group)
                {
                    @OptionMarkup(entry.Option, entry.Index)
                }
            }
            else
            {
                <optgroup label="@group.Key">
                    @foreach (var entry in group)
                    {
                        @OptionMarkup(entry.Option, entry.Index)
                    }
                </optgroup>
            }
        }
    </select>
}
