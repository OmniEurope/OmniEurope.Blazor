@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

@if (Filterable)
{
    <OmniAutocomplete TValue="TValue"
                      @attributes="AdditionalAttributes"
                      Id="@Id"
                      Class="@Class"
                      Size="@Size"
                      Value="@CurrentValue"
                      ValueChanged="HandleAutocompleteChange"
                      ValueExpression="@ValueExpression"
                      Search="SearchOptionsAsync"
                      FormatValue="FormatValue"
                      MinimumLength="0"
                      Debounce="TimeSpan.Zero"
                      Placeholder="@EffectivePlaceholder"
                      Label="@Label"
                      Disabled="@Disabled"
                      ReadOnly="@ReadOnly"
                      ShowToggle="true"
                      AriaDescribedBy="@AriaDescribedBy" />
}
else if (ReadOnly)
{
    @* A native select cannot be read-only, and an open list would let the reader pick: the chosen text is
       shown in a read-only field of the same look instead, which keeps the focus and the Id. *@
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", "omni-drop-down", "omni-drop-down--readonly")"
           type="text"
           value="@SelectedText"
           readonly
           disabled="@Disabled"
           aria-readonly="true"
           aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy" />
}
else
{
    <select @attributes="AdditionalAttributes"
            id="@Id"
            class="@InputCss("omni-input", "omni-drop-down")"
            disabled="@Disabled"
            aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)"
            aria-invalid="@AriaInvalid"
            aria-describedby="@AriaDescribedBy"
            value="@SelectedOptionValue"
            @onchange="HandleChange">
        @if (AllowEmpty)
        {
            <option value="">@EffectivePlaceholder</option>
        }
        @foreach (var group in IndexedOptions.GroupBy(entry => entry.Option.Group))
        {
            if (group.Key is null)
            {
                @foreach (var entry in group)
                {
                    @OptionMarkup(entry.Option, entry.Index)
                }
            }
            else
            {
                <optgroup label="@group.Key">
                    @foreach (var entry in group)
                    {
                        @OptionMarkup(entry.Option, entry.Index)
                    }
                </optgroup>
            }
        }
    </select>
}
