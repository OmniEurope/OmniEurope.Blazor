@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>
@implements IAsyncDisposable

@* The editable combobox pattern: the focus stays in the input, the arrows move a visual focus through
   the suggestions (announced through aria-activedescendant), Enter picks it and Escape closes the list.
   The suggestions are plain options, not buttons: a button inside an option is a second, conflicting
   role that screen readers announce twice. While the list is open, no key pressed in the field goes up to
   a Blazor handler around it, so a dialog holding the field never closes on the Escape meant for the list; the
   Escape that closed the list stays held back until its key is released (see _escapeConsumed). *@
<div @ref="_root" class="@RootClass" @onkeydown:stopPropagation="@(IsOpen || _escapeConsumed)">
    <input @attributes="AdditionalAttributes"
           @ref="_input"
           id="@Id"
           class="@InputClass"
           type="search"
           value="@_searchText"
           placeholder="@Placeholder"
           aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)"
           autocomplete="off"
           disabled="@Disabled"
           readonly="@IsReadOnly"
           aria-readonly="@(IsReadOnly ? "true" : null)"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(IsOpen ? "true" : "false")"
           aria-controls="@ResultsId"
           aria-activedescendant="@ActiveOptionId"
           aria-invalid="@AriaInvalid"
           aria-describedby="@CombinedAriaDescribedBy"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync"
           @onkeyup="EscapeReleaseHandler"
           @onfocus="OpenOnFocusCallback"
           @onclick="OpenOnClickCallback"
           @onblur="HandleBlur" />
    @if (ShowToggle)
    {
        @* A pointer affordance only, out of the tab order: the keyboard opens the list with the arrows.
           Pressing it keeps the focus in the field, so the list does not close on a blur. *@
        <span class="@ToggleClass"
              aria-hidden="true"
              data-omni-autocomplete-toggle
              @onmousedown:preventDefault="true"
              @onclick="ToggleListAsync"></span>
    }
    @if (_error is not null)
    {
        <div id="@ErrorId" class="omni-autocomplete__error" role="alert">
            @if (ErrorContent is not null)
            {
                @ErrorContent(_error)
            }
            else
            {
                @EffectiveSearchErrorMessage
            }
        </div>
    }
    @if (IsOpen)
    {
        <ul @ref="_resultsList" id="@ResultsId" class="omni-autocomplete__results" role="listbox" aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)">
            @{
                RenderFragment<int> optionItem = at => @<li id="@OptionId(at)"
                    class="@OptionClass(at, _results[at])"
                    role="option"
                    aria-selected="@(at == _activeIndex ? "true" : "false")"
                    aria-disabled="@(IsUnavailable(_results[at]) ? "true" : null)"
                    @onmousedown:preventDefault="true"
                    @onclick="() => Select(_results[at])">
                    @if (OptionIconTemplate is not null)
                    {
                        <span class="omni-autocomplete__option-icon" aria-hidden="true">@OptionIconTemplate(_results[at])</span>
                    }
                    @if (HighlightMatches)
                    {
                        @foreach (var segment in OmniTextMatch.Split(_results[at].Text, _resultsQuery))
                        {
                            if (segment.Matched)
                            {
                                <mark class="omni-autocomplete__match">@segment.Text</mark>
                            }
                            else
                            {
                                @segment.Text
                            }
                        }
                    }
                    else
                    {
                        @_results[at].Text
                    }
                </li>;
            }
            @* A run of options under a Group heading is a role=group named by its heading (the ARIA listbox
               pattern). The heading is not an option, so the arrows, aria-activedescendant and the result
               count never see it. Options without a group stay direct children of the listbox. *@
            @foreach (var run in ResultRuns)
            {
                if (run.Group is null)
                {
                    @for (var position = run.Start; position < run.Start + run.Count; position++)
                    {
                        @optionItem(position)
                    }
                }
                else
                {
                    <li role="presentation" class="omni-autocomplete__group">
                        <ul role="group" class="omni-autocomplete__group-list" aria-labelledby="@GroupHeadingId(run)">
                            <li id="@GroupHeadingId(run)" role="presentation" class="omni-autocomplete__group-heading" @onmousedown:preventDefault="true">@run.Group</li>
                            @for (var position = run.Start; position < run.Start + run.Count; position++)
                            {
                                @optionItem(position)
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    }
    <span class="omni-visually-hidden" role="status" aria-live="polite">@_announcement</span>
</div>
