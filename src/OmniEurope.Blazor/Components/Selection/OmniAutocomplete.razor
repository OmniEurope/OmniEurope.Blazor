@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>
@implements IAsyncDisposable

@* The editable combobox pattern: the focus stays in the input, the arrows move a visual focus through
   the suggestions (announced through aria-activedescendant), Enter picks it and Escape closes the list.
   The suggestions are plain options, not buttons: a button inside an option is a second, conflicting
   role that screen readers announce twice. *@
<div class="@RootClass">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputClass"
           type="search"
           value="@_searchText"
           placeholder="@Placeholder"
           aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)"
           autocomplete="off"
           disabled="@Disabled"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(IsOpen ? "true" : "false")"
           aria-controls="@ResultsId"
           aria-activedescendant="@ActiveOptionId"
           aria-invalid="@AriaInvalid"
           aria-describedby="@CombinedAriaDescribedBy"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync"
           @onblur="Close" />
    @if (_error is not null)
    {
        <div id="@ErrorId" class="omni-autocomplete__error" role="alert">
            @if (ErrorContent is not null)
            {
                @ErrorContent(_error)
            }
            else
            {
                @EffectiveSearchErrorMessage
            }
        </div>
    }
    @if (IsOpen)
    {
        <ul id="@ResultsId" class="omni-autocomplete__results" role="listbox" aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)">
            @for (var index = 0; index < _results.Count; index++)
            {
                var position = index;
                var option = _results[position];
                var unavailable = option.Disabled || Disabled;
                <li id="@OptionId(position)"
                    class="@OptionClass(position, option)"
                    role="option"
                    aria-selected="@(position == _activeIndex ? "true" : "false")"
                    aria-disabled="@(unavailable ? "true" : null)"
                    @onmousedown:preventDefault="true"
                    @onclick="() => Select(option)">
                    @if (OptionIconTemplate is not null)
                    {
                        <span class="omni-autocomplete__option-icon" aria-hidden="true">@OptionIconTemplate(option)</span>
                    }
                    @if (HighlightMatches)
                    {
                        @foreach (var segment in OmniTextMatch.Split(option.Text, _resultsQuery))
                        {
                            if (segment.Matched)
                            {
                                <mark class="omni-autocomplete__match">@segment.Text</mark>
                            }
                            else
                            {
                                @segment.Text
                            }
                        }
                    }
                    else
                    {
                        @option.Text
                    }
                </li>
            }
        </ul>
    }
    <span class="omni-visually-hidden" role="status" aria-live="polite">@_announcement</span>
</div>
