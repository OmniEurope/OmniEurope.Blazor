@namespace OmniEurope.Blazor.Components
@typeparam TValue
@typeparam TSelection
@inherits OmniInputBase<TSelection>
@inject IJSRuntime JavaScript

@* A radio group (one choice) or a group of check boxes (Multiple) made of selectable cards: the cards of
   Options, then the cards written inside it, each standing for its Choice. In a radio group the arrows are
   .NET's, counted in reading order: the focus module swaps the two horizontal ones in a right-to-left page
   (data-omni-mirror-arrows), and is loaded at the first focus of the group. *@
<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@InputCss("omni-selectable-card-group", Columns is null ? null : "omni-tile-grid", Columns is null ? null : $"omni-tile-grid--columns-{Columns}", Columns is null ? null : "omni-tile-grid--gap-sm")"
     role="@(Multiple ? "group" : "radiogroup")"
     aria-label="@Internal.OmniAriaLabel.Of(Label, AdditionalAttributes)"
     aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? FormFieldLabelId : null)"
     aria-disabled="@(Disabled ? "true" : null)"
     aria-readonly="@(ReadOnly && !Multiple ? "true" : null)"
     aria-invalid="@AriaInvalid"
     data-omni-mirror-arrows="@(Multiple ? null : "")"
     @onfocusin="EnablePageKeysAsync">
    <CascadingValue TValue="IOmniSelectableCardGroup" Value="this" IsFixed="true">
        @foreach (var option in Options)
        {
            <OmniSelectableCard @key="option" Title="@option.Text" Disabled="@option.Disabled" Choice="@option.Value" />
        }
        @ChildContent
    </CascadingValue>
</div>
