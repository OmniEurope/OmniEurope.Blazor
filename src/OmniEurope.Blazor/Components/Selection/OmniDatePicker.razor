@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<DateOnly?>

@* While the panel is open, no key pressed in the picker goes up to a Blazor handler around it:
   omni-focus.js already keeps Escape in the panel, and this keeps it there too before the script is
   attached, so a dialog holding the picker never closes on the Escape meant for the panel. *@
<div @ref="_root" class="omni-date omni-date--date" @onkeydown:stopPropagation="@Popup.IsOpen">
    <div class="omni-date__field">
        <input @attributes="AdditionalAttributes"
               id="@Id"
               class="@InputCss("omni-input", "omni-date-input", "omni-date-picker")"
               type="text"
               inputmode="numeric"
               autocomplete="off"
               placeholder="@EffectivePlaceholder"
               value="@CurrentValueAsString"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-invalid="@AriaInvalid"
               aria-describedby="@AriaDescribedBy"
               @onchange="HandleChange" />
        <button @ref="_toggle"
                type="button"
                class="omni-date__toggle"
                aria-label="@ToggleLabel"
                aria-haspopup="dialog"
                aria-expanded="@(Popup.IsOpen ? "true" : "false")"
                aria-controls="@(Popup.IsOpen ? PanelId : null)"
                disabled="@(Disabled || ReadOnly)"
                @onclick="Toggle">
            <svg class="omni-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" focusable="false" aria-hidden="true"><rect height="16" rx="2" width="18" x="3" y="5"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
        </button>
    </div>
    @if (Popup.IsOpen)
    {
        <div @ref="_panel" id="@PanelId" class="omni-calendar" role="dialog" aria-label="@ToggleLabel">
            @CalendarContent
            <div class="omni-calendar__foot">
                <OmniButton Variant="OmniButtonVariant.Ghost" Disabled="@TodayIsOutside" OnClick="SelectToday">@Localize("DatePickerToday")</OmniButton>
                <OmniButton Variant="OmniButtonVariant.Ghost" OnClick="Clear">@Localize("DatePickerClear")</OmniButton>
            </div>
        </div>
    }
</div>
