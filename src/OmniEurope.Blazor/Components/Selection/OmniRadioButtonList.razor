@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

@* An Error is drawn inside the fieldset, after the choices, like the error line of OmniFormField:
   the group is then marked invalid and described by that line. A validation message of the form marks
   it invalid too. *@
<fieldset @attributes="AdditionalAttributes" id="@Id" class="@InputCss("omni-choice-list", IsInvalid ? "omni-choice-list--invalid" : null)" disabled="@Disabled"
          aria-invalid="@(IsInvalid ? "true" : null)" aria-describedby="@DescribedBy">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <legend class="omni-choice-list__legend">@Label</legend>
    }
    @foreach (var option in Options)
    {
        <label class="@ItemClass(option)">
            <input type="radio"
                   class="omni-radio"
                   name="@GroupName"
                   checked="@IsSelected(option.Value)"
                   disabled="@option.Disabled"
                   value="@option.Value?.ToString()"
                   @onchange="() => SelectOption(option)" />
            <span>@option.Text</span>
        </label>
    }
    @OmniFieldError.Region(ErrorId, HasError ? Error : null)
</fieldset>
