@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

@* An Error is drawn inside the fieldset, after the choices, like the error line of OmniFormField:
   the group is then marked invalid and described by that line. *@
<fieldset @attributes="AdditionalAttributes" id="@Id" class="@InputCss("omni-choice-list", HasError ? "omni-choice-list--invalid" : null)" disabled="@Disabled"
          aria-invalid="@(HasError ? "true" : InvalidFromAttributes)" aria-describedby="@DescribedBy">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <legend class="omni-choice-list__legend">@Label</legend>
    }
    @foreach (var option in Options)
    {
        <OmniRadioButtonListItem TValue="TValue"
                                 Name="@GroupName"
                                 Value="@option.Value"
                                 Selected="@IsSelected(option.Value)"
                                 Disabled="@option.Disabled"
                                 SelectedValueChanged="Select" >@option.Text</OmniRadioButtonListItem>
    }
    @if (HasError)
    {
        <div id="@ErrorId" class="omni-form-field__error" role="alert"><svg class="omni-form-field__error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5m0 3.5h.01" /></svg><span>@Error</span></div>
    }
</fieldset>
