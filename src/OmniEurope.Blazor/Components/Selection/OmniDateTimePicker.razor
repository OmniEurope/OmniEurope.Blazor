@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<DateTime?>

<input @attributes="AdditionalAttributes"
       id="@Id"
       class="@InputCss("omni-input", "omni-date-time-picker")"
       type="datetime-local"
       value="@CurrentValueAsString"
       min="@FormatDateTime(Minimum)"
       max="@FormatDateTime(Maximum)"
       step="@StepAttribute"
       disabled="@Disabled"
       readonly="@ReadOnly"
       aria-invalid="@AriaInvalid"
       aria-describedby="@AriaDescribedBy"
       @onchange="HandleChange" />
