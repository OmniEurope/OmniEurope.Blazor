@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The host's attributes come first; the validated href, the target and the merged rel come after,
   so that none of them can replace the link's own. *@
<a @attributes="AdditionalAttributes"
   id="@Id"
   class="@Css("omni-link", ShowsExternalIcon ? "omni-link--external" : null)"
   target="@EffectiveTarget"
   rel="@EffectiveRel"
   aria-label="@Label"
   @onclick="OnClick"
   href="@SafeHref">
    @ChildContent
    @if (ShowsExternalIcon)
    {
        <OmniIcon Name="OmniIconName.OpenExternal" Size="OmniControlSize.Small" Class="omni-link__external" />
        <span class="omni-visually-hidden">@Localize("LinkOpensInNewTab")</span>
    }
</a>
