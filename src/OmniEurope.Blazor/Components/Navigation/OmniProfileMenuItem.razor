@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@using OmniEurope.Blazor.Internal

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a @attributes="AdditionalAttributes" id="@Id" class="@ItemCss" role="menuitem" href="@SafeHref">@Content</a>
}
else
{
    <button @attributes="AdditionalAttributes" id="@Id" class="@ItemCss" role="menuitem" type="button" disabled="@Disabled" @onclick="OnClick">@Content</button>
}
