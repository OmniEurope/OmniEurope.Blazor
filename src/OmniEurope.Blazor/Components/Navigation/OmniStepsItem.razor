@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IDisposable

<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-steps__item", Selected ? "omni-steps__item--selected" : null)" role="listitem">
    <button id="@ButtonId" type="button" class="omni-steps__button" aria-current="@(Selected ? "step" : null)" aria-controls="@ControlledPanelId" disabled="@Disabled" @onclick="SelectAsync">
        @if (Icon is not null)
        {
            @* The icon replaces the number on screen; the number stays for assistive technologies. *@
            <span class="omni-steps__number"><span class="omni-steps__icon" aria-hidden="true">@Icon</span><span class="omni-visually-hidden">@(Position + 1)</span></span>
        }
        else
        {
            <span class="omni-steps__number">@(Position + 1)</span>
        }
        <span>@Title</span>
    </button>
    @if (SharedPanel is null)
    {
        <section id="@OwnPanelId" class="omni-steps__panel" role="region" aria-labelledby="@ButtonId" hidden="@(!Selected)">@ChildContent</section>
    }
</div>
