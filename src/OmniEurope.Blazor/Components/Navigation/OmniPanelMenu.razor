@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<nav @attributes="AdditionalAttributes"
     id="@Id"
     class="@Css("omni-panel-menu", EffectiveDisplayStyle == OmniPanelMenuDisplayStyle.Icon ? "omni-panel-menu--icons" : null)"
     aria-label="@EffectiveLabel"
     data-omni-density="@OmniDensityAttribute.Of(Density)">
    <CascadingValue Value="OwnContext">
        @ChildContent
    </CascadingValue>
</nav>
