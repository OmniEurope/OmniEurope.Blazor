@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@if (IsPanelPhase)
{
    @* The content is built on first selection and kept afterwards: mounting every panel up front
       made a page of grids pay for all of them at load and re-render the lot on each switch, while
       dropping a panel on leaving would rebuild it, and lose its scroll and filters, on return. *@
    <section id="@PanelId" class="omni-tabs__panel" role="tabpanel" aria-labelledby="@TabId" hidden="@(!Selected)">
        @if (_visited)
        {
            @ChildContent
        }
    </section>
}
else
{
    <div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-tabs__item")">
        <button id="@TabId" type="button" class="omni-tabs__tab" role="tab" data-key="@Key" aria-selected="@(Selected ? "true" : "false")" aria-controls="@PanelId" tabindex="@(Selected ? 0 : -1)" disabled="@Disabled" @onclick="SelectAsync">
            @if (Icon is not null)
            {
                <span class="omni-tabs__icon" aria-hidden="true">@Icon</span>
            }
            <span class="omni-tabs__title">@Title</span>
        </button>
    </div>
}
