@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<button id="@Id"
        class="@Css("omni-sidebar-toggle")"
        type="button"
        aria-controls="@Controls"
        aria-expanded="@(Open ? "true" : "false")"
        aria-label="@EffectiveAriaLabel"
        @attributes="AdditionalAttributes"
        @onclick="ToggleAsync">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!Open)
    {
        <OmniIcon Name="OmniIconName.Menu" />
    }
    else if (OpenIcon is { } openIcon)
    {
        <OmniIcon Name="@openIcon" />
    }
    else
    {
        @* Both glyphs, one shown per width: the menu while the sidebar sits beside the content, the cross
           on a phone where it covers the page. *@
        <OmniIcon Name="OmniIconName.Menu" Class="omni-sidebar-toggle__wide" />
        <OmniIcon Name="OmniIconName.Close" Class="omni-sidebar-toggle__narrow" />
    }
</button>
