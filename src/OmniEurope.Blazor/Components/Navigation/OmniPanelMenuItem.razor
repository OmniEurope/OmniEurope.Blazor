@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@inject NavigationManager Navigation
@implements IDisposable
@using OmniEurope.Blazor.Internal

@if (ChildContent is not null)
{
    @* A group is a controlled disclosure rather than a <details>: the open state has to follow the
       active route, and a <details> the browser toggles on its own drifts away from that. *@
    <div @attributes="AdditionalAttributes"
         id="@Id"
         class="@Css("omni-panel-menu__group", IsOpen ? "omni-panel-menu__group--open" : "omni-panel-menu__group--closed")">
        <div class="omni-panel-menu__summary">
            @if (!string.IsNullOrWhiteSpace(Href))
            {
                @* A group that names a route is navigable as well as expandable, which is what a
                   section landing page needs. The chevron stays its own control, so reaching the
                   children never costs a navigation. *@
                <a class="@GroupLinkClass"
                   href="@SafeHref"
                   aria-current="@(IsCurrent ? "page" : null)"
                   @onclick="HandleNavigateAsync"
                   @onclick:preventDefault="@(CanNavigate is not null)">
                    @if (Icon is not null)
                    {
                        <span class="omni-panel-menu__icon" aria-hidden="true">@Icon</span>
                    }
                    <span class="omni-panel-menu__text">@Text</span>
                </a>
            }
            else
            {
                <button type="button"
                        class="@GroupLinkClass"
                        aria-expanded="@(IsOpen ? "true" : "false")"
                        aria-controls="@ChildrenId"
                        @onclick="Toggle">
                    @if (Icon is not null)
                    {
                        <span class="omni-panel-menu__icon" aria-hidden="true">@Icon</span>
                    }
                    <span class="omni-panel-menu__text">@Text</span>
                </button>
            }

            <button type="button"
                    class="omni-panel-menu__toggle"
                    aria-expanded="@(IsOpen ? "true" : "false")"
                    aria-controls="@ChildrenId"
                    aria-label="@ToggleLabel"
                    @onclick="Toggle">
                <svg class="omni-panel-menu__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
        </div>

        @* The context flows down even while the group is collapsed: it is what the children use
           to report they are the current page, and therefore what expands the group. *@
        <CascadingValue Value="OwnContext" IsFixed="true">
            <div id="@ChildrenId" class="omni-panel-menu__children" hidden="@(!IsOpen)">@ChildContent</div>
        </CascadingValue>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Href))
{
    <a @attributes="AdditionalAttributes"
       id="@Id"
       class="@LinkClass"
       href="@SafeHref"
       aria-current="@(IsCurrent ? "page" : null)"
       @onclick="HandleNavigateAsync"
       @onclick:preventDefault="@(CanNavigate is not null)">
        @if (Icon is not null)
        {
            <span class="omni-panel-menu__icon" aria-hidden="true">@Icon</span>
        }
        <span class="omni-panel-menu__text">@Text</span>
    </a>
}
else
{
    <span @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-panel-menu__label")">
        @if (Icon is not null)
        {
            <span class="omni-panel-menu__icon" aria-hidden="true">@Icon</span>
        }
        <span class="omni-panel-menu__text">@Text</span>
    </span>
}
