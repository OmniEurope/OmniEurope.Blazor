@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@inject NavigationManager Navigation
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@* Overlay mode needs the aside to hold a positioned panel while taking no width of its own, so the
   panel is its own element rather than the aside itself. Push mode leaves both in the flow and the
   pair renders exactly as the single element used to. *@
<aside @attributes="AdditionalAttributes"
       id="@Id"
       class="@Css("omni-sidebar", $"omni-sidebar--{Position.ToString().ToLowerInvariant()}", $"omni-sidebar--{EffectiveReveal.ToString().ToLowerInvariant()}", $"omni-sidebar--collapse-{Collapse.ToString().ToLowerInvariant()}", Open ? "omni-sidebar--open" : "omni-sidebar--closed", Header is not null ? "omni-sidebar--has-header" : null, Smooth ? "omni-sidebar--smooth" : null)"
       aria-label="@EffectiveLabel"
       aria-hidden="@(Concealed ? "true" : null)"
       inert="@Concealed"
       hidden="@(!Rendered)">
    @* The veil belongs to the sidebar and not to the page: it exists only while a floating sidebar
       is open, and closing it is the one thing it does. *@
    @if (ShowBackdrop)
    {
        <button type="button"
                class="omni-sidebar__backdrop"
                aria-label="@EffectiveCloseLabel"
                title="@EffectiveCloseLabel"
                @onclick="CloseAsync"></button>
    }
    <div class="omni-sidebar__panel" @ref="_panel">
        @* Shown only while the panel floats open, when it rises over the application header and
           must carry what it covers. The rest of the time the header above it is the real one. *@
        @if (Header is not null)
        {
            <div class="omni-sidebar__header">@Header</div>
        }
        @* A menu taller than the window scrolls without a scrollbar: a chevron above and below shows
           that items are hidden that way and scrolls to them, as the tab strips do sideways. The
           chevrons are for the pointer; the keyboard reaches every item and brings it into view. *@
        <button type="button" class="omni-sidebar__scroll omni-sidebar__scroll--start" tabindex="-1" aria-hidden="true" hidden>
            <svg class="omni-sidebar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                <path d="M6 15l6-6 6 6" />
            </svg>
        </button>
        <div class="omni-sidebar__viewport">
            <CascadingValue Value="State">
                @ChildContent
            </CascadingValue>
        </div>
        <button type="button" class="omni-sidebar__scroll omni-sidebar__scroll--end" tabindex="-1" aria-hidden="true" hidden>
            <svg class="omni-sidebar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </button>
    </div>
</aside>
