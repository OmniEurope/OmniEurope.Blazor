@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The mode inline; the theme, the palette with the mode again, the font and the scales in the
   appearance window, opened from the last row (review points 84 and 92: the font only there). The mode is a segmented choice (radio group): the
   chosen mode reads by its state, not by its colour alone. *@
<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-appearance-settings", Compact ? "omni-appearance-settings--compact" : null)">
    <div class="omni-appearance-settings__row">
        <span class="omni-appearance-settings__label"><OmniIcon Name="OmniIconName.Palette" /> @Localize("SettingsMode")</span>
        <div class="omni-appearance-settings__actions">
            @* A theme drawn in dark mode only shows the mode it draws, fixed, and says why. *@
            <OmniSelectBar TValue="OmniAppearance" Options="@ModeOptions" IconFor="@ModeIcon" Label="@Localize("SettingsMode")"
                           Disabled="@ModeFixed" title="@ModeFixedTitle"
                           @bind-Value:get="ShownAppearance" @bind-Value:set="SetAppearanceAsync" />
        </div>
    </div>
    @* Compact, the look reads as one short label and a summary beside the edit action, instead of a
       title wrapped over several lines. Edit is the main action of the row: Primary, the accent. *@
    <div class="omni-appearance-settings__row omni-appearance-settings__row--scale">
        <span class="omni-appearance-settings__label" id="@RowId("look")"><OmniIcon Name="OmniIconName.Layers" /> @LookTitle</span>
        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("look")">
            @if (Compact)
            {
                <span class="omni-appearance-settings__summary">@LookSummary</span>
            }
            <OmniButton Variant="OmniButtonVariant.Primary" OnClick="OpenWindowAsync"><OmniIcon Name="OmniIconName.Edit" /><span>@Localize("Edit")</span></OmniButton>
        </div>
    </div>
</div>
@* The window of the look: theme, palette and mode, font, the density and the scales. The same window
   a host opens from its own menu entry (OmniAppearanceWindow). *@
<OmniAppearanceWindow Open="@_windowOpen" OpenChanged="SetWindowOpenAsync"
                      Appearance="Appearance" AppearanceChanged="WindowAppearanceChanged"
                      Preset="Preset" PresetChanged="ChangeThemeAsync"
                      Palette="Palette" PaletteChanged="ChangePaletteAsync"
                      Font="Font" FontChanged="WindowFontChanged"
                      BackdropMotion="BackdropMotion" BackdropMotionChanged="WindowBackdropMotionChanged"
                      TextSizeLevel="TextSizeLevel" TextSizeLevelChanged="ChangeTextSizeAsync"
                      Density="Density" DensityChanged="ChangeDensityAsync"
                      ControlSizeLevel="ControlSizeLevel" ControlSizeLevelChanged="WindowControlSizeChanged"
                      FullWidth="FullWidth" FullWidthChanged="WindowFullWidthChanged" />
