@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The window of the look, one grid of rows laid two by two where it is wide enough: theme and palette,
   the text size and the size of the controls, then the density, the font and, under a theme that moves
   its field, its motion. Modeless and draggable, so the page stays in view while the user tries a
   setting; each row shows only once the host binds its change, so the window never offers a setting
   that does nothing. Every row is a group named by its label, so its buttons are read with it. *@
<OmniDialog AdditionalAttributes="AdditionalAttributes" Id="@Id" Class="@Css("omni-appearance-window")"
            Open="@Open" OpenChanged="OpenChanged" Modal="false" Draggable="true" FreezeScale="true" Title="@EffectiveTitle">
    <ChildContent>
        @if (ShowsRows)
        {
            <div class="omni-appearance-settings omni-appearance-settings--window">
                @if (PresetChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("theme")"><OmniIcon Name="OmniIconName.Layers" /> @Localize("SettingsTheme")</span>
                        @* Beside the name of the row: a theme and a palette drawn at random. *@
                        <OmniButton Variant="OmniButtonVariant.Secondary" Class="omni-appearance-settings__random" title="@Localize("SettingsRandomTitle")" OnClick="RandomLookAsync"><OmniIcon Name="OmniIconName.Dice" /><span>@Localize("SettingsRandom")</span></OmniButton>
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("theme")">
                            <OmniDropDown TValue="string" Options="@ThemeOptions" @bind-Value:get="ThemeName" @bind-Value:set="SetThemeAsync" Label="@Localize("SettingsTheme")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Preset is null)" OnClick="ResetThemeAsync"><OmniIcon Name="OmniIconName.Reset" /><span>@Localize("SettingsDefault")</span></OmniButton>
                        </div>
                    </div>
                }
                @if (PaletteChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("palette")"><OmniIcon Name="OmniIconName.Palette" /> @Localize("SettingsPalette")</span>
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("palette")">
                            <OmniDropDown TValue="string" Options="@PaletteOptions" @bind-Value:get="PaletteName" @bind-Value:set="SetPaletteAsync" Label="@Localize("SettingsPalette")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Palette is null)" OnClick="ResetPaletteAsync"><OmniIcon Name="OmniIconName.Reset" /><span>@Localize("SettingsDefault")</span></OmniButton>
                        </div>
                    </div>
                }
                @if (TextSizeLevelChanged.HasDelegate)
                {
                    @ScaleRow(TextSizeScale)
                }
                @if (ControlSizeLevelChanged.HasDelegate)
                {
                    @ScaleRow(ControlSizeScale)
                }
                @if (DensityChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label"><OmniIcon Name="OmniIconName.Rows" /> @Localize("SettingsDensity")</span>
                        <div class="omni-appearance-settings__actions">
                            <OmniSelectBar TValue="OmniDensity" Options="@DensityOptions" Label="@Localize("SettingsDensity")"
                                           @bind-Value:get="Density" @bind-Value:set="SetDensityAsync" />
                        </div>
                    </div>
                }
                @if (FontChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("font")"><OmniIcon Name="OmniIconName.TextItalic" /> @Localize("SettingsFont")</span>
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("font")">
                            <OmniDropDown TValue="string" Options="@FontOptions" @bind-Value:get="FontName" @bind-Value:set="SetFontAsync" Label="@Localize("SettingsFont")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Font is null)" OnClick="ResetFontAsync"><OmniIcon Name="OmniIconName.Reset" /><span>@Localize("SettingsDefault")</span></OmniButton>
                        </div>
                    </div>
                }
                @if (ShowsBackdropMotion)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("motion")"><OmniIcon Name="OmniIconName.Sparkle" /> @Localize("SettingsBackdropMotion")</span>
                        <div class="omni-appearance-settings__actions">
                            <OmniSwitch TValue="bool" aria-labelledby="@RowId("motion")"
                                        @bind-Value:get="BackdropMotion" @bind-Value:set="SetBackdropMotionAsync" />
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</OmniDialog>
