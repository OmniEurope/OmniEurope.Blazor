@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The window of the look, one grid of rows laid two by two where it is wide enough: theme and palette
   (the mode on its title line), font and backdrop, density, then the text size and the size of the controls. The
   motion of a backdrop that moves sits on the title line of the backdrop row (of the theme row without it). Modeless
   and draggable, so the page stays in view while the user tries a setting; each row shows only once the host binds its
   change, so the window never offers a setting that does nothing. Every row is a group named by its
   label, so its buttons are read with it. The footer holds the actions on the whole look: a random
   one, all back to the defaults, then Apply, which keeps the current look, and Restore, which puts
   back the look the window opened on (owner decision of 2026-10-02: Apply before Restore). *@
<OmniDialog AdditionalAttributes="AdditionalAttributes" Id="@Id" Class="@Css("omni-appearance-window")"
            Open="@Open" OpenChanged="OnDialogOpenChangedAsync" Modal="false" Draggable="true" FreezeScale="true" Title="@EffectiveTitle">
    <ChildContent>
        @if (ShowsRows)
        {
            <div class="omni-appearance-settings omni-appearance-settings--window">
                @if (PresetChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("theme")"><OmniIcon Name="OmniIconName.Layers" /> @Localize("SettingsTheme")</span>
                        @if (ShowsBackdropMotion && !BackdropChanged.HasDelegate)
                        {
                            @* On the title line, aligned to the end: the switch adds no height to the row. *@
                            @MotionSwitch
                        }
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("theme")">
                            <OmniDropDown TValue="string" Options="@ThemeOptions" @bind-Value:get="ThemeName" @bind-Value:set="SetThemeAsync" Label="@Localize("SettingsTheme")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Preset is null)" OnClick="ResetThemeAsync"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent><span>@Localize("SettingsDefault")</span></ChildContent></OmniButton>
                        </div>
                    </div>
                }
                @if (PaletteChanged.HasDelegate || AppearanceChanged.HasDelegate)
                {
                    @* The mode joins the palette tile as three icon buttons in one group, as in the
                       application menu (review point 92): on its title line, aligned to the end like
                       the motion of the theme, so the list keeps its width. With no palette bound the mode
                       keeps the row for itself. The chosen mode reads by its state (radio), not by its
                       colour alone. *@
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("palette")"><OmniIcon Name="@(PaletteChanged.HasDelegate ? OmniIconName.Palette : OmniIconName.ThemeSystem)" /> @Localize(PaletteChanged.HasDelegate ? "SettingsPalette" : "SettingsMode")</span>
                        @if (AppearanceChanged.HasDelegate)
                        {
                            @ModeGroup
                        }
                        @if (PaletteChanged.HasDelegate)
                        {
                            <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("palette")">
                                <OmniDropDown TValue="string" Options="@PaletteOptions" @bind-Value:get="PaletteName" @bind-Value:set="SetPaletteAsync" Label="@Localize("SettingsPalette")" />
                                <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Palette is null)" OnClick="ResetPaletteAsync"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent><span>@Localize("SettingsDefault")</span></ChildContent></OmniButton>
                            </div>
                        }
                    </div>
                }
                @if (FontChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("font")"><OmniIcon Name="OmniIconName.TextItalic" /> @Localize("SettingsFont")</span>
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("font")">
                            <OmniDropDown TValue="string" Options="@FontOptions" @bind-Value:get="FontName" @bind-Value:set="SetFontAsync" Label="@Localize("SettingsFont")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Font is null)" OnClick="ResetFontAsync"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent><span>@Localize("SettingsDefault")</span></ChildContent></OmniButton>
                        </div>
                    </div>
                }
                @if (BackdropChanged.HasDelegate)
                {
                    @* The backdrop drawn behind the page (review R1-2), right before the motion that animates
                       it: the switch sits on the title line of this row, aligned to the end. Under Essentiel the
                       list holds the plain page alone. *@
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label" id="@RowId("backdrop")"><OmniIcon Name="OmniIconName.Image" /> @Localize("SettingsBackdrop")</span>
                        @if (ShowsBackdropMotion)
                        {
                            @MotionSwitch
                        }
                        <div class="omni-appearance-settings__actions" role="group" aria-labelledby="@RowId("backdrop")">
                            <OmniDropDown TValue="string" Options="@BackdropOptions" @bind-Value:get="BackdropName" @bind-Value:set="SetBackdropAsync" Label="@Localize("SettingsBackdrop")" />
                            <OmniButton Variant="OmniButtonVariant.Secondary" Disabled="@(Backdrop is null)" OnClick="ResetBackdropAsync"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent><span>@Localize("SettingsDefault")</span></ChildContent></OmniButton>
                        </div>
                    </div>
                }
                @if (ShowsBackdropMotion && !PresetChanged.HasDelegate && !BackdropChanged.HasDelegate)
                {
                    @* No theme nor backdrop row to sit under: the motion keeps a row of its own. *@
                    <div class="omni-appearance-settings__row">@MotionSwitch</div>
                }
                @if (DensityChanged.HasDelegate)
                {
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label"><OmniIcon Name="OmniIconName.Rows" /> @Localize("SettingsDensity")</span>
                        <div class="omni-appearance-settings__actions">
                            <OmniSelectBar TValue="OmniDensity" Options="@DensityOptions" Label="@Localize("SettingsDensity")"
                                           @bind-Value:get="Density" @bind-Value:set="SetDensityAsync" />
                        </div>
                    </div>
                }
                @if (TextSizeLevelChanged.HasDelegate)
                {
                    @ScaleRow(TextSizeScale)
                }
                @if (ControlSizeLevelChanged.HasDelegate)
                {
                    @ScaleRow(ControlSizeScale)
                }
                @if (FullWidthChanged.HasDelegate)
                {
                    @* Centred column or the whole width (review R1-1): the host keeps its own column and
                       passes the whole width to its main area when asked. *@
                    <div class="omni-appearance-settings__row">
                        <span class="omni-appearance-settings__label"><OmniIcon Name="OmniIconName.Layout" /> @Localize("SettingsContentWidth")</span>
                        <div class="omni-appearance-settings__actions">
                            <OmniSelectBar TValue="bool" Options="@WidthOptions" Label="@Localize("SettingsContentWidth")"
                                           @bind-Value:get="FullWidth" @bind-Value:set="SetFullWidthAsync" />
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (ShowsRows)
        {
            <div class="omni-appearance-window__footer">
                <div class="omni-appearance-window__tools">
                    @if (PresetChanged.HasDelegate)
                    {
                        <OmniButton Variant="OmniButtonVariant.Secondary" Class="omni-appearance-settings__random" title="@Localize("SettingsRandomTitle")" OnClick="RandomLookAsync"><Icon><OmniIcon Name="OmniIconName.Dice" /></Icon><ChildContent><span>@Localize("SettingsRandom")</span></ChildContent></OmniButton>
                    }
                    <OmniButton Variant="OmniButtonVariant.Secondary" Class="omni-appearance-window__reset" Disabled="@IsDefaultLook" OnClick="ResetAllAsync"><Icon><OmniIcon Name="OmniIconName.Reset" /></Icon><ChildContent><span>@Localize("SettingsResetAll")</span></ChildContent></OmniButton>
                </div>
                <div class="omni-appearance-window__decision">
                    <OmniButton Variant="OmniButtonVariant.Primary" Class="omni-appearance-window__apply" OnClick="ApplyAsync"><Icon><OmniIcon Name="OmniIconName.Check" /></Icon><ChildContent><span>@Localize("SettingsApply")</span></ChildContent></OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" Class="omni-appearance-window__cancel" OnClick="CancelAsync"><Icon><OmniIcon Name="OmniIconName.Restore" /></Icon><ChildContent><span>@Localize("SettingsRestore")</span></ChildContent></OmniButton>
                </div>
            </div>
        }
    </FooterContent>
</OmniDialog>
