@inherits OmniComponentBase
@implements IDisposable

<CascadingValue Value="Service" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (Service.Dialog is { } dialog)
{
    <OmniDialog Open="true" Title="@dialog.Title" CloseLabel="@dialog.CloseLabel" OpenChanged="HandleDialogOpenChanged">
        @dialog.Content
    </OmniDialog>
}

<section class="omni-notification-region" aria-label="Notifications">
    @foreach (var notification in Service.Notifications)
    {
        <OmniNotification Message="@notification.Message"
                          Title="@notification.Title"
                          Severity="@notification.Severity"
                          OnDismiss="() => Service.Dismiss(notification.Id)" />
    }
</section>

@code {
    [Parameter]
    public OmniOverlayService? OverlayService { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private OmniOverlayService Service { get; set; } = new();

    protected override void OnInitialized()
    {
        Service = OverlayService ?? new OmniOverlayService();
        Service.Changed += HandleChanged;
    }

    private Task HandleDialogOpenChanged(bool open)
    {
        if (!open)
        {
            Service.CloseDialog();
        }

        return Task.CompletedTask;
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Service.Changed -= HandleChanged;
}
