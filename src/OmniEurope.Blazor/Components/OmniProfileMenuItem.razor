@inherits OmniComponentBase

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-profile-menu__item")" role="menuitem" href="@Href">@ChildContent</a>
}
else
{
    <button @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-profile-menu__item")" role="menuitem" type="button" disabled="@Disabled" @onclick="OnClick">@ChildContent</button>
}

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
