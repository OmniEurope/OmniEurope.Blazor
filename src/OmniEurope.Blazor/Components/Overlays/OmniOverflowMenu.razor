@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IOmniMenu
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@* The "⋮" of a row or a header: three dots alone, no frame, that open a vertical menu of actions.
   The trigger toggles on its own click; the menu is drawn in the overlay portal and kept inside the
   window by omni-focus.js. Without an OmniComponentsHost it is drawn here, fixed to the window. *@
<div @ref="_root"
     @attributes="AdditionalAttributes"
     class="@Css("omni-overflow-menu")"
     @onkeydown="HandleTriggerKeyDownAsync">
    <OmniButton Id="@Id"
                Variant="OmniButtonVariant.Ghost"
                Size="Size"
                Class="omni-overflow-menu__trigger"
                Label="@EffectiveLabel"
                title="@EffectiveLabel"
                Disabled="Disabled"
                OnClick="ToggleAsync"
                aria-haspopup="menu"
                aria-expanded="@(IsOpen ? "true" : "false")"
                aria-controls="@(IsOpen ? MenuId : null)"><OmniIcon Name="OmniIconName.DotsThreeVertical" /></OmniButton>
    @if (IsOpen && Coordinator is null)
    {
        @Popup
    }
</div>
