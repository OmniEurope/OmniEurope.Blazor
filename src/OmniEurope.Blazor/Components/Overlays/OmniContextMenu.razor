@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IOmniMenu
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@* The wrapped content is the trigger: a right-click opens the menu at the pointer, the ContextMenu key
   or Shift+F10 under the trigger. The menu is drawn in the overlay portal, or here without a host. *@
<div @attributes="AdditionalAttributes"
     @ref="_trigger"
     id="@Id"
     class="@Css("omni-context-menu")"
     data-omni-density="@OmniDensityAttribute.Of(Density)"
     tabindex="0"
     @oncontextmenu="OpenAtPointerAsync"
     @oncontextmenu:preventDefault="!Disabled"
     @onkeydown="HandleTriggerKeyDownAsync">
    <div class="omni-context-menu__trigger">@TriggerContent</div>
    @if (IsOpen && Coordinator is null)
    {
        @Popup
    }
</div>
