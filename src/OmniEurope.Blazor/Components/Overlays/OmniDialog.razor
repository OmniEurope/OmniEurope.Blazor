@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@if (Open)
{
    <div class="omni-overlay" role="presentation" @onclick="HandleBackdropAsync">
        <section @attributes="AdditionalAttributes"
                 @ref="_dialog"
                 id="@EffectiveId"
                 class="@Css("omni-dialog")"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleKeyDownAsync">
            <button type="button" class="omni-visually-hidden" data-focus-sentinel aria-label="@Localize("DialogEnd")" @onfocus="FocusLastAsync"></button>
            <header class="omni-dialog__header">
                <h2 id="@TitleId" class="omni-dialog__title">@Title</h2>
                <button type="button" class="omni-dialog__close" aria-label="@EffectiveCloseLabel" autofocus @onclick="CloseAsync">×</button>
            </header>
            <div class="omni-dialog__content" tabindex="-1">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="omni-dialog__footer">@Footer</footer>
            }
            <button type="button" class="omni-visually-hidden" data-focus-sentinel aria-label="@Localize("DialogStart")" @onfocus="FocusFirstAsync"></button>
        </section>
    </div>
}
