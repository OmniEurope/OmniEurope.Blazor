@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@switch (Level)
{
    case OmniHeadingLevel.H1:
        <h1 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h1>
        break;
    case OmniHeadingLevel.H2:
        <h2 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h2>
        break;
    case OmniHeadingLevel.H3:
        <h3 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h3>
        break;
    case OmniHeadingLevel.H4:
        <h4 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h4>
        break;
    case OmniHeadingLevel.H5:
        <h5 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h5>
        break;
    default:
        <h6 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h6>
        break;
}
