@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* One heading for the two layouts: alone, exactly as before, or beside the help mark. *@
@{
    RenderFragment heading = Level switch
    {
        OmniHeadingLevel.H1 => @<h1 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h1>,
        OmniHeadingLevel.H2 => @<h2 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h2>,
        OmniHeadingLevel.H3 => @<h3 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h3>,
        OmniHeadingLevel.H4 => @<h4 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h4>,
        OmniHeadingLevel.H5 => @<h5 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h5>,
        _ => @<h6 @attributes="AdditionalAttributes" id="@Id" class="@HeadingClass">@ChildContent</h6>,
    };
}

@if (string.IsNullOrWhiteSpace(Help))
{
    @heading
}
else
{
    @* The mark stays outside the heading, as it stays outside a field's label: its text is a description,
       not a part of the heading's name in the document outline. *@
    <div class="@RowClass">
        @heading
        <OmniTooltip Id="@HelpId" Class="omni-heading__help" Text="@Help" Focusable="true">
            <span class="omni-heading__help-mark" role="img" aria-label="@Localize("FormFieldHelp")"><OmniIcon Name="OmniIconName.Question" /></span>
        </OmniTooltip>
    </div>
}
