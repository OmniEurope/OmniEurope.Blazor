@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@switch (Level)
{
    case OmniHeadingLevel.H1:
        <h1 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h1>
        break;
    case OmniHeadingLevel.H2:
        <h2 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h2>
        break;
    case OmniHeadingLevel.H3:
        <h3 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h3>
        break;
    case OmniHeadingLevel.H4:
        <h4 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h4>
        break;
    case OmniHeadingLevel.H5:
        <h5 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h5>
        break;
    default:
        <h6 id="@Id" class="@HeadingClass" @attributes="AdditionalAttributes">@ChildContent</h6>
        break;
}
