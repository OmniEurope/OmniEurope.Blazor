@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@switch (Element)
{
    case OmniTextElement.Paragraph:
        <p @attributes="AdditionalAttributes" id="@Id" class="@TextClass">@ChildContent</p>
        break;
    case OmniTextElement.Strong:
        <strong @attributes="AdditionalAttributes" id="@Id" class="@TextClass">@ChildContent</strong>
        break;
    case OmniTextElement.Emphasis:
        <em @attributes="AdditionalAttributes" id="@Id" class="@TextClass">@ChildContent</em>
        break;
    case OmniTextElement.Small:
        <small @attributes="AdditionalAttributes" id="@Id" class="@TextClass">@ChildContent</small>
        break;
    default:
        <span @attributes="AdditionalAttributes" id="@Id" class="@TextClass">@ChildContent</span>
        break;
}
