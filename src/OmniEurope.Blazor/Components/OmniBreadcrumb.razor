@inherits OmniComponentBase

<nav @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-breadcrumb")" aria-label="@Label">
    <ol class="omni-breadcrumb__list">@ChildContent</ol>
</nav>

@code {
    [Parameter]
    public string Label { get; set; } = "Fil d'Ariane";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
