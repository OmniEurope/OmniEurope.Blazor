@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniComponentBase
@implements IAsyncDisposable

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@Css("omni-tree__item", Selected ? "omni-tree__item--selected" : null)"
     role="treeitem"
     aria-selected="@(Selected ? "true" : "false")"
     aria-expanded="@(HasChildren ? (_expanded ? "true" : "false") : null)"
     tabindex="0"
     @onkeydown="HandleKeyDownAsync"
     @onkeydown:stopPropagation="true">
    @* Dragged with the pointer when the tree allows it (the whole row); a row that accepts the item carried
       lets it be dropped (dragover default prevented) and is highlighted while the pointer is over it. *@
    <div class="@RowClass" draggable="@(CanDragThis ? "true" : null)"
         @ondragstart="DragStart" @ondragend="DragEnd"
         @ondragenter="DragEnter" @ondragleave="DragLeave"
         @ondragover:preventDefault="@AcceptsDrop"
         @ondrop="DropAsync" @ondrop:preventDefault="true">
        @if (HasChildren)
        {
            <button type="button" class="omni-tree__toggle" aria-label="@(_expanded ? Localize("TreeCollapse") : Localize("TreeExpand"))" @onclick="ToggleExpandedAsync">@(_expanded ? "▾" : "▸")</button>
        }
        @if (TextContent is not null)
        {
            <button type="button" class="omni-tree__select" aria-label="@Text" disabled="@Disabled" @onclick="SelectAsync">@TextContent</button>
        }
        else
        {
            <button type="button" class="omni-tree__select" disabled="@Disabled" @onclick="SelectAsync">@Text</button>
        }
    </div>
    @if (_expanded && HasChildren)
    {
        @if (_loading)
        {
            <span class="omni-tree__state" role="status">@Localize("Loading")</span>
        }
        else if (_loadError)
        {
            <span class="omni-tree__state" role="alert">@Localize("TreeLoadFailed")</span>
        }
        <div class="omni-tree__level" role="group"><CascadingValue Value="this" Name="OmniTreeParentItem" IsFixed="true">@ChildContent</CascadingValue></div>
    }
</div>
