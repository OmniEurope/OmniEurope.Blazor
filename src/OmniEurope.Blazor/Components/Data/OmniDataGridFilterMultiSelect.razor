@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The search box and the list are the same in both presentations; only their frame changes. *@
@{
    RenderFragment list = @<text>
        @if (Filterable)
        {
            <input id="@Id"
                   type="text"
                   class="omni-input omni-multi-select__search"
                   autocomplete="off"
                   placeholder="@Placeholder"
                   value="@_search"
                   @oninput="OnSearchInput" />
        }
        @* Named by the search box or the folded summary; open without either, the list takes the id
           itself and its own name. *@
        <ul id="@(NamesItself ? Id : null)" class="omni-multi-select__list" role="listbox" aria-multiselectable="true"
            aria-labelledby="@(NamesItself ? null : Id)" aria-label="@(NamesItself ? EffectiveLabel : null)">
            @foreach (var candidate in Matches)
            {
                var option = candidate;
                var checkedNow = Selected.Contains(option);
                <li class="omni-multi-select__option" role="option" aria-selected="@(checkedNow ? "true" : "false")">
                    <label class="omni-multi-select__label">
                        <input type="checkbox"
                               class="omni-multi-select__checkbox"
                               checked="@checkedNow"
                               @onchange="args => ToggleAsync(option, args.Value is true)" />
                        <span>
                            @foreach (var segment in OmniTextMatch.Split(Display(option), _search))
                            {
                                if (segment.Matched)
                                {
                                    <mark class="omni-combo__match">@segment.Text</mark>
                                }
                                else
                                {
                                    @segment.Text
                                }
                            }
                        </span>
                    </label>
                </li>
            }
        </ul>
    </text>;
}

@if (Presentation == OmniMultiSelectPresentation.Compact)
{
    @* Folded on one line: the summary reads the ticked values and the list opens on demand over the
       rows. Outside click, Escape and placement past the grid's scroll box are the behaviour the
       grid gives every [data-omni-popover]. *@
    <details @attributes="AdditionalAttributes" class="@Css("omni-data-grid__popover", "omni-data-grid__multi")" data-omni-popover>
        <summary id="@(Filterable ? null : Id)" class="omni-input omni-data-grid__multi-summary" aria-haspopup="listbox">
            <span class="@SummaryClass">@SummaryText</span>
            <OmniIcon Name="OmniIconName.ChevronDown" Size="OmniControlSize.Small" />
        </summary>
        <div class="omni-data-grid__popover-panel omni-data-grid__multi-panel">
            @list
        </div>
    </details>
}
else
{
    <div @attributes="AdditionalAttributes" class="@Css("omni-multi-select")">
        @list
    </div>
}
