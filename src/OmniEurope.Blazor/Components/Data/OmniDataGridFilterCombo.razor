@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* While the list is open, no key pressed in the field goes up to a Blazor handler around it, so a dialog
   holding the grid never closes on the Escape meant for the list. *@
<div @attributes="AdditionalAttributes" class="@Css("omni-combo")" @onkeydown:stopPropagation="@(IsOpen || _escape.IsConsumed)">
    <input id="@Id"
           type="text"
           class="omni-input omni-data-grid__filter omni-combo__input"
           role="combobox"
           aria-expanded="@(IsOpen ? "true" : "false")"
           aria-controls="@ListId"
           aria-autocomplete="list"
           aria-activedescendant="@ActiveOptionId"
           autocomplete="off"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnInputAsync"
           @onkeydown="OnKeyDownAsync"
           @onkeyup="_escape.ReleaseHandler"
           @onfocus="OpenList"
           @onblur="BlurList" />
    @if (IsOpen)
    {
        // Matches filters the suggestions on every read: read once per render.
        var matches = Matches;
        <ul id="@ListId" class="omni-combo__list" role="listbox">
            @for (var index = 0; index < matches.Count; index++)
            {
                var position = index;
                var candidate = matches[position];
                <li id="@OptionId(position)"
                    class="@OptionClass(position)"
                    role="option"
                    aria-selected="@(position == _activeIndex ? "true" : "false")"
                    @onmousedown:preventDefault="true"
                    @onmousedown="() => PickAsync(candidate)">
                    @foreach (var segment in OmniTextMatch.Split(candidate, Value))
                    {
                        if (segment.Matched)
                        {
                            <mark class="omni-combo__match">@segment.Text</mark>
                        }
                        else
                        {
                            @segment.Text
                        }
                    }
                </li>
            }
        </ul>
    }
</div>
