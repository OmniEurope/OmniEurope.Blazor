@inherits OmniComponentBase

<figure @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-arc-gauge")">
    <svg class="omni-arc-gauge__svg" viewBox="0 0 100 60" role="img" aria-label="@Label">@ChildContent</svg>
</figure>

@code {
    [Parameter] public string Label { get; set; } = "Jauge";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
