@typeparam TValue
@inherits OmniValidatorBase<TValue>
@using System.Linq.Expressions

@if (ShowMessage && !string.IsNullOrWhiteSpace(CurrentError))
{
    <div class="omni-validation-message" role="alert">@CurrentError</div>
}

@code {
    private Func<TValue>? _otherAccessor;

    [Parameter, EditorRequired]
    public Expression<Func<TValue>> Other { get; set; } = default!;

    [Parameter]
    public string Message { get; set; } = "Les valeurs ne correspondent pas.";

    protected override void OnInitialized()
    {
        _otherAccessor = Other.Compile();
        base.OnInitialized();
    }

    protected override string? GetValidationError(TValue value) =>
        EqualityComparer<TValue>.Default.Equals(value, _otherAccessor!()) ? null : Message;
}
