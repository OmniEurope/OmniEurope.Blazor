@inherits OmniComponentBase

<li @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-breadcrumb__item")">
    @if (Current || string.IsNullOrWhiteSpace(Href))
    {
        <span aria-current="@(Current ? "page" : null)">@ChildContent</span>
    }
    else
    {
        <a href="@Href">@ChildContent</a>
    }
</li>

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Current { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
