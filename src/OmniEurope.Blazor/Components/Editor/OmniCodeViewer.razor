@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable

@* Read-only code with its line numbers, without Monaco: plain markup, valid under the strict policy.
   Line numbers are drawn beside the text, never inside it, so selecting and copying the code by hand
   does not pick them up. *@
<section @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-code-viewer", SidePanel is not null ? "omni-code-viewer--with-panel" : null, _wrap ? "omni-code-viewer--wrap" : null)"
         aria-labelledby="@TitleId">
    @Header
    <div class="omni-code-viewer__body">
        <div class="omni-code-viewer__code" role="region" aria-labelledby="@TitleId" tabindex="0">
            @if (_lines.Count == 0 || (_lines.Count == 1 && _lines[0].Length == 0))
            {
                <p class="omni-code-viewer__empty">@EffectiveEmptyText</p>
            }
            else
            {
                @for (var index = 0; index < _lines.Count; index++)
                {
                    var number = Math.Max(1, FirstLineNumber) + index;
                    <div class="@LineClass(number)">
                        @if (ShowLineNumbers)
                        {
                            <span class="omni-code-viewer__number" aria-hidden="true">@number</span>
                        }
                        <code class="omni-code-viewer__text">
                            @foreach (var segment in Segments(_lines[index], number))
                            {
                                if (segment.Link is { } link)
                                {
                                    <button type="button" class="omni-code-viewer__link" title="@link.Tooltip" @onclick="() => ActivateLinkAsync(link)">@segment.Text</button>
                                }
                                else
                                {
                                    @segment.Text
                                }
                            }
                        </code>
                    </div>
                }
            }
        </div>
        @if (SidePanel is not null)
        {
            <aside class="omni-code-viewer__panel" aria-label="@SidePanelLabel">@SidePanel</aside>
        }
    </div>
    <span class="omni-visually-hidden" role="status" aria-live="polite">@CopyAnnouncement</span>
</section>
