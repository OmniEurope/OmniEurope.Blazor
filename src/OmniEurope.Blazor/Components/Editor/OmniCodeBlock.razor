@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable

@* A command, a snippet or a secret to copy. The copy always takes the real value, even while a
   secret is masked on screen; the result is announced in words, never by a colour change alone. The
   header (title, language, copy button) is the one OmniCodeViewer draws. *@
<figure @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-code-block", Inline ? "omni-code-block--inline" : null, Wrap ? "omni-code-block--wrap" : null)">
    @Header
    <pre class="omni-code-block__pre" tabindex="0"><code class="@CodeClass">@DisplayedCode</code></pre>
    <span class="omni-visually-hidden" role="status" aria-live="polite">@CopyAnnouncement</span>
</figure>
