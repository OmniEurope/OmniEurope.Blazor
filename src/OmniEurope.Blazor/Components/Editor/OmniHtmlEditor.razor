@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>
@implements IAsyncDisposable
@using OmniEurope.Blazor.Internal

@* The editor is written once and placed either alone or inside the document frame (the sheet and
   the status bar), which wraps it without changing it. *@
@{
    @* The rows of the context menu: the menu around them is the package's one menu (ContextMenuList). *@
    RenderFragment contextMenuItems =
        @<text>
            @* A passage a proofreader flagged: its explanation, its corrections, then what can be done with it. *@
            @if (_proofreading?.Issue is { } issue && _proofreading.Proofreader is { } proofreader)
            {
                @if (!string.IsNullOrWhiteSpace(issue.Message))
                {
                    <OmniMenuItem Disabled="true" data-proofreading="message"><ChildContent>@issue.Message</ChildContent></OmniMenuItem>
                }

                @if (_proofreading.Loading)
                {
                    <OmniMenuItem Disabled="true" data-proofreading="loading"><ChildContent>@Localize("HtmlEditorProofreadingLoading")</ChildContent></OmniMenuItem>
                }
                else if (_proofreading.Suggestions.Count == 0)
                {
                    <OmniMenuItem Disabled="true" data-proofreading="none"><ChildContent>@Localize("HtmlEditorProofreadingNoSuggestion")</ChildContent></OmniMenuItem>
                }
                else
                {
                    @foreach (var suggestion in _proofreading.Suggestions)
                    {
                        <OmniMenuItem data-proofreading="suggestion" OnClick="() => ApplyCorrectionAsync(suggestion)"><ChildContent><strong>@suggestion</strong></ChildContent></OmniMenuItem>
                    }
                }

                <span class="omni-html-editor__menu-separator" role="separator"></span>
                <OmniMenuItem data-proofreading="ignore" OnClick="IgnoreIssueAsync"><ChildContent>@Localize("HtmlEditorProofreadingIgnore")</ChildContent></OmniMenuItem>
                @if (proofreader.CanIgnoreAll)
                {
                    <OmniMenuItem data-proofreading="ignore-all" OnClick="() => RecordIssueAsync(false)"><ChildContent>@Localize("HtmlEditorProofreadingIgnoreAll")</ChildContent></OmniMenuItem>
                }

                @if (proofreader.CanAddToDictionary)
                {
                    <OmniMenuItem data-proofreading="add" OnClick="() => RecordIssueAsync(true)"><ChildContent>@Localize("HtmlEditorProofreadingAddToDictionary")</ChildContent></OmniMenuItem>
                }

                @if (_extensionSet.ContextMenu.Count > 0)
                {
                    <span class="omni-html-editor__menu-separator" role="separator"></span>
                }
            }

            @foreach (var command in _extensionSet.ContextMenu)
            {
                if (command.Action == OmniHtmlEditorAction.Separator)
                {
                    <span class="omni-html-editor__menu-separator" role="separator"></span>
                    continue;
                }

                var menuIcon = IconOf(command);
                <OmniMenuItem data-command="@command.Name" Disabled="@IsDisabled(command)" OnClick="() => RunFromMenuAsync(command)">
                    <Icon>
                        @if (menuIcon is { } menuIconName)
                        {
                            <OmniIcon Name="menuIconName" />
                        }
                    </Icon>
                    <ChildContent>@LabelOf(command)</ChildContent>
                </OmniMenuItem>
            }
        </text>;

    RenderFragment editor =
        @<section class="@EditorClass" aria-label="@VisualAriaLabel" aria-labelledby="@VisualLabelledBy">
            <div @ref="_toolbar" class="@(ToolbarLabels ? "omni-html-editor__toolbar omni-html-editor__toolbar--labels" : "omni-html-editor__toolbar")" role="toolbar" aria-label="@Localize("HtmlEditorToolbar")" aria-controls="@SurfaceId">
                @foreach (var (group, groupIndex) in ToolbarGroups.Select((group, index) => (group, index)))
                {
                    <span class="omni-html-editor__group">
                        @if (groupIndex > 0)
                        {
                            <span class="omni-html-editor__separator" role="separator" aria-orientation="vertical"></span>
                        }
                        @foreach (var command in group)
                        {
                            @switch (command.Action)
                            {
                                case OmniHtmlEditorAction.BlockFormat:
                                    <select @key="(command, _selectGeneration)" class="omni-html-editor__select" data-command="@command.Name" aria-label="@LabelOf(command)" aria-description="@command.Description" data-omni-tip="@TipOf(command)" disabled="@IsDisabled(command)" value="@_selection.Block" @onchange="args => ChooseAsync(command, args)">
                                        @foreach (var (value, key) in HtmlEditorToolbar.BlockFormats)
                                        {
                                            <option value="@value">@Localize(key)</option>
                                        }
                                    </select>
                                    break;
                                case OmniHtmlEditorAction.FontSize:
                                    <select @key="(command, _selectGeneration)" class="omni-html-editor__select" data-command="@command.Name" aria-label="@LabelOf(command)" aria-description="@command.Description" data-omni-tip="@TipOf(command)" disabled="@IsDisabled(command)" value="@_selection.Size" @onchange="args => ChooseAsync(command, args)">
                                        @foreach (var (value, key) in HtmlEditorToolbar.FontSizes)
                                        {
                                            <option value="@value">@Localize(key)</option>
                                        }
                                    </select>
                                    break;
                                case OmniHtmlEditorAction.ChangeCase:
                                    @* An action rather than a state: the list shows its name and comes back to it once a case is chosen. *@
                                    <select @key="(command, _selectGeneration)" class="omni-html-editor__select" data-command="@command.Name" aria-label="@LabelOf(command)" aria-description="@command.Description" data-omni-tip="@TipOf(command)" disabled="@IsDisabled(command)" value="" @onchange="args => ChooseAsync(command, args)">
                                        <option value="" disabled>@LabelOf(command)</option>
                                        <option value="upper">@Localize("HtmlEditorCaseUpper")</option>
                                        <option value="lower">@Localize("HtmlEditorCaseLower")</option>
                                        <option value="title">@Localize("HtmlEditorCaseTitle")</option>
                                    </select>
                                    break;
                                default:
                                    var icon = IconOf(command);
                                    <button type="button"
                                            class="@(icon is null ? "omni-html-editor__tool omni-html-editor__tool--text" : "omni-html-editor__tool")"
                                            data-command="@command.Name"
                                            aria-label="@LabelOf(command)"
                                            aria-description="@command.Description"
                                            data-omni-tip="@TipOf(command)"
                                            aria-pressed="@PressedOf(command)"
                                            disabled="@IsDisabled(command)"
                                            @onmousedown:preventDefault
                                            @onclick="() => RunAsync(command)">
                                        @if (icon is { } name)
                                        {
                                            <OmniIcon Name="name" />
                                            @if (ToolbarLabels)
                                            {
                                                <span class="omni-html-editor__tool-label" aria-hidden="true">@LabelOf(command)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@LabelOf(command)</span>
                                        }
                                    </button>
                                    break;
                            }
                        }
                    </span>
                }
                @* The commands placed in the menu, and those a row limit moved there (ToolbarRows): the
                   script hides the button of the menu while nothing has to go in it. *@
                @if (ShowsMoreMenu)
                {
                    var menuCommands = MenuCommands;
                    <span class="omni-html-editor__more" data-omni-fixed="@ArrangedCommands.Count(HtmlEditorToolbar.InMenu)">
                        <OmniOverflowMenu Size="OmniControlSize.Small" Disabled="@(menuCommands.Count == 0)">
                            @foreach (var command in menuCommands)
                            {
                                var menuIcon = IconOf(command);
                                <OmniMenuItem data-command="@command.Name" data-omni-tip="@(string.IsNullOrWhiteSpace(command.Description) ? null : command.Description)" Disabled="@IsDisabled(command)" OnClick="() => RunAsync(command)">
                                    <Icon>
                                        @if (menuIcon is { } menuIconName)
                                        {
                                            <OmniIcon Name="menuIconName" />
                                        }
                                    </Icon>
                                    <ChildContent>@LabelOf(command)</ChildContent>
                                </OmniMenuItem>
                            }
                        </OmniOverflowMenu>
                    </span>
                }
            </div>
            @if (_panels.LinkOpen)
            {
                <div class="omni-html-editor__link" role="group" aria-label="@Localize("HtmlEditorLink")">
                    <label class="omni-html-editor__link-label" for="@LinkInputId">@Localize("HtmlEditorLinkUrl")</label>
                    <input @ref="_linkInput"
                           id="@LinkInputId"
                           class="omni-html-editor__link-input"
                           type="url"
                           form="@(LinkInputId + "-detached")"
                           inputmode="url"
                           autocomplete="off"
                           value="@_panels.LinkUrl"
                           aria-invalid="@(_panels.LinkErrorKey is null ? null : "true")"
                           aria-describedby="@(_panels.LinkErrorKey is null ? null : LinkInputId + "-error")"
                           @oninput="args => _panels.LinkUrl = args.Value?.ToString() ?? string.Empty"
                           @onkeydown="HandleLinkKeyAsync" />
                    <OmniButton Variant="OmniButtonVariant.Primary" Size="OmniControlSize.Small" OnClick="ApplyLinkAsync">
                        <OmniIcon Name="OmniIconName.Check" />
                        <span>@Localize("HtmlEditorLinkApply")</span>
                    </OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Danger" Size="OmniControlSize.Small" OnClick="CloseLinkAsync">
                        <OmniIcon Name="OmniIconName.Close" />
                        <span>@Localize("HtmlEditorLinkCancel")</span>
                    </OmniButton>
                    @if (_panels.LinkErrorKey is { } linkErrorKey)
                    {
                        <p id="@(LinkInputId + "-error")" class="omni-html-editor__link-error" role="alert">@Localize(linkErrorKey)</p>
                    }
                </div>
            }
            @if (_panels.Current == HtmlEditorPanel.Characters)
            {
                <div class="omni-html-editor__panel" role="group" aria-label="@Localize("HtmlEditorInsertSpecialCharacter")">
                    <div class="omni-html-editor__panel-bar">
                        <div class="omni-html-editor__categories" role="group" aria-label="@Localize("HtmlEditorInsertSpecialCharacter")">
                            @foreach (var category in HtmlEditorCharacters.Categories)
                            {
                                var current = category == _panels.CharacterCategory && _panels.CharacterSearch.Trim().Length == 0;
                                <OmniButton Variant="@(current ? OmniButtonVariant.Primary : OmniButtonVariant.Secondary)" Size="OmniControlSize.Small" aria-pressed="@(current ? "true" : "false")"
                                            OnClick="@(() => _panels.ChooseCategory(category))">
                                    <span>@Localize("HtmlEditorCharCategory" + category)</span>
                                </OmniButton>
                            }
                        </div>
                        <input class="omni-html-editor__link-input omni-html-editor__char-search" type="search" autocomplete="off"
                               aria-label="@Localize("HtmlEditorCharSearch")" placeholder="@Localize("HtmlEditorCharSearch")"
                               value="@_panels.CharacterSearch" @oninput="args => _panels.CharacterSearch = args.Value?.ToString() ?? string.Empty" />
                        <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="_panels.Close">
                            <OmniIcon Name="OmniIconName.Close" />
                            <span>@Localize("HtmlEditorClosePanel")</span>
                        </OmniButton>
                    </div>
                    @{ var characters = VisibleCharacters.ToList(); }
                    @if (characters.Count == 0)
                    {
                        <p class="omni-html-editor__panel-note" role="status">@Localize("HtmlEditorCharNone")</p>
                    }
                    else
                    {
                        <div class="omni-html-editor__characters">
                            @foreach (var codePoint in characters)
                            {
                                var character = HtmlEditorCharacters.Text(codePoint);
                                var name = Localize(HtmlEditorCharacters.NameKey(codePoint));
                                <button type="button" class="omni-html-editor__character" data-character="@codePoint.ToString("X4", CultureInfo.InvariantCulture)"
                                        aria-label="@name" title="@name" @onmousedown:preventDefault
                                        @onclick="() => RunBuiltInAsync(OmniHtmlEditorAction.InsertSpecialCharacter, character)">@(codePoint == 0x00A0 ? "␣" : character)</button>
                            }
                        </div>
                    }
                </div>
            }
            else if (_panels.Current == HtmlEditorPanel.Table)
            {
                <div class="omni-html-editor__panel" role="group" aria-label="@Localize("HtmlEditorImportTable")">
                    <div class="omni-html-editor__panel-bar">
                        <OmniUpload Display="OmniUploadDisplay.Field" Accept="@TableAccept" MaximumFileSize="@HtmlEditorTableFile.MaxBytes"
                                    FilesSelected="ReadTableFileAsync" Disabled="@_panels.TableBusy" Class="omni-html-editor__table-file" />
                        <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" OnClick="_panels.Close">
                            <OmniIcon Name="OmniIconName.Close" />
                            <span>@Localize("HtmlEditorClosePanel")</span>
                        </OmniButton>
                    </div>
                    <p class="omni-html-editor__panel-note">@Localize("HtmlEditorImportTableHint", TableAccept)</p>
                    @if (_panels.TableErrorKey is { } tableErrorKey)
                    {
                        <p class="omni-html-editor__link-error" role="alert">@Localize(tableErrorKey)</p>
                    }
                    @if (_panels.TableRows is { } rows)
                    {
                        <p class="omni-html-editor__panel-note" role="status">@Localize("HtmlEditorImportTableRows", _panels.TableHeader ? rows.Count - 1 : rows.Count, rows[0].Count)</p>
                        <div class="omni-html-editor__table-preview omni-rich-text" role="region" aria-label="@Localize("HtmlEditorImportTablePreview")">
                            @((MarkupString)HtmlEditorTableFile.ToHtml(rows.Take(6).ToList(), _panels.TableHeader))
                        </div>
                        <div class="omni-html-editor__panel-bar">
                            <label class="omni-html-editor__check">
                                <OmniCheckBox @bind-Value="_panels.TableHeader" />
                                <span>@Localize("HtmlEditorImportTableHeader")</span>
                            </label>
                            <OmniButton Variant="OmniButtonVariant.Success" Size="OmniControlSize.Small" OnClick="InsertTableAsync">
                                <OmniIcon Name="OmniIconName.Table" />
                                <span>@Localize("HtmlEditorImportTableInsert")</span>
                            </OmniButton>
                        </div>
                    }
                </div>
            }
            @if (_mode == OmniHtmlEditorMode.Visual)
            {
                @* The browser's spell checker is on unless the host says otherwise (a host with its own proofreader turns it off):
                   set before the host's attributes so that theirs wins. *@
                <div spellcheck="true"
                     @attributes="AdditionalAttributes"
                     @ref="_surface"
                     id="@SurfaceId"
                     class="omni-html-editor__surface omni-rich-text"
                     contenteditable="@(IsLocked ? "false" : "true")"
                     tabindex="@(ReadOnly && !Disabled ? "0" : null)"
                     role="textbox"
                     aria-multiline="true"
                     aria-label="@VisualAriaLabel"
                     aria-labelledby="@VisualLabelledBy"
                     aria-readonly="@(ReadOnly && !Disabled ? "true" : null)"
                     aria-disabled="@(Disabled ? "true" : null)"
                     aria-invalid="@AriaInvalid"
                     aria-describedby="@AriaDescribedBy"></div>
                @if (IsMenuOpen)
                {
                    @ContextMenuList(contextMenuItems)
                }
            }
            else
            {
                <textarea @attributes="AdditionalAttributes"
                          id="@SurfaceId"
                          class="omni-html-editor__source"
                          value="@CurrentValue"
                          rows="@Rows"
                          disabled="@Disabled"
                          readonly="@ReadOnly"
                          spellcheck="false"
                          aria-label="@Label"
                          aria-invalid="@AriaInvalid"
                          aria-describedby="@AriaDescribedBy"
                          @ref="_source"
                          @oninput="HandleInputAsync"></textarea>
                @if (ShowPreview)
                {
                    <div class="omni-html-editor__preview omni-rich-text" aria-label="@Localize("HtmlEditorPreview")">@((MarkupString)Clean(CurrentValue))</div>
                }
            }
        </section>;
}

@if (Framed)
{
    <section class="@FrameClass" aria-label="@VisualAriaLabel" aria-labelledby="@VisualLabelledBy">
        @editor
        @if (ShowStatusBar)
        {
            <div class="omni-document-editor__status" role="group" aria-label="@Localize("DocumentEditorStatus")">
                <span data-statistic="words">@Localize("DocumentEditorWords", WordCount)</span>
                <span data-statistic="characters">@Localize("DocumentEditorCharacters", CharacterCount)</span>
                <span class="omni-document-editor__actions">
                    <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" data-export="html" OnClick="DownloadHtmlAsync">
                        <OmniIcon Name="OmniIconName.FileHtml" />
                        <span>@Localize("DocumentEditorExportHtml")</span>
                    </OmniButton>
                    <OmniButton Variant="OmniButtonVariant.Secondary" Size="OmniControlSize.Small" data-export="text" OnClick="DownloadTextAsync">
                        <OmniIcon Name="OmniIconName.Download" />
                        <span>@Localize("DocumentEditorExportText")</span>
                    </OmniButton>
                </span>
            </div>
        }
    </section>
}
else
{
    @editor
}
