@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<fieldset @attributes="AdditionalAttributes"
          id="@Id"
          class="@Css("omni-fieldset", Collapsible ? "omni-fieldset--collapsible" : null)"
          disabled="@Disabled">
    @if (Collapsible)
    {
        @* Native disclosure: it opens and closes without script, keeps its keyboard and screen
           reader semantics, and survives a strict CSP. The same mechanism as the compact
           multi-select and the grid filter menus. Script only listens to it when the host asks
           through ExpandedChanged. *@
        <details @ref="_details" open="@Expanded">
            <summary class="omni-fieldset__legend omni-fieldset__summary">@Legend</summary>
            <div class="omni-fieldset__content">@ChildContent</div>
        </details>
    }
    else
    {
        <legend class="omni-fieldset__legend">@Legend</legend>
        <div class="omni-fieldset__content">@ChildContent</div>
    }
</fieldset>
