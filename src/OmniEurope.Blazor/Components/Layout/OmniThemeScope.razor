@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div @ref="_element"
     id="@Id"
     class="@Css("omni-theme-scope")"
     data-omni-theme="@Appearance.ToString().ToLowerInvariant()"
     data-omni-density="@Density.ToString().ToLowerInvariant()"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>
