@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable

@* Each main area tells the ones nested in it that it holds them: only the outermost follows the
   user's content width. Scrollable wraps the landmark in a frame as wide as the main area: the landmark scrolls across the
   whole of it, so its scrollbar sits at the window's edge and never beside a centred column, and its
   inline padding, measured against the frame, is what centres that column. A page veil declared in the
   content (OmniPageVeil) is drawn here, as the last child of the frame (or of the landmark when it does not
   scroll), so it covers the content area exactly and nothing outside it. *@
@if (Scrollable)
{
    <div class="@(_veils.Count > 0 ? "omni-main-scroll omni-main-scroll--veiled" : "omni-main-scroll")">
        <main @attributes="AdditionalAttributes"
              @ref="_main"
              id="@Id"
              class="@Css("omni-main", "omni-main--scrollable", WidthClass, AutoHideScrollbar ? "omni-main--scrollbar-autohide" : null)"
              tabindex="@(FocusTarget ? "-1" : null)"
              aria-labelledby="@AriaLabelledBy">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </main>
        @foreach (var veil in _veils)
        {
            @veil.Surface
        }
    </div>
}
else
{
    <main @attributes="AdditionalAttributes"
          id="@Id"
          class="@Css("omni-main", WidthClass, _veils.Count > 0 ? "omni-main--veiled" : null)"
          tabindex="@(FocusTarget ? "-1" : null)"
          aria-labelledby="@AriaLabelledBy">
        <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        @foreach (var veil in _veils)
        {
            @veil.Surface
        }
    </main>
}
