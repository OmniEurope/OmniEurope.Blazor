@typeparam TValue
@inherits OmniInputBase<TValue>
@implements IAsyncDisposable

<div class="omni-autocomplete">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", "omni-autocomplete__input")"
           type="search"
           value="@_searchText"
           placeholder="@Placeholder"
           autocomplete="off"
           disabled="@Disabled"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@(_results.Count > 0 ? "true" : "false")"
           aria-controls="@ResultsId"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @oninput="HandleInputAsync" />
    @if (_results.Count > 0)
    {
        <ul id="@ResultsId" class="omni-autocomplete__results" role="listbox">
            @foreach (var option in _results)
            {
                <li role="option" aria-selected="@(IsSelected(option.Value) ? "true" : "false")">
                    <button type="button"
                            class="omni-autocomplete__option"
                            disabled="@option.Disabled"
                            @onclick="() => SelectAsync(option)">@option.Text</button>
                </li>
            }
        </ul>
    }
    <span class="omni-visually-hidden" role="status" aria-live="polite">@_announcement</span>
</div>

@code {
    private CancellationTokenSource? _searchCancellation;
    private int _searchGeneration;
    private IReadOnlyList<OmniOption<TValue>> _results = Array.Empty<OmniOption<TValue>>();
    private string _searchText = string.Empty;
    private string _announcement = string.Empty;

    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<IReadOnlyList<OmniOption<TValue>>>>? Search { get; set; }

    [Parameter]
    public int DebounceMilliseconds { get; set; } = 250;

    [Parameter]
    public int MinimumLength { get; set; } = 1;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? AriaDescribedBy { get; set; }

    [Parameter]
    public Func<TValue, string>? FormatValue { get; set; }

    private string ResultsId => $"{Id ?? FieldIdentifier.FieldName}-results";
    private bool IsSelected(TValue value) => EqualityComparer<TValue>.Default.Equals(CurrentValue, value);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (string.IsNullOrEmpty(_searchText) && CurrentValue is not null)
        {
            _searchText = FormatValue?.Invoke(CurrentValue) ?? CurrentValue.ToString() ?? string.Empty;
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        var token = _searchCancellation.Token;
        var generation = ++_searchGeneration;

        if (_searchText.Length < MinimumLength || Search is null)
        {
            _results = Array.Empty<OmniOption<TValue>>();
            _announcement = string.Empty;
            return;
        }

        try
        {
            await Task.Delay(Math.Max(0, DebounceMilliseconds), token);
            var results = await Search(_searchText, token);
            if (generation != _searchGeneration)
            {
                return;
            }

            _results = results;
            _announcement = _results.Count == 1
                ? "1 résultat disponible."
                : $"{_results.Count} résultats disponibles.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task SelectAsync(OmniOption<TValue> option)
    {
        if (option.Disabled)
        {
            return;
        }

        CurrentValue = option.Value;
        _searchText = option.Text;
        _results = Array.Empty<OmniOption<TValue>>();
        _announcement = $"{option.Text} sélectionné.";
        await Task.CompletedTask;
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = "La valeur de saisie assistée n'est pas valide.";
        return false;
    }

    public ValueTask DisposeAsync()
    {
        _searchGeneration++;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
