@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-split-button")" @onkeydown="HandleKeyDownAsync">
    <button type="button"
            @ref="_toggle"
            class="@(Busy ? "omni-split-button__main omni-busy" : "omni-split-button__main")"
            disabled="@Disabled"
            aria-busy="@(Busy ? "true" : null)"
            @onclick="InvokeMainAsync">@Text</button>
    <button type="button"
            class="@(Busy ? "omni-split-button__toggle omni-busy" : "omni-split-button__toggle")"
            disabled="@Disabled"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@EffectiveMenuLabel"
            @onclick="ToggleMenuAsync">▾</button>
    @if (_open)
    {
        <div @ref="_menu" class="omni-split-button__menu" role="menu" tabindex="-1" autofocus>@ChildContent</div>
    }
</div>
