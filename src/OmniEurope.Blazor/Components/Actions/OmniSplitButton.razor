@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IOmniMenu
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@* The main part runs the main action; the chevron opens the menu of the others, drawn in the overlay
   portal (or here, fixed to the window, without a host) and placed under the whole button. *@
<div @attributes="AdditionalAttributes"
     @ref="_root"
     id="@Id"
     class="@Css("omni-split-button", $"omni-split-button--{Size.ToString().ToLowerInvariant()}", VariantClass)">
    <button type="button"
            class="@(Busy ? "omni-split-button__main omni-busy" : "omni-split-button__main")"
            disabled="@Disabled"
            aria-busy="@(Busy ? "true" : null)"
            aria-label="@(string.IsNullOrWhiteSpace(Label) ? null : Label)"
            @onclick="InvokeMainAsync">@Icon@Text</button>
    <button type="button"
            class="@(Busy ? "omni-split-button__toggle omni-busy" : "omni-split-button__toggle")"
            disabled="@Disabled"
            aria-haspopup="menu"
            aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="@(IsOpen ? MenuId : null)"
            aria-label="@EffectiveMenuLabel"
            @onclick="ToggleMenuAsync"
            @onkeydown="HandleToggleKeyDownAsync"><OmniIcon Name="OmniIconName.ChevronDown" Size="OmniControlSize.Small" /></button>
    @if (IsOpen && Coordinator is null)
    {
        @Popup
    }
</div>
