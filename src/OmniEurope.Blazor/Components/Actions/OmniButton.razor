@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* Busy is not disabled (it would change size and colours); preventDefault stops a form resubmitting on Enter. *@
<button id="@Id"
        class="@Css("omni-button", $"omni-button--{Variant.ToString().ToLowerInvariant()}", $"omni-button--{Size.ToString().ToLowerInvariant()}", Busy ? "omni-busy" : null)"
        type="@ButtonType.ToString().ToLowerInvariant()"
        disabled="@Disabled"
        aria-busy="@(Busy ? "true" : null)"
        aria-label="@AriaLabel"
        @attributes="AdditionalAttributes"
        @onclick="HandleClickAsync"
        @onclick:preventDefault="Busy">
    <span class="omni-button__content">@ChildContent</span>
</button>
