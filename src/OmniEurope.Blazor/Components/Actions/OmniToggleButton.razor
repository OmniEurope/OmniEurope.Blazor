@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<button @attributes="AdditionalAttributes"
        id="@Id"
        type="button"
        class="@Css("omni-toggle-button", Value ? "omni-toggle-button--pressed" : null, Busy ? "omni-busy" : null)"
        aria-pressed="@(Value ? "true" : "false")"
        disabled="@Disabled"
        aria-busy="@(Busy ? "true" : null)"
        @onclick="ToggleAsync">@ChildContent</button>
