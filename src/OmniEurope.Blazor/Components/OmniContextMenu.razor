@inherits OmniComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@Css("omni-context-menu")"
     @oncontextmenu="OpenAsync"
     @oncontextmenu:preventDefault="true"
     @onkeydown="HandleKeyDownAsync">
    <div class="omni-context-menu__trigger">@TriggerContent</div>
    @if (Open)
    {
        <div class="omni-context-menu__popup" role="menu" aria-label="@MenuLabel" tabindex="-1">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string MenuLabel { get; set; } = "Menu contextuel";

    [Parameter, EditorRequired]
    public RenderFragment? TriggerContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task OpenAsync() => OpenChanged.InvokeAsync(true);

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "ContextMenu" || (args.ShiftKey && args.Key == "F10"))
        {
            return OpenChanged.InvokeAsync(true);
        }

        return args.Key == "Escape" ? OpenChanged.InvokeAsync(false) : Task.CompletedTask;
    }
}
