@inherits OmniComponentBase

<details @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-profile-menu")">
    <summary class="omni-profile-menu__summary" aria-label="@Label">@Summary</summary>
    <div class="omni-profile-menu__items" role="menu">@ChildContent</div>
</details>

@code {
    [Parameter]
    public string Label { get; set; } = "Menu du profil";

    [Parameter, EditorRequired]
    public RenderFragment? Summary { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
