@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

@if (IsNullable)
{
    <button @attributes="AdditionalAttributes"
            id="@EffectiveId"
            class="@InputCss("omni-checkbox-nullable", State is null ? "omni-checkbox-nullable--mixed" : State == true ? "omni-checkbox-nullable--checked" : null)"
            type="button"
            role="checkbox"
            disabled="@Disabled"
            aria-checked="@AriaChecked"
            aria-invalid="@AriaInvalid"
            aria-describedby="@AriaDescribedBy"
            @onclick="Cycle">
        <span class="omni-checkbox-nullable__indicator" aria-hidden="true"></span>
        @if (ChildContent is not null)
        {
            <span>@ChildContent</span>
        }
    </button>
}
else if (ChildContent is null)
{
    <input @attributes="AdditionalAttributes"
           id="@EffectiveId"
           class="@InputCss("omni-checkbox")"
           type="checkbox"
           checked="@(State == true)"
           disabled="@Disabled"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @onchange="HandleChange" />
}
else
{
    @* The label wraps the box, so a click on the text toggles it and the text names it. The host's Class
       goes on the label, the element that lays the line out; the validation state stays on the box. *@
    <label class="@LabelCss">
        <input @attributes="AdditionalAttributes"
               id="@EffectiveId"
               class="@BoxCss"
               type="checkbox"
               checked="@(State == true)"
               disabled="@Disabled"
               aria-invalid="@AriaInvalid"
               aria-describedby="@AriaDescribedBy"
               @onchange="HandleChange" />
        <span class="omni-checkbox-label__text">@ChildContent</span>
    </label>
}
