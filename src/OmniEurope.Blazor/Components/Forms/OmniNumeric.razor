@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

<input @attributes="AdditionalAttributes"
       id="@Id"
       class="@InputCss("omni-input", "omni-numeric")"
       type="number"
       value="@DisplayValue"
       min="@Invariant(Minimum)"
       max="@Invariant(Maximum)"
       step="@Invariant(Step)"
       placeholder="@Placeholder"
       disabled="@Disabled"
       readonly="@ReadOnly"
       aria-invalid="@AriaInvalid"
       aria-describedby="@AriaDescribedBy"
       @onchange="HandleChange" />
