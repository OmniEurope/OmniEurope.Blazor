@namespace OmniEurope.Blazor.Components
@typeparam TValue
@inherits OmniInputBase<TValue>

<button @attributes="AdditionalAttributes"
        id="@EffectiveId"
        class="@InputCss("omni-switch", State == true ? "omni-switch--checked" : null, IsNullable && State is null ? "omni-switch--mixed" : null, TextFirst && ChildContent is not null ? "omni-switch--text-first" : null)"
        type="button"
        role="switch"
        disabled="@Disabled"
        aria-checked="@(State == true ? "true" : "false")"
        aria-description="@(IsNullable && State is null ? EffectiveIndeterminateDescription : null)"
        aria-invalid="@AriaInvalid"
        aria-describedby="@AriaDescribedBy"
        @onclick="Toggle">
    <span class="omni-switch__track" aria-hidden="true"><span class="omni-switch__thumb"></span></span>
    @if (ChildContent is not null)
    {
        <span class="omni-switch__label">@ChildContent</span>
    }
</button>
