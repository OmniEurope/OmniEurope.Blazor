@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>

<div class="omni-password">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", "omni-password__input")"
           type="@(_revealed ? "text" : "password")"
           value="@CurrentValueAsString"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @oninput="HandleInput" />
    @if (Revealable)
    {
        @* An eye by default: a square as tall as the field, whose glyph changes without the button
           changing size. A word ("Afficher" / "Masquer") changed its width at every press. *@
        <button class="@(ShowsText ? "omni-password__toggle" : "omni-password__toggle omni-password__toggle--icon")"
                type="button"
                disabled="@Disabled"
                aria-controls="@Id"
                aria-pressed="@(_revealed ? "true" : "false")"
                aria-label="@(_revealed ? EffectiveHideLabel : EffectiveRevealLabel)"
                @onclick="ToggleReveal">
            @if (ShowsText)
            {
                @(_revealed ? HideText : RevealText)
            }
            else
            {
                <OmniIcon Name="@(_revealed ? OmniIconName.EyeSlash : OmniIconName.Eye)" />
            }
        </button>
    }
</div>
