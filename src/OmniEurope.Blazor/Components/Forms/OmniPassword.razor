@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>

<div class="omni-password">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", "omni-password__input")"
           type="@(_revealed ? "text" : "password")"
           value="@CurrentValueAsString"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @oninput="HandleInput" />
    @if (Revealable)
    {
        <button class="omni-password__toggle"
                type="button"
                disabled="@Disabled"
                aria-controls="@Id"
                aria-pressed="@(_revealed ? "true" : "false")"
                aria-label="@(_revealed ? EffectiveHideLabel : EffectiveRevealLabel)"
                @onclick="ToggleReveal">
            @(_revealed ? EffectiveHideText : EffectiveRevealText)
        </button>
    }
</div>
