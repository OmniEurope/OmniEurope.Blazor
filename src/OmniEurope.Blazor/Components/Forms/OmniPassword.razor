@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>

<div class="@(AriaInvalid == "true" ? "omni-password omni-password--invalid" : "omni-password")">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", MaskedByStyle ? "omni-password__input omni-password__input--masked" : "omni-password__input")"
           type="@InputType"
           value="@CurrentValueAsString"
           placeholder="@Placeholder"
           autocomplete="@(IgnorePasswordManagers ? "off" : Autocomplete)"
           spellcheck="@(IgnorePasswordManagers ? "false" : null)"
           autocapitalize="@(IgnorePasswordManagers ? "off" : null)"
           data-lpignore="@(IgnorePasswordManagers ? "true" : null)"
           data-1p-ignore="@(IgnorePasswordManagers ? "true" : null)"
           data-bwignore="@(IgnorePasswordManagers ? "true" : null)"
           data-form-type="@(IgnorePasswordManagers ? "other" : null)"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @oninput="HandleInput" />
    @if (Revealable)
    {
        @* An eye by default: a square as tall as the field, whose glyph changes without the button
           changing size. A word ("Afficher" / "Masquer") changed its width at every press. *@
        <button class="@(ShowsText ? "omni-password__toggle" : "omni-password__toggle omni-password__toggle--icon")"
                type="button"
                disabled="@Disabled"
                aria-controls="@Id"
                aria-pressed="@(_revealed ? "true" : "false")"
                aria-label="@(_revealed ? EffectiveHideLabel : EffectiveRevealLabel)"
                @onclick="ToggleReveal">
            @if (ShowsText)
            {
                @(_revealed ? HideText : RevealText)
            }
            else
            {
                <OmniIcon Name="@(_revealed ? OmniIconName.EyeSlash : OmniIconName.Eye)" />
            }
        </button>
    }
</div>
