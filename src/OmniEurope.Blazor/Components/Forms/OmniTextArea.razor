@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>

@* Class goes on the wrapper, the outermost element; Id and the additional attributes on the text area,
   the control. *@
<div class="@WrapperCss("omni-text-area")">
    <textarea @attributes="AdditionalAttributes"
              id="@Id"
              class="@InnerInputCss("omni-input", "omni-text-area__input")"
              rows="@Rows"
              maxlength="@MaxLength"
              placeholder="@Placeholder"
              disabled="@Disabled"
              readonly="@ReadOnly"
              aria-invalid="@AriaInvalid"
              aria-describedby="@AriaDescribedBy"
              value="@CurrentValueAsString"
              @oninput="HandleInput"></textarea>
    @if (ShowCount && MaxLength is not null)
    {
        <span class="omni-text-area__count" aria-live="polite">@Localize("TextAreaCount", CurrentLength, MaxLength)</span>
    }
</div>
