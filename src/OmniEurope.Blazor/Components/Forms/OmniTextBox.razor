@namespace OmniEurope.Blazor.Components
@inherits OmniInputBase<string>
@implements IAsyncDisposable

@* With an Icon or ShowCopy the input sits in a wrapper: the icon is laid over its start padding,
   decorative and click-through, like the magnifier of a search field, and the copy button is welded
   to its end. Without either the input is rendered alone, as it always was. Class goes on the
   outermost element (the input alone, or the wrapper); Id and the additional attributes always on
   the input. *@
@if (Icon is null && !ShowCopy)
{
    <input @attributes="AdditionalAttributes"
           id="@Id"
           class="@InputCss("omni-input", "omni-text-box")"
           type="@TypeAttribute"
           value="@CurrentValueAsString"
           placeholder="@Placeholder"
           autocomplete="@Autocomplete"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@AriaInvalid"
           aria-describedby="@AriaDescribedBy"
           @oninput="HandleInput"
           @onblur="BlurCallback" />
}
else
{
    <span class="@WrapperCss("omni-text-box-field", ShowCopy ? "omni-text-box-field--copy" : null)">
        @if (Icon is not null)
        {
            <span class="omni-text-box-field__icon" aria-hidden="true">@Icon</span>
        }
        <input @attributes="AdditionalAttributes"
               id="@Id"
               class="@InnerInputCss("omni-input", "omni-text-box", Icon is not null ? "omni-text-box--icon" : null)"
               type="@TypeAttribute"
               value="@CurrentValueAsString"
               placeholder="@Placeholder"
               autocomplete="@Autocomplete"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-invalid="@AriaInvalid"
               aria-describedby="@AriaDescribedBy"
               @oninput="HandleInput"
               @onblur="BlurCallback" />
        @if (ShowCopy)
        {
            <OmniButton Class="omni-text-box-field__copy"
                        Variant="OmniButtonVariant.Secondary"
                        Disabled="@(Disabled || string.IsNullOrEmpty(CurrentValueAsString))"
                        Label="@(CopyIconOnly ? CopyLabel : null)"
                        title="@(CopyIconOnly ? CopyLabel : null)"
                        ChildContent="CopyContent"
                        OnClick="CopyAsync">
                <Icon><OmniIcon Name="@(CopyResult == true ? OmniIconName.Check : OmniIconName.Copy)" /></Icon>
            </OmniButton>
            <span class="omni-visually-hidden" role="status" aria-live="polite">@CopyAnnouncement</span>
        }
    </span>
}
