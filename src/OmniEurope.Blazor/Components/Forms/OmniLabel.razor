@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<label @attributes="AdditionalAttributes"
       id="@Id"
       class="@Css("omni-label", Required ? "omni-label--required" : null)"
       for="@For">
    @ChildContent
    @if (Required)
    {
        <span class="omni-label__required" aria-hidden="true">*</span>
    }
</label>
