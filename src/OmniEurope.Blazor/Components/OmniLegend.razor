<g class="omni-chart__legend" aria-label="@Label">
    @for (var index = 0; index < Items.Count; index++)
    {
        <rect class="omni-chart-color-@(index % 8)" x="75" y="@OmniChartGeometry.Number(5 + index * 6)" width="3" height="3" />
        <g><text x="80" y="@OmniChartGeometry.Number(8 + index * 6)">@Items[index]</text></g>
    }
</g>

@code {
    [Parameter] public string Label { get; set; } = "Légende";
    [Parameter] public IReadOnlyList<string> Items { get; set; } = Array.Empty<string>();
}
