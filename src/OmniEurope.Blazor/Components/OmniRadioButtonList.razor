@typeparam TValue
@inherits OmniInputBase<TValue>

<fieldset @attributes="AdditionalAttributes" id="@Id" class="@InputCss("omni-choice-list")" disabled="@Disabled">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <legend class="omni-choice-list__legend">@Label</legend>
    }
    @foreach (var option in Options)
    {
        <OmniRadioButtonListItem TValue="TValue"
                                 Name="@GroupName"
                                 Value="@option.Value"
                                 Selected="@IsSelected(option.Value)"
                                 Disabled="@option.Disabled"
                                 SelectedValueChanged="Select" >@option.Text</OmniRadioButtonListItem>
    }
</fieldset>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OmniOption<TValue>> Options { get; set; } = Array.Empty<OmniOption<TValue>>();

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string GroupName => Name ?? Id ?? $"omni-radio-{FieldIdentifier.FieldName}";
    private bool IsSelected(TValue value) => EqualityComparer<TValue>.Default.Equals(CurrentValue, value);

    private void Select(TValue? value)
    {
        if (!Disabled)
        {
            CurrentValue = value!;
        }
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        result = default!;
        validationErrorMessage = "La sélection radio n'est pas valide.";
        return false;
    }
}
