@inherits OmniComponentBase

<section @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-scheduler-view", "omni-month-view")" aria-label="@Label">
    @for (var dayNumber = 1; dayNumber <= DateTime.DaysInMonth(Date.Year, Date.Month); dayNumber++)
    {
        var day = new DateTimeOffset(Date.Year, Date.Month, dayNumber, 0, 0, 0, Date.Offset);
        <article class="omni-month-view__day">
            <h3>@dayNumber</h3>
            @foreach (var appointment in Appointments.Where(item => item.Start.Date == day.Date).OrderBy(item => item.Start))
            {
                <p><time datetime="@appointment.Start.ToString("O")">@appointment.Start.ToString("t", Culture)</time> @appointment.Title</p>
            }
        </article>
    }
</section>

@code {
    [Parameter] public DateTimeOffset Date { get; set; }
    [Parameter] public IReadOnlyList<OmniSchedulerAppointment> Appointments { get; set; } = Array.Empty<OmniSchedulerAppointment>();
    [Parameter] public System.Globalization.CultureInfo Culture { get; set; } = System.Globalization.CultureInfo.CurrentCulture;
    [Parameter] public string Label { get; set; } = "Vue mensuelle";
}
