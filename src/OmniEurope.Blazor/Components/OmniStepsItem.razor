@inherits OmniComponentBase

<div @attributes="AdditionalAttributes" id="@Id" class="@Css("omni-steps__item", Selected ? "omni-steps__item--selected" : null)">
    <button type="button" class="omni-steps__button" role="tab" aria-selected="@(Selected ? "true" : "false")" aria-controls="@PanelId" disabled="@Disabled" @onclick="SelectAsync">
        <span class="omni-steps__number">@(Index + 1)</span>
        <span>@Title</span>
    </button>
    <section id="@PanelId" class="omni-steps__panel" role="tabpanel" hidden="@(!Selected)">@ChildContent</section>
</div>

@code {
    [CascadingParameter]
    private OmniStepsContext? Context { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool Selected => Context?.Value == Index;
    private string PanelId => $"{Id ?? $"omni-step-{Index}"}-panel";
    private Task SelectAsync() => Disabled || Context is null ? Task.CompletedTask : Context.SelectAsync(Index);
}
