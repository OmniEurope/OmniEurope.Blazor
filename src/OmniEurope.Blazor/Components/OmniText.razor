@inherits OmniComponentBase

@switch (Element)
{
    case OmniTextElement.Paragraph:
        <p id="@Id" class="@TextClass" @attributes="AdditionalAttributes">@ChildContent</p>
        break;
    case OmniTextElement.Strong:
        <strong id="@Id" class="@TextClass" @attributes="AdditionalAttributes">@ChildContent</strong>
        break;
    case OmniTextElement.Emphasis:
        <em id="@Id" class="@TextClass" @attributes="AdditionalAttributes">@ChildContent</em>
        break;
    case OmniTextElement.Small:
        <small id="@Id" class="@TextClass" @attributes="AdditionalAttributes">@ChildContent</small>
        break;
    default:
        <span id="@Id" class="@TextClass" @attributes="AdditionalAttributes">@ChildContent</span>
        break;
}

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public OmniTextElement Element { get; set; }

    [Parameter]
    public OmniTextTone Tone { get; set; }

    [Parameter]
    public bool Truncate { get; set; }

    private string TextClass => Css(
        "omni-text",
        $"omni-text--{Tone.ToString().ToLowerInvariant()}",
        Truncate ? "omni-text--truncate" : null);
}
