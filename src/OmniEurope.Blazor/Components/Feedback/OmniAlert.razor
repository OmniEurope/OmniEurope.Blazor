@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@if (!_dismissed)
{
    @* Live, the message is announced at once (role="alert"); otherwise it is ordinary content, read in
       its place, with no live role that would announce it anyway. *@
    <div @attributes="AdditionalAttributes"
         id="@Id"
         class="@Css("omni-alert", $"omni-alert--{Severity.ToString().ToLowerInvariant()}", $"omni-alert--{Fill.ToString().ToLowerInvariant()}")"
         role="@(Live ? "alert" : null)"
         data-omni-density="@OmniDensityAttribute.Of(Density)">
        @* The icon is a glyph alone in a disc: the severity's own glyph, or the consumer's icon in its place. *@
        <span class="omni-alert__icon" aria-hidden="true">
            @if (Icon is not null)
            {
                @Icon
            }
            else
            {
                <svg class="omni-alert__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="@GlyphPath" /></svg>
            }
        </span>
        <div class="omni-alert__body">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <strong class="omni-alert__title">@Title</strong>
            }
            <div class="omni-alert__content">@ChildContent</div>
        </div>
        @if (Dismissible)
        {
            <button type="button" class="omni-alert__dismiss" aria-label="@EffectiveCloseLabel" title="@EffectiveCloseLabel" @onclick="DismissAsync">
                <OmniIcon Name="OmniIconName.Close" Size="OmniControlSize.Small" />
            </button>
        }
    </div>
}
