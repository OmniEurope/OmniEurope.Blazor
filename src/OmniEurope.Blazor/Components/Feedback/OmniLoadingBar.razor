@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase
@implements IDisposable
@inject OmniLoadingState State

@* The strip takes no height at all: the track is laid over whatever follows it. Reserving a strip
   kept the layout still, but left an empty gap under the header outside of every load, which is
   most of the time. Drawn over the content, it moves nothing and leaves no gap. *@
<div id="@Id"
     class="@Css("omni-loading-bar", $"omni-loading-bar--{Mode.ToString().ToLowerInvariant()}", State.Loading ? "omni-loading-bar--active" : null, _finishing ? "omni-loading-bar--done" : null)"
     role="@(State.Loading ? "progressbar" : null)"
     aria-label="@(State.Loading ? EffectiveLabel : null)"
     aria-valuemin="@(State.Loading && !Unmeasured ? "0" : null)"
     aria-valuemax="@(State.Loading && !Unmeasured ? "100" : null)"
     aria-valuenow="@ValueNow"
     @attributes="AdditionalAttributes">
    @if (Visible)
    {
        <span class="omni-loading-bar__track" aria-hidden="true">
            <span class="@IndicatorClass"></span>
        </span>
    }
</div>
