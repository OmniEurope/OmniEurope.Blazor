@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<svg id="@Id"
     class="@Css("omni-icon", $"omni-icon--{Size.ToString().ToLowerInvariant()}")"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     focusable="false"
     role="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : "img")"
     aria-hidden="@(string.IsNullOrWhiteSpace(AriaLabel) ? "true" : null)"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(AriaLabel))
    {
        <title>@AriaLabel</title>
    }
    @switch (Name)
    {
        case OmniIconName.Check:
            <path d="M5 12l4 4 10-10" />
            break;
        case OmniIconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case OmniIconName.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v6M12 7h.01" />
            break;
        case OmniIconName.Warning:
            <path d="M12 3L2.8 20h18.4L12 3zM12 9v5M12 17h.01" />
            break;
        case OmniIconName.ChevronDown:
            <path d="M6 9l6 6 6-6" />
            break;
        default:
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
    }
</svg>
