@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<svg id="@Id"
     class="@Css("omni-icon", $"omni-icon--{Size.ToString().ToLowerInvariant()}")"
     viewBox="@ResolvedGlyph.ViewBox"
     fill="currentColor"
     focusable="false"
     role="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : "img")"
     aria-hidden="@(string.IsNullOrWhiteSpace(AriaLabel) ? "true" : null)"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">
    @* An SVG shows no tooltip for a title attribute, only for a <title> child: the accessible name,
       or else a title the caller passed as an attribute, becomes that child. *@
    @if (!string.IsNullOrWhiteSpace(TooltipText))
    {
        <title>@TooltipText</title>
    }
    <path d="@ResolvedGlyph.PathData" />
</svg>
