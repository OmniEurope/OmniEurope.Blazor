@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<svg id="@Id"
     class="@Css("omni-icon", $"omni-icon--{Size.ToString().ToLowerInvariant()}")"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     focusable="false"
     role="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : "img")"
     aria-hidden="@(string.IsNullOrWhiteSpace(AriaLabel) ? "true" : null)"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(AriaLabel))
    {
        <title>@AriaLabel</title>
    }
    @switch (Name)
    {
        case OmniIconName.Check:
            <path d="M5 12l4 4 10-10" />
            break;
        case OmniIconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case OmniIconName.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v6M12 7h.01" />
            break;
        case OmniIconName.Warning:
            <path d="M12 3L2.8 20h18.4L12 3zM12 9v5M12 17h.01" />
            break;
        case OmniIconName.ChevronDown:
            <path d="M6 9l6 6 6-6" />
            break;
        case OmniIconName.Filter:
            <path d="M3 5h18l-7 8v6l-4 2v-8z" />
            break;
        case OmniIconName.SortAscending:
            <path d="M12 19V5M6 11l6-6 6 6" />
            break;
        case OmniIconName.SortDescending:
            <path d="M12 5v14M6 13l6 6 6-6" />
            break;
        case OmniIconName.ThemeDark:
            <path d="M20 14.5A8 8 0 019.5 4a7 7 0 1010.5 10.5z" />
            break;
        case OmniIconName.ThemeLight:
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            break;
        default:
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
    }
</svg>
