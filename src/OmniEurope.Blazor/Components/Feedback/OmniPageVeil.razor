@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

@* The wait of a whole page: an opaque layer fixed over the viewport with the application's own logo at its
   centre. Nothing here animates; the wait is told in words to assistive technologies (the logo is
   decorative) and the veil only shows once the wait has lasted 100 ms, a delay the stylesheet keeps
   (no timer, so a wait that ends sooner removes the element before it was ever visible). *@
@if (Busy)
{
    <div @attributes="AdditionalAttributes"
         id="@Id"
         class="@Css("omni-page-veil")"
         role="status">
        @if (HasLogo)
        {
            <span class="omni-page-veil__logo" aria-hidden="true">
                @if (Logo is not null)
                {
                    @Logo
                }
                else
                {
                    <img class="omni-page-veil__image" src="@LogoSource" alt="" />
                }
            </span>
        }
        <span class="omni-visually-hidden">@EffectiveLabel</span>
    </div>
}
