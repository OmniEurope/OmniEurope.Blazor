@namespace OmniEurope.Blazor.Components
@inherits OmniComponentBase

<span @attributes="AdditionalAttributes"
      id="@Id"
      class="@Css("omni-badge", $"omni-badge--{Tone.ToString().ToLowerInvariant()}", $"omni-badge--{Fill.ToString().ToLowerInvariant()}", IconOnly ? "omni-badge--icon" : null)">
    @Icon
    @ChildContent
</span>
